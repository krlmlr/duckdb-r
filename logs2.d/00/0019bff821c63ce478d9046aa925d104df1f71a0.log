2026-07-28T07:11:08.1231861Z > library(testthat)
2026-07-28T07:11:08.1232096Z > library(duckdb.dev)
2026-07-28T07:11:08.1232367Z Loading required package: DBI
2026-07-28T07:11:08.1232607Z > 
2026-07-28T07:11:08.1232798Z > # CRAN guard
2026-07-28T07:11:08.1232987Z > #
2026-07-28T07:11:08.1233406Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:11:08.1234137Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:11:08.1234739Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:11:08.1235314Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:11:08.1235893Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:11:08.1236503Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:11:08.1237143Z > # so the guard is obvious and self-contained.
2026-07-28T07:11:08.1237754Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:11:08.1238097Z > 
2026-07-28T07:11:08.1238365Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:11:08.1238708Z +   run <- TRUE
2026-07-28T07:11:08.1239027Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:11:08.1239627Z +   run <- FALSE
2026-07-28T07:11:08.1239896Z + } else {
2026-07-28T07:11:08.1240264Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:11:08.1240726Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:11:08.1241014Z + }
2026-07-28T07:11:08.1241181Z > 
2026-07-28T07:11:08.1241375Z > if (run) {
2026-07-28T07:11:08.1241626Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:11:08.1241899Z + } else {
2026-07-28T07:11:08.1242357Z +   message(
2026-07-28T07:11:08.1242573Z +     "\n",
2026-07-28T07:11:08.1242789Z +     strrep("=", 78),
2026-07-28T07:11:08.1243018Z +     "\n",
2026-07-28T07:11:08.1243274Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:11:08.1243556Z +     "\n",
2026-07-28T07:11:08.1243969Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:11:08.1244585Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:11:08.1245167Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:11:08.1245771Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:11:08.1246207Z +     "manner.\n",
2026-07-28T07:11:08.1246421Z +     "\n",
2026-07-28T07:11:08.1246826Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:11:08.1247479Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:11:08.1247996Z +     "\n",
2026-07-28T07:11:08.1248474Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:11:08.1249072Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:11:08.1249767Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:11:08.1250151Z +     strrep("=", 78),
2026-07-28T07:11:08.1250371Z +     "\n"
2026-07-28T07:11:08.1250546Z +   )
2026-07-28T07:11:08.1250714Z + }
