2026-07-28T07:09:15.3545771Z > # CRAN guard
2026-07-28T07:09:15.3546251Z > #
2026-07-28T07:09:15.3547132Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:09:15.3548359Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:09:15.3549809Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:09:15.3550883Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:09:15.3551922Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:09:15.3553018Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:09:15.3553886Z > # so the guard is obvious and self-contained.
2026-07-28T07:09:15.3554699Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:09:15.3555302Z > 
2026-07-28T07:09:15.3555771Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:09:15.3556300Z +   run <- TRUE
2026-07-28T07:09:15.3556863Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:09:15.3557434Z +   run <- FALSE
2026-07-28T07:09:15.3557788Z + } else {
2026-07-28T07:09:15.3558425Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:09:15.3559229Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:09:15.3559911Z + }
2026-07-28T07:09:15.3560202Z > 
2026-07-28T07:09:15.3560529Z > if (run) {
2026-07-28T07:09:15.3560965Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:09:15.3561499Z + } else {
2026-07-28T07:09:15.3561828Z +   message(
2026-07-28T07:09:15.3562165Z +     "\n",
2026-07-28T07:09:15.3562537Z +     strrep("=", 78),
2026-07-28T07:09:15.3562908Z +     "\n",
2026-07-28T07:09:15.3563342Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:09:15.3563829Z +     "\n",
2026-07-28T07:09:15.3564568Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:09:15.3565646Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:09:15.3566670Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:09:15.3567770Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:09:15.3568527Z +     "manner.\n",
2026-07-28T07:09:15.3568881Z +     "\n",
2026-07-28T07:09:15.3569819Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:09:15.3570996Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:09:15.3571764Z +     "\n",
2026-07-28T07:09:15.3572499Z +     "To run the test suite locally, set the environment variable before checking:\n",
