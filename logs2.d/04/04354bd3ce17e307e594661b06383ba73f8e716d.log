2026-07-29T06:51:11.5686750Z Loading required package: DBI
2026-07-29T06:51:11.5686810Z > 
2026-07-29T06:51:11.5686880Z > # CRAN guard
2026-07-29T06:51:11.5686930Z > #
2026-07-29T06:51:11.5687220Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T06:51:11.5687500Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T06:51:11.5687780Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T06:51:11.5688030Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T06:51:11.5688310Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T06:51:11.5688590Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T06:51:11.5688740Z > # so the guard is obvious and self-contained.
2026-07-29T06:51:11.5688970Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T06:51:11.5689030Z > 
2026-07-29T06:51:11.5689230Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T06:51:11.5689320Z +   run <- TRUE
2026-07-29T06:51:11.5689550Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T06:51:11.5689630Z +   run <- FALSE
2026-07-29T06:51:11.5689700Z + } else {
2026-07-29T06:51:11.5689930Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T06:51:11.5690220Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T06:51:11.5690260Z + }
2026-07-29T06:51:11.5690310Z > 
2026-07-29T06:51:11.5690390Z > if (run) {
2026-07-29T06:51:11.5690520Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T06:51:11.5690590Z + } else {
2026-07-29T06:51:11.5690670Z +   message(
2026-07-29T06:51:11.5690740Z +     "\n",
2026-07-29T06:51:11.5690830Z +     strrep("=", 78),
2026-07-29T06:51:11.5690900Z +     "\n",
2026-07-29T06:51:11.5691040Z +     "Skipping the duckdb test suite.\n",
2026-07-29T06:51:11.5691110Z +     "\n",
2026-07-29T06:51:11.5691410Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T06:51:11.5691690Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T06:51:11.5691990Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T06:51:11.5692310Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T06:51:11.5692420Z +     "manner.\n",
2026-07-29T06:51:11.5692500Z +     "\n",
2026-07-29T06:51:11.5692790Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T06:51:11.5693110Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T06:51:11.5693180Z +     "\n",
2026-07-29T06:51:11.5693480Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-29T06:51:11.5693740Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-29T06:51:11.5694160Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-29T06:51:11.5694270Z +     strrep("=", 78),
2026-07-29T06:51:11.5694350Z +     "\n"
2026-07-29T06:51:11.5694580Z +   )
2026-07-29T06:51:11.5694670Z + }
