2026-07-29T06:51:11.4555560Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T06:51:11.4556090Z > # so the guard is obvious and self-contained.
2026-07-29T06:51:11.4556740Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T06:51:11.4557040Z > 
2026-07-29T06:51:11.4557400Z > if (run_tests %in% c("true", "1", "yes", "on")) {
