2026-07-28T07:06:53.9648503Z > 
2026-07-28T07:06:53.9648700Z > # CRAN guard
2026-07-28T07:06:53.9648876Z > #
2026-07-28T07:06:53.9649268Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:06:53.9650440Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:06:53.9651295Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:06:53.9651873Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:06:53.9652456Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:06:53.9653050Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:06:53.9653514Z > # so the guard is obvious and self-contained.
2026-07-28T07:06:53.9653958Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:06:53.9654298Z > 
2026-07-28T07:06:53.9654570Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:06:53.9654876Z +   run <- TRUE
2026-07-28T07:06:53.9655177Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:06:53.9655492Z +   run <- FALSE
2026-07-28T07:06:53.9655687Z + } else {
2026-07-28T07:06:53.9656033Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:06:53.9656473Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:06:53.9656746Z + }
2026-07-28T07:06:53.9656905Z > 
2026-07-28T07:06:53.9657087Z > if (run) {
2026-07-28T07:06:53.9657330Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:06:53.9657606Z + } else {
2026-07-28T07:06:53.9657791Z +   message(
2026-07-28T07:06:53.9657976Z +     "\n",
2026-07-28T07:06:53.9658176Z +     strrep("=", 78),
2026-07-28T07:06:53.9658384Z +     "\n",
2026-07-28T07:06:53.9658624Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:06:53.9658892Z +     "\n",
2026-07-28T07:06:53.9659292Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:06:53.9660316Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:06:53.9660888Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:06:53.9661476Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:06:53.9661888Z +     "manner.\n",
2026-07-28T07:06:53.9662090Z +     "\n",
2026-07-28T07:06:53.9662482Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:06:53.9663109Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:06:53.9663534Z +     "\n",
2026-07-28T07:06:53.9663936Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:06:53.9664741Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:06:53.9665281Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:06:53.9666000Z +     strrep("=", 78),
2026-07-28T07:06:53.9666225Z +     "\n"
2026-07-28T07:06:53.9666395Z +   )
2026-07-28T07:06:53.9666557Z + }
