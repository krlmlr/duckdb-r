2026-07-28T07:08:45.5581190Z > library(testthat)
2026-07-28T07:08:45.5581426Z > library(duckdb.dev)
2026-07-28T07:08:45.5581688Z Loading required package: DBI
2026-07-28T07:08:45.5581916Z > 
2026-07-28T07:08:45.5582104Z > # CRAN guard
2026-07-28T07:08:45.5582292Z > #
2026-07-28T07:08:45.5582691Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:45.5583297Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:45.5583889Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:45.5584460Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:45.5585035Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:45.5585712Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:45.5586186Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:45.5586631Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:45.5586983Z > 
2026-07-28T07:08:45.5587242Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:45.5587539Z +   run <- TRUE
2026-07-28T07:08:45.5587853Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:45.5588177Z +   run <- FALSE
2026-07-28T07:08:45.5588387Z + } else {
2026-07-28T07:08:45.5588754Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:45.5589203Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:45.5589690Z + }
2026-07-28T07:08:45.5589870Z > 
2026-07-28T07:08:45.5590062Z > if (run) {
2026-07-28T07:08:45.5590323Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:45.5590606Z + } else {
2026-07-28T07:08:45.5590954Z +   message(
2026-07-28T07:08:45.5591160Z +     "\n",
2026-07-28T07:08:45.5591373Z +     strrep("=", 78),
2026-07-28T07:08:45.5591594Z +     "\n",
2026-07-28T07:08:45.5591845Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:45.5592125Z +     "\n",
2026-07-28T07:08:45.5592540Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:45.5593144Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:45.5593711Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:45.5594306Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:45.5594726Z +     "manner.\n",
2026-07-28T07:08:45.5594932Z +     "\n",
2026-07-28T07:08:45.5595326Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:45.5595993Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:45.5596439Z +     "\n",
2026-07-28T07:08:45.5596852Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:45.5597433Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:45.5598092Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:45.5598468Z +     strrep("=", 78),
2026-07-28T07:08:45.5598698Z +     "\n"
2026-07-28T07:08:45.5598869Z +   )
2026-07-28T07:08:45.5599036Z + }
