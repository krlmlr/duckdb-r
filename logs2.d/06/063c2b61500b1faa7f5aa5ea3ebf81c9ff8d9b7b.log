2026-08-08T14:40:01.5308685Z > # CRAN guard
2026-08-08T14:40:01.5308879Z > #
2026-08-08T14:40:01.5309288Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-08T14:40:01.5309896Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-08T14:40:01.5310492Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-08T14:40:01.5311089Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-08T14:40:01.5311688Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-08T14:40:01.5312762Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-08T14:40:01.5313289Z > # so the guard is obvious and self-contained.
2026-08-08T14:40:01.5313755Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-08T14:40:01.5314101Z > 
2026-08-08T14:40:01.5314384Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-08T14:40:01.5314692Z +   run <- TRUE
2026-08-08T14:40:01.5315029Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-08T14:40:01.5315465Z +   run <- FALSE
2026-08-08T14:40:01.5315682Z + } else {
2026-08-08T14:40:01.5316041Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-08T14:40:01.5316618Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-08T14:40:01.5316907Z + }
2026-08-08T14:40:01.5317075Z > 
2026-08-08T14:40:01.5317261Z > if (run) {
2026-08-08T14:40:01.5317513Z +   test_check(simulate_duckdb()$pkg)
2026-08-08T14:40:01.5317779Z + } else {
2026-08-08T14:40:01.5317970Z +   message(
