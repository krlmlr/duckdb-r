2026-08-08T14:40:01.4580314Z > # CRAN guard
2026-08-08T14:40:01.4580497Z > #
2026-08-08T14:40:01.4580908Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-08T14:40:01.4581536Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-08T14:40:01.4582466Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-08T14:40:01.4583798Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-08T14:40:01.4584884Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-08T14:40:01.4586019Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-08T14:40:01.4587148Z > # so the guard is obvious and self-contained.
2026-08-08T14:40:01.4588062Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-08T14:40:01.4588552Z > 
2026-08-08T14:40:01.4588828Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-08T14:40:01.4589248Z +   run <- TRUE
2026-08-08T14:40:01.4589815Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
