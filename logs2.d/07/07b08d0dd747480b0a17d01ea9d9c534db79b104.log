2026-07-28T08:21:06.6765975Z > # This file is part of the standard setup for testthat.
2026-07-28T08:21:06.6766619Z > # It is recommended that you do not modify it.
2026-07-28T08:21:06.6766914Z > #
2026-07-28T08:21:06.6767218Z > # Where should you do additional test configuration?
2026-07-28T08:21:06.6767634Z > # Learn more about the roles of various files in:
2026-07-28T08:21:06.6768147Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T08:21:06.6769021Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T08:21:06.6769360Z > 
2026-07-28T08:21:06.6769594Z > library(testthat)
2026-07-28T08:21:06.6769835Z > library(duckdb)
2026-07-28T08:21:06.6770101Z Loading required package: DBI
2026-07-28T08:21:06.6770356Z > 
2026-07-28T08:21:06.6770571Z > # CRAN guard
2026-07-28T08:21:06.6770777Z > #
2026-07-28T08:21:06.6771195Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T08:21:06.6771854Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T08:21:06.6772453Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T08:21:06.6773116Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T08:21:06.6773694Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T08:21:06.6774284Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T08:21:06.6774756Z > # so the guard is obvious and self-contained.
2026-07-28T08:21:06.6775229Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T08:21:06.6775591Z > 
2026-07-28T08:21:06.6775875Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T08:21:06.6776192Z +   run <- TRUE
2026-07-28T08:21:06.6776518Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T08:21:06.6776851Z +   run <- FALSE
2026-07-28T08:21:06.6777075Z + } else {
2026-07-28T08:21:06.6777451Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T08:21:06.6777905Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T08:21:06.6778416Z + }
2026-07-28T08:21:06.6778607Z > 
2026-07-28T08:21:06.6778815Z > if (run) {
2026-07-28T08:21:06.6779093Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T08:21:06.6779386Z + } else {
2026-07-28T08:21:06.6779603Z +   message(
2026-07-28T08:21:06.6779928Z +     "\n",
2026-07-28T08:21:06.6780153Z +     strrep("=", 78),
2026-07-28T08:21:06.6780398Z +     "\n",
2026-07-28T08:21:06.6780661Z +     "Skipping the duckdb test suite.\n",
2026-07-28T08:21:06.6780963Z +     "\n",
2026-07-28T08:21:06.6781385Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T08:21:06.6781995Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T08:21:06.6782572Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T08:21:06.6783243Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T08:21:06.6783683Z +     "manner.\n",
2026-07-28T08:21:06.6783908Z +     "\n",
2026-07-28T08:21:06.6784317Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T08:21:06.6784952Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T08:21:06.6785382Z +     "\n",
2026-07-28T08:21:06.6785795Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T08:21:06.6786376Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T08:21:06.6786905Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T08:21:06.6787281Z +     strrep("=", 78),
2026-07-28T08:21:06.6787522Z +     "\n"
2026-07-28T08:21:06.6787713Z +   )
2026-07-28T08:21:06.6787904Z + }
