2026-07-29T14:01:05.1279106Z > # It is recommended that you do not modify it.
2026-07-29T14:01:05.1279556Z > #
2026-07-29T14:01:05.1280037Z > # Where should you do additional test configuration?
2026-07-29T14:01:05.1280678Z > # Learn more about the roles of various files in:
2026-07-29T14:01:05.1281458Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-29T14:01:05.1282418Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-29T14:01:05.1282936Z > 
2026-07-29T14:01:05.1283319Z > library(testthat)
2026-07-29T14:01:05.1283677Z > library(duckdb)
2026-07-29T14:01:05.1284100Z Loading required package: DBI
2026-07-29T14:01:05.1284473Z > 
2026-07-29T14:01:05.1284778Z > # CRAN guard
2026-07-29T14:01:05.1285078Z > #
2026-07-29T14:01:05.1285719Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T14:01:05.1286681Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T14:01:05.1287634Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T14:01:05.1288558Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T14:01:05.1289483Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T14:01:05.1290440Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T14:01:05.1291215Z > # so the guard is obvious and self-contained.
2026-07-29T14:01:05.1291930Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T14:01:05.1292769Z > 
2026-07-29T14:01:05.1293208Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T14:01:05.1293690Z +   run <- TRUE
2026-07-29T14:01:05.1294195Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T14:01:05.1294710Z +   run <- FALSE
2026-07-29T14:01:05.1295031Z + } else {
2026-07-29T14:01:05.1295634Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T14:01:05.1296357Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T14:01:05.1296809Z + }
2026-07-29T14:01:05.1297276Z > 
2026-07-29T14:01:05.1297568Z > if (run) {
2026-07-29T14:01:05.1297969Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T14:01:05.1298390Z + } else {
2026-07-29T14:01:05.1298692Z +   message(
2026-07-29T14:01:05.1299015Z +     "\n",
2026-07-29T14:01:05.1299355Z +     strrep("=", 78),
2026-07-29T14:01:05.1299703Z +     "\n",
2026-07-29T14:01:05.1300098Z +     "Skipping the duckdb test suite.\n",
﻿2026-07-29T14:01:05.1303119Z +     "\n",
2026-07-29T14:01:05.1303793Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T14:01:05.1304795Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T14:01:05.1305725Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T14:01:05.1306694Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T14:01:05.1307377Z +     "manner.\n",
2026-07-29T14:01:05.1307723Z +     "\n",
2026-07-29T14:01:05.1308379Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T14:01:05.1309416Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T14:01:05.1310087Z +     "\n",
2026-07-29T14:01:05.1310746Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-29T14:01:05.1311684Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-29T14:01:05.1312898Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-29T14:01:05.1313503Z +     strrep("=", 78),
2026-07-29T14:01:05.1313860Z +     "\n"
2026-07-29T14:01:05.1314139Z +   )
2026-07-29T14:01:05.1314410Z + }
