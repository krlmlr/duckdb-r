2026-07-27T14:57:52.9985375Z +           function renderTNode(node, depth) {
2026-07-27T14:57:52.9985503Z +               var wrap = document.createElement("div");
2026-07-27T14:57:52.9985832Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:57:52.9985987Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:57:52.9986422Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:57:52.9986683Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:57:52.9986967Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:57:52.9987163Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:57:52.9987274Z +               wrap.appendChild(row);
2026-07-27T14:57:52.9987361Z +               if (hasKids) {
