2026-07-27T14:57:52.9989049Z +                   });
2026-07-27T14:57:52.9989119Z +               }
2026-07-27T14:57:52.9989211Z +               return wrap;
2026-07-27T14:57:52.9989277Z +           }
2026-07-27T14:57:52.9989379Z +           panel.innerHTML = "";
2026-07-27T14:57:52.9989568Z +           var head = document.createElement("div"); head.className = "tm-head";
