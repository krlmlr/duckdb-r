2026-07-27T14:57:52.9987805Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T14:57:52.9987919Z +                   wrap.appendChild(kids);
2026-07-27T14:57:52.9988027Z +                   var open = depth === 0;
2026-07-27T14:57:52.9988304Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:57:52.9988444Z +                   row.classList.add("clickable");
2026-07-27T14:57:52.9988580Z +                   row.addEventListener("click", function () {
