2026-07-27T14:57:52.9982516Z +           var map = {};
2026-07-27T14:57:52.9982680Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:57:52.9982903Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:57:52.9983183Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:57:52.9983325Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:57:52.9983572Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:57:52.9983740Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:57:52.9983804Z +   
2026-07-27T14:57:52.9984035Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:57:52.9984382Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:57:52.9984560Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:57:52.9984904Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:57:52.9985117Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T14:57:52.9985190Z +           }) };
