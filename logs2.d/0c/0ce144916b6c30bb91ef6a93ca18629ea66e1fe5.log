2026-07-27T07:10:29.7903859Z > library(testthat)
2026-07-27T07:10:29.7904268Z > library(duckdb.dev)
2026-07-27T07:10:29.7904725Z Loading required package: DBI
2026-07-27T07:10:29.7905125Z > 
2026-07-27T07:10:29.7905462Z > # CRAN guard
2026-07-27T07:10:29.7905792Z > #
2026-07-27T07:10:29.7906809Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T07:10:29.7907901Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T07:10:29.7908962Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T07:10:29.7909992Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T07:10:29.7911037Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T07:10:29.7912126Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T07:10:29.7912985Z > # so the guard is obvious and self-contained.
2026-07-27T07:10:29.7913795Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T07:10:29.7914383Z > 
2026-07-27T07:10:29.7914847Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T07:10:29.7915388Z +   run <- TRUE
2026-07-27T07:10:29.7916558Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T07:10:29.7917174Z +   run <- FALSE
2026-07-27T07:10:29.7917542Z + } else {
2026-07-27T07:10:29.7918183Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T07:10:29.7918988Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T07:10:29.7919485Z + }
2026-07-27T07:10:29.7919781Z > 
2026-07-27T07:10:29.7920106Z > if (run) {
2026-07-27T07:10:29.7920536Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T07:10:29.7921005Z + } else {
2026-07-27T07:10:29.7921335Z +   message(
2026-07-27T07:10:29.7921675Z +     "\n",
2026-07-27T07:10:29.7922040Z +     strrep("=", 78),
2026-07-27T07:10:29.7922433Z +     "\n",
2026-07-27T07:10:29.7922873Z +     "Skipping the duckdb test suite.\n",
2026-07-27T07:10:29.7923360Z +     "\n",
2026-07-27T07:10:29.7924088Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T07:10:29.7925170Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T07:10:29.7926411Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T07:10:29.7927525Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T07:10:29.7928284Z +     "manner.\n",
2026-07-27T07:10:29.7928654Z +     "\n",
2026-07-27T07:10:29.7929370Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T07:10:29.7930529Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T07:10:29.7931286Z +     "\n",
2026-07-27T07:10:29.7932024Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T07:10:29.7933188Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T07:10:29.7934145Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T07:10:29.7934926Z +     strrep("=", 78),
2026-07-27T07:10:29.7935311Z +     "\n"
2026-07-27T07:10:29.7935611Z +   )
2026-07-27T07:10:29.7935906Z + }
