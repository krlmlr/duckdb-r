2026-07-27T07:12:19.8944808Z > # This file is part of the standard setup for testthat.
2026-07-27T07:12:19.8945208Z > # It is recommended that you do not modify it.
2026-07-27T07:12:19.8945489Z > #
2026-07-27T07:12:19.8945781Z > # Where should you do additional test configuration?
2026-07-27T07:12:19.8946533Z > # Learn more about the roles of various files in:
2026-07-27T07:12:19.8947146Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T07:12:19.8947666Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T07:12:19.8948000Z > 
2026-07-27T07:12:19.8948222Z > library(testthat)
2026-07-27T07:12:19.8948461Z > library(duckdb.dev)
2026-07-27T07:12:19.8948732Z Loading required package: DBI
2026-07-27T07:12:19.8948967Z > 
2026-07-27T07:12:19.8949166Z > # CRAN guard
2026-07-27T07:12:19.8949355Z > #
2026-07-27T07:12:19.8949775Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T07:12:19.8950394Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T07:12:19.8950997Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T07:12:19.8951570Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T07:12:19.8952155Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T07:12:19.8952765Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T07:12:19.8953249Z > # so the guard is obvious and self-contained.
2026-07-27T07:12:19.8953711Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T07:12:19.8954055Z > 
2026-07-27T07:12:19.8954330Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T07:12:19.8954633Z +   run <- TRUE
2026-07-27T07:12:19.8954956Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T07:12:19.8955287Z +   run <- FALSE
2026-07-27T07:12:19.8955496Z + } else {
2026-07-27T07:12:19.8955865Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T07:12:19.8956655Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T07:12:19.8956948Z + }
2026-07-27T07:12:19.8957120Z > 
2026-07-27T07:12:19.8957318Z > if (run) {
2026-07-27T07:12:19.8957572Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T07:12:19.8957853Z + } else {
2026-07-27T07:12:19.8958070Z +   message(
2026-07-27T07:12:19.8958273Z +     "\n",
2026-07-27T07:12:19.8958491Z +     strrep("=", 78),
2026-07-27T07:12:19.8958721Z +     "\n",
2026-07-27T07:12:19.8958979Z +     "Skipping the duckdb test suite.\n",
2026-07-27T07:12:19.8959292Z +     "\n",
2026-07-27T07:12:19.8959858Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T07:12:19.8960479Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T07:12:19.8961053Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T07:12:19.8961658Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T07:12:19.8962086Z +     "manner.\n",
2026-07-27T07:12:19.8962298Z +     "\n",
2026-07-27T07:12:19.8962699Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T07:12:19.8963355Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T07:12:19.8963789Z +     "\n",
2026-07-27T07:12:19.8964197Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T07:12:19.8964856Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T07:12:19.8965404Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T07:12:19.8965783Z +     strrep("=", 78),
2026-07-27T07:12:19.8966267Z +     "\n"
2026-07-27T07:12:19.8966474Z +   )
2026-07-27T07:12:19.8966648Z + }
