2026-07-27T14:07:56.8451843Z +           function renderTNode(node, depth) {
2026-07-27T14:07:56.8451968Z +               var wrap = document.createElement("div");
2026-07-27T14:07:56.8452288Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:07:56.8452439Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:07:56.8452849Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:07:56.8453109Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:07:56.8453377Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:07:56.8453569Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:07:56.8453670Z +               wrap.appendChild(row);
2026-07-27T14:07:56.8453751Z +               if (hasKids) {
2026-07-27T14:07:56.8453955Z +                   var kids = document.createElement("div"); kids.className = "tm-kids";
2026-07-27T14:07:56.8454192Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T14:07:56.8454298Z +                   wrap.appendChild(kids);
2026-07-27T14:07:56.8454401Z +                   var open = depth === 0;
2026-07-27T14:07:56.8454677Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:07:56.8454798Z +                   row.classList.add("clickable");
2026-07-27T14:07:56.8454938Z +                   row.addEventListener("click", function () {
2026-07-27T14:07:56.8455387Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:07:56.8455469Z +                   });
2026-07-27T14:07:56.8455535Z +               }
2026-07-27T14:07:56.8455627Z +               return wrap;
2026-07-27T14:07:56.8455700Z +           }
2026-07-27T14:07:56.8455790Z +           panel.innerHTML = "";
2026-07-27T14:07:56.8456019Z +           var head = document.createElement("div"); head.className = "tm-head";
