2026-07-27T14:07:56.8448977Z +           var timings = (PLAN.query && PLAN.query.timings) ? PLAN.query.timings : [];
2026-07-27T14:07:56.8449059Z +           var map = {};
2026-07-27T14:07:56.8449218Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:07:56.8449440Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:07:56.8449702Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:07:56.8449821Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:07:56.8450061Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:07:56.8450221Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:07:56.8450283Z +   
2026-07-27T14:07:56.8450508Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:07:56.8450859Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:07:56.8451063Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:07:56.8451392Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:07:56.8451600Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T14:07:56.8451669Z +           }) };
