2026-06-25T02:34:59.9827924Z > #
2026-06-25T02:34:59.9828317Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-06-25T02:34:59.9828946Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-06-25T02:34:59.9829555Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-06-25T02:34:59.9830127Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-06-25T02:34:59.9830705Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-06-25T02:34:59.9831324Z > # This check is intentionally inlined here (rather than calling into the package)
2026-06-25T02:34:59.9831813Z > # so the guard is obvious and self-contained.
2026-06-25T02:34:59.9832266Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-06-25T02:34:59.9832947Z > 
2026-06-25T02:34:59.9833229Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-06-25T02:34:59.9833546Z +   run <- TRUE
2026-06-25T02:34:59.9833864Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-06-25T02:34:59.9834191Z +   run <- FALSE
2026-06-25T02:34:59.9834396Z + } else {
2026-06-25T02:34:59.9834751Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-06-25T02:34:59.9835202Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-06-25T02:34:59.9837990Z + }
2026-06-25T02:34:59.9838326Z > 
2026-06-25T02:34:59.9838701Z > if (run) {
2026-06-25T02:34:59.9839030Z +   test_check(simulate_duckdb()$pkg)
2026-06-25T02:34:59.9839508Z + } else {
2026-06-25T02:34:59.9839710Z +   message(
2026-06-25T02:34:59.9839905Z +     "\n",
2026-06-25T02:34:59.9840328Z +     strrep("=", 78),
2026-06-25T02:34:59.9841196Z +     "\n",
2026-06-25T02:34:59.9841549Z +     "Skipping the duckdb test suite.\n",
2026-06-25T02:34:59.9841842Z +     "\n",
2026-06-25T02:34:59.9842260Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-06-25T02:34:59.9843557Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-06-25T02:34:59.9844356Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-06-25T02:34:59.9844985Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-06-25T02:34:59.9845410Z +     "manner.\n",
2026-06-25T02:34:59.9845621Z +     "\n",
2026-06-25T02:34:59.9846026Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-06-25T02:34:59.9846675Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-06-25T02:34:59.9847121Z +     "\n",
2026-06-25T02:34:59.9847548Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-06-25T02:34:59.9848133Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-06-25T02:34:59.9848667Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-06-25T02:34:59.9849046Z +     strrep("=", 78),
2026-06-25T02:34:59.9849265Z +     "\n"
2026-06-25T02:34:59.9849437Z +   )
2026-06-25T02:34:59.9849605Z + }
