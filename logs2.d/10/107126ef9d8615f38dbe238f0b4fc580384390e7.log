2026-06-25T02:35:00.0270384Z > # CRAN guard
2026-06-25T02:35:00.0270562Z > #
2026-06-25T02:35:00.0270955Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-06-25T02:35:00.0271566Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-06-25T02:35:00.0272152Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-06-25T02:35:00.0272834Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-06-25T02:35:00.0273534Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-06-25T02:35:00.0274235Z > # This check is intentionally inlined here (rather than calling into the package)
2026-06-25T02:35:00.0274717Z > # so the guard is obvious and self-contained.
2026-06-25T02:35:00.0275165Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-06-25T02:35:00.0275495Z > 
2026-06-25T02:35:00.0275758Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-06-25T02:35:00.0276052Z +   run <- TRUE
2026-06-25T02:35:00.0276360Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-06-25T02:35:00.0276684Z +   run <- FALSE
2026-06-25T02:35:00.0276885Z + } else {
2026-06-25T02:35:00.0277248Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-06-25T02:35:00.0277694Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-06-25T02:35:00.0277966Z + }
2026-06-25T02:35:00.0278128Z > 
2026-06-25T02:35:00.0278311Z > if (run) {
2026-06-25T02:35:00.0278571Z +   test_check(simulate_duckdb()$pkg)
2026-06-25T02:35:00.0278831Z + } else {
2026-06-25T02:35:00.0279026Z +   message(
2026-06-25T02:35:00.0279218Z +     "\n",
2026-06-25T02:35:00.0279429Z +     strrep("=", 78),
2026-06-25T02:35:00.0279645Z +     "\n",
2026-06-25T02:35:00.0279887Z +     "Skipping the duckdb test suite.\n",
2026-06-25T02:35:00.0280158Z +     "\n",
2026-06-25T02:35:00.0280564Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-06-25T02:35:00.0281166Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-06-25T02:35:00.0281724Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-06-25T02:35:00.0282318Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-06-25T02:35:00.0283026Z +     "manner.\n",
2026-06-25T02:35:00.0283247Z +     "\n",
2026-06-25T02:35:00.0283650Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-06-25T02:35:00.0284295Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-06-25T02:35:00.0284727Z +     "\n",
2026-06-25T02:35:00.0285146Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-06-25T02:35:00.0285733Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-06-25T02:35:00.0286260Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
