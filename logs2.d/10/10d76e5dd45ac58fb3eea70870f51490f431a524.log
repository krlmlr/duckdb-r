2026-07-28T21:40:01.6759019Z > 
2026-07-28T21:40:01.6759219Z > # CRAN guard
2026-07-28T21:40:01.6759342Z > #
2026-07-28T21:40:01.6760042Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T21:40:01.6760431Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T21:40:01.6760817Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T21:40:01.6761395Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T21:40:01.6761861Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T21:40:01.6762308Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T21:40:01.6762526Z > # so the guard is obvious and self-contained.
2026-07-28T21:40:01.6762805Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T21:40:01.6762931Z > 
2026-07-28T21:40:01.6763108Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T21:40:01.6763257Z +   run <- TRUE
2026-07-28T21:40:01.6763486Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T21:40:01.6763606Z +   run <- FALSE
2026-07-28T21:40:01.6763744Z + } else {
2026-07-28T21:40:01.6764032Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T21:40:01.6764214Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T21:40:01.6764344Z + }
2026-07-28T21:40:01.6764476Z > 
2026-07-28T21:40:01.6764977Z > if (run) {
2026-07-28T21:40:01.6766078Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T21:40:01.6766282Z + } else {
2026-07-28T21:40:01.6766493Z +   message(
2026-07-28T21:40:01.6766686Z +     "\n",
2026-07-28T21:40:01.6766874Z +     strrep("=", 78),
2026-07-28T21:40:01.6767092Z +     "\n",
2026-07-28T21:40:01.6767349Z +     "Skipping the duckdb test suite.\n",
2026-07-28T21:40:01.6767500Z +     "\n",
2026-07-28T21:40:01.6768252Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T21:40:01.6768692Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T21:40:01.6769139Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T21:40:01.6769579Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T21:40:01.6769813Z +     "manner.\n",
2026-07-28T21:40:01.6769998Z +     "\n",
2026-07-28T21:40:01.6770416Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T21:40:01.6770892Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T21:40:01.6771054Z +     "\n",
2026-07-28T21:40:01.6771498Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T21:40:01.6772687Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T21:40:01.6773003Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T21:40:01.6773136Z +     strrep("=", 78),
2026-07-28T21:40:01.6773294Z +     "\n"
2026-07-28T21:40:01.6773434Z +   )
2026-07-28T21:40:01.6773581Z + }
