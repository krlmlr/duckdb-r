2026-07-28T07:04:20.1844390Z Loading required package: DBI
2026-07-28T07:04:20.1844579Z > 
2026-07-28T07:04:20.1844746Z > # CRAN guard
2026-07-28T07:04:20.1844901Z > #
2026-07-28T07:04:20.1845392Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:04:20.1845862Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:04:20.1846311Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:04:20.1846744Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:04:20.1847191Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:04:20.1847732Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:04:20.1848104Z > # so the guard is obvious and self-contained.
2026-07-28T07:04:20.1848456Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:04:20.1848723Z > 
2026-07-28T07:04:20.1848938Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:04:20.1849192Z +   run <- TRUE
2026-07-28T07:04:20.1849447Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:04:20.1849700Z +   run <- FALSE
2026-07-28T07:04:20.1849871Z + } else {
2026-07-28T07:04:20.1850153Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:04:20.1850504Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:04:20.1850727Z + }
2026-07-28T07:04:20.1850872Z > 
2026-07-28T07:04:20.1851028Z > if (run) {
2026-07-28T07:04:20.1851232Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:04:20.1851451Z + } else {
2026-07-28T07:04:20.1851716Z +   message(
2026-07-28T07:04:20.1851887Z +     "\n",
2026-07-28T07:04:20.1852063Z +     strrep("=", 78),
2026-07-28T07:04:20.1852254Z +     "\n",
2026-07-28T07:04:20.1852456Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:04:20.1852676Z +     "\n",
2026-07-28T07:04:20.1852997Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:04:20.1853457Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:04:20.1853886Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:04:20.1854343Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:04:20.1854674Z +     "manner.\n",
2026-07-28T07:04:20.1854847Z +     "\n",
2026-07-28T07:04:20.1855348Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:04:20.1855852Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:04:20.1856182Z +     "\n",
2026-07-28T07:04:20.1856503Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:04:20.1857031Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:04:20.1857441Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:04:20.1857735Z +     strrep("=", 78),
2026-07-28T07:04:20.1857920Z +     "\n"
2026-07-28T07:04:20.1858072Z +   )
2026-07-28T07:04:20.1858224Z + }
