2026-07-28T07:02:45.9061907Z > # This file is part of the standard setup for testthat.
2026-07-28T07:02:45.9062300Z > # It is recommended that you do not modify it.
2026-07-28T07:02:45.9062520Z > #
2026-07-28T07:02:45.9062748Z > # Where should you do additional test configuration?
2026-07-28T07:02:45.9063051Z > # Learn more about the roles of various files in:
2026-07-28T07:02:45.9063415Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T07:02:45.9063808Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T07:02:45.9064059Z > 
2026-07-28T07:02:45.9064227Z > library(testthat)
2026-07-28T07:02:45.9064411Z > library(duckdb.dev)
2026-07-28T07:02:45.9064623Z Loading required package: DBI
2026-07-28T07:02:45.9064807Z > 
2026-07-28T07:02:45.9064968Z > # CRAN guard
2026-07-28T07:02:45.9065331Z > #
2026-07-28T07:02:45.9065656Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:02:45.9066211Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:02:45.9066652Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:02:45.9067077Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:02:45.9067501Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:02:45.9067938Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:02:45.9068294Z > # so the guard is obvious and self-contained.
2026-07-28T07:02:45.9068634Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:02:45.9068905Z > 
2026-07-28T07:02:45.9069112Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:02:45.9069357Z +   run <- TRUE
2026-07-28T07:02:45.9069603Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:02:45.9069852Z +   run <- FALSE
2026-07-28T07:02:45.9070025Z + } else {
2026-07-28T07:02:45.9070307Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:02:45.9070646Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:02:45.9070863Z + }
2026-07-28T07:02:45.9071000Z > 
2026-07-28T07:02:45.9071148Z > if (run) {
2026-07-28T07:02:45.9071349Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:02:45.9071561Z + } else {
2026-07-28T07:02:45.9071720Z +   message(
2026-07-28T07:02:45.9071881Z +     "\n",
2026-07-28T07:02:45.9072048Z +     strrep("=", 78),
2026-07-28T07:02:45.9072224Z +     "\n",
2026-07-28T07:02:45.9072419Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:02:45.9072627Z +     "\n",
2026-07-28T07:02:45.9072937Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:02:45.9073494Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:02:45.9073928Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:02:45.9074381Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:02:45.9074694Z +     "manner.\n",
2026-07-28T07:02:45.9074856Z +     "\n",
2026-07-28T07:02:45.9075266Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:02:45.9075753Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:02:45.9076066Z +     "\n",
2026-07-28T07:02:45.9076379Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:02:45.9076806Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:02:45.9077197Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:02:45.9077591Z +     strrep("=", 78),
2026-07-28T07:02:45.9077763Z +     "\n"
2026-07-28T07:02:45.9077904Z +   )
2026-07-28T07:02:45.9078045Z + }
