2026-09-04T02:09:41.1570972Z > # CRAN guard
2026-09-04T02:09:41.1571052Z > #
2026-09-04T02:09:41.1571368Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-04T02:09:41.1571668Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-04T02:09:41.1571960Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-04T02:09:41.1572243Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-04T02:09:41.1572537Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-04T02:09:41.1572841Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-04T02:09:41.1573023Z > # so the guard is obvious and self-contained.
2026-09-04T02:09:41.1573269Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-04T02:09:41.1573347Z > 
2026-09-04T02:09:41.1573531Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-04T02:09:41.1573632Z +   run <- TRUE
2026-09-04T02:09:41.1573836Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-04T02:09:41.1573935Z +   run <- FALSE
2026-09-04T02:09:41.1574030Z + } else {
2026-09-04T02:09:41.1574299Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-04T02:09:41.1574820Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-04T02:09:41.1574968Z + }
2026-09-04T02:09:41.1575092Z > 
2026-09-04T02:09:41.1575266Z > if (run) {
2026-09-04T02:09:41.1575509Z +   test_check(simulate_duckdb()$pkg)
2026-09-04T02:09:41.1575863Z + } else {
2026-09-04T02:09:41.1576036Z +   message(
2026-09-04T02:09:41.1576193Z +     "\n",
2026-09-04T02:09:41.1576402Z +     strrep("=", 78),
2026-09-04T02:09:41.1576565Z +     "\n",
2026-09-04T02:09:41.1576841Z +     "Skipping the duckdb test suite.\n",
2026-09-04T02:09:41.1576996Z +     "\n",
2026-09-04T02:09:41.1577676Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-04T02:09:41.1578081Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-04T02:09:41.1578369Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-04T02:09:41.1578681Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-04T02:09:41.1578786Z +     "manner.\n",
2026-09-04T02:09:41.1578881Z +     "\n",
2026-09-04T02:09:41.1579190Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-04T02:09:41.1579524Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-04T02:09:41.1579625Z +     "\n",
2026-09-04T02:09:41.1579936Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-04T02:09:41.1580211Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-04T02:09:41.1580472Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-04T02:09:41.1580648Z +     strrep("=", 78),
2026-09-04T02:09:41.1580745Z +     "\n"
2026-09-04T02:09:41.1580821Z +   )
2026-09-04T02:09:41.1580899Z + }
