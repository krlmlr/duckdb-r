2026-09-04T02:09:41.0874820Z > # CRAN guard
2026-09-04T02:09:41.0875002Z > #
2026-09-04T02:09:41.0875415Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-04T02:09:41.0876382Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-04T02:09:41.0876985Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-04T02:09:41.0877714Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-04T02:09:41.0878307Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-04T02:09:41.0878907Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-04T02:09:41.0907984Z > # so the guard is obvious and self-contained.
2026-09-04T02:09:41.0908747Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-04T02:09:41.0909101Z > 
2026-09-04T02:09:41.0909383Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-04T02:09:41.0909701Z +   run <- TRUE
2026-09-04T02:09:41.0910028Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-04T02:09:41.0910863Z +   run <- FALSE
2026-09-04T02:09:41.0911176Z + } else {
2026-09-04T02:09:41.0911566Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-04T02:09:41.0912039Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-04T02:09:41.0912695Z + }
2026-09-04T02:09:41.0913004Z > 
2026-09-04T02:09:41.0913326Z > if (run) {
2026-09-04T02:09:41.0913735Z +   test_check(simulate_duckdb()$pkg)
2026-09-04T02:09:41.0914017Z + } else {
2026-09-04T02:09:41.0914214Z +   message(
2026-09-04T02:09:41.0914419Z +     "\n",
