2026-07-28T06:57:04.0194158Z Loading required package: DBI
2026-07-28T06:57:04.0194292Z > 
2026-07-28T06:57:04.0194408Z > # CRAN guard
2026-07-28T06:57:04.0194515Z > #
2026-07-28T06:57:04.0194739Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T06:57:04.0195068Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T06:57:04.0195390Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T06:57:04.0195700Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T06:57:04.0196024Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T06:57:04.0196391Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T06:57:04.0196653Z > # so the guard is obvious and self-contained.
2026-07-28T06:57:04.0196902Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T06:57:04.0197091Z > 
2026-07-28T06:57:04.0197242Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T06:57:04.0197415Z +   run <- TRUE
2026-07-28T06:57:04.0197591Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T06:57:04.0197772Z +   run <- FALSE
2026-07-28T06:57:04.0197893Z + } else {
2026-07-28T06:57:04.0198096Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T06:57:04.0198339Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T06:57:04.0198645Z + }
2026-07-28T06:57:04.0198750Z > 
2026-07-28T06:57:04.0198858Z > if (run) {
2026-07-28T06:57:04.0199001Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T06:57:04.0199160Z + } else {
2026-07-28T06:57:04.0199361Z +   message(
2026-07-28T06:57:04.0199478Z +     "\n",
2026-07-28T06:57:04.0199605Z +     strrep("=", 78),
2026-07-28T06:57:04.0199736Z +     "\n",
2026-07-28T06:57:04.0199879Z +     "Skipping the duckdb test suite.\n",
2026-07-28T06:57:04.0200033Z +     "\n",
2026-07-28T06:57:04.0200255Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T06:57:04.0200574Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T06:57:04.0200883Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T06:57:04.0201215Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T06:57:04.0201449Z +     "manner.\n",
2026-07-28T06:57:04.0201570Z +     "\n",
2026-07-28T06:57:04.0201784Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T06:57:04.0202131Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T06:57:04.0202367Z +     "\n",
2026-07-28T06:57:04.0202592Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T06:57:04.0202945Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T06:57:04.0203227Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T06:57:04.0203433Z +     strrep("=", 78),
2026-07-28T06:57:04.0203558Z +     "\n"
2026-07-28T06:57:04.0203657Z +   )
2026-07-28T06:57:04.0203758Z + }
