2026-07-28T06:55:52.3949165Z > library(testthat)
2026-07-28T06:55:52.3949290Z > library(duckdb.dev)
2026-07-28T06:55:52.3949432Z Loading required package: DBI
2026-07-28T06:55:52.3949558Z > 
2026-07-28T06:55:52.3949664Z > # CRAN guard
2026-07-28T06:55:52.3949768Z > #
2026-07-28T06:55:52.3949976Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T06:55:52.3950337Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T06:55:52.3950634Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T06:55:52.3950924Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T06:55:52.3951220Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T06:55:52.3951523Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T06:55:52.3951771Z > # so the guard is obvious and self-contained.
2026-07-28T06:55:52.3952004Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T06:55:52.3952183Z > 
2026-07-28T06:55:52.3952325Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T06:55:52.3952488Z +   run <- TRUE
2026-07-28T06:55:52.3952653Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T06:55:52.3952826Z +   run <- FALSE
2026-07-28T06:55:52.3952939Z + } else {
2026-07-28T06:55:52.3953128Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T06:55:52.3953358Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T06:55:52.3953504Z + }
2026-07-28T06:55:52.3953595Z > 
2026-07-28T06:55:52.3953697Z > if (run) {
2026-07-28T06:55:52.3953829Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T06:55:52.3953971Z + } else {
2026-07-28T06:55:52.3954076Z +   message(
2026-07-28T06:55:52.3954185Z +     "\n",
2026-07-28T06:55:52.3954299Z +     strrep("=", 78),
2026-07-28T06:55:52.3954417Z +     "\n",
2026-07-28T06:55:52.3954548Z +     "Skipping the duckdb test suite.\n",
2026-07-28T06:55:52.3954694Z +     "\n",
2026-07-28T06:55:52.3954904Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T06:55:52.3955256Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T06:55:52.3955544Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T06:55:52.3955851Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T06:55:52.3956068Z +     "manner.\n",
2026-07-28T06:55:52.3956180Z +     "\n",
2026-07-28T06:55:52.3956391Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T06:55:52.3956719Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T06:55:52.3956937Z +     "\n",
2026-07-28T06:55:52.3957149Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T06:55:52.3957447Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T06:55:52.3957719Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T06:55:52.3957988Z +     strrep("=", 78),
2026-07-28T06:55:52.3958108Z +     "\n"
2026-07-28T06:55:52.3958205Z +   )
2026-07-28T06:55:52.3958300Z + }
