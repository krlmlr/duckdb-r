2026-07-27T14:22:48.8632155Z +   
2026-07-27T14:22:48.8632508Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:22:48.8633035Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:22:48.8633369Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
