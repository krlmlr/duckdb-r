2026-07-27T14:43:50.9600681Z +                   });
2026-07-27T14:43:50.9600789Z +               }
2026-07-27T14:43:50.9600912Z +               return wrap;
2026-07-27T14:43:50.9601004Z +           }
2026-07-27T14:43:50.9601146Z +           panel.innerHTML = "";
2026-07-27T14:43:50.9601428Z +           var head = document.createElement("div"); head.className = "tm-head";
