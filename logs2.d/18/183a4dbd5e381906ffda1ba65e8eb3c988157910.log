2026-07-27T14:43:50.9598878Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T14:43:50.9599035Z +                   wrap.appendChild(kids);
2026-07-27T14:43:50.9599178Z +                   var open = depth === 0;
2026-07-27T14:43:50.9599607Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:43:50.9599778Z +                   row.classList.add("clickable");
2026-07-27T14:43:50.9599978Z +                   row.addEventListener("click", function () {
