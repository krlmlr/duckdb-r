2026-07-27T14:43:50.9590790Z +           var map = {};
2026-07-27T14:43:50.9591033Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:43:50.9591365Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:43:50.9591803Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:43:50.9592103Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:43:50.9592491Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:43:50.9592730Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:43:50.9592806Z +   
2026-07-27T14:43:50.9593162Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:43:50.9593710Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:43:50.9593977Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:43:50.9594564Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
