2026-07-27T14:43:50.9596741Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:43:50.9597129Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
