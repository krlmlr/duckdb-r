2026-07-27T14:43:50.9597847Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:43:50.9598081Z +               wrap.appendChild(row);
2026-07-27T14:43:50.9598209Z +               if (hasKids) {
