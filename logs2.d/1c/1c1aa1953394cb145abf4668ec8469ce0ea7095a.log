2026-07-28T07:34:20.4787385Z > # CRAN guard
2026-07-28T07:34:20.4787697Z > #
2026-07-28T07:34:20.4788410Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:34:20.4789644Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:34:20.4790710Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:34:20.4791738Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:34:20.4792766Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:34:20.4794183Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:34:20.4795053Z > # so the guard is obvious and self-contained.
2026-07-28T07:34:20.4795844Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:34:20.4796436Z > 
2026-07-28T07:34:20.4796898Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:34:20.4797431Z +   run <- TRUE
2026-07-28T07:34:20.4797970Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:34:20.4798532Z +   run <- FALSE
2026-07-28T07:34:20.4798879Z + } else {
2026-07-28T07:34:20.4799504Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:34:20.4800304Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:34:20.4800793Z + }
2026-07-28T07:34:20.4801071Z > 
2026-07-28T07:34:20.4801384Z > if (run) {
2026-07-28T07:34:20.4801815Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:34:20.4802273Z + } else {
2026-07-28T07:34:20.4802593Z +   message(
2026-07-28T07:34:20.4802982Z +     "\n",
2026-07-28T07:34:20.4803356Z +     strrep("=", 78),
2026-07-28T07:34:20.4803934Z +     "\n",
2026-07-28T07:34:20.4804374Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:34:20.4804920Z +     "\n",
2026-07-28T07:34:20.4805652Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:34:20.4806862Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:34:20.4807887Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:34:20.4808978Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:34:20.4809728Z +     "manner.\n",
2026-07-28T07:34:20.4810074Z +     "\n",
2026-07-28T07:34:20.4810787Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:34:20.4811945Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:34:20.4812700Z +     "\n",
2026-07-28T07:34:20.4813424Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:34:20.4814689Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:34:20.4815638Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:34:20.4816481Z +     strrep("=", 78),
2026-07-28T07:34:20.4816870Z +     "\n"
2026-07-28T07:34:20.4817157Z +   )
2026-07-28T07:34:20.4817432Z + }
