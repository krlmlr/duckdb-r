2026-07-28T07:36:12.3034972Z > library(testthat)
2026-07-28T07:36:12.3035205Z > library(duckdb.dev)
2026-07-28T07:36:12.3035461Z Loading required package: DBI
2026-07-28T07:36:12.3035692Z > 
2026-07-28T07:36:12.3035879Z > # CRAN guard
2026-07-28T07:36:12.3036063Z > #
2026-07-28T07:36:12.3036456Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:36:12.3037065Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:36:12.3037652Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:36:12.3038222Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:36:12.3038800Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:36:12.3039492Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:36:12.3039972Z > # so the guard is obvious and self-contained.
2026-07-28T07:36:12.3040422Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:36:12.3040762Z > 
2026-07-28T07:36:12.3041028Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:36:12.3041329Z +   run <- TRUE
2026-07-28T07:36:12.3041643Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:36:12.3041971Z +   run <- FALSE
2026-07-28T07:36:12.3042186Z + } else {
2026-07-28T07:36:12.3042544Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:36:12.3042994Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:36:12.3043279Z + }
2026-07-28T07:36:12.3043445Z > 
2026-07-28T07:36:12.3043630Z > if (run) {
2026-07-28T07:36:12.3044161Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:36:12.3044441Z + } else {
2026-07-28T07:36:12.3044759Z +   message(
2026-07-28T07:36:12.3044959Z +     "\n",
2026-07-28T07:36:12.3045168Z +     strrep("=", 78),
2026-07-28T07:36:12.3045382Z +     "\n",
2026-07-28T07:36:12.3045628Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:36:12.3045898Z +     "\n",
2026-07-28T07:36:12.3046308Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:36:12.3046901Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:36:12.3047468Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:36:12.3048069Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:36:12.3048486Z +     "manner.\n",
2026-07-28T07:36:12.3048693Z +     "\n",
2026-07-28T07:36:12.3049098Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:36:12.3049742Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:36:12.3050173Z +     "\n",
2026-07-28T07:36:12.3050577Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:36:12.3051225Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:36:12.3051757Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:36:12.3052133Z +     strrep("=", 78),
2026-07-28T07:36:12.3052350Z +     "\n"
2026-07-28T07:36:12.3052523Z +   )
2026-07-28T07:36:12.3052691Z + }
