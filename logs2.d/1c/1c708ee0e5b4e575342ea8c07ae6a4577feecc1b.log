2026-07-28T21:46:01.8684654Z > 
2026-07-28T21:46:01.8684829Z > # CRAN guard
2026-07-28T21:46:01.8684969Z > #
2026-07-28T21:46:01.8685256Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T21:46:01.8685673Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T21:46:01.8686081Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T21:46:01.8686574Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T21:46:01.8686981Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T21:46:01.8688466Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T21:46:01.8688980Z > # so the guard is obvious and self-contained.
2026-07-28T21:46:01.8689400Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T21:46:01.8689728Z > 
2026-07-28T21:46:01.8689981Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T21:46:01.8690300Z +   run <- TRUE
2026-07-28T21:46:01.8690604Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T21:46:01.8691199Z +   run <- FALSE
2026-07-28T21:46:01.8691408Z + } else {
2026-07-28T21:46:01.8691852Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T21:46:01.8692412Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T21:46:01.8692792Z + }
2026-07-28T21:46:01.8693080Z > 
2026-07-28T21:46:01.8693326Z > if (run) {
2026-07-28T21:46:01.8693668Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T21:46:01.8694040Z + } else {
2026-07-28T21:46:01.8694305Z +   message(
2026-07-28T21:46:01.8695483Z +     "\n",
2026-07-28T21:46:01.8695821Z +     strrep("=", 78),
2026-07-28T21:46:01.8696168Z +     "\n",
2026-07-28T21:46:01.8696501Z +     "Skipping the duckdb test suite.\n",
2026-07-28T21:46:01.8696893Z +     "\n",
2026-07-28T21:46:01.8697453Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T21:46:01.8699598Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T21:46:01.8700431Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T21:46:01.8701164Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T21:46:01.8701689Z +     "manner.\n",
2026-07-28T21:46:01.8701982Z +     "\n",
2026-07-28T21:46:01.8702434Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T21:46:01.8703173Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T21:46:01.8703642Z +     "\n",
2026-07-28T21:46:01.8704050Z +     "To run the test suite locally, set the environment variable before checking:\n",
