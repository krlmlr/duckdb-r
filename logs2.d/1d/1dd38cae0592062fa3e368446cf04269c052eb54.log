2026-07-27T16:19:09.0016467Z +           var map = {};
2026-07-27T16:19:09.0016592Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T16:19:09.0016774Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T16:19:09.0016984Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T16:19:09.0017081Z +           function val(k) { return map[k] || 0; }
2026-07-27T16:19:09.0017278Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
