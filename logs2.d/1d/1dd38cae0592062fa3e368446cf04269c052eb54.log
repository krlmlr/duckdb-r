2026-07-27T16:19:09.0020726Z +                   wrap.appendChild(kids);
2026-07-27T16:19:09.0020807Z +                   var open = depth === 0;
2026-07-27T16:19:09.0021038Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T16:19:09.0021131Z +                   row.classList.add("clickable");
2026-07-27T16:19:09.0021245Z +                   row.addEventListener("click", function () {
2026-07-27T16:19:09.0021540Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T16:19:09.0021604Z +                   });
2026-07-27T16:19:09.0021664Z +               }
2026-07-27T16:19:09.0021732Z +               return wrap;
2026-07-27T16:19:09.0021786Z +           }
2026-07-27T16:19:09.0021858Z +           panel.innerHTML = "";
2026-07-27T16:19:09.0022008Z +           var head = document.createElement("div"); head.className = "tm-head";
