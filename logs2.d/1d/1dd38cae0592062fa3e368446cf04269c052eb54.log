2026-07-27T16:19:09.0019550Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T16:19:09.0019753Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T16:19:09.0020002Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T16:19:09.0020148Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
