2026-07-27T16:19:09.0018763Z +           function renderTNode(node, depth) {
2026-07-27T16:19:09.0018863Z +               var wrap = document.createElement("div");
2026-07-27T16:19:09.0019112Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
