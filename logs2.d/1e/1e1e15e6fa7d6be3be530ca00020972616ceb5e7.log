2026-07-28T17:08:53.9749104Z > 
2026-07-28T17:08:53.9749204Z > library(testthat)
2026-07-28T17:08:53.9749300Z > library(duckdb)
2026-07-28T17:08:53.9749415Z Loading required package: DBI
2026-07-28T17:08:53.9749530Z > 
2026-07-28T17:08:53.9749669Z > # CRAN guard
2026-07-28T17:08:53.9750026Z > #
2026-07-28T17:08:53.9750534Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T17:08:53.9750985Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T17:08:53.9751320Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T17:08:53.9751568Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T17:08:53.9751958Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T17:08:53.9752226Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T17:08:53.9752380Z > # so the guard is obvious and self-contained.
2026-07-28T17:08:53.9752609Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T17:08:53.9752675Z > 
2026-07-28T17:08:53.9752839Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T17:08:53.9752934Z +   run <- TRUE
2026-07-28T17:08:53.9753121Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T17:08:53.9753217Z +   run <- FALSE
2026-07-28T17:08:53.9753301Z + } else {
2026-07-28T17:08:53.9753536Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T17:08:53.9754042Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T17:08:53.9754137Z + }
2026-07-28T17:08:53.9754770Z > 
2026-07-28T17:08:53.9755064Z > if (run) {
2026-07-28T17:08:53.9755292Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T17:08:53.9755422Z + } else {
2026-07-28T17:08:53.9755556Z +   message(
2026-07-28T17:08:53.9755708Z +     "\n",
2026-07-28T17:08:53.9755866Z +     strrep("=", 78),
2026-07-28T17:08:53.9756008Z +     "\n",
2026-07-28T17:08:53.9756226Z +     "Skipping the duckdb test suite.\n",
2026-07-28T17:08:53.9756349Z +     "\n",
2026-07-28T17:08:53.9756842Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T17:08:53.9757282Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T17:08:53.9757724Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T17:08:53.9758213Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T17:08:53.9758370Z +     "manner.\n",
2026-07-28T17:08:53.9758453Z +     "\n",
2026-07-28T17:08:53.9758830Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T17:08:53.9759311Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T17:08:53.9759471Z +     "\n",
2026-07-28T17:08:53.9759827Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T17:08:53.9760190Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T17:08:53.9760568Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T17:08:53.9761274Z +     strrep("=", 78),
2026-07-28T17:08:53.9761417Z +     "\n"
2026-07-28T17:08:53.9761488Z +   )
2026-07-28T17:08:53.9761559Z + }
