2026-07-28T16:55:30.9142489Z > # This file is part of the standard setup for testthat.
2026-07-28T16:55:30.9143106Z > # It is recommended that you do not modify it.
2026-07-28T16:55:30.9143741Z > #
2026-07-28T16:55:30.9144271Z > # Where should you do additional test configuration?
2026-07-28T16:55:30.9145002Z > # Learn more about the roles of various files in:
2026-07-28T16:55:30.9145982Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T16:55:30.9146928Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T16:55:30.9147523Z > 
2026-07-28T16:55:30.9147900Z > library(testthat)
2026-07-28T16:55:30.9148323Z > library(duckdb)
2026-07-28T16:55:30.9148785Z Loading required package: DBI
2026-07-28T16:55:30.9149221Z > 
2026-07-28T16:55:30.9149575Z > # CRAN guard
2026-07-28T16:55:30.9149906Z > #
2026-07-28T16:55:30.9150642Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T16:55:30.9152002Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T16:55:30.9153066Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T16:55:30.9154109Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T16:55:30.9155121Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T16:55:30.9156201Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T16:55:30.9157073Z > # so the guard is obvious and self-contained.
2026-07-28T16:55:30.9157876Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T16:55:30.9158481Z > 
2026-07-28T16:55:30.9158952Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T16:55:30.9159625Z +   run <- TRUE
2026-07-28T16:55:30.9160179Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T16:55:30.9160764Z +   run <- FALSE
2026-07-28T16:55:30.9161393Z + } else {
2026-07-28T16:55:30.9162060Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T16:55:30.9162880Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T16:55:30.9163399Z + }
2026-07-28T16:55:30.9163690Z > 
2026-07-28T16:55:30.9164015Z > if (run) {
2026-07-28T16:55:30.9164469Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T16:55:30.9164954Z + } else {
2026-07-28T16:55:30.9165326Z +   message(
2026-07-28T16:55:30.9165674Z +     "\n",
2026-07-28T16:55:30.9166052Z +     strrep("=", 78),
2026-07-28T16:55:30.9166448Z +     "\n",
2026-07-28T16:55:30.9166884Z +     "Skipping the duckdb test suite.\n",
2026-07-28T16:55:30.9167399Z +     "\n",
2026-07-28T16:55:30.9168290Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T16:55:30.9169374Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T16:55:30.9170457Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T16:55:30.9171857Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T16:55:30.9172628Z +     "manner.\n",
2026-07-28T16:55:30.9173004Z +     "\n",
2026-07-28T16:55:30.9173710Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T16:55:30.9174596Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T16:55:30.9175048Z +     "\n",
2026-07-28T16:55:30.9175460Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T16:55:30.9176044Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T16:55:30.9176584Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T16:55:30.9176970Z +     strrep("=", 78),
2026-07-28T16:55:30.9177191Z +     "\n"
2026-07-28T16:55:30.9177369Z +   )
2026-07-28T16:55:30.9177538Z + }
