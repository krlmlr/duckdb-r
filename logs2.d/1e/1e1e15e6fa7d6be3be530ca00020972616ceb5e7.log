2026-07-28T17:08:53.7874075Z > # This file is part of the standard setup for testthat.
2026-07-28T17:08:53.7874528Z > # It is recommended that you do not modify it.
2026-07-28T17:08:53.7874947Z > #
2026-07-28T17:08:53.7875475Z > # Where should you do additional test configuration?
2026-07-28T17:08:53.7875975Z > # Learn more about the roles of various files in:
2026-07-28T17:08:53.7876644Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T17:08:53.7877251Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T17:08:53.7877706Z > 
2026-07-28T17:08:53.7878078Z > library(testthat)
2026-07-28T17:08:53.7878451Z > library(duckdb)
2026-07-28T17:08:53.7879095Z Loading required package: DBI
2026-07-28T17:08:53.7880129Z > 
2026-07-28T17:08:53.7880509Z > # CRAN guard
2026-07-28T17:08:53.7880869Z > #
2026-07-28T17:08:53.7881563Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T17:08:53.7882878Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T17:08:53.7885699Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T17:08:53.7886706Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T17:08:53.7887607Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T17:08:53.7888576Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T17:08:53.7889788Z > # so the guard is obvious and self-contained.
2026-07-28T17:08:53.7890548Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T17:08:53.7891150Z > 
2026-07-28T17:08:53.7891674Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T17:08:53.7892196Z +   run <- TRUE
2026-07-28T17:08:53.7892722Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T17:08:53.7893834Z +   run <- FALSE
2026-07-28T17:08:53.7894224Z + } else {
2026-07-28T17:08:53.7894666Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T17:08:53.7895204Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T17:08:53.7895583Z + }
2026-07-28T17:08:53.7895783Z > 
2026-07-28T17:08:53.7896030Z > if (run) {
2026-07-28T17:08:53.7896362Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T17:08:53.7896683Z + } else {
2026-07-28T17:08:53.7896932Z +   message(
2026-07-28T17:08:53.7897432Z +     "\n",
2026-07-28T17:08:53.7897736Z +     strrep("=", 78),
2026-07-28T17:08:53.7898024Z +     "\n",
2026-07-28T17:08:53.7898317Z +     "Skipping the duckdb test suite.\n",
2026-07-28T17:08:53.7898687Z +     "\n",
2026-07-28T17:08:53.7899144Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T17:08:53.7899781Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T17:08:53.7900376Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T17:08:53.7901038Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T17:08:53.7901642Z +     "manner.\n",
2026-07-28T17:08:53.7901914Z +     "\n",
2026-07-28T17:08:53.7902405Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T17:08:53.7903100Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T17:08:53.7903586Z +     "\n",
2026-07-28T17:08:53.7904076Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T17:08:53.7904696Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T17:08:53.7905856Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T17:08:53.7906339Z +     strrep("=", 78),
2026-07-28T17:08:53.7906611Z +     "\n"
2026-07-28T17:08:53.7906853Z +   )
2026-07-28T17:08:53.7907092Z + }
