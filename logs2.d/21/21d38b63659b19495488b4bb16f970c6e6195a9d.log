2026-07-27T14:13:40.0118800Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:13:40.0119061Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:13:40.0119377Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:13:40.0119520Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:13:40.0119815Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:13:40.0119993Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:13:40.0120064Z +   
2026-07-27T14:13:40.0120340Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:13:40.0120739Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:13:40.0121014Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:13:40.0121466Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:13:40.0121723Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
