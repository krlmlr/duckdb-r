2026-07-27T14:13:40.0124931Z +                   wrap.appendChild(kids);
2026-07-27T14:13:40.0125049Z +                   var open = depth === 0;
2026-07-27T14:13:40.0125382Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:13:40.0125568Z +                   row.classList.add("clickable");
2026-07-27T14:13:40.0125733Z +                   row.addEventListener("click", function () {
2026-07-27T14:13:40.0126183Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:13:40.0126282Z +                   });
2026-07-27T14:13:40.0126365Z +               }
2026-07-27T14:13:40.0126463Z +               return wrap;
2026-07-27T14:13:40.0126547Z +           }
2026-07-27T14:13:40.0126653Z +           panel.innerHTML = "";
2026-07-27T14:13:40.0126875Z +           var head = document.createElement("div"); head.className = "tm-head";
