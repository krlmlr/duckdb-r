2026-07-27T14:13:40.0122547Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:13:40.0122729Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:13:40.0123242Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:13:40.0123540Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:13:40.0123862Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:13:40.0124080Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:13:40.0124199Z +               wrap.appendChild(row);
2026-07-27T14:13:40.0124295Z +               if (hasKids) {
