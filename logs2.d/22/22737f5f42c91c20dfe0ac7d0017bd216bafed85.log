2026-07-27T14:26:03.9137368Z +           allNodes.forEach(function (r) { r.node.classList.toggle("open-details", open); });
2026-07-27T14:26:03.9137753Z +           scheduleEdges();
2026-07-27T14:26:03.9137913Z +       }
2026-07-27T14:26:03.9138251Z +       expandBtn.addEventListener("click", function () { setDetailsAll(true); });
