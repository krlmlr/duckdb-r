2026-07-27T14:26:03.9149515Z +           var timings = (PLAN.query && PLAN.query.timings) ? PLAN.query.timings : [];
2026-07-27T14:26:03.9149652Z +           var map = {};
2026-07-27T14:26:03.9150055Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:26:03.9150481Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:26:03.9150896Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:26:03.9151112Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:26:03.9151603Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:26:03.9151957Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:26:03.9152076Z +   
2026-07-27T14:26:03.9152545Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:26:03.9153282Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:26:03.9153694Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:26:03.9154417Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:26:03.9154854Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T14:26:03.9155035Z +           }) };
2026-07-27T14:26:03.9155147Z +   
2026-07-27T14:26:03.9155311Z +           function renderTNode(node, depth) {
2026-07-27T14:26:03.9155616Z +               var wrap = document.createElement("div");
2026-07-27T14:26:03.9156209Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:26:03.9156537Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:26:03.9157300Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:26:03.9157979Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:26:03.9158484Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:26:03.9158941Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:26:03.9159127Z +               wrap.appendChild(row);
2026-07-27T14:26:03.9159258Z +               if (hasKids) {
2026-07-27T14:26:03.9159555Z +                   var kids = document.createElement("div"); kids.className = "tm-kids";
2026-07-27T14:26:03.9159925Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T14:26:03.9160090Z +                   wrap.appendChild(kids);
2026-07-27T14:26:03.9160229Z +                   var open = depth === 0;
2026-07-27T14:26:03.9160669Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:26:03.9160838Z +                   row.classList.add("clickable");
2026-07-27T14:26:03.9161047Z +                   row.addEventListener("click", function () {
2026-07-27T14:26:03.9161618Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:26:03.9161735Z +                   });
2026-07-27T14:26:03.9161842Z +               }
2026-07-27T14:26:03.9161965Z +               return wrap;
2026-07-27T14:26:03.9162072Z +           }
2026-07-27T14:26:03.9162212Z +           panel.innerHTML = "";
2026-07-27T14:26:03.9162485Z +           var head = document.createElement("div"); head.className = "tm-head";
2026-07-27T14:26:03.9163111Z +           head.innerHTML = '<span class="t">Phase timings</span><span class="tm-close" id="tm-close">×</span>';
2026-07-27T14:26:03.9163262Z +           panel.appendChild(head);
2026-07-27T14:26:03.9163454Z +           panel.appendChild(renderTNode(planNode, 0));
