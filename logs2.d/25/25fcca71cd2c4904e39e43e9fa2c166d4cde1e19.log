2026-07-28T07:08:47.4967050Z Loading required package: DBI
2026-07-28T07:08:47.4967365Z > 
2026-07-28T07:08:47.4967564Z > # CRAN guard
2026-07-28T07:08:47.4967757Z > #
2026-07-28T07:08:47.4968167Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:47.4968778Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:47.4969378Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:47.4969959Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:47.4970540Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:47.4971229Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:47.4971715Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:47.4972166Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:47.4972520Z > 
2026-07-28T07:08:47.4972783Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:47.4973091Z +   run <- TRUE
2026-07-28T07:08:47.4973408Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:47.4973736Z +   run <- FALSE
2026-07-28T07:08:47.4973943Z + } else {
2026-07-28T07:08:47.4974300Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:47.4974766Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:47.4975050Z + }
2026-07-28T07:08:47.4975219Z > 
2026-07-28T07:08:47.4975408Z > if (run) {
2026-07-28T07:08:47.4975657Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:47.4975931Z + } else {
2026-07-28T07:08:47.4976242Z +   message(
2026-07-28T07:08:47.4976455Z +     "\n",
2026-07-28T07:08:47.4976671Z +     strrep("=", 78),
2026-07-28T07:08:47.4977181Z +     "\n",
2026-07-28T07:08:47.4977444Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:47.4977726Z +     "\n",
2026-07-28T07:08:47.4978136Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:47.4978750Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:47.4979327Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:47.4979928Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:47.4980357Z +     "manner.\n",
2026-07-28T07:08:47.4980580Z +     "\n",
2026-07-28T07:08:47.4980989Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:47.4981651Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:47.4982092Z +     "\n",
2026-07-28T07:08:47.4982506Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:47.4983228Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:47.4983761Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:47.4984144Z +     strrep("=", 78),
2026-07-28T07:08:47.4984379Z +     "\n"
2026-07-28T07:08:47.4984562Z +   )
2026-07-28T07:08:47.4984732Z + }
