2026-07-28T07:06:55.3811236Z > library(testthat)
2026-07-28T07:06:55.3811666Z > library(duckdb.dev)
2026-07-28T07:06:55.3812120Z Loading required package: DBI
2026-07-28T07:06:55.3812526Z > 
2026-07-28T07:06:55.3812866Z > # CRAN guard
2026-07-28T07:06:55.3813182Z > #
2026-07-28T07:06:55.3813903Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:06:55.3815146Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:06:55.3816231Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:06:55.3817488Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:06:55.3818711Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:06:55.3819809Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:06:55.3820684Z > # so the guard is obvious and self-contained.
2026-07-28T07:06:55.3821488Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:06:55.3822086Z > 
2026-07-28T07:06:55.3822547Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:06:55.3823090Z +   run <- TRUE
2026-07-28T07:06:55.3823632Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:06:55.3824201Z +   run <- FALSE
2026-07-28T07:06:55.3824555Z + } else {
2026-07-28T07:06:55.3825193Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:06:55.3826004Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:06:55.3826502Z + }
2026-07-28T07:06:55.3826976Z > 
2026-07-28T07:06:55.3827323Z > if (run) {
2026-07-28T07:06:55.3827766Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:06:55.3828233Z + } else {
2026-07-28T07:06:55.3828561Z +   message(
2026-07-28T07:06:55.3828896Z +     "\n",
2026-07-28T07:06:55.3829257Z +     strrep("=", 78),
2026-07-28T07:06:55.3829626Z +     "\n",
2026-07-28T07:06:55.3830054Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:06:55.3830543Z +     "\n",
2026-07-28T07:06:55.3831291Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:06:55.3832518Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:06:55.3833558Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:06:55.3834665Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:06:55.3835429Z +     "manner.\n",
2026-07-28T07:06:55.3835792Z +     "\n",
2026-07-28T07:06:55.3836521Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:06:55.3837878Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:06:55.3838646Z +     "\n",
2026-07-28T07:06:55.3839379Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:06:55.3840433Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:06:55.3841389Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:06:55.3842249Z +     strrep("=", 78),
2026-07-28T07:06:55.3842649Z +     "\n"
2026-07-28T07:06:55.3842953Z +   )
2026-07-28T07:06:55.3843244Z + }
