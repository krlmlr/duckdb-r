2026-07-28T07:09:28.7243878Z Loading required package: DBI
2026-07-28T07:09:28.7244105Z > 
2026-07-28T07:09:28.7244296Z > # CRAN guard
2026-07-28T07:09:28.7244475Z > #
2026-07-28T07:09:28.7244870Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:09:28.7245477Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:09:28.7246073Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:09:28.7246646Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:09:28.7247229Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:09:28.7248202Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:09:28.7248694Z > # so the guard is obvious and self-contained.
2026-07-28T07:09:28.7249147Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:09:28.7249489Z > 
2026-07-28T07:09:28.7249770Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:09:28.7250092Z +   run <- TRUE
2026-07-28T07:09:28.7250402Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:09:28.7250728Z +   run <- FALSE
2026-07-28T07:09:28.7250932Z + } else {
2026-07-28T07:09:28.7251292Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:09:28.7251743Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:09:28.7252029Z + }
2026-07-28T07:09:28.7252196Z > 
2026-07-28T07:09:28.7252380Z > if (run) {
2026-07-28T07:09:28.7252631Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:09:28.7252900Z + } else {
2026-07-28T07:09:28.7253283Z +   message(
2026-07-28T07:09:28.7253494Z +     "\n",
2026-07-28T07:09:28.7253709Z +     strrep("=", 78),
2026-07-28T07:09:28.7253942Z +     "\n",
2026-07-28T07:09:28.7254193Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:09:28.7254475Z +     "\n",
2026-07-28T07:09:28.7254886Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:09:28.7255491Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:09:28.7256066Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:09:28.7256687Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:09:28.7257117Z +     "manner.\n",
2026-07-28T07:09:28.7257334Z +     "\n",
2026-07-28T07:09:28.7258002Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:09:28.7258678Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:09:28.7259123Z +     "\n",
2026-07-28T07:09:28.7259540Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:09:28.7260216Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:09:28.7260803Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:09:28.7261189Z +     strrep("=", 78),
2026-07-28T07:09:28.7261409Z +     "\n"
2026-07-28T07:09:28.7261581Z +   )
2026-07-28T07:09:28.7261747Z + }
