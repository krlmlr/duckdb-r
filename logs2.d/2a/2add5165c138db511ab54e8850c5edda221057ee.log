2026-07-28T07:07:36.3972832Z > # This file is part of the standard setup for testthat.
2026-07-28T07:07:36.3973235Z > # It is recommended that you do not modify it.
2026-07-28T07:07:36.3973516Z > #
2026-07-28T07:07:36.3973803Z > # Where should you do additional test configuration?
2026-07-28T07:07:36.3974210Z > # Learn more about the roles of various files in:
2026-07-28T07:07:36.3974704Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T07:07:36.3975223Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T07:07:36.3975549Z > 
2026-07-28T07:07:36.3975754Z > library(testthat)
2026-07-28T07:07:36.3975989Z > library(duckdb.dev)
2026-07-28T07:07:36.3976251Z Loading required package: DBI
2026-07-28T07:07:36.3976486Z > 
2026-07-28T07:07:36.3976684Z > # CRAN guard
2026-07-28T07:07:36.3976870Z > #
2026-07-28T07:07:36.3977277Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:36.3978323Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:36.3979047Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:36.3979643Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:36.3980236Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:36.3980852Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:36.3981339Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:36.3981795Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:36.3982131Z > 
2026-07-28T07:07:36.3982396Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:36.3982706Z +   run <- TRUE
2026-07-28T07:07:36.3983020Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:36.3983345Z +   run <- FALSE
2026-07-28T07:07:36.3983552Z + } else {
2026-07-28T07:07:36.3983909Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:36.3984356Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:36.3984634Z + }
2026-07-28T07:07:36.3984804Z > 
2026-07-28T07:07:36.3985023Z > if (run) {
2026-07-28T07:07:36.3985266Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:36.3985536Z + } else {
2026-07-28T07:07:36.3985729Z +   message(
2026-07-28T07:07:36.3985926Z +     "\n",
2026-07-28T07:07:36.3986139Z +     strrep("=", 78),
2026-07-28T07:07:36.3986358Z +     "\n",
2026-07-28T07:07:36.3986601Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:36.3986875Z +     "\n",
2026-07-28T07:07:36.3987283Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:36.3988470Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:36.3989067Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:36.3989677Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:36.3990110Z +     "manner.\n",
2026-07-28T07:07:36.3990318Z +     "\n",
2026-07-28T07:07:36.3990720Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:36.3991390Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:36.3991836Z +     "\n",
2026-07-28T07:07:36.3992257Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:36.3992841Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:36.3993376Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:36.3993925Z +     strrep("=", 78),
2026-07-28T07:07:36.3994161Z +     "\n"
2026-07-28T07:07:36.3994334Z +   )
2026-07-28T07:07:36.3994500Z + }
