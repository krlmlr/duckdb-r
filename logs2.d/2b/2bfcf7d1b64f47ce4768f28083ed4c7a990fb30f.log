2026-07-26T10:19:30.5098568Z > # so the guard is obvious and self-contained.
2026-07-26T10:19:30.5098846Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-26T10:19:30.5098935Z > 
2026-07-26T10:19:30.5099126Z > if (run_tests %in% c("true", "1", "yes", "on")) {
