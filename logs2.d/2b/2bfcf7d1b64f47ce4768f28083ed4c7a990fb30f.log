2026-07-26T10:21:23.4777024Z > 
2026-07-26T10:21:23.4777410Z > library(testthat)
2026-07-26T10:21:23.4777842Z > library(duckdb)
2026-07-26T10:21:23.4778323Z Loading required package: DBI
2026-07-26T10:21:23.4778841Z > 
2026-07-26T10:21:23.4779200Z > # CRAN guard
2026-07-26T10:21:23.4779540Z > #
2026-07-26T10:21:23.4780330Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-26T10:21:23.4781586Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-26T10:21:23.4782752Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-26T10:21:23.4784175Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-26T10:21:23.4785735Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-26T10:21:23.4786989Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-26T10:21:23.4787907Z > # so the guard is obvious and self-contained.
2026-07-26T10:21:23.4788744Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-26T10:21:23.4789357Z > 
2026-07-26T10:21:23.4789828Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-26T10:21:23.4790373Z +   run <- TRUE
2026-07-26T10:21:23.4790744Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-26T10:21:23.4791099Z +   run <- FALSE
2026-07-26T10:21:23.4791320Z + } else {
2026-07-26T10:21:23.4791700Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-26T10:21:23.4792175Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-26T10:21:23.4792462Z + }
2026-07-26T10:21:23.4792634Z > 
2026-07-26T10:21:23.4792827Z > if (run) {
2026-07-26T10:21:23.4793081Z +   test_check(simulate_duckdb()$pkg)
2026-07-26T10:21:23.4793509Z + } else {
2026-07-26T10:21:23.4793705Z +   message(
2026-07-26T10:21:23.4793910Z +     "\n",
2026-07-26T10:21:23.4794123Z +     strrep("=", 78),
2026-07-26T10:21:23.4794347Z +     "\n",
2026-07-26T10:21:23.4794594Z +     "Skipping the duckdb test suite.\n",
2026-07-26T10:21:23.4794885Z +     "\n",
2026-07-26T10:21:23.4795722Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-26T10:21:23.4796342Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-26T10:21:23.4797041Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-26T10:21:23.4798544Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-26T10:21:23.4799416Z +     "manner.\n",
2026-07-26T10:21:23.4799833Z +     "\n",
2026-07-26T10:21:23.4800603Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-26T10:21:23.4801562Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-26T10:21:23.4802034Z +     "\n",
2026-07-26T10:21:23.4802458Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-26T10:21:23.4803055Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-26T10:21:23.4803597Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-26T10:21:23.4803981Z +     strrep("=", 78),
2026-07-26T10:21:23.4804206Z +     "\n"
