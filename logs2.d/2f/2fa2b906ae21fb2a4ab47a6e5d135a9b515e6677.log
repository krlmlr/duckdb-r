2026-08-09T14:38:23.9130657Z [36;1m        echo "::warning::No usable $wrapper, compiling $var without ccache."[0m
2026-08-09T14:38:23.9131030Z [36;1m      fi[0m
2026-08-09T14:38:23.9131217Z [36;1m    fi[0m
2026-08-09T14:38:23.9131401Z [36;1m[0m
2026-08-09T14:38:23.9131619Z [36;1m    if [ -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-09T14:38:23.9131953Z [36;1m      echo "$var = $wrapper$flags" >> ~/.R/Makevars[0m
2026-08-09T14:38:23.9132259Z [36;1m    fi[0m
2026-08-09T14:38:23.9132442Z [36;1m  done[0m
2026-08-09T14:38:23.9132640Z [36;1m  rm -f "$empty_makevars"[0m
2026-08-09T14:38:23.9132902Z [36;1m[0m
2026-08-09T14:38:23.9133104Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
