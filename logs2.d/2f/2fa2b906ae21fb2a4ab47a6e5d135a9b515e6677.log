2026-08-09T14:43:23.2791032Z > # CRAN guard
2026-08-09T14:43:23.2791278Z > #
2026-08-09T14:43:23.2791810Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-09T14:43:23.2792485Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-09T14:43:23.2793088Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-09T14:43:23.2793778Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-09T14:43:23.2794372Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-09T14:43:23.2794979Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-09T14:43:23.2795689Z > # so the guard is obvious and self-contained.
2026-08-09T14:43:23.2796152Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-09T14:43:23.2796502Z > 
2026-08-09T14:43:23.2796782Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-09T14:43:23.2797099Z +   run <- TRUE
2026-08-09T14:43:23.2797423Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
