2026-08-09T14:43:23.3532582Z > # CRAN guard
2026-08-09T14:43:23.3532823Z > #
2026-08-09T14:43:23.3533341Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-09T14:43:23.3533981Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-09T14:43:23.3534579Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-09T14:43:23.3535151Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-09T14:43:23.3535743Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-09T14:43:23.3536337Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-09T14:43:23.3536817Z > # so the guard is obvious and self-contained.
2026-08-09T14:43:23.3537288Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-09T14:43:23.3537637Z > 
2026-08-09T14:43:23.3537927Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-09T14:43:23.3538254Z +   run <- TRUE
2026-08-09T14:43:23.3538583Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-09T14:43:23.3539175Z +   run <- FALSE
2026-08-09T14:43:23.3539400Z + } else {
2026-08-09T14:43:23.3539948Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-09T14:43:23.3540424Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-09T14:43:23.3540704Z + }
2026-08-09T14:43:23.3540879Z > 
2026-08-09T14:43:23.3541076Z > if (run) {
2026-08-09T14:43:23.3541331Z +   test_check(simulate_duckdb()$pkg)
2026-08-09T14:43:23.3541606Z + } else {
2026-08-09T14:43:23.3541799Z +   message(
2026-08-09T14:43:23.3541993Z +     "\n",
2026-08-09T14:43:23.3542203Z +     strrep("=", 78),
2026-08-09T14:43:23.3542429Z +     "\n",
2026-08-09T14:43:23.3542676Z +     "Skipping the duckdb test suite.\n",
2026-08-09T14:43:23.3542957Z +     "\n",
2026-08-09T14:43:23.3543384Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
