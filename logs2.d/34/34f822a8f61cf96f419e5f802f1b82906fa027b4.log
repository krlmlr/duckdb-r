2026-08-08T02:28:09.7968450Z > # This file is part of the standard setup for testthat.
2026-08-08T02:28:09.7968610Z > # It is recommended that you do not modify it.
2026-08-08T02:28:09.7968660Z > #
2026-08-08T02:28:09.7968840Z > # Where should you do additional test configuration?
2026-08-08T02:28:09.7969010Z > # Learn more about the roles of various files in:
2026-08-08T02:28:09.7969260Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-08-08T02:28:09.7969470Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-08-08T02:28:09.7969520Z > 
2026-08-08T02:28:09.7969610Z > library(testthat)
2026-08-08T02:28:09.7969690Z > library(duckdb)
2026-08-08T02:28:09.7969810Z Loading required package: DBI
2026-08-08T02:28:09.7969850Z > 
2026-08-08T02:28:09.7969930Z > # CRAN guard
2026-08-08T02:28:09.7969980Z > #
2026-08-08T02:28:09.7970270Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-08T02:28:09.7970550Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-08T02:28:09.7970830Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-08T02:28:09.7971100Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-08T02:28:09.7971390Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-08T02:28:09.7971670Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-08T02:28:09.7971830Z > # so the guard is obvious and self-contained.
2026-08-08T02:28:09.7972070Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-08T02:28:09.7972110Z > 
2026-08-08T02:28:09.7972270Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-08T02:28:09.7972360Z +   run <- TRUE
2026-08-08T02:28:09.7972540Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-08T02:28:09.7972740Z +   run <- FALSE
2026-08-08T02:28:09.7972810Z + } else {
2026-08-08T02:28:09.7973060Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-08T02:28:09.7973220Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-08T02:28:09.7973270Z + }
2026-08-08T02:28:09.7973320Z > 
2026-08-08T02:28:09.7973650Z > if (run) {
2026-08-08T02:28:09.7973800Z +   test_check(simulate_duckdb()$pkg)
2026-08-08T02:28:09.7973880Z + } else {
2026-08-08T02:28:09.7973960Z +   message(
2026-08-08T02:28:09.7974030Z +     "\n",
2026-08-08T02:28:09.7974120Z +     strrep("=", 78),
2026-08-08T02:28:09.7974190Z +     "\n",
2026-08-08T02:28:09.7974330Z +     "Skipping the duckdb test suite.\n",
2026-08-08T02:28:09.7974400Z +     "\n",
2026-08-08T02:28:09.7974710Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-08T02:28:09.7974980Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-08T02:28:09.7975270Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-08T02:28:09.7975630Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-08T02:28:09.7975740Z +     "manner.\n",
2026-08-08T02:28:09.7975820Z +     "\n",
2026-08-08T02:28:09.7976180Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-08T02:28:09.7976660Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-08T02:28:09.7976730Z +     "\n",
2026-08-08T02:28:09.7977040Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-08T02:28:09.7977300Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-08T02:28:09.7977550Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-08T02:28:09.7977640Z +     strrep("=", 78),
2026-08-08T02:28:09.7977710Z +     "\n"
2026-08-08T02:28:09.7977760Z +   )
2026-08-08T02:28:09.7977810Z + }
