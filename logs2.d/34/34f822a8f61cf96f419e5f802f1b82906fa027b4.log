2026-08-08T02:28:09.6995990Z > # This file is part of the standard setup for testthat.
2026-08-08T02:28:09.6996530Z > # It is recommended that you do not modify it.
2026-08-08T02:28:09.6996970Z > #
2026-08-08T02:28:09.6997230Z > # Where should you do additional test configuration?
2026-08-08T02:28:09.6997670Z > # Learn more about the roles of various files in:
2026-08-08T02:28:09.6998200Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-08-08T02:28:09.6998880Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-08-08T02:28:09.6999330Z > 
2026-08-08T02:28:09.6999570Z > library(testthat)
2026-08-08T02:28:09.6999940Z > library(duckdb)
2026-08-08T02:28:09.7000200Z Loading required package: DBI
2026-08-08T02:28:09.7000450Z > 
2026-08-08T02:28:09.7000690Z > # CRAN guard
2026-08-08T02:28:09.7000980Z > #
2026-08-08T02:28:09.7001410Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-08T02:28:09.7002120Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-08T02:28:09.7003130Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-08T02:28:09.7003870Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-08T02:28:09.7004520Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-08T02:28:09.7005250Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-08T02:28:09.7005750Z > # so the guard is obvious and self-contained.
2026-08-08T02:28:09.7006350Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-08T02:28:09.7006730Z > 
2026-08-08T02:28:09.7007150Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-08T02:28:09.7007520Z +   run <- TRUE
2026-08-08T02:28:09.7007850Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-08T02:28:09.7008230Z +   run <- FALSE
2026-08-08T02:28:09.7008570Z + } else {
2026-08-08T02:28:09.7009080Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-08T02:28:09.7009590Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-08T02:28:09.7010070Z + }
2026-08-08T02:28:09.7010330Z > 
2026-08-08T02:28:09.7010470Z > if (run) {
2026-08-08T02:28:09.7010810Z +   test_check(simulate_duckdb()$pkg)
2026-08-08T02:28:09.7011010Z + } else {
2026-08-08T02:28:09.7011270Z +   message(
2026-08-08T02:28:09.7011480Z +     "\n",
2026-08-08T02:28:09.7011810Z +     strrep("=", 78),
2026-08-08T02:28:09.7012330Z +     "\n",
2026-08-08T02:28:09.7012660Z +     "Skipping the duckdb test suite.\n",
2026-08-08T02:28:09.7013000Z +     "\n",
2026-08-08T02:28:09.7013480Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-08T02:28:09.7014000Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-08T02:28:09.7014540Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-08T02:28:09.7015150Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-08T02:28:09.7015620Z +     "manner.\n",
2026-08-08T02:28:09.7015850Z +     "\n",
2026-08-08T02:28:09.7016340Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-08T02:28:09.7016930Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-08T02:28:09.7017320Z +     "\n",
2026-08-08T02:28:09.7017770Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-08T02:28:09.7018580Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-08T02:28:09.7019130Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-08T02:28:09.7019500Z +     strrep("=", 78),
2026-08-08T02:28:09.7019810Z +     "\n"
2026-08-08T02:28:09.7020060Z +   )
2026-08-08T02:28:09.7020260Z + }
