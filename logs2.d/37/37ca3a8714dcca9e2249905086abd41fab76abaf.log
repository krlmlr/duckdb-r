2026-07-28T07:09:04.0592628Z > library(testthat)
2026-07-28T07:09:04.0592861Z > library(duckdb.dev)
2026-07-28T07:09:04.0593117Z Loading required package: DBI
2026-07-28T07:09:04.0593353Z > 
2026-07-28T07:09:04.0593604Z > # CRAN guard
2026-07-28T07:09:04.0593796Z > #
2026-07-28T07:09:04.0594167Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:09:04.0594711Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:09:04.0595239Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:09:04.0595749Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:09:04.0596273Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:09:04.0596806Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:09:04.0597372Z > # so the guard is obvious and self-contained.
2026-07-28T07:09:04.0597787Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:09:04.0598102Z > 
2026-07-28T07:09:04.0598371Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:09:04.0598736Z +   run <- TRUE
2026-07-28T07:09:04.0599045Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:09:04.0599351Z +   run <- FALSE
2026-07-28T07:09:04.0599559Z + } else {
2026-07-28T07:09:04.0599892Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:09:04.0600299Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:09:04.0600568Z + }
2026-07-28T07:09:04.0600743Z > 
2026-07-28T07:09:04.0600931Z > if (run) {
2026-07-28T07:09:04.0601172Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:09:04.0601426Z + } else {
2026-07-28T07:09:04.0601619Z +   message(
2026-07-28T07:09:04.0601813Z +     "\n",
2026-07-28T07:09:04.0602031Z +     strrep("=", 78),
2026-07-28T07:09:04.0602249Z +     "\n",
2026-07-28T07:09:04.0602493Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:09:04.0602756Z +     "\n",
2026-07-28T07:09:04.0603131Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:09:04.0603669Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:09:04.0604229Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:09:04.0604772Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:09:04.0605170Z +     "manner.\n",
2026-07-28T07:09:04.0605392Z +     "\n",
2026-07-28T07:09:04.0605775Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:09:04.0606352Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:09:04.0606757Z +     "\n",
2026-07-28T07:09:04.0607222Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:09:04.0607738Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:09:04.0608213Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:09:04.0608579Z +     strrep("=", 78),
2026-07-28T07:09:04.0608803Z +     "\n"
2026-07-28T07:09:04.0609049Z +   )
2026-07-28T07:09:04.0609228Z + }
