2026-07-28T07:07:08.6197979Z > library(testthat)
2026-07-28T07:07:08.6198231Z > library(duckdb.dev)
2026-07-28T07:07:08.6198504Z Loading required package: DBI
2026-07-28T07:07:08.6198758Z > 
2026-07-28T07:07:08.6198967Z > # CRAN guard
2026-07-28T07:07:08.6199181Z > #
2026-07-28T07:07:08.6199574Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:08.6200149Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:08.6200708Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:08.6201245Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:08.6201774Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:08.6202331Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:08.6202793Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:08.6203648Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:08.6204002Z > 
2026-07-28T07:07:08.6204278Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:08.6204587Z +   run <- TRUE
2026-07-28T07:07:08.6204898Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:08.6205230Z +   run <- FALSE
2026-07-28T07:07:08.6205466Z + } else {
2026-07-28T07:07:08.6205814Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:08.6206244Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:08.6206510Z + }
2026-07-28T07:07:08.6206688Z > 
2026-07-28T07:07:08.6207028Z > if (run) {
2026-07-28T07:07:08.6207441Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:08.6207714Z + } else {
2026-07-28T07:07:08.6207920Z +   message(
2026-07-28T07:07:08.6208124Z +     "\n",
2026-07-28T07:07:08.6208404Z +     strrep("=", 78),
2026-07-28T07:07:08.6208626Z +     "\n",
2026-07-28T07:07:08.6208869Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:08.6209138Z +     "\n",
2026-07-28T07:07:08.6209522Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:08.6210069Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:08.6210605Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:08.6211162Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:08.6211570Z +     "manner.\n",
2026-07-28T07:07:08.6211784Z +     "\n",
2026-07-28T07:07:08.6212165Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:08.6212771Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:08.6213175Z +     "\n",
2026-07-28T07:07:08.6213629Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:08.6214153Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:08.6214626Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:08.6214969Z +     strrep("=", 78),
2026-07-28T07:07:08.6215185Z +     "\n"
2026-07-28T07:07:08.6215363Z +   )
2026-07-28T07:07:08.6215537Z + }
