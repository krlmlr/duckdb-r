2026-07-28T06:59:36.0352582Z > library(testthat)
2026-07-28T06:59:36.0352708Z > library(duckdb.dev)
2026-07-28T06:59:36.0352846Z Loading required package: DBI
2026-07-28T06:59:36.0352968Z > 
2026-07-28T06:59:36.0353071Z > # CRAN guard
2026-07-28T06:59:36.0353170Z > #
2026-07-28T06:59:36.0353378Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T06:59:36.0353685Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T06:59:36.0353984Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T06:59:36.0354275Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T06:59:36.0354574Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T06:59:36.0354926Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T06:59:36.0355177Z > # so the guard is obvious and self-contained.
2026-07-28T06:59:36.0355415Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T06:59:36.0355596Z > 
2026-07-28T06:59:36.0355744Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T06:59:36.0355911Z +   run <- TRUE
2026-07-28T06:59:36.0356082Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T06:59:36.0356260Z +   run <- FALSE
2026-07-28T06:59:36.0356382Z + } else {
2026-07-28T06:59:36.0356731Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T06:59:36.0356971Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T06:59:36.0357123Z + }
2026-07-28T06:59:36.0357222Z > 
2026-07-28T06:59:36.0357328Z > if (run) {
2026-07-28T06:59:36.0357465Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T06:59:36.0357614Z + } else {
2026-07-28T06:59:36.0357812Z +   message(
2026-07-28T06:59:36.0357921Z +     "\n",
2026-07-28T06:59:36.0358032Z +     strrep("=", 78),
2026-07-28T06:59:36.0358149Z +     "\n",
2026-07-28T06:59:36.0358284Z +     "Skipping the duckdb test suite.\n",
2026-07-28T06:59:36.0358432Z +     "\n",
2026-07-28T06:59:36.0358649Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T06:59:36.0358954Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T06:59:36.0359244Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T06:59:36.0359551Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T06:59:36.0359775Z +     "manner.\n",
2026-07-28T06:59:36.0359893Z +     "\n",
2026-07-28T06:59:36.0360111Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T06:59:36.0360446Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T06:59:36.0360668Z +     "\n",
2026-07-28T06:59:36.0360885Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T06:59:36.0361225Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T06:59:36.0361509Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T06:59:36.0361707Z +     strrep("=", 78),
2026-07-28T06:59:36.0361828Z +     "\n"
2026-07-28T06:59:36.0361927Z +   )
2026-07-28T06:59:36.0362022Z + }
