2026-07-28T06:58:21.0777911Z > # CRAN guard
2026-07-28T06:58:21.0778069Z > #
2026-07-28T06:58:21.0778410Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T06:58:21.0778924Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T06:58:21.0779504Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T06:58:21.0779981Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T06:58:21.0780466Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T06:58:21.0781075Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T06:58:21.0781487Z > # so the guard is obvious and self-contained.
2026-07-28T06:58:21.0781867Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T06:58:21.0782154Z > 
2026-07-28T06:58:21.0782385Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T06:58:21.0782648Z +   run <- TRUE
2026-07-28T06:58:21.0782916Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T06:58:21.0783188Z +   run <- FALSE
2026-07-28T06:58:21.0783363Z + } else {
2026-07-28T06:58:21.0783674Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T06:58:21.0784051Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T06:58:21.0784293Z + }
2026-07-28T06:58:21.0784440Z > 
2026-07-28T06:58:21.0784608Z > if (run) {
2026-07-28T06:58:21.0784825Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T06:58:21.0785053Z + } else {
2026-07-28T06:58:21.0785227Z +   message(
2026-07-28T06:58:21.0785403Z +     "\n",
2026-07-28T06:58:21.0785587Z +     strrep("=", 78),
2026-07-28T06:58:21.0785776Z +     "\n",
2026-07-28T06:58:21.0785995Z +     "Skipping the duckdb test suite.\n",
2026-07-28T06:58:21.0786234Z +     "\n",
2026-07-28T06:58:21.0786730Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T06:58:21.0787307Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T06:58:21.0787782Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T06:58:21.0788289Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T06:58:21.0788649Z +     "manner.\n",
2026-07-28T06:58:21.0788827Z +     "\n",
2026-07-28T06:58:21.0789171Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T06:58:21.0789706Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T06:58:21.0790061Z +     "\n",
2026-07-28T06:58:21.0790411Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T06:58:21.0790900Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T06:58:21.0791338Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T06:58:21.0791755Z +     strrep("=", 78),
2026-07-28T06:58:21.0791949Z +     "\n"
2026-07-28T06:58:21.0792107Z +   )
2026-07-28T06:58:21.0792257Z + }
