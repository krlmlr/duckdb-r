2026-09-13T14:56:49.8088270Z > # CRAN guard
2026-09-13T14:56:49.8088430Z > #
2026-09-13T14:56:49.8088880Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-13T14:56:49.8089640Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-13T14:56:49.8090270Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-13T14:56:49.8090780Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-13T14:56:49.8091550Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-13T14:56:49.8092090Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-13T14:56:49.8092490Z > # so the guard is obvious and self-contained.
2026-09-13T14:56:49.8092960Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-13T14:56:49.8093260Z > 
2026-09-13T14:56:49.8093490Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-13T14:56:49.8093950Z +   run <- TRUE
2026-09-13T14:56:49.8108220Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-13T14:56:49.8108710Z +   run <- FALSE
2026-09-13T14:56:49.8108900Z + } else {
2026-09-13T14:56:49.8109230Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-13T14:56:49.8109620Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-13T14:56:49.8109840Z + }
2026-09-13T14:56:49.8109960Z > 
2026-09-13T14:56:49.8110110Z > if (run) {
2026-09-13T14:56:49.8110320Z +   test_check(simulate_duckdb()$pkg)
2026-09-13T14:56:49.8110530Z + } else {
2026-09-13T14:56:49.8110680Z +   message(
2026-09-13T14:56:49.8110830Z +     "\n",
2026-09-13T14:56:49.8111000Z +     strrep("=", 78),
2026-09-13T14:56:49.8111190Z +     "\n",
2026-09-13T14:56:49.8111400Z +     "Skipping the duckdb test suite.\n",
2026-09-13T14:56:49.8111620Z +     "\n",
2026-09-13T14:56:49.8111990Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-13T14:56:49.8112530Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-13T14:56:49.8113140Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-13T14:56:49.8113750Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-13T14:56:49.8114120Z +     "manner.\n",
2026-09-13T14:56:49.8114280Z +     "\n",
2026-09-13T14:56:49.8114650Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-13T14:56:49.8115220Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-13T14:56:49.8115560Z +     "\n",
2026-09-13T14:56:49.8115940Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-13T14:56:49.8116530Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-13T14:56:49.8117010Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-13T14:56:49.8117400Z +     strrep("=", 78),
2026-09-13T14:56:49.8117590Z +     "\n"
2026-09-13T14:56:49.8117710Z +   )
2026-09-13T14:56:49.8117840Z + }
