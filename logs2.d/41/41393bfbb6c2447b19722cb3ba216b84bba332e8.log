2026-08-19T03:55:57.1623935Z [36;1m# the *package's* runtime parallelism, not compilation, so this is safe.[0m
2026-08-19T03:55:57.1624539Z [36;1mncores="$(Rscript --vanilla -e 'n <- parallel::detectCores(); cat(if (is.na(n) || n < 1) 2L else as.integer(n))')"[0m
2026-08-19T03:55:57.1625068Z [36;1mecho "MAKEFLAGS = -j${ncores}" >> ~/.R/Makevars[0m
2026-08-19T03:55:57.1625406Z [36;1mecho "===== generated ~/.R/Makevars ====="[0m
2026-08-19T03:55:57.1625697Z [36;1mcat ~/.R/Makevars[0m
2026-08-19T03:55:57.1625961Z [36;1mecho "==================================="[0m
