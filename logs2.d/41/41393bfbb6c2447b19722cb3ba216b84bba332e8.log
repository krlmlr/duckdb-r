2026-08-19T04:00:31.7078190Z > # CRAN guard
2026-08-19T04:00:31.7078529Z > #
2026-08-19T04:00:31.7079227Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-19T04:00:31.7080303Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-19T04:00:31.7081491Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-19T04:00:31.7082519Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-19T04:00:31.7083546Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-19T04:00:31.7084638Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-19T04:00:31.7085494Z > # so the guard is obvious and self-contained.
2026-08-19T04:00:31.7086301Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-19T04:00:31.7086881Z > 
2026-08-19T04:00:31.7087381Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-19T04:00:31.7087913Z +   run <- TRUE
2026-08-19T04:00:31.7088461Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
