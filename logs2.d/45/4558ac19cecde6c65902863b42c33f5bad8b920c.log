2026-07-28T07:08:53.5986862Z > library(testthat)
2026-07-28T07:08:53.5987095Z > library(duckdb.dev)
2026-07-28T07:08:53.5987356Z Loading required package: DBI
2026-07-28T07:08:53.5987587Z > 
2026-07-28T07:08:53.5987779Z > # CRAN guard
2026-07-28T07:08:53.5987963Z > #
2026-07-28T07:08:53.5988577Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:53.5989222Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:53.5989819Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:53.5990394Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:53.5990977Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:53.5991663Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:53.5992147Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:53.5992593Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:53.5992933Z > 
2026-07-28T07:08:53.5993195Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:53.5993496Z +   run <- TRUE
2026-07-28T07:08:53.5993808Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:53.5994146Z +   run <- FALSE
2026-07-28T07:08:53.5994352Z + } else {
2026-07-28T07:08:53.5994708Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:53.5995150Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:53.5995429Z + }
2026-07-28T07:08:53.5995590Z > 
2026-07-28T07:08:53.5995775Z > if (run) {
2026-07-28T07:08:53.5996029Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:53.5996298Z + } else {
2026-07-28T07:08:53.5996601Z +   message(
2026-07-28T07:08:53.5996800Z +     "\n",
2026-07-28T07:08:53.5997008Z +     strrep("=", 78),
2026-07-28T07:08:53.5997227Z +     "\n",
2026-07-28T07:08:53.5997471Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:53.5997752Z +     "\n",
2026-07-28T07:08:53.5998157Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:53.5999129Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:53.5999716Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:53.6000319Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:53.6000748Z +     "manner.\n",
2026-07-28T07:08:53.6000966Z +     "\n",
2026-07-28T07:08:53.6001368Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:53.6002015Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:53.6002457Z +     "\n",
2026-07-28T07:08:53.6002905Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:53.6003590Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:53.6004131Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:53.6004507Z +     strrep("=", 78),
2026-07-28T07:08:53.6004727Z +     "\n"
2026-07-28T07:08:53.6004907Z +   )
2026-07-28T07:08:53.6005072Z + }
