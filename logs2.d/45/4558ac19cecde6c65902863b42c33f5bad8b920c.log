2026-07-28T07:07:01.9513298Z > library(testthat)
2026-07-28T07:07:01.9513714Z > library(duckdb.dev)
2026-07-28T07:07:01.9514172Z Loading required package: DBI
2026-07-28T07:07:01.9514576Z > 
2026-07-28T07:07:01.9514953Z > # CRAN guard
2026-07-28T07:07:01.9515266Z > #
2026-07-28T07:07:01.9516013Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:01.9517340Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:01.9518630Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:01.9519769Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:01.9520805Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:01.9521899Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:01.9522785Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:01.9523574Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:01.9524161Z > 
2026-07-28T07:07:01.9524628Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:01.9525171Z +   run <- TRUE
2026-07-28T07:07:01.9525716Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:01.9526283Z +   run <- FALSE
2026-07-28T07:07:01.9526633Z + } else {
2026-07-28T07:07:01.9527262Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:01.9528053Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:01.9528863Z + }
2026-07-28T07:07:01.9529157Z > 
2026-07-28T07:07:01.9529482Z > if (run) {
2026-07-28T07:07:01.9529921Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:01.9530387Z + } else {
2026-07-28T07:07:01.9530717Z +   message(
2026-07-28T07:07:01.9531047Z +     "\n",
2026-07-28T07:07:01.9531436Z +     strrep("=", 78),
2026-07-28T07:07:01.9531812Z +     "\n",
2026-07-28T07:07:01.9532242Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:01.9532716Z +     "\n",
2026-07-28T07:07:01.9533437Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:01.9534759Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:01.9535784Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:01.9536865Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:01.9537624Z +     "manner.\n",
2026-07-28T07:07:01.9537991Z +     "\n",
2026-07-28T07:07:01.9538977Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:01.9540157Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:01.9540917Z +     "\n",
2026-07-28T07:07:01.9541646Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:01.9542683Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:01.9543637Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:01.9544497Z +     strrep("=", 78),
2026-07-28T07:07:01.9544893Z +     "\n"
2026-07-28T07:07:01.9545190Z +   )
2026-07-28T07:07:01.9545482Z + }
