2026-07-29T13:29:03.8748280Z > library(testthat)
2026-07-29T13:29:03.8748369Z > library(duckdb)
2026-07-29T13:29:03.8748487Z Loading required package: DBI
2026-07-29T13:29:03.8748547Z > 
2026-07-29T13:29:03.8748634Z > # CRAN guard
2026-07-29T13:29:03.8748692Z > #
2026-07-29T13:29:03.8748978Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T13:29:03.8749245Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T13:29:03.8749520Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T13:29:03.8749771Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T13:29:03.8750050Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T13:29:03.8750340Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T13:29:03.8750493Z > # so the guard is obvious and self-contained.
2026-07-29T13:29:03.8750726Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T13:29:03.8750784Z > 
2026-07-29T13:29:03.8750949Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T13:29:03.8751034Z +   run <- TRUE
2026-07-29T13:29:03.8751220Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T13:29:03.8751306Z +   run <- FALSE
2026-07-29T13:29:03.8751386Z + } else {
2026-07-29T13:29:03.8751623Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T13:29:03.8751979Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T13:29:03.8752253Z + }
2026-07-29T13:29:03.8752316Z > 
2026-07-29T13:29:03.8752403Z > if (run) {
2026-07-29T13:29:03.8752537Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T13:29:03.8752616Z + } else {
2026-07-29T13:29:03.8752698Z +   message(
2026-07-29T13:29:03.8752776Z +     "\n",
2026-07-29T13:29:03.8752870Z +     strrep("=", 78),
2026-07-29T13:29:03.8752950Z +     "\n",
2026-07-29T13:29:03.8753082Z +     "Skipping the duckdb test suite.\n",
2026-07-29T13:29:03.8753161Z +     "\n",
2026-07-29T13:29:03.8753580Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T13:29:03.8753851Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T13:29:03.8754113Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T13:29:03.8754409Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T13:29:03.8754496Z +     "manner.\n",
2026-07-29T13:29:03.8754579Z +     "\n",
2026-07-29T13:29:03.8754858Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T13:29:03.8755248Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T13:29:03.8755328Z +     "\n",
2026-07-29T13:29:03.8755619Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-29T13:29:03.8755874Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-29T13:29:03.8756112Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-29T13:29:03.8756212Z +     strrep("=", 78),
2026-07-29T13:29:03.8756290Z +     "\n"
2026-07-29T13:29:03.8756352Z +   )
2026-07-29T13:29:03.8756411Z + }
