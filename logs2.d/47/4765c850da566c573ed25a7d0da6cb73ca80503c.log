2026-07-29T13:29:03.8087644Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-29T13:29:03.8088099Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-29T13:29:03.8088383Z > 
2026-07-29T13:29:03.8088553Z > library(testthat)
2026-07-29T13:29:03.8088751Z > library(duckdb)
2026-07-29T13:29:03.8088970Z Loading required package: DBI
2026-07-29T13:29:03.8089171Z > 
2026-07-29T13:29:03.8089329Z > # CRAN guard
2026-07-29T13:29:03.8089479Z > #
2026-07-29T13:29:03.8089843Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T13:29:03.8090436Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T13:29:03.8091006Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T13:29:03.8091538Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T13:29:03.8092327Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T13:29:03.8092940Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T13:29:03.8093383Z > # so the guard is obvious and self-contained.
2026-07-29T13:29:03.8094105Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T13:29:03.8094409Z > 
2026-07-29T13:29:03.8094642Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T13:29:03.8094911Z +   run <- TRUE
2026-07-29T13:29:03.8095187Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T13:29:03.8095470Z +   run <- FALSE
2026-07-29T13:29:03.8095644Z + } else {
2026-07-29T13:29:03.8095965Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T13:29:03.8096699Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T13:29:03.8096980Z + }
2026-07-29T13:29:03.8097114Z > 
2026-07-29T13:29:03.8097271Z > if (run) {
2026-07-29T13:29:03.8097489Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T13:29:03.8097721Z + } else {
2026-07-29T13:29:03.8098075Z +   message(
2026-07-29T13:29:03.8098243Z +     "\n",
2026-07-29T13:29:03.8098423Z +     strrep("=", 78),
2026-07-29T13:29:03.8098615Z +     "\n",
2026-07-29T13:29:03.8098836Z +     "Skipping the duckdb test suite.\n",
2026-07-29T13:29:03.8099081Z +     "\n",
2026-07-29T13:29:03.8099616Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T13:29:03.8100172Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T13:29:03.8100697Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T13:29:03.8101253Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T13:29:03.8101637Z +     "manner.\n",
2026-07-29T13:29:03.8102057Z +     "\n",
2026-07-29T13:29:03.8102445Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T13:29:03.8103047Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T13:29:03.8103428Z +     "\n",
2026-07-29T13:29:03.8103802Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-29T13:29:03.8104341Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-29T13:29:03.8104831Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-29T13:29:03.8105165Z +     strrep("=", 78),
2026-07-29T13:29:03.8105349Z +     "\n"
2026-07-29T13:29:03.8105542Z +   )
2026-07-29T13:29:03.8137678Z + }
