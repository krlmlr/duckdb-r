2026-07-27T16:39:24.8729676Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T16:39:24.8730091Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T16:39:24.8730262Z +           function val(k) { return map[k] || 0; }
2026-07-27T16:39:24.8730747Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
