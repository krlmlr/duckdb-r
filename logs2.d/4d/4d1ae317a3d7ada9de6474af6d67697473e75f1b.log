2026-07-27T15:07:57.0003733Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T15:07:57.0004106Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
