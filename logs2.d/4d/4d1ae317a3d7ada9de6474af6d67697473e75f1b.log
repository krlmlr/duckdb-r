2026-07-27T15:07:56.9998132Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T15:07:56.9998454Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T15:07:56.9998862Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T15:07:56.9999097Z +           function val(k) { return map[k] || 0; }
2026-07-27T15:07:56.9999604Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T15:07:56.9999833Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T15:07:56.9999902Z +   
2026-07-27T15:07:57.0000245Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T15:07:57.0000772Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T15:07:57.0001027Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T15:07:57.0001614Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
