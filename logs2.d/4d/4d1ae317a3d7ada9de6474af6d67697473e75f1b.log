2026-07-27T15:07:57.0006053Z +                   var open = depth === 0;
2026-07-27T15:07:57.0006470Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T15:07:57.0006634Z +                   row.classList.add("clickable");
2026-07-27T15:07:57.0006828Z +                   row.addEventListener("click", function () {
