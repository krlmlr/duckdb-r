2026-07-27T15:07:57.0007506Z +                   });
2026-07-27T15:07:57.0007604Z +               }
2026-07-27T15:07:57.0007722Z +               return wrap;
2026-07-27T15:07:57.0007809Z +           }
2026-07-27T15:07:57.0007944Z +           panel.innerHTML = "";
2026-07-27T15:07:57.0008209Z +           var head = document.createElement("div"); head.className = "tm-head";
