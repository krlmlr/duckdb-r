2026-07-28T07:09:06.7219058Z > 
2026-07-28T07:09:06.7219266Z > library(testthat)
2026-07-28T07:09:06.7219503Z > library(duckdb.dev)
2026-07-28T07:09:06.7219775Z Loading required package: DBI
2026-07-28T07:09:06.7220014Z > 
2026-07-28T07:09:06.7220215Z > # CRAN guard
2026-07-28T07:09:06.7220407Z > #
2026-07-28T07:09:06.7220812Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:09:06.7221525Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:09:06.7222126Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:09:06.7222695Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:09:06.7223594Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:09:06.7224212Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:09:06.7224677Z > # so the guard is obvious and self-contained.
2026-07-28T07:09:06.7225126Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:09:06.7225466Z > 
2026-07-28T07:09:06.7225742Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:09:06.7226058Z +   run <- TRUE
2026-07-28T07:09:06.7226378Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:09:06.7226707Z +   run <- FALSE
2026-07-28T07:09:06.7226915Z + } else {
2026-07-28T07:09:06.7227268Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:09:06.7227705Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:09:06.7227978Z + }
2026-07-28T07:09:06.7228162Z > 
2026-07-28T07:09:06.7228354Z > if (run) {
2026-07-28T07:09:06.7228612Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:09:06.7228881Z + } else {
2026-07-28T07:09:06.7229083Z +   message(
2026-07-28T07:09:06.7229290Z +     "\n",
2026-07-28T07:09:06.7229507Z +     strrep("=", 78),
2026-07-28T07:09:06.7229736Z +     "\n",
2026-07-28T07:09:06.7229988Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:09:06.7230268Z +     "\n",
2026-07-28T07:09:06.7230673Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:09:06.7231380Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:09:06.7231937Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:09:06.7232524Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:09:06.7232935Z +     "manner.\n",
2026-07-28T07:09:06.7233353Z +     "\n",
2026-07-28T07:09:06.7233759Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:09:06.7234380Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:09:06.7234790Z +     "\n",
2026-07-28T07:09:06.7235185Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:09:06.7235746Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:09:06.7236259Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:09:06.7236764Z +     strrep("=", 78),
2026-07-28T07:09:06.7236989Z +     "\n"
2026-07-28T07:09:06.7237171Z +   )
2026-07-28T07:09:06.7237356Z + }
