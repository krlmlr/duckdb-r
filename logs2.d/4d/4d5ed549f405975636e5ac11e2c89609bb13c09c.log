2026-07-28T07:11:06.1014487Z > library(testthat)
2026-07-28T07:11:06.1014726Z > library(duckdb.dev)
2026-07-28T07:11:06.1015006Z Loading required package: DBI
2026-07-28T07:11:06.1015247Z > 
2026-07-28T07:11:06.1015446Z > # CRAN guard
2026-07-28T07:11:06.1015643Z > #
2026-07-28T07:11:06.1016064Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:11:06.1016667Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:11:06.1017246Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:11:06.1017810Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:11:06.1018381Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:11:06.1019101Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:11:06.1019580Z > # so the guard is obvious and self-contained.
2026-07-28T07:11:06.1020033Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:11:06.1020373Z > 
2026-07-28T07:11:06.1020648Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:11:06.1020952Z +   run <- TRUE
2026-07-28T07:11:06.1021278Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:11:06.1021615Z +   run <- FALSE
2026-07-28T07:11:06.1021832Z + } else {
2026-07-28T07:11:06.1022197Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:11:06.1022639Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:11:06.1022921Z + }
2026-07-28T07:11:06.1023270Z > 
2026-07-28T07:11:06.1023465Z > if (run) {
2026-07-28T07:11:06.1023730Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:11:06.1024141Z + } else {
2026-07-28T07:11:06.1024344Z +   message(
2026-07-28T07:11:06.1024548Z +     "\n",
2026-07-28T07:11:06.1024772Z +     strrep("=", 78),
2026-07-28T07:11:06.1024997Z +     "\n",
2026-07-28T07:11:06.1025250Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:11:06.1025529Z +     "\n",
2026-07-28T07:11:06.1025936Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:11:06.1026519Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:11:06.1027061Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:11:06.1027640Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:11:06.1028057Z +     "manner.\n",
2026-07-28T07:11:06.1028272Z +     "\n",
2026-07-28T07:11:06.1028670Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:11:06.1029302Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:11:06.1029723Z +     "\n",
2026-07-28T07:11:06.1030205Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:11:06.1030794Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:11:06.1031316Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:11:06.1031691Z +     strrep("=", 78),
2026-07-28T07:11:06.1031918Z +     "\n"
2026-07-28T07:11:06.1032101Z +   )
2026-07-28T07:11:06.1032281Z + }
