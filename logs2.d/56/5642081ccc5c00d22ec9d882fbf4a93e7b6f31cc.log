2026-07-27T14:07:09.9586653Z +           function renderTNode(node, depth) {
2026-07-27T14:07:09.9586840Z +               var wrap = document.createElement("div");
2026-07-27T14:07:09.9587322Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:07:09.9587553Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:07:09.9588285Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:07:09.9588673Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:07:09.9589105Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:07:09.9589390Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:07:09.9589528Z +               wrap.appendChild(row);
2026-07-27T14:07:09.9589653Z +               if (hasKids) {
