2026-07-27T14:07:09.9590321Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T14:07:09.9590477Z +                   wrap.appendChild(kids);
2026-07-27T14:07:09.9590616Z +                   var open = depth === 0;
2026-07-27T14:07:09.9591283Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:07:09.9591583Z +                   row.classList.add("clickable");
2026-07-27T14:07:09.9591809Z +                   row.addEventListener("click", function () {
2026-07-27T14:07:09.9592425Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:07:09.9592534Z +                   });
2026-07-27T14:07:09.9592638Z +               }
2026-07-27T14:07:09.9592764Z +               return wrap;
2026-07-27T14:07:09.9592856Z +           }
2026-07-27T14:07:09.9592992Z +           panel.innerHTML = "";
2026-07-27T14:07:09.9593279Z +           var head = document.createElement("div"); head.className = "tm-head";
