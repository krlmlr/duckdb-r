2026-07-27T14:07:09.9582288Z +           var map = {};
2026-07-27T14:07:09.9582534Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:07:09.9582866Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:07:09.9583289Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:07:09.9583460Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:07:09.9583845Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:07:09.9584084Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:07:09.9584158Z +   
2026-07-27T14:07:09.9584522Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:07:09.9585065Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:07:09.9585408Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:07:09.9585989Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:07:09.9586302Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T14:07:09.9586409Z +           }) };
