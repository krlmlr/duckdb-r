2026-07-29T04:43:40.2702970Z Loading required package: DBI
2026-07-29T04:43:40.2703040Z > 
2026-07-29T04:43:40.2703140Z > # CRAN guard
2026-07-29T04:43:40.2703190Z > #
2026-07-29T04:43:40.2703490Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T04:43:40.2703820Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T04:43:40.2704170Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T04:43:40.2704430Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T04:43:40.2704720Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T04:43:40.2705010Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T04:43:40.2705170Z > # so the guard is obvious and self-contained.
2026-07-29T04:43:40.2705540Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T04:43:40.2705590Z > 
2026-07-29T04:43:40.2705760Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T04:43:40.2705840Z +   run <- TRUE
2026-07-29T04:43:40.2706040Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T04:43:40.2706130Z +   run <- FALSE
2026-07-29T04:43:40.2706200Z + } else {
2026-07-29T04:43:40.2706450Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T04:43:40.2706620Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T04:43:40.2706670Z + }
2026-07-29T04:43:40.2706730Z > 
2026-07-29T04:43:40.2706810Z > if (run) {
2026-07-29T04:43:40.2706940Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T04:43:40.2707020Z + } else {
2026-07-29T04:43:40.2707100Z +   message(
2026-07-29T04:43:40.2707170Z +     "\n",
2026-07-29T04:43:40.2707270Z +     strrep("=", 78),
2026-07-29T04:43:40.2707350Z +     "\n",
2026-07-29T04:43:40.2707490Z +     "Skipping the duckdb test suite.\n",
2026-07-29T04:43:40.2707580Z +     "\n",
2026-07-29T04:43:40.2707880Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T04:43:40.2708220Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T04:43:40.2708560Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T04:43:40.2708960Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T04:43:40.2709050Z +     "manner.\n",
2026-07-29T04:43:40.2709130Z +     "\n",
2026-07-29T04:43:40.2709660Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T04:43:40.2710070Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T04:43:40.2710170Z +     "\n",
2026-07-29T04:43:40.2710870Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-29T04:43:40.2711210Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-29T04:43:40.2711590Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-29T04:43:40.2711690Z +     strrep("=", 78),
2026-07-29T04:43:40.2711770Z +     "\n"
2026-07-29T04:43:40.2711820Z +   )
2026-07-29T04:43:40.2712080Z + }
