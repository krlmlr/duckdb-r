2026-07-29T04:43:40.1852700Z > library(testthat)
2026-07-29T04:43:40.1853340Z > library(duckdb)
2026-07-29T04:43:40.1853660Z Loading required package: DBI
2026-07-29T04:43:40.1854000Z > 
2026-07-29T04:43:40.1854300Z > # CRAN guard
2026-07-29T04:43:40.1854560Z > #
2026-07-29T04:43:40.1854960Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T04:43:40.1855890Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T04:43:40.1856460Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T04:43:40.1857000Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T04:43:40.1857560Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T04:43:40.1858130Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T04:43:40.1858580Z > # so the guard is obvious and self-contained.
2026-07-29T04:43:40.1859090Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T04:43:40.1859450Z > 
2026-07-29T04:43:40.1859740Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T04:43:40.1860060Z +   run <- TRUE
2026-07-29T04:43:40.1860430Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T04:43:40.1861060Z +   run <- FALSE
2026-07-29T04:43:40.1861270Z + } else {
2026-07-29T04:43:40.1861610Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T04:43:40.1862040Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T04:43:40.1862380Z + }
2026-07-29T04:43:40.1862540Z > 
2026-07-29T04:43:40.1862750Z > if (run) {
2026-07-29T04:43:40.1862990Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T04:43:40.1863290Z + } else {
2026-07-29T04:43:40.1863570Z +   message(
2026-07-29T04:43:40.1863870Z +     "\n",
2026-07-29T04:43:40.1864070Z +     strrep("=", 78),
2026-07-29T04:43:40.1864270Z +     "\n",
2026-07-29T04:43:40.1864490Z +     "Skipping the duckdb test suite.\n",
2026-07-29T04:43:40.1864790Z +     "\n",
2026-07-29T04:43:40.1865240Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T04:43:40.1865810Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T04:43:40.1866350Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
