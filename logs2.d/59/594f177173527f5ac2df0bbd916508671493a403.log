2026-07-28T21:41:54.0378535Z > library(testthat)
2026-07-28T21:41:54.0378887Z > library(duckdb)
2026-07-28T21:41:54.0380170Z Loading required package: DBI
2026-07-28T21:41:54.0381036Z > 
2026-07-28T21:41:54.0381863Z > # CRAN guard
2026-07-28T21:41:54.0382118Z > #
2026-07-28T21:41:54.0382733Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T21:41:54.0383772Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T21:41:54.0384714Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T21:41:54.0385867Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T21:41:54.0386843Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T21:41:54.0387868Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T21:41:54.0388698Z > # so the guard is obvious and self-contained.
2026-07-28T21:41:54.0389411Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T21:41:54.0389972Z > 
2026-07-28T21:41:54.0390381Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T21:41:54.0390847Z +   run <- TRUE
2026-07-28T21:41:54.0391316Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T21:41:54.0391825Z +   run <- FALSE
2026-07-28T21:41:54.0392138Z + } else {
2026-07-28T21:41:54.0393094Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T21:41:54.0394641Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T21:41:54.0395092Z + }
2026-07-28T21:41:54.0395349Z > 
2026-07-28T21:41:54.0395632Z > if (run) {
2026-07-28T21:41:54.0396015Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T21:41:54.0396414Z + } else {
2026-07-28T21:41:54.0396689Z +   message(
2026-07-28T21:41:54.0396989Z +     "\n",
2026-07-28T21:41:54.0397614Z +     strrep("=", 78),
2026-07-28T21:41:54.0397929Z +     "\n",
2026-07-28T21:41:54.0398292Z +     "Skipping the duckdb test suite.\n",
2026-07-28T21:41:54.0398726Z +     "\n",
2026-07-28T21:41:54.0399350Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T21:41:54.0400298Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T21:41:54.0401217Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T21:41:54.0402166Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T21:41:54.0402845Z +     "manner.\n",
2026-07-28T21:41:54.0403147Z +     "\n",
2026-07-28T21:41:54.0403764Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T21:41:54.0404774Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
