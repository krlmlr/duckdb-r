2026-07-28T07:21:45.0694972Z > 
2026-07-28T07:21:45.0695179Z > library(testthat)
2026-07-28T07:21:45.0695417Z > library(duckdb.dev)
2026-07-28T07:21:45.0695681Z Loading required package: DBI
2026-07-28T07:21:45.0695911Z > 
2026-07-28T07:21:45.0696098Z > # CRAN guard
2026-07-28T07:21:45.0696285Z > #
2026-07-28T07:21:45.0696686Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:21:45.0697292Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:21:45.0697888Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:21:45.0698752Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:21:45.0699337Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:21:45.0700036Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:21:45.0700515Z > # so the guard is obvious and self-contained.
2026-07-28T07:21:45.0700982Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:21:45.0701324Z > 
2026-07-28T07:21:45.0701584Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:21:45.0701883Z +   run <- TRUE
2026-07-28T07:21:45.0702198Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:21:45.0702524Z +   run <- FALSE
2026-07-28T07:21:45.0702732Z + } else {
2026-07-28T07:21:45.0703097Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:21:45.0703546Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:21:45.0703820Z + }
2026-07-28T07:21:45.0703989Z > 
2026-07-28T07:21:45.0704173Z > if (run) {
2026-07-28T07:21:45.0704419Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:21:45.0704820Z + } else {
2026-07-28T07:21:45.0705021Z +   message(
2026-07-28T07:21:45.0705214Z +     "\n",
2026-07-28T07:21:45.0705425Z +     strrep("=", 78),
2026-07-28T07:21:45.0705643Z +     "\n",
2026-07-28T07:21:45.0705886Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:21:45.0706166Z +     "\n",
2026-07-28T07:21:45.0706567Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:21:45.0707166Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:21:45.0707738Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:21:45.0708619Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:21:45.0709045Z +     "manner.\n",
2026-07-28T07:21:45.0709256Z +     "\n",
2026-07-28T07:21:45.0709665Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:21:45.0710310Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:21:45.0710751Z +     "\n",
2026-07-28T07:21:45.0711177Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:21:45.0711859Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:21:45.0712392Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:21:45.0712777Z +     strrep("=", 78),
2026-07-28T07:21:45.0712998Z +     "\n"
2026-07-28T07:21:45.0713171Z +   )
2026-07-28T07:21:45.0713339Z + }
