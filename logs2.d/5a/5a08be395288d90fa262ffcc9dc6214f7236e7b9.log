2026-07-28T07:19:51.7465366Z > 
2026-07-28T07:19:51.7465562Z > library(testthat)
2026-07-28T07:19:51.7465790Z > library(duckdb.dev)
2026-07-28T07:19:51.7466043Z Loading required package: DBI
2026-07-28T07:19:51.7466274Z > 
2026-07-28T07:19:51.7466463Z > # CRAN guard
2026-07-28T07:19:51.7466639Z > #
2026-07-28T07:19:51.7467029Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:19:51.7467623Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:19:51.7468800Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:19:51.7469393Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:19:51.7469965Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:19:51.7470565Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:19:51.7471038Z > # so the guard is obvious and self-contained.
2026-07-28T07:19:51.7471475Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:19:51.7471810Z > 
2026-07-28T07:19:51.7472069Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:19:51.7472380Z +   run <- TRUE
2026-07-28T07:19:51.7472685Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:19:51.7473004Z +   run <- FALSE
2026-07-28T07:19:51.7473201Z + } else {
2026-07-28T07:19:51.7473552Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:19:51.7473999Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:19:51.7474283Z + }
2026-07-28T07:19:51.7474444Z > 
2026-07-28T07:19:51.7474627Z > if (run) {
2026-07-28T07:19:51.7474877Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:19:51.7475142Z + } else {
2026-07-28T07:19:51.7475338Z +   message(
2026-07-28T07:19:51.7475528Z +     "\n",
2026-07-28T07:19:51.7475734Z +     strrep("=", 78),
2026-07-28T07:19:51.7475948Z +     "\n",
2026-07-28T07:19:51.7476185Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:19:51.7476453Z +     "\n",
2026-07-28T07:19:51.7476852Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:19:51.7477614Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:19:51.7478600Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:19:51.7479237Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:19:51.7479655Z +     "manner.\n",
2026-07-28T07:19:51.7479859Z +     "\n",
2026-07-28T07:19:51.7480255Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:19:51.7480891Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:19:51.7481314Z +     "\n",
2026-07-28T07:19:51.7481722Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:19:51.7482308Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:19:51.7482844Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:19:51.7483383Z +     strrep("=", 78),
2026-07-28T07:19:51.7483608Z +     "\n"
2026-07-28T07:19:51.7483780Z +   )
2026-07-28T07:19:51.7483943Z + }
