2026-07-28T07:08:59.6961431Z > library(testthat)
2026-07-28T07:08:59.6961680Z > library(duckdb.dev)
2026-07-28T07:08:59.6961950Z Loading required package: DBI
2026-07-28T07:08:59.6962193Z > 
2026-07-28T07:08:59.6962397Z > # CRAN guard
2026-07-28T07:08:59.6962595Z > #
2026-07-28T07:08:59.6963015Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:59.6963622Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:59.6964219Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:59.6964780Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:59.6965346Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:59.6966071Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:59.6966551Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:59.6967012Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:59.6967354Z > 
2026-07-28T07:08:59.6967641Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:59.6967943Z +   run <- TRUE
2026-07-28T07:08:59.6968258Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:59.6968616Z +   run <- FALSE
2026-07-28T07:08:59.6968835Z + } else {
2026-07-28T07:08:59.6969207Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:59.6969660Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:59.6969944Z + }
2026-07-28T07:08:59.6970346Z > 
2026-07-28T07:08:59.6970550Z > if (run) {
2026-07-28T07:08:59.6970823Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:59.6971114Z + } else {
2026-07-28T07:08:59.6971477Z +   message(
2026-07-28T07:08:59.6971683Z +     "\n",
2026-07-28T07:08:59.6971902Z +     strrep("=", 78),
2026-07-28T07:08:59.6972128Z +     "\n",
2026-07-28T07:08:59.6972381Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:59.6972668Z +     "\n",
2026-07-28T07:08:59.6973079Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:59.6973680Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:59.6974240Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:59.6974823Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:59.6975236Z +     "manner.\n",
2026-07-28T07:08:59.6975460Z +     "\n",
2026-07-28T07:08:59.6975858Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:59.6976501Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:59.6976925Z +     "\n",
2026-07-28T07:08:59.6977335Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:59.6977991Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:59.6978514Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:59.6978900Z +     strrep("=", 78),
2026-07-28T07:08:59.6979131Z +     "\n"
2026-07-28T07:08:59.6979315Z +   )
2026-07-28T07:08:59.6979499Z + }
