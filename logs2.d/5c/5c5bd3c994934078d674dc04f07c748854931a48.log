2026-07-28T07:07:00.2764848Z > library(testthat)
2026-07-28T07:07:00.2765211Z > library(duckdb.dev)
2026-07-28T07:07:00.2765608Z Loading required package: DBI
2026-07-28T07:07:00.2765976Z > 
2026-07-28T07:07:00.2766280Z > # CRAN guard
2026-07-28T07:07:00.2766567Z > #
2026-07-28T07:07:00.2767206Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:00.2768290Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:00.2769230Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:00.2770312Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:00.2771271Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:00.2772228Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:00.2772989Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:00.2773705Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:00.2774398Z > 
2026-07-28T07:07:00.2774822Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:00.2775311Z +   run <- TRUE
2026-07-28T07:07:00.2775793Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:00.2776298Z +   run <- FALSE
2026-07-28T07:07:00.2776619Z + } else {
2026-07-28T07:07:00.2777188Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:00.2777888Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:00.2778345Z + }
2026-07-28T07:07:00.2778594Z > 
2026-07-28T07:07:00.2778881Z > if (run) {
2026-07-28T07:07:00.2779265Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:00.2779679Z + } else {
2026-07-28T07:07:00.2780169Z +   message(
2026-07-28T07:07:00.2780473Z +     "\n",
2026-07-28T07:07:00.2780802Z +     strrep("=", 78),
2026-07-28T07:07:00.2781140Z +     "\n",
2026-07-28T07:07:00.2781534Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:00.2781963Z +     "\n",
2026-07-28T07:07:00.2782607Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:00.2783689Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:00.2784609Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:00.2785563Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:00.2786233Z +     "manner.\n",
2026-07-28T07:07:00.2786558Z +     "\n",
2026-07-28T07:07:00.2787203Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:00.2788252Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:00.2788913Z +     "\n",
2026-07-28T07:07:00.2789554Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:00.2790644Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:00.2791485Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
