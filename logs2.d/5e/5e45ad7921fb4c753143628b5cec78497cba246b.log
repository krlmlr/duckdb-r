2026-09-13T02:11:32.7569588Z [36;1m# Infer each compiler default for the active R version from R CMD config,[0m
2026-09-13T02:11:32.7569947Z [36;1m# then route it through ccache. Reading the resolved defaults preserves the[0m
2026-09-13T02:11:32.7570305Z [36;1m# standard flags R selects per version (e.g. -std=gnu2x for C, -std=gnu++17[0m
2026-09-13T02:11:32.7570647Z [36;1m# / -std=gnu++20 for C++); a plain "CC = ccache gcc" override would drop[0m
2026-09-13T02:11:32.7570983Z [36;1m# them and silently downgrade the standard across the version matrix.[0m
2026-09-13T02:11:32.7571331Z [36;1m# Inference uses an empty user Makevars so we always read the pristine[0m
2026-09-13T02:11:32.7571625Z [36;1m# Makeconf defaults, never a value we just wrote.[0m
2026-09-13T02:11:32.7571928Z [36;1m# Note: the versioned switches (CXX11..CXX23) intentionally come out as[0m
2026-09-13T02:11:32.7572254Z [36;1m# bare "g++" with no -std flag. R keeps the standard in a separate[0m
2026-09-13T02:11:32.7572577Z [36;1m# CXXnnSTD variable (CXX17STD = -std=gnu++17, ...) and applies it on top[0m
2026-09-13T02:11:32.7572913Z [36;1m# at compile time, so wrapping only CXXnn with ccache is correct and we[0m
2026-09-13T02:11:32.7573198Z [36;1m# must NOT pin -std here ourselves.[0m
2026-09-13T02:11:32.7573391Z [36;1m#[0m
2026-09-13T02:11:32.7573601Z [36;1m# On Unix, ccache is attached through a generated one-word wrapper[0m
2026-09-13T02:11:32.7573924Z [36;1m# command (ccache-gcc, ccache-g++, ...) rather than the more obvious[0m
2026-09-13T02:11:32.7574246Z [36;1m# "CC = ccache gcc" prefix. R-devel briefly could not cope with a[0m
2026-09-13T02:11:32.7574563Z [36;1m# compiler command of more than one word: tools:::ccE(), which backs the[0m
2026-09-13T02:11:32.7575201Z [36;1m# "checking use of non-API entry points" check and therefore runs for[0m
2026-09-13T02:11:32.7575550Z [36;1m# every package with compiled code, read R CMD config CC, kept only the[0m
2026-09-13T02:11:32.7575873Z [36;1m# first word, and ran that. With "CC = ccache gcc" that left a bare[0m
2026-09-13T02:11:32.7576237Z [36;1m# "ccache", and the check died with "ccache: invalid option -- 'E'".[0m
2026-09-13T02:11:32.7576605Z [36;1m# https://github.com/r-devel/r-svn/commit/ca19f35240517186ed447e773ee67b55e207cf27[0m
2026-09-13T02:11:32.7576961Z [36;1m# https://bugs.r-project.org/show_bug.cgi?id=19130[0m
2026-09-13T02:11:32.7577270Z [36;1m# Upstream has since dropped the truncation again, so the prefix works[0m
2026-09-13T02:11:32.7577605Z [36;1m# once more -- but it takes a while for that to reach the R-devel builds[0m
2026-09-13T02:11:32.7578083Z [36;1m# CI installs, so the wrapper is still doing real work here. It stays[0m
2026-09-13T02:11:32.7578395Z [36;1m# after that too: it costs nothing and is correct either way.[0m
2026-09-13T02:11:32.7578729Z [36;1m#[0m
2026-09-13T02:11:32.7578958Z [36;1m# Windows deliberately keeps the plain prefix, as a control group: it is[0m
2026-09-13T02:11:32.7579302Z [36;1m# where a repeat of that upstream change would show up, while the Unix[0m
2026-09-13T02:11:32.7579565Z [36;1m# jobs carry on regardless.[0m
2026-09-13T02:11:32.7579779Z [36;1mccache_bin="$(command -v ccache || true)"[0m
2026-09-13T02:11:32.7579998Z [36;1mif [ -z "$ccache_bin" ]; then[0m
2026-09-13T02:11:32.7580267Z [36;1m  echo "::warning::ccache is not on the PATH, compiling without it."[0m
2026-09-13T02:11:32.7580520Z [36;1melse[0m
2026-09-13T02:11:32.7580696Z [36;1m  wrapper_dir="$HOME/.R/ccache-wrappers"[0m
2026-09-13T02:11:32.7580921Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-09-13T02:11:32.7581142Z [36;1m    mkdir -p "$wrapper_dir"[0m
2026-09-13T02:11:32.7581323Z [36;1m  fi[0m
2026-09-13T02:11:32.7581466Z [36;1m[0m
2026-09-13T02:11:32.7581621Z [36;1m  empty_makevars="$(mktemp)"[0m
2026-09-13T02:11:32.7581860Z [36;1m  for var in CC CXX CXX11 CXX14 CXX17 CXX20 CXX23; do[0m
2026-09-13T02:11:32.7582186Z [36;1m    val="$(R_MAKEVARS_USER="$empty_makevars" R CMD config "$var" 2>/dev/null || true)"[0m
2026-09-13T02:11:32.7582482Z [36;1m    if [ -z "$val" ]; then[0m
2026-09-13T02:11:32.7582665Z [36;1m      continue[0m
2026-09-13T02:11:32.7582834Z [36;1m    fi[0m
2026-09-13T02:11:32.7583005Z [36;1m    if [ "$RUNNER_OS" = "Windows" ]; then[0m
2026-09-13T02:11:32.7583240Z [36;1m      echo "$var = ccache $val" >> ~/.R/Makevars[0m
2026-09-13T02:11:32.7583448Z [36;1m      continue[0m
2026-09-13T02:11:32.7583608Z [36;1m    fi[0m
2026-09-13T02:11:32.7583748Z [36;1m[0m
2026-09-13T02:11:32.7583957Z [36;1m    # Split "gcc -std=gnu2x" into the compiler and its flags: only the[0m
2026-09-13T02:11:32.7584280Z [36;1m    # compiler is wrapped, the flags are passed through unchanged.[0m
2026-09-13T02:11:32.7584602Z [36;1m    # ccache and the compiler are both found on the PATH at run time,[0m
2026-09-13T02:11:32.7585008Z [36;1m    # nothing is baked into the wrapper by path.[0m
2026-09-13T02:11:32.7585254Z [36;1m    prog="${val%%[[:space:]]*}"[0m
2026-09-13T02:11:32.7585466Z [36;1m    flags="${val#"$prog"}"[0m
2026-09-13T02:11:32.7585673Z [36;1m    wrapper="ccache-$(basename "$prog")"[0m
2026-09-13T02:11:32.7585879Z [36;1m[0m
2026-09-13T02:11:32.7586054Z [36;1m    if [ ! -f "$wrapper_dir/$wrapper" ]; then[0m
2026-09-13T02:11:32.7586359Z [36;1m      printf '#!/bin/sh\nexec ccache %s "$@"\n' "$prog" > "$wrapper_dir/$wrapper"[0m
2026-09-13T02:11:32.7586647Z [36;1m      chmod +x "$wrapper_dir/$wrapper"[0m
2026-09-13T02:11:32.7586902Z [36;1m      # Never hand R a wrapper that has not been shown to work.[0m
2026-09-13T02:11:32.7587199Z [36;1m      if ! "$wrapper_dir/$wrapper" --version > /dev/null; then[0m
2026-09-13T02:11:32.7587462Z [36;1m        rm -f "$wrapper_dir/$wrapper"[0m
2026-09-13T02:11:32.7587739Z [36;1m        echo "::warning::No usable $wrapper, compiling $var without ccache."[0m
2026-09-13T02:11:32.7588000Z [36;1m      fi[0m
2026-09-13T02:11:32.7588149Z [36;1m    fi[0m
2026-09-13T02:11:32.7588300Z [36;1m[0m
2026-09-13T02:11:32.7588465Z [36;1m    if [ -f "$wrapper_dir/$wrapper" ]; then[0m
2026-09-13T02:11:32.7588700Z [36;1m      echo "$var = $wrapper$flags" >> ~/.R/Makevars[0m
2026-09-13T02:11:32.7588910Z [36;1m    fi[0m
2026-09-13T02:11:32.7589063Z [36;1m  done[0m
