2026-09-13T02:14:37.3620252Z > # CRAN guard
2026-09-13T02:14:37.3620411Z > #
2026-09-13T02:14:37.3620698Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-13T02:14:37.3621119Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-13T02:14:37.3621514Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-13T02:14:37.3621902Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-13T02:14:37.3622308Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-13T02:14:37.3622714Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-13T02:14:37.3623057Z > # so the guard is obvious and self-contained.
2026-09-13T02:14:37.3623372Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-13T02:14:37.3623615Z > 
2026-09-13T02:14:37.3623827Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-13T02:14:37.3624048Z +   run <- TRUE
2026-09-13T02:14:37.3624292Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-13T02:14:37.3624528Z +   run <- FALSE
2026-09-13T02:14:37.3624689Z + } else {
2026-09-13T02:14:37.3625101Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-13T02:14:37.3625423Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-13T02:14:37.3625636Z + }
2026-09-13T02:14:37.3625777Z > 
