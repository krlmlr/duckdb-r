2026-07-28T07:07:22.8477790Z > library(testthat)
2026-07-28T07:07:22.8478022Z > library(duckdb.dev)
2026-07-28T07:07:22.8478285Z Loading required package: DBI
2026-07-28T07:07:22.8478517Z > 
2026-07-28T07:07:22.8478707Z > # CRAN guard
2026-07-28T07:07:22.8478892Z > #
2026-07-28T07:07:22.8479299Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:22.8479912Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:22.8480503Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:22.8481073Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:22.8481648Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:22.8482333Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:22.8482814Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:22.8483265Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:22.8483603Z > 
2026-07-28T07:07:22.8483865Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:22.8484165Z +   run <- TRUE
2026-07-28T07:07:22.8484473Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:22.8484801Z +   run <- FALSE
2026-07-28T07:07:22.8485004Z + } else {
2026-07-28T07:07:22.8485357Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:22.8485800Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:22.8486079Z + }
2026-07-28T07:07:22.8486244Z > 
2026-07-28T07:07:22.8486698Z > if (run) {
2026-07-28T07:07:22.8486967Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:22.8487244Z + } else {
2026-07-28T07:07:22.8487638Z +   message(
2026-07-28T07:07:22.8487840Z +     "\n",
2026-07-28T07:07:22.8488052Z +     strrep("=", 78),
2026-07-28T07:07:22.8488268Z +     "\n",
2026-07-28T07:07:22.8488522Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:22.8488803Z +     "\n",
2026-07-28T07:07:22.8489207Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:22.8489837Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:22.8490398Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:22.8490993Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:22.8491429Z +     "manner.\n",
2026-07-28T07:07:22.8491640Z +     "\n",
2026-07-28T07:07:22.8492035Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:22.8492670Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:22.8493097Z +     "\n",
2026-07-28T07:07:22.8493501Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:22.8494168Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:22.8505099Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:22.8505517Z +     strrep("=", 78),
2026-07-28T07:07:22.8505758Z +     "\n"
2026-07-28T07:07:22.8505939Z +   )
2026-07-28T07:07:22.8506109Z + }
