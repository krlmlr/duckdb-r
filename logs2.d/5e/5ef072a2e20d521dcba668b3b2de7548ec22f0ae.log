2026-07-28T07:05:32.8005350Z > # CRAN guard
2026-07-28T07:05:32.8005656Z > #
2026-07-28T07:05:32.8006356Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:05:32.8007983Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:05:32.8009029Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:05:32.8010053Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:05:32.8011075Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:05:32.8012147Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:05:32.8012997Z > # so the guard is obvious and self-contained.
2026-07-28T07:05:32.8013772Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:05:32.8014345Z > 
2026-07-28T07:05:32.8014806Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:05:32.8015338Z +   run <- TRUE
2026-07-28T07:05:32.8015874Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:05:32.8016652Z +   run <- FALSE
2026-07-28T07:05:32.8017032Z + } else {
2026-07-28T07:05:32.8017656Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:05:32.8018432Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:05:32.8018904Z + }
2026-07-28T07:05:32.8019184Z > 
2026-07-28T07:05:32.8019500Z > if (run) {
2026-07-28T07:05:32.8019928Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:05:32.8020393Z + } else {
2026-07-28T07:05:32.8020720Z +   message(
2026-07-28T07:05:32.8021057Z +     "\n",
2026-07-28T07:05:32.8021406Z +     strrep("=", 78),
2026-07-28T07:05:32.8021774Z +     "\n",
2026-07-28T07:05:32.8022199Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:05:32.8022660Z +     "\n",
2026-07-28T07:05:32.8023372Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:05:32.8024555Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:05:32.8025552Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:05:32.8026827Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:05:32.8027581Z +     "manner.\n",
2026-07-28T07:05:32.8027940Z +     "\n",
2026-07-28T07:05:32.8028640Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:05:32.8029763Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:05:32.8030490Z +     "\n",
2026-07-28T07:05:32.8031197Z +     "To run the test suite locally, set the environment variable before checking:\n",
