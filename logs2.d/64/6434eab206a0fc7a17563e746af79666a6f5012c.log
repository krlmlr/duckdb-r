2026-08-07T08:26:46.4549051Z > 
2026-08-07T08:26:46.4549131Z > # CRAN guard
2026-08-07T08:26:46.4549189Z > #
2026-08-07T08:26:46.4549427Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-07T08:26:46.4549702Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-07T08:26:46.4549928Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-07T08:26:46.4550139Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-07T08:26:46.4550354Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-07T08:26:46.4550583Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-07T08:26:46.4550718Z > # so the guard is obvious and self-contained.
2026-08-07T08:26:46.4550908Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-07T08:26:46.4550972Z > 
2026-08-07T08:26:46.4551107Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-07T08:26:46.4551191Z +   run <- TRUE
2026-08-07T08:26:46.4551349Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-07T08:26:46.4551429Z +   run <- FALSE
2026-08-07T08:26:46.4551507Z + } else {
2026-08-07T08:26:46.4551703Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-07T08:26:46.4551838Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-07T08:26:46.4551901Z + }
2026-08-07T08:26:46.4551962Z > 
2026-08-07T08:26:46.4552041Z > if (run) {
2026-08-07T08:26:46.4552153Z +   test_check(simulate_duckdb()$pkg)
2026-08-07T08:26:46.4552230Z + } else {
2026-08-07T08:26:46.4552309Z +   message(
2026-08-07T08:26:46.4552386Z +     "\n",
2026-08-07T08:26:46.4552476Z +     strrep("=", 78),
2026-08-07T08:26:46.4552547Z +     "\n",
2026-08-07T08:26:46.4552670Z +     "Skipping the duckdb test suite.\n",
2026-08-07T08:26:46.4552744Z +     "\n",
2026-08-07T08:26:46.4552983Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-07T08:26:46.4553194Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-07T08:26:46.4553400Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-07T08:26:46.4553637Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-07T08:26:46.4553720Z +     "manner.\n",
2026-08-07T08:26:46.4553796Z +     "\n",
2026-08-07T08:26:46.4554022Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-07T08:26:46.4554278Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-07T08:26:46.4554358Z +     "\n",
2026-08-07T08:26:46.4554596Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-07T08:26:46.4554803Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-07T08:26:46.4554994Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-07T08:26:46.4555083Z +     strrep("=", 78),
2026-08-07T08:26:46.4555158Z +     "\n"
2026-08-07T08:26:46.4555331Z +   )
2026-08-07T08:26:46.4555392Z + }
