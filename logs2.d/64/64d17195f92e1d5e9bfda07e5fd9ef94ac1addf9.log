2026-07-27T14:09:01.0028532Z +       var manualTheme = false;
2026-07-27T14:09:01.0028880Z +       function applyTheme(t) { document.documentElement.setAttribute("data-theme", t); }
2026-07-27T14:09:01.0029362Z +       function systemTheme() { return (themeMedia && themeMedia.matches) ? "dark" : "light"; }
2026-07-27T14:09:01.0029501Z +       applyTheme(systemTheme());
2026-07-27T14:09:01.0029703Z +       if (themeMedia && themeMedia.addEventListener) {
