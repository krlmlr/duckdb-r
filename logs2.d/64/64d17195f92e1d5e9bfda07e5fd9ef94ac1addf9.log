2026-07-27T14:09:01.0032308Z +           var sql = (PLAN.query && PLAN.query.sql) ? PLAN.query.sql : "";
2026-07-27T14:09:01.0032515Z +           var chip = document.getElementById("sql-chip");
2026-07-27T14:09:01.0032746Z +           if (!sql.trim()) { chip.style.display = "none"; return; }
