2026-07-27T14:09:01.0034441Z +       // ---------- phase timings (cascaded) ----------
2026-07-27T14:09:01.0034575Z +       function buildTimings() {
2026-07-27T14:09:01.0034775Z +           var btn = document.getElementById("timings-fab");
2026-07-27T14:09:01.0034999Z +           var panel = document.getElementById("timings-panel");
2026-07-27T14:09:01.0035303Z +           var timings = (PLAN.query && PLAN.query.timings) ? PLAN.query.timings : [];
2026-07-27T14:09:01.0035422Z +           var map = {};
2026-07-27T14:09:01.0035667Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:09:01.0036011Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:09:01.0036431Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:09:01.0036599Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:09:01.0036981Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:09:01.0037214Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:09:01.0037290Z +   
2026-07-27T14:09:01.0037652Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:09:01.0038195Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:09:01.0038460Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:09:01.0039276Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:09:01.0039793Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T14:09:01.0039903Z +           }) };
2026-07-27T14:09:01.0039982Z +   
2026-07-27T14:09:01.0040149Z +           function renderTNode(node, depth) {
2026-07-27T14:09:01.0040341Z +               var wrap = document.createElement("div");
2026-07-27T14:09:01.0040843Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:09:01.0041071Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:09:01.0041711Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:09:01.0042115Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:09:01.0042543Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:09:01.0042836Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:09:01.0042977Z +               wrap.appendChild(row);
2026-07-27T14:09:01.0043104Z +               if (hasKids) {
2026-07-27T14:09:01.0043406Z +                   var kids = document.createElement("div"); kids.className = "tm-kids";
2026-07-27T14:09:01.0043787Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T14:09:01.0043940Z +                   wrap.appendChild(kids);
2026-07-27T14:09:01.0044081Z +                   var open = depth === 0;
2026-07-27T14:09:01.0044512Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:09:01.0044682Z +                   row.classList.add("clickable");
2026-07-27T14:09:01.0044893Z +                   row.addEventListener("click", function () {
2026-07-27T14:09:01.0045571Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:09:01.0045684Z +                   });
2026-07-27T14:09:01.0045789Z +               }
2026-07-27T14:09:01.0045914Z +               return wrap;
2026-07-27T14:09:01.0046008Z +           }
2026-07-27T14:09:01.0046147Z +           panel.innerHTML = "";
2026-07-27T14:09:01.0046438Z +           var head = document.createElement("div"); head.className = "tm-head";
2026-07-27T14:09:01.0046935Z +           head.innerHTML = '<span class="t">Phase timings</span><span class="tm-close" id="tm-close">×</span>';
2026-07-27T14:09:01.0047088Z +           panel.appendChild(head);
2026-07-27T14:09:01.0047290Z +           panel.appendChild(renderTNode(planNode, 0));
