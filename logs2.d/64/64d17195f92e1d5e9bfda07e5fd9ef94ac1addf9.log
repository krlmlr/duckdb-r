2026-07-27T14:09:01.0026694Z +           scheduleEdges();
2026-07-27T14:09:01.0026781Z +       }
2026-07-27T14:09:01.0027095Z +       expandBtn.addEventListener("click", function () { setDetailsAll(true); });
