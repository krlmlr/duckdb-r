2026-08-13T02:03:15.3673923Z > # CRAN guard
2026-08-13T02:03:15.3674092Z > #
2026-08-13T02:03:15.3674423Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-13T02:03:15.3674986Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-13T02:03:15.3675458Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-13T02:03:15.3675903Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-13T02:03:15.3676342Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-13T02:03:15.3676805Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-13T02:03:15.3677176Z > # so the guard is obvious and self-contained.
2026-08-13T02:03:15.3677707Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-13T02:03:15.3677982Z > 
2026-08-13T02:03:15.3678216Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-13T02:03:15.3678545Z +   run <- TRUE
2026-08-13T02:03:15.3678801Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-13T02:03:15.3679068Z +   run <- FALSE
2026-08-13T02:03:15.3679241Z + } else {
2026-08-13T02:03:15.3679532Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-13T02:03:15.3679885Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-13T02:03:15.3680109Z + }
2026-08-13T02:03:15.3680254Z > 
2026-08-13T02:03:15.3680410Z > if (run) {
2026-08-13T02:03:15.3680623Z +   test_check(simulate_duckdb()$pkg)
2026-08-13T02:03:15.3680842Z + } else {
2026-08-13T02:03:15.3681005Z +   message(
