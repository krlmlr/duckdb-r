2026-07-29T07:19:26.5899463Z > # Learn more about the roles of various files in:
2026-07-29T07:19:26.5899931Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-29T07:19:26.5900459Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-29T07:19:26.5900798Z > 
2026-07-29T07:19:26.5901032Z > library(testthat)
2026-07-29T07:19:26.5901274Z > library(duckdb)
2026-07-29T07:19:26.5901537Z Loading required package: DBI
2026-07-29T07:19:26.5901785Z > 
2026-07-29T07:19:26.5902009Z > # CRAN guard
2026-07-29T07:19:26.5902226Z > #
2026-07-29T07:19:26.5902631Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T07:19:26.5903273Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T07:19:26.5903831Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T07:19:26.5904373Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T07:19:26.5904908Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T07:19:26.5905523Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T07:19:26.5905963Z > # so the guard is obvious and self-contained.
2026-07-29T07:19:26.5906383Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T07:19:26.5906696Z > 
2026-07-29T07:19:26.5906971Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T07:19:26.5907271Z +   run <- TRUE
2026-07-29T07:19:26.5907593Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T07:19:26.5907920Z +   run <- FALSE
2026-07-29T07:19:26.5908137Z + } else {
2026-07-29T07:19:26.5908769Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T07:19:26.5909218Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T07:19:26.5909507Z + }
2026-07-29T07:19:26.5909691Z > 
2026-07-29T07:19:26.5909886Z > if (run) {
2026-07-29T07:19:26.5910148Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T07:19:26.5910414Z + } else {
2026-07-29T07:19:26.5910624Z +   message(
2026-07-29T07:19:26.5910830Z +     "\n",
2026-07-29T07:19:26.5911059Z +     strrep("=", 78),
2026-07-29T07:19:26.5911287Z +     "\n",
2026-07-29T07:19:26.5911531Z +     "Skipping the duckdb test suite.\n",
2026-07-29T07:19:26.5911809Z +     "\n",
2026-07-29T07:19:26.5912191Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T07:19:26.5912733Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T07:19:26.5913258Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T07:19:26.5913816Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T07:19:26.5914204Z +     "manner.\n",
2026-07-29T07:19:26.5914420Z +     "\n",
2026-07-29T07:19:26.5914803Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T07:19:26.5915385Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T07:19:26.5915777Z +     "\n",
2026-07-29T07:19:26.5916168Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-29T07:19:26.5916754Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-29T07:19:26.5917254Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-29T07:19:26.5917633Z +     strrep("=", 78),
2026-07-29T07:19:26.5917872Z +     "\n"
2026-07-29T07:19:26.5918152Z +   )
2026-07-29T07:19:26.5918582Z + }
