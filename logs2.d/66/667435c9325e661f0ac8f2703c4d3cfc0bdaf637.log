2026-07-27T15:00:53.2000450Z [36;1m# Infer each compiler default for the active R version from R CMD config,[0m
2026-07-27T15:00:53.2001009Z [36;1m# then prepend ccache. Reading the resolved defaults preserves the[0m
2026-07-27T15:00:53.2001565Z [36;1m# standard flags R selects per version (e.g. -std=gnu2x for C, -std=gnu++17[0m
2026-07-27T15:00:53.2002137Z [36;1m# / -std=gnu++20 for C++); a plain "CC = ccache gcc" override would drop[0m
2026-07-27T15:00:53.2002660Z [36;1m# them and silently downgrade the standard across the version matrix.[0m
2026-07-27T15:00:53.2003211Z [36;1m# Inference uses an empty user Makevars so we always read the pristine[0m
2026-07-27T15:00:53.2003690Z [36;1m# Makeconf defaults, never a value we just wrote.[0m
2026-07-27T15:00:53.2004155Z [36;1m# Note: the versioned switches (CXX11..CXX23) intentionally come out as[0m
2026-07-27T15:00:53.2005118Z [36;1m# bare "g++" with no -std flag. R keeps the standard in a separate[0m
2026-07-27T15:00:53.2005756Z [36;1m# CXXnnSTD variable (CXX17STD = -std=gnu++17, ...) and applies it on top[0m
2026-07-27T15:00:53.2006299Z [36;1m# at compile time, so wrapping only CXXnn with ccache is correct and we[0m
2026-07-27T15:00:53.2006742Z [36;1m# must NOT pin -std here ourselves.[0m
2026-07-27T15:00:53.2007050Z [36;1mempty_makevars="$(mktemp)"[0m
2026-07-27T15:00:53.2007384Z [36;1mfor var in CC CXX CXX11 CXX14 CXX17 CXX20 CXX23; do[0m
2026-07-27T15:00:53.2007884Z [36;1m  val="$(R_MAKEVARS_USER="$empty_makevars" R CMD config "$var" 2>/dev/null || true)"[0m
2026-07-27T15:00:53.2008343Z [36;1m  if [ -n "$val" ]; then[0m
2026-07-27T15:00:53.2008640Z [36;1m    echo "$var = ccache $val" >> ~/.R/Makevars[0m
2026-07-27T15:00:53.2008956Z [36;1m  fi[0m
2026-07-27T15:00:53.2009150Z [36;1mdone[0m
2026-07-27T15:00:53.2009360Z [36;1mrm -f "$empty_makevars"[0m
2026-07-27T15:00:53.2009645Z [36;1mecho 'MAKEFLAGS = -j2' >> ~/.R/Makevars[0m
2026-07-27T15:00:53.2009966Z [36;1mecho "===== generated ~/.R/Makevars ====="[0m
2026-07-27T15:00:53.2010262Z [36;1mcat ~/.R/Makevars[0m
2026-07-27T15:00:53.2010518Z [36;1mecho "==================================="[0m
2026-07-27T15:00:53.2010786Z [36;1m[0m
