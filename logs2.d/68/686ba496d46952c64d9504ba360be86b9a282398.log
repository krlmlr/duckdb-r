2026-08-17T02:25:12.4109809Z > # CRAN guard
2026-08-17T02:25:12.4110121Z > #
2026-08-17T02:25:12.4110837Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-17T02:25:12.4112232Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-17T02:25:12.4113324Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-17T02:25:12.4114664Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-17T02:25:12.4115715Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-17T02:25:12.4116823Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-17T02:25:12.4117710Z > # so the guard is obvious and self-contained.
2026-08-17T02:25:12.4118523Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-17T02:25:12.4119145Z > 
2026-08-17T02:25:12.4119615Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-17T02:25:12.4120163Z +   run <- TRUE
2026-08-17T02:25:12.4120717Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-17T02:25:12.4121726Z +   run <- FALSE
2026-08-17T02:25:12.4122088Z + } else {
2026-08-17T02:25:12.4122736Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-17T02:25:12.4123790Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-17T02:25:12.4124325Z + }
2026-08-17T02:25:12.4124623Z > 
2026-08-17T02:25:12.4124957Z > if (run) {
