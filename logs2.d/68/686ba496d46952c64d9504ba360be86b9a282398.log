2026-08-17T02:25:12.3449514Z > # CRAN guard
2026-08-17T02:25:12.3449699Z > #
2026-08-17T02:25:12.3450281Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-17T02:25:12.3451758Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-17T02:25:12.3452892Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-17T02:25:12.3453592Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-17T02:25:12.3454190Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-17T02:25:12.3454796Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-17T02:25:12.3455287Z > # so the guard is obvious and self-contained.
2026-08-17T02:25:12.3455958Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-17T02:25:12.3456324Z > 
2026-08-17T02:25:12.3456605Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-17T02:25:12.3456919Z +   run <- TRUE
2026-08-17T02:25:12.3457250Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-17T02:25:12.3457593Z +   run <- FALSE
2026-08-17T02:25:12.3457819Z + } else {
2026-08-17T02:25:12.3458189Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-17T02:25:12.3458716Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-17T02:25:12.3459005Z + }
2026-08-17T02:25:12.3459173Z > 
2026-08-17T02:25:12.3459360Z > if (run) {
2026-08-17T02:25:12.3459609Z +   test_check(simulate_duckdb()$pkg)
2026-08-17T02:25:12.3459889Z + } else {
2026-08-17T02:25:12.3460084Z +   message(
2026-08-17T02:25:12.3460279Z +     "\n",
2026-08-17T02:25:12.3460503Z +     strrep("=", 78),
2026-08-17T02:25:12.3460731Z +     "\n",
2026-08-17T02:25:12.3461553Z +     "Skipping the duckdb test suite.\n",
2026-08-17T02:25:12.3462080Z +     "\n",
2026-08-17T02:25:12.3462830Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-17T02:25:12.3463916Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-17T02:25:12.3464947Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-17T02:25:12.3466042Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-17T02:25:12.3466814Z +     "manner.\n",
2026-08-17T02:25:12.3467186Z +     "\n",
2026-08-17T02:25:12.3467914Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-17T02:25:12.3469066Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-17T02:25:12.3469816Z +     "\n",
2026-08-17T02:25:12.3470544Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-17T02:25:12.3471873Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-17T02:25:12.3472836Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-17T02:25:12.3473506Z +     strrep("=", 78),
2026-08-17T02:25:12.3473929Z +     "\n"
2026-08-17T02:25:12.3474238Z +   )
2026-08-17T02:25:12.3474560Z + }
