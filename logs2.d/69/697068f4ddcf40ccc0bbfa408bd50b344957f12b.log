2026-07-27T16:17:23.5738273Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T16:17:23.5738396Z +               wrap.appendChild(row);
2026-07-27T16:17:23.5738470Z +               if (hasKids) {
