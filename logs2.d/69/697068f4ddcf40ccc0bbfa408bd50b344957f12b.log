2026-07-27T16:17:23.5734983Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T16:17:23.5735084Z +           function val(k) { return map[k] || 0; }
2026-07-27T16:17:23.5735280Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
