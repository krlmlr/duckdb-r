2026-07-27T16:17:23.5738997Z +                   var open = depth === 0;
2026-07-27T16:17:23.5739227Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T16:17:23.5739326Z +                   row.classList.add("clickable");
2026-07-27T16:17:23.5739435Z +                   row.addEventListener("click", function () {
