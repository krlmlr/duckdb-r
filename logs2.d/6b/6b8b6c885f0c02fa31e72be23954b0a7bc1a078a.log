2026-07-28T07:08:32.3086537Z > library(testthat)
2026-07-28T07:08:32.3086775Z > library(duckdb.dev)
2026-07-28T07:08:32.3087034Z Loading required package: DBI
2026-07-28T07:08:32.3087260Z > 
2026-07-28T07:08:32.3087445Z > # CRAN guard
2026-07-28T07:08:32.3087628Z > #
2026-07-28T07:08:32.3088033Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:32.3088645Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:32.3089255Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:32.3089851Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:32.3090436Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:32.3091132Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:32.3091617Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:32.3092079Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:32.3092419Z > 
2026-07-28T07:08:32.3092687Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:32.3092993Z +   run <- TRUE
2026-07-28T07:08:32.3093310Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:32.3093633Z +   run <- FALSE
2026-07-28T07:08:32.3093838Z + } else {
2026-07-28T07:08:32.3094207Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:32.3094655Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:32.3095153Z + }
2026-07-28T07:08:32.3095325Z > 
2026-07-28T07:08:32.3095515Z > if (run) {
2026-07-28T07:08:32.3095768Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:32.3096053Z + } else {
2026-07-28T07:08:32.3096373Z +   message(
2026-07-28T07:08:32.3096576Z +     "\n",
2026-07-28T07:08:32.3096785Z +     strrep("=", 78),
2026-07-28T07:08:32.3097005Z +     "\n",
2026-07-28T07:08:32.3097256Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:32.3097536Z +     "\n",
2026-07-28T07:08:32.3097954Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:32.3098558Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:32.3099133Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:32.3099740Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:32.3100158Z +     "manner.\n",
2026-07-28T07:08:32.3100367Z +     "\n",
2026-07-28T07:08:32.3100774Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:32.3101424Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:32.3101855Z +     "\n",
2026-07-28T07:08:32.3102262Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:32.3102912Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:32.3103440Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:32.3103818Z +     strrep("=", 78),
2026-07-28T07:08:32.3104035Z +     "\n"
2026-07-28T07:08:32.3104207Z +   )
2026-07-28T07:08:32.3104370Z + }
