2026-07-28T07:06:42.0987412Z > # CRAN guard
2026-07-28T07:06:42.0987718Z > #
2026-07-28T07:06:42.0988432Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:06:42.0989693Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:06:42.0990760Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:06:42.0991783Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:06:42.0992816Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:06:42.0993914Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:06:42.0994781Z > # so the guard is obvious and self-contained.
2026-07-28T07:06:42.0996008Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:06:42.0996609Z > 
2026-07-28T07:06:42.0997075Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:06:42.0997619Z +   run <- TRUE
2026-07-28T07:06:42.0998166Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:06:42.0998732Z +   run <- FALSE
2026-07-28T07:06:42.0999089Z + } else {
2026-07-28T07:06:42.0999730Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:06:42.1000529Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:06:42.1001017Z + }
2026-07-28T07:06:42.1001293Z > 
2026-07-28T07:06:42.1001611Z > if (run) {
2026-07-28T07:06:42.1002040Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:06:42.1002505Z + } else {
2026-07-28T07:06:42.1002843Z +   message(
2026-07-28T07:06:42.1003177Z +     "\n",
2026-07-28T07:06:42.1003534Z +     strrep("=", 78),
2026-07-28T07:06:42.1003903Z +     "\n",
2026-07-28T07:06:42.1004328Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:06:42.1005026Z +     "\n",
2026-07-28T07:06:42.1005804Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:06:42.1007074Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:06:42.1008120Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:06:42.1009233Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:06:42.1009993Z +     "manner.\n",
2026-07-28T07:06:42.1010353Z +     "\n",
2026-07-28T07:06:42.1011081Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:06:42.1012250Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:06:42.1013009Z +     "\n",
2026-07-28T07:06:42.1013752Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:06:42.1014996Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:06:42.1015998Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:06:42.1016885Z +     strrep("=", 78),
2026-07-28T07:06:42.1017285Z +     "\n"
2026-07-28T07:06:42.1017579Z +   )
2026-07-28T07:06:42.1017861Z + }
