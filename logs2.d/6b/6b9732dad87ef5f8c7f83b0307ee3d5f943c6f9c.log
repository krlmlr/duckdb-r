2026-07-27T06:08:39.0093734Z > # This file is part of the standard setup for testthat.
2026-07-27T06:08:39.0094040Z > # It is recommended that you do not modify it.
2026-07-27T06:08:39.0094275Z > #
2026-07-27T06:08:39.0094516Z > # Where should you do additional test configuration?
2026-07-27T06:08:39.0094829Z > # Learn more about the roles of various files in:
2026-07-27T06:08:39.0095210Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:08:39.0095658Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:08:39.0095907Z > 
2026-07-27T06:08:39.0096078Z > library(testthat)
2026-07-27T06:08:39.0096279Z > library(duckdb.dev)
2026-07-27T06:08:39.0096494Z Loading required package: DBI
2026-07-27T06:08:39.0096689Z > 
2026-07-27T06:08:39.0096861Z > # CRAN guard
2026-07-27T06:08:39.0097020Z > #
2026-07-27T06:08:39.0097345Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:08:39.0097828Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:08:39.0098290Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:08:39.0098728Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:08:39.0099172Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:08:39.0099633Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:08:39.0100018Z > # so the guard is obvious and self-contained.
2026-07-27T06:08:39.0100377Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:08:39.0100653Z > 
2026-07-27T06:08:39.0100884Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:08:39.0101296Z +   run <- TRUE
2026-07-27T06:08:39.0101622Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:08:39.0101892Z +   run <- FALSE
2026-07-27T06:08:39.0102072Z + } else {
2026-07-27T06:08:39.0102373Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:08:39.0102737Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:08:39.0102963Z + }
2026-07-27T06:08:39.0103111Z > 
2026-07-27T06:08:39.0103282Z > if (run) {
2026-07-27T06:08:39.0103493Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:08:39.0103716Z + } else {
2026-07-27T06:08:39.0103884Z +   message(
2026-07-27T06:08:39.0104062Z +     "\n",
2026-07-27T06:08:39.0104247Z +     strrep("=", 78),
2026-07-27T06:08:39.0104435Z +     "\n",
2026-07-27T06:08:39.0104650Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:08:39.0104879Z +     "\n",
2026-07-27T06:08:39.0105373Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:08:39.0105847Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:08:39.0106295Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:08:39.0106764Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:08:39.0107094Z +     "manner.\n",
2026-07-27T06:08:39.0107284Z +     "\n",
2026-07-27T06:08:39.0107609Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:08:39.0108103Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:08:39.0108468Z +     "\n",
2026-07-27T06:08:39.0108808Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:08:39.0109263Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:08:39.0109692Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:08:39.0110061Z +     strrep("=", 78),
2026-07-27T06:08:39.0110256Z +     "\n"
2026-07-27T06:08:39.0110412Z +   )
2026-07-27T06:08:39.0110574Z + }
