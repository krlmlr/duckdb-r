2026-07-27T06:07:06.8603192Z > # CRAN guard
2026-07-27T06:07:06.8603421Z > #
2026-07-27T06:07:06.8603938Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:07:06.8604693Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:07:06.8605426Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:07:06.8606133Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:07:06.8606840Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:07:06.8607594Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:07:06.8608210Z > # so the guard is obvious and self-contained.
2026-07-27T06:07:06.8608772Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:07:06.8609191Z > 
2026-07-27T06:07:06.8609525Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:07:06.8610004Z +   run <- TRUE
2026-07-27T06:07:06.8610559Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:07:06.8610970Z +   run <- FALSE
2026-07-27T06:07:06.8611360Z + } else {
2026-07-27T06:07:06.8611823Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:07:06.8612390Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:07:06.8612731Z + }
2026-07-27T06:07:06.8612933Z > 
2026-07-27T06:07:06.8613170Z > if (run) {
2026-07-27T06:07:06.8613483Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:07:06.8613817Z + } else {
2026-07-27T06:07:06.8614055Z +   message(
2026-07-27T06:07:06.8614299Z +     "\n",
2026-07-27T06:07:06.8614563Z +     strrep("=", 78),
2026-07-27T06:07:06.8614835Z +     "\n",
2026-07-27T06:07:06.8615156Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:07:06.8615497Z +     "\n",
2026-07-27T06:07:06.8616007Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:07:06.8616741Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:07:06.8617446Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:07:06.8618205Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:07:06.8618740Z +     "manner.\n",
2026-07-27T06:07:06.8619009Z +     "\n",
2026-07-27T06:07:06.8619518Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:07:06.8620313Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:07:06.8620832Z +     "\n",
2026-07-27T06:07:06.8621475Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:07:06.8622206Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:07:06.8622946Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:07:06.8623417Z +     strrep("=", 78),
2026-07-27T06:07:06.8623686Z +     "\n"
2026-07-27T06:07:06.8623905Z +   )
2026-07-27T06:07:06.8624134Z + }
