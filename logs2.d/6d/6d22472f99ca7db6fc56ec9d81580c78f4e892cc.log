2026-08-09T03:35:50.9252472Z > 
2026-08-09T03:35:50.9253084Z > library(testthat)
2026-08-09T03:35:50.9253492Z > library(duckdb)
2026-08-09T03:35:50.9253911Z Loading required package: DBI
2026-08-09T03:35:50.9254331Z > 
2026-08-09T03:35:50.9254690Z > # CRAN guard
2026-08-09T03:35:50.9255016Z > #
2026-08-09T03:35:50.9255686Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-09T03:35:50.9256674Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-09T03:35:50.9257645Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-09T03:35:50.9260280Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-09T03:35:50.9264350Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-09T03:35:50.9266112Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-09T03:35:50.9267607Z > # so the guard is obvious and self-contained.
2026-08-09T03:35:50.9268378Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-09T03:35:50.9269406Z > 
2026-08-09T03:35:50.9269907Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-09T03:35:50.9271098Z +   run <- TRUE
2026-08-09T03:35:50.9271761Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-09T03:35:50.9272282Z +   run <- FALSE
2026-08-09T03:35:50.9273570Z + } else {
2026-08-09T03:35:50.9274199Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-09T03:35:50.9275661Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-09T03:35:50.9276829Z + }
2026-08-09T03:35:50.9277326Z > 
2026-08-09T03:35:50.9277667Z > if (run) {
2026-08-09T03:35:50.9278120Z +   test_check(simulate_duckdb()$pkg)
2026-08-09T03:35:50.9279451Z + } else {
2026-08-09T03:35:50.9279796Z +   message(
2026-08-09T03:35:50.9280148Z +     "\n",
2026-08-09T03:35:50.9280514Z +     strrep("=", 78),
2026-08-09T03:35:50.9280907Z +     "\n",
2026-08-09T03:35:50.9281319Z +     "Skipping the duckdb test suite.\n",
2026-08-09T03:35:50.9282228Z +     "\n",
2026-08-09T03:35:50.9282985Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-09T03:35:50.9284003Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-09T03:35:50.9284957Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-09T03:35:50.9285988Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-09T03:35:50.9286710Z +     "manner.\n",
2026-08-09T03:35:50.9287150Z +     "\n",
2026-08-09T03:35:50.9288593Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-09T03:35:50.9289763Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-09T03:35:50.9290586Z +     "\n",
2026-08-09T03:35:50.9291292Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-09T03:35:50.9292520Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
