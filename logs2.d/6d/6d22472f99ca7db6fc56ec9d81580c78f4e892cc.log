2026-08-09T03:35:51.1474467Z > library(duckdb)
2026-08-09T03:35:51.1474672Z Loading required package: DBI
2026-08-09T03:35:51.1474770Z > 
2026-08-09T03:35:51.1474908Z > # CRAN guard
2026-08-09T03:35:51.1475001Z > #
2026-08-09T03:35:51.1475477Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-09T03:35:51.1475909Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-09T03:35:51.1476363Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-09T03:35:51.1476772Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-09T03:35:51.1478675Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-09T03:35:51.1479188Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-09T03:35:51.1479438Z > # so the guard is obvious and self-contained.
2026-08-09T03:35:51.1480304Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-09T03:35:51.1480410Z > 
2026-08-09T03:35:51.1481077Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-09T03:35:51.1481809Z +   run <- TRUE
2026-08-09T03:35:51.1482102Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-09T03:35:51.1482227Z +   run <- FALSE
2026-08-09T03:35:51.1482687Z + } else {
2026-08-09T03:35:51.1484691Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-09T03:35:51.1485039Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-09T03:35:51.1485137Z + }
2026-08-09T03:35:51.1485241Z > 
2026-08-09T03:35:51.1485368Z > if (run) {
2026-08-09T03:35:51.1485566Z +   test_check(simulate_duckdb()$pkg)
2026-08-09T03:35:51.1485692Z + } else {
2026-08-09T03:35:51.1486026Z +   message(
2026-08-09T03:35:51.1486188Z +     "\n",
2026-08-09T03:35:51.1486344Z +     strrep("=", 78),
2026-08-09T03:35:51.1486763Z +     "\n",
2026-08-09T03:35:51.1486992Z +     "Skipping the duckdb test suite.\n",
2026-08-09T03:35:51.1487120Z +     "\n",
2026-08-09T03:35:51.1489647Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-09T03:35:51.1490823Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-09T03:35:51.1491467Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-09T03:35:51.1491934Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-09T03:35:51.1492070Z +     "manner.\n",
2026-08-09T03:35:51.1492192Z +     "\n",
2026-08-09T03:35:51.1492627Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-09T03:35:51.1493127Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-09T03:35:51.1493486Z +     "\n",
2026-08-09T03:35:51.1493988Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-09T03:35:51.1494378Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-09T03:35:51.1494731Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-09T03:35:51.1494885Z +     strrep("=", 78),
2026-08-09T03:35:51.1495000Z +     "\n"
2026-08-09T03:35:51.1495091Z +   )
2026-08-09T03:35:51.1495181Z + }
