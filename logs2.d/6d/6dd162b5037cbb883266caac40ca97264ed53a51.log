2026-07-27T14:57:33.6806409Z +                   row.addEventListener("click", function () {
2026-07-27T14:57:33.6806981Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:57:33.6807103Z +                   });
2026-07-27T14:57:33.6807204Z +               }
2026-07-27T14:57:33.6807331Z +               return wrap;
2026-07-27T14:57:33.6807436Z +           }
2026-07-27T14:57:33.6807569Z +           panel.innerHTML = "";
2026-07-27T14:57:33.6807843Z +           var head = document.createElement("div"); head.className = "tm-head";
