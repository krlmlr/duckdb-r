2026-07-27T14:57:33.6797484Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:57:33.6797818Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:57:33.6798215Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:57:33.6798456Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:57:33.6798822Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:57:33.6799059Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:57:33.6799142Z +   
2026-07-27T14:57:33.6799480Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:57:33.6800006Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:57:33.6800274Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:57:33.6800847Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:57:33.6801160Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T14:57:33.6801259Z +           }) };
