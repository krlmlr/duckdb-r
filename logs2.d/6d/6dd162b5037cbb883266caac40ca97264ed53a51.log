2026-07-27T14:57:33.6802166Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:57:33.6802382Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:57:33.6803001Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:57:33.6803390Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:57:33.6803797Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:57:33.6804081Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:57:33.6804450Z +               wrap.appendChild(row);
2026-07-27T14:57:33.6804572Z +               if (hasKids) {
