2026-08-16T02:11:45.9643247Z > # CRAN guard
2026-08-16T02:11:45.9643449Z > #
2026-08-16T02:11:45.9643871Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-16T02:11:45.9644493Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-16T02:11:45.9645102Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-16T02:11:45.9645695Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-16T02:11:45.9646289Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-16T02:11:45.9647163Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-16T02:11:45.9647667Z > # so the guard is obvious and self-contained.
2026-08-16T02:11:45.9648129Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-16T02:11:45.9648482Z > 
2026-08-16T02:11:45.9648769Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-16T02:11:45.9649080Z +   run <- TRUE
2026-08-16T02:11:45.9649406Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-16T02:11:45.9649747Z +   run <- FALSE
2026-08-16T02:11:45.9649971Z + } else {
2026-08-16T02:11:45.9650491Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-16T02:11:45.9650967Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-16T02:11:45.9651266Z + }
2026-08-16T02:11:45.9651443Z > 
2026-08-16T02:11:45.9651637Z > if (run) {
2026-08-16T02:11:45.9651904Z +   test_check(simulate_duckdb()$pkg)
