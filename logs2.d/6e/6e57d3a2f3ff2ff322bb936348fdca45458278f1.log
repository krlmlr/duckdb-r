2026-08-16T02:11:45.8960481Z > # CRAN guard
2026-08-16T02:11:45.8960811Z > #
2026-08-16T02:11:45.8961721Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-16T02:11:45.8962834Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-16T02:11:45.8963879Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-16T02:11:45.8964969Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-16T02:11:45.8966006Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-16T02:11:45.8967897Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-16T02:11:45.8968752Z > # so the guard is obvious and self-contained.
2026-08-16T02:11:45.8969775Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-16T02:11:45.8970394Z > 
2026-08-16T02:11:45.8970876Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-16T02:11:45.8971412Z +   run <- TRUE
2026-08-16T02:11:45.8971968Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-16T02:11:45.8972544Z +   run <- FALSE
2026-08-16T02:11:45.8972910Z + } else {
2026-08-16T02:11:45.8973548Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-16T02:11:45.8974347Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-16T02:11:45.8974850Z + }
2026-08-16T02:11:45.8975146Z > 
2026-08-16T02:11:45.8975487Z > if (run) {
