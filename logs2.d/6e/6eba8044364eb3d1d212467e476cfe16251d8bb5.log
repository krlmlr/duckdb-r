2026-09-28T02:40:54.6561417Z > # CRAN guard
2026-09-28T02:40:54.6561618Z > #
2026-09-28T02:40:54.6562052Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-28T02:40:54.6562695Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-28T02:40:54.6563326Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-28T02:40:54.6563926Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-28T02:40:54.6564534Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-28T02:40:54.6565394Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-28T02:40:54.6565907Z > # so the guard is obvious and self-contained.
2026-09-28T02:40:54.6566388Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-28T02:40:54.6566748Z > 
2026-09-28T02:40:54.6567041Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-28T02:40:54.6567369Z +   run <- TRUE
2026-09-28T02:40:54.6567711Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
