2026-07-29T16:55:03.6547367Z > # CRAN guard
2026-07-29T16:55:03.6547691Z > #
2026-07-29T16:55:03.6548412Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T16:55:03.6549487Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T16:55:03.6550793Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T16:55:03.6551823Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T16:55:03.6552866Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T16:55:03.6554192Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T16:55:03.6555080Z > # so the guard is obvious and self-contained.
2026-07-29T16:55:03.6555891Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T16:55:03.6556494Z > 
2026-07-29T16:55:03.6556965Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T16:55:03.6557509Z +   run <- TRUE
2026-07-29T16:55:03.6558062Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T16:55:03.6558649Z +   run <- FALSE
2026-07-29T16:55:03.6559008Z + } else {
2026-07-29T16:55:03.6559644Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T16:55:03.6560662Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T16:55:03.6561162Z + }
2026-07-29T16:55:03.6561452Z > 
2026-07-29T16:55:03.6561788Z > if (run) {
2026-07-29T16:55:03.6562231Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T16:55:03.6562697Z + } else {
2026-07-29T16:55:03.6563026Z +   message(
2026-07-29T16:55:03.6563392Z +     "\n",
2026-07-29T16:55:03.6563770Z +     strrep("=", 78),
2026-07-29T16:55:03.6564153Z +     "\n",
2026-07-29T16:55:03.6564593Z +     "Skipping the duckdb test suite.\n",
2026-07-29T16:55:03.6565310Z +     "\n",
2026-07-29T16:55:03.6566050Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
