2026-07-29T16:55:03.6850946Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T16:55:03.6851533Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T16:55:03.6852127Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T16:55:03.6852736Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T16:55:03.6853225Z > # so the guard is obvious and self-contained.
2026-07-29T16:55:03.6853718Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
