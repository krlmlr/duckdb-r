2026-07-29T16:55:03.6854339Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T16:55:03.6854655Z +   run <- TRUE
2026-07-29T16:55:03.6854976Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
