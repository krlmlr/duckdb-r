2026-07-29T16:51:07.6304484Z [36;1m# Infer each compiler default for the active R version from R CMD config,[0m
2026-07-29T16:51:07.6305012Z [36;1m# then prepend ccache. Reading the resolved defaults preserves the[0m
2026-07-29T16:51:07.6305532Z [36;1m# standard flags R selects per version (e.g. -std=gnu2x for C, -std=gnu++17[0m
2026-07-29T16:51:07.6306062Z [36;1m# / -std=gnu++20 for C++); a plain "CC = ccache gcc" override would drop[0m
2026-07-29T16:51:07.6306567Z [36;1m# them and silently downgrade the standard across the version matrix.[0m
2026-07-29T16:51:07.6307066Z [36;1m# Inference uses an empty user Makevars so we always read the pristine[0m
2026-07-29T16:51:07.6307507Z [36;1m# Makeconf defaults, never a value we just wrote.[0m
2026-07-29T16:51:07.6307963Z [36;1m# Note: the versioned switches (CXX11..CXX23) intentionally come out as[0m
2026-07-29T16:51:07.6308452Z [36;1m# bare "g++" with no -std flag. R keeps the standard in a separate[0m
2026-07-29T16:51:07.6309112Z [36;1m# CXXnnSTD variable (CXX17STD = -std=gnu++17, ...) and applies it on top[0m
2026-07-29T16:51:07.6310219Z [36;1m# at compile time, so wrapping only CXXnn with ccache is correct and we[0m
2026-07-29T16:51:07.6310681Z [36;1m# must NOT pin -std here ourselves.[0m
2026-07-29T16:51:07.6310992Z [36;1mempty_makevars="$(mktemp)"[0m
2026-07-29T16:51:07.6311326Z [36;1mfor var in CC CXX CXX11 CXX14 CXX17 CXX20 CXX23; do[0m
2026-07-29T16:51:07.6311813Z [36;1m  val="$(R_MAKEVARS_USER="$empty_makevars" R CMD config "$var" 2>/dev/null || true)"[0m
2026-07-29T16:51:07.6312258Z [36;1m  if [ -n "$val" ]; then[0m
2026-07-29T16:51:07.6312552Z [36;1m    echo "$var = ccache $val" >> ~/.R/Makevars[0m
2026-07-29T16:51:07.6312847Z [36;1m  fi[0m
2026-07-29T16:51:07.6313042Z [36;1mdone[0m
2026-07-29T16:51:07.6313248Z [36;1mrm -f "$empty_makevars"[0m
2026-07-29T16:51:07.6313492Z [36;1m[0m
2026-07-29T16:51:07.6313797Z [36;1m# Compile on every core the runner has, not the two this used to pin.[0m
2026-07-29T16:51:07.6314318Z [36;1m# Standard GitHub-hosted Linux runners have been 4-vCPU since 2024, so[0m
2026-07-29T16:51:07.6314824Z [36;1m# -j2 left half the box idle through the phase that dominates a build:[0m
2026-07-29T16:51:07.6315304Z [36;1m# measured on a 4-core box, 8 vendored unity objects with ccache[0m
2026-07-29T16:51:07.6315765Z [36;1m# disabled take 70.8 s at -j2 and 43.1 s at -j4 -- 1.64x, at identical[0m
2026-07-29T16:51:07.6316245Z [36;1m# user time. Peak RSS per unity object is ~834 MB, so four in flight is[0m
2026-07-29T16:51:07.6316639Z [36;1m# ~3.3 GB of the runner's 16 GB.[0m
2026-07-29T16:51:07.6317019Z [36;1m# detectCores() can return NA on exotic platforms; fall back to the old[0m
2026-07-29T16:51:07.6317509Z [36;1m# value there. `--as-cran` sets _R_CHECK_LIMIT_CORES_, but that polices[0m
2026-07-29T16:51:07.6318007Z [36;1m# the *package's* runtime parallelism, not compilation, so this is safe.[0m
2026-07-29T16:51:07.6318660Z [36;1mncores="$(Rscript --vanilla -e 'n <- parallel::detectCores(); cat(if (is.na(n) || n < 1) 2L else as.integer(n))')"[0m
2026-07-29T16:51:07.6319238Z [36;1mecho "MAKEFLAGS = -j${ncores}" >> ~/.R/Makevars[0m
2026-07-29T16:51:07.6319591Z [36;1mecho "===== generated ~/.R/Makevars ====="[0m
2026-07-29T16:51:07.6320199Z [36;1mcat ~/.R/Makevars[0m
2026-07-29T16:51:07.6320465Z [36;1mecho "==================================="[0m
2026-07-29T16:51:07.6320738Z [36;1m[0m
2026-07-29T16:51:07.6321039Z [36;1mecho 'CCACHE_SLOPPINESS=locale,time_macros' | tee -a $GITHUB_ENV[0m
