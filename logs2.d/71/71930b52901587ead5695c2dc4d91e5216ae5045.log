2026-06-21T02:49:40.5258157Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-06-21T02:49:40.5258783Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-06-21T02:49:40.5259373Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-06-21T02:49:40.5259943Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-06-21T02:49:40.5260514Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-06-21T02:49:40.5261104Z > # This check is intentionally inlined here (rather than calling into the package)
2026-06-21T02:49:40.5261583Z > # so the guard is obvious and self-contained.
2026-06-21T02:49:40.5262026Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-06-21T02:49:40.5262562Z > 
2026-06-21T02:49:40.5262832Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-06-21T02:49:40.5263126Z +   run <- TRUE
2026-06-21T02:49:40.5263444Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-06-21T02:49:40.5263774Z +   run <- FALSE
2026-06-21T02:49:40.5263980Z + } else {
2026-06-21T02:49:40.5264342Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-06-21T02:49:40.5264786Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-06-21T02:49:40.5265059Z + }
2026-06-21T02:49:40.5265221Z > 
2026-06-21T02:49:40.5265534Z > if (run) {
2026-06-21T02:49:40.5265783Z +   test_check(simulate_duckdb()$pkg)
2026-06-21T02:49:40.5266322Z + } else {
2026-06-21T02:49:40.5266523Z +   message(
2026-06-21T02:49:40.5266715Z +     "\n",
2026-06-21T02:49:40.5266929Z +     strrep("=", 78),
2026-06-21T02:49:40.5267144Z +     "\n",
2026-06-21T02:49:40.5267385Z +     "Skipping the duckdb test suite.\n",
2026-06-21T02:49:40.5267662Z +     "\n",
2026-06-21T02:49:40.5268064Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-06-21T02:49:40.5268656Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-06-21T02:49:40.5269215Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-06-21T02:49:40.5269801Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-06-21T02:49:40.5270213Z +     "manner.\n",
2026-06-21T02:49:40.5270424Z +     "\n",
2026-06-21T02:49:40.5270820Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-06-21T02:49:40.5271448Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-06-21T02:49:40.5271869Z +     "\n",
2026-06-21T02:49:40.5272270Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-06-21T02:49:40.5272846Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-06-21T02:49:40.5273369Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-06-21T02:49:40.5273735Z +     strrep("=", 78),
2026-06-21T02:49:40.5273948Z +     "\n"
2026-06-21T02:49:40.5274122Z +   )
2026-06-21T02:49:40.5274286Z + }
