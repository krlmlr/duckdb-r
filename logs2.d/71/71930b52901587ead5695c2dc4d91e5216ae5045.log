2026-06-21T02:49:40.5784876Z > # CRAN guard
2026-06-21T02:49:40.5785054Z > #
2026-06-21T02:49:40.5785453Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-06-21T02:49:40.5786319Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-06-21T02:49:40.5787064Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-06-21T02:49:40.5787643Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-06-21T02:49:40.5788218Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-06-21T02:49:40.5788808Z > # This check is intentionally inlined here (rather than calling into the package)
2026-06-21T02:49:40.5789290Z > # so the guard is obvious and self-contained.
2026-06-21T02:49:40.5789728Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-06-21T02:49:40.5790059Z > 
2026-06-21T02:49:40.5790319Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-06-21T02:49:40.5790624Z +   run <- TRUE
2026-06-21T02:49:40.5790934Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-06-21T02:49:40.5791256Z +   run <- FALSE
2026-06-21T02:49:40.5791456Z + } else {
2026-06-21T02:49:40.5791810Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-06-21T02:49:40.5792267Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-06-21T02:49:40.5792540Z + }
2026-06-21T02:49:40.5792701Z > 
2026-06-21T02:49:40.5792881Z > if (run) {
2026-06-21T02:49:40.5793124Z +   test_check(simulate_duckdb()$pkg)
2026-06-21T02:49:40.5793397Z + } else {
2026-06-21T02:49:40.5793582Z +   message(
2026-06-21T02:49:40.5793775Z +     "\n",
2026-06-21T02:49:40.5793985Z +     strrep("=", 78),
2026-06-21T02:49:40.5794199Z +     "\n",
2026-06-21T02:49:40.5794442Z +     "Skipping the duckdb test suite.\n",
2026-06-21T02:49:40.5794714Z +     "\n",
2026-06-21T02:49:40.5795116Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-06-21T02:49:40.5795706Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-06-21T02:49:40.5796525Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-06-21T02:49:40.5797127Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-06-21T02:49:40.5797546Z +     "manner.\n",
2026-06-21T02:49:40.5797754Z +     "\n",
2026-06-21T02:49:40.5798146Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-06-21T02:49:40.5798788Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-06-21T02:49:40.5799205Z +     "\n",
2026-06-21T02:49:40.5799612Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-06-21T02:49:40.5800181Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-06-21T02:49:40.5800703Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
