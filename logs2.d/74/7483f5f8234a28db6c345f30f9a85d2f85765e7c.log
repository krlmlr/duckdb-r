2026-08-07T14:05:02.2785354Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-07T14:05:02.2785814Z +   run <- FALSE
2026-08-07T14:05:02.2786116Z + } else {
2026-08-07T14:05:02.2786662Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-07T14:05:02.2787423Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-07T14:05:02.2788133Z + }
