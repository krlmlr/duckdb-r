2026-09-12T11:24:13.6666339Z > # This file is part of the standard setup for testthat.
2026-09-12T11:24:13.6666849Z > # It is recommended that you do not modify it.
2026-09-12T11:24:13.6667320Z > #
2026-09-12T11:24:13.6667706Z > # Where should you do additional test configuration?
2026-09-12T11:24:13.6668201Z > # Learn more about the roles of various files in:
2026-09-12T11:24:13.6668836Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-09-12T11:24:13.6669507Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-09-12T11:24:13.6669914Z > 
2026-09-12T11:24:13.6670180Z > library(testthat)
2026-09-12T11:24:13.6670379Z > library(duckdb)
2026-09-12T11:24:13.6670603Z Loading required package: DBI
2026-09-12T11:24:13.6670932Z > 
2026-09-12T11:24:13.6671103Z > # CRAN guard
2026-09-12T11:24:13.6671277Z > #
2026-09-12T11:24:13.6671610Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-12T11:24:13.6672096Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-12T11:24:13.6673076Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-12T11:24:13.6673816Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-12T11:24:13.6674568Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-12T11:24:13.6675341Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-12T11:24:13.6676170Z > # so the guard is obvious and self-contained.
2026-09-12T11:24:13.6676660Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-12T11:24:13.6676955Z > 
2026-09-12T11:24:13.6677328Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-12T11:24:13.6677613Z +   run <- TRUE
2026-09-12T11:24:13.6677882Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-12T11:24:13.6678152Z +   run <- FALSE
2026-09-12T11:24:13.6678332Z + } else {
2026-09-12T11:24:13.6678629Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-12T11:24:13.6679087Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-12T11:24:13.6679324Z + }
2026-09-12T11:24:13.6679473Z > 
2026-09-12T11:24:13.6679635Z > if (run) {
2026-09-12T11:24:13.6679853Z +   test_check(simulate_duckdb()$pkg)
2026-09-12T11:24:13.6680074Z + } else {
2026-09-12T11:24:13.6680237Z +   message(
2026-09-12T11:24:13.6680407Z +     "\n",
2026-09-12T11:24:13.6680588Z +     strrep("=", 78),
2026-09-12T11:24:13.6680787Z +     "\n",
2026-09-12T11:24:13.6681000Z +     "Skipping the duckdb test suite.\n",
2026-09-12T11:24:13.6681229Z +     "\n",
2026-09-12T11:24:13.6681563Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-12T11:24:13.6682111Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-12T11:24:13.6682560Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-12T11:24:13.6683037Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-12T11:24:13.6683367Z +     "manner.\n",
2026-09-12T11:24:13.6683548Z +     "\n",
2026-09-12T11:24:13.6683867Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-12T11:24:13.6684361Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-12T11:24:13.6684703Z +     "\n",
2026-09-12T11:24:13.6685029Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-12T11:24:13.6685493Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-12T11:24:13.6685912Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-12T11:24:13.6686213Z +     strrep("=", 78),
2026-09-12T11:24:13.6686410Z +     "\n"
2026-09-12T11:24:13.6686562Z +   )
2026-09-12T11:24:13.6686719Z + }
