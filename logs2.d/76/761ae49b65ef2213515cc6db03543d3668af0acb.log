2026-09-27T17:46:50.8051770Z > # It is recommended that you do not modify it.
2026-09-27T17:46:50.8052133Z > #
2026-09-27T17:46:50.8052520Z > # Where should you do additional test configuration?
2026-09-27T17:46:50.8052998Z > # Learn more about the roles of various files in:
2026-09-27T17:46:50.8053537Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-09-27T17:46:50.8054130Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-09-27T17:46:50.8054452Z > 
2026-09-27T17:46:50.8054656Z > library(testthat)
2026-09-27T17:46:50.8054873Z > library(duckdb)
2026-09-27T17:46:50.8055109Z Loading required package: DBI
2026-09-27T17:46:50.8055343Z > 
2026-09-27T17:46:50.8055529Z > # CRAN guard
2026-09-27T17:46:50.8055727Z > #
2026-09-27T17:46:50.8056111Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-27T17:46:50.8056707Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-27T17:46:50.8057255Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-27T17:46:50.8057793Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-27T17:46:50.8058583Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-27T17:46:50.8059386Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-27T17:46:50.8059861Z > # so the guard is obvious and self-contained.
2026-09-27T17:46:50.8060295Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-27T17:46:50.8060632Z > 
2026-09-27T17:46:50.8060892Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-27T17:46:50.8061192Z +   run <- TRUE
2026-09-27T17:46:50.8061494Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-27T17:46:50.8061817Z +   run <- FALSE
2026-09-27T17:46:50.8062211Z + } else {
2026-09-27T17:46:50.8062568Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-27T17:46:50.8062992Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-27T17:46:50.8063270Z + }
2026-09-27T17:46:50.8063440Z > 
2026-09-27T17:46:50.8063645Z > if (run) {
2026-09-27T17:46:50.8064047Z +   test_check(simulate_duckdb()$pkg)
2026-09-27T17:46:50.8064323Z + } else {
2026-09-27T17:46:50.8064514Z +   message(
2026-09-27T17:46:50.8064707Z +     "\n",
2026-09-27T17:46:50.8064910Z +     strrep("=", 78),
2026-09-27T17:46:50.8065126Z +     "\n",
2026-09-27T17:46:50.8065366Z +     "Skipping the duckdb test suite.\n",
2026-09-27T17:46:50.8065635Z +     "\n",
2026-09-27T17:46:50.8066211Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-27T17:46:50.8066785Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-27T17:46:50.8067425Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-27T17:46:50.8067990Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-27T17:46:50.8068447Z +     "manner.\n",
2026-09-27T17:46:50.8068702Z +     "\n",
2026-09-27T17:46:50.8069116Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-27T17:46:50.8069715Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-27T17:46:50.8070120Z +     "\n",
2026-09-27T17:46:50.8070502Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-27T17:46:50.8071123Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-27T17:46:50.8071631Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-27T17:46:50.8071991Z +     strrep("=", 78),
2026-09-27T17:46:50.8072212Z +     "\n"
2026-09-27T17:46:50.8072390Z +   )
2026-09-27T17:46:50.8072569Z + }
