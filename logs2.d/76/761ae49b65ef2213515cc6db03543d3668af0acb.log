2026-09-27T17:46:50.9987400Z > 
2026-09-27T17:46:50.9987556Z > # CRAN guard
2026-09-27T17:46:50.9987677Z > #
2026-09-27T17:46:50.9988535Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-27T17:46:50.9990395Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-27T17:46:50.9990946Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-27T17:46:50.9991371Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-27T17:46:50.9991836Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-27T17:46:50.9992521Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-27T17:46:50.9992783Z > # so the guard is obvious and self-contained.
2026-09-27T17:46:50.9993156Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-27T17:46:50.9993279Z > 
2026-09-27T17:46:50.9994543Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-27T17:46:50.9994749Z +   run <- TRUE
2026-09-27T17:46:50.9995091Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-27T17:46:50.9995242Z +   run <- FALSE
2026-09-27T17:46:50.9995375Z + } else {
2026-09-27T17:46:50.9995809Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-27T17:46:50.9996072Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-27T17:46:50.9996185Z + }
2026-09-27T17:46:50.9996299Z > 
2026-09-27T17:46:50.9996433Z > if (run) {
2026-09-27T17:46:50.9996641Z +   test_check(simulate_duckdb()$pkg)
2026-09-27T17:46:50.9996789Z + } else {
2026-09-27T17:46:50.9996926Z +   message(
2026-09-27T17:46:50.9997066Z +     "\n",
2026-09-27T17:46:50.9997235Z +     strrep("=", 78),
2026-09-27T17:46:50.9997366Z +     "\n",
2026-09-27T17:46:50.9997575Z +     "Skipping the duckdb test suite.\n",
2026-09-27T17:46:50.9997714Z +     "\n",
2026-09-27T17:46:50.9998175Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-27T17:46:50.9998570Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-27T17:46:50.9998945Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-27T17:46:50.9999652Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-27T17:46:51.0000908Z +     "manner.\n",
2026-09-27T17:46:51.0001082Z +     "\n",
2026-09-27T17:46:51.0001551Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-27T17:46:51.0002080Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-27T17:46:51.0002211Z +     "\n",
2026-09-27T17:46:51.0002684Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-27T17:46:51.0003037Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-27T17:46:51.0003661Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-27T17:46:51.0004736Z +     strrep("=", 78),
2026-09-27T17:46:51.0004898Z +     "\n"
2026-09-27T17:46:51.0005021Z +   )
2026-09-27T17:46:51.0005447Z + }
