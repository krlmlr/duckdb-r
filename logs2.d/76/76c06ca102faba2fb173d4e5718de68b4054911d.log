2026-07-28T07:04:54.0887040Z Loading required package: DBI
2026-07-28T07:04:54.0887252Z > 
2026-07-28T07:04:54.0887431Z > # CRAN guard
2026-07-28T07:04:54.0887611Z > #
2026-07-28T07:04:54.0887951Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:04:54.0888465Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:04:54.0888946Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:04:54.0889425Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:04:54.0889903Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:04:54.0890393Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:04:54.0890797Z > # so the guard is obvious and self-contained.
2026-07-28T07:04:54.0891173Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:04:54.0891457Z > 
2026-07-28T07:04:54.0891688Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:04:54.0891944Z +   run <- TRUE
2026-07-28T07:04:54.0892210Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:04:54.0892482Z +   run <- FALSE
2026-07-28T07:04:54.0892675Z + } else {
2026-07-28T07:04:54.0892975Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:04:54.0893345Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:04:54.0893586Z + }
2026-07-28T07:04:54.0893741Z > 
2026-07-28T07:04:54.0893908Z > if (run) {
2026-07-28T07:04:54.0894126Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:04:54.0894437Z + } else {
2026-07-28T07:04:54.0894617Z +   message(
2026-07-28T07:04:54.0894798Z +     "\n",
2026-07-28T07:04:54.0894991Z +     strrep("=", 78),
2026-07-28T07:04:54.0895192Z +     "\n",
2026-07-28T07:04:54.0895411Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:04:54.0895803Z +     "\n",
2026-07-28T07:04:54.0896159Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:04:54.0896648Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:04:54.0897127Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:04:54.0897627Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:04:54.0897992Z +     "manner.\n",
2026-07-28T07:04:54.0898182Z +     "\n",
2026-07-28T07:04:54.0898530Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:04:54.0899061Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:04:54.0899454Z +     "\n",
2026-07-28T07:04:54.0899836Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:04:54.0900309Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:04:54.0900753Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:04:54.0901071Z +     strrep("=", 78),
2026-07-28T07:04:54.0901267Z +     "\n"
2026-07-28T07:04:54.0901429Z +   )
2026-07-28T07:04:54.0901585Z + }
