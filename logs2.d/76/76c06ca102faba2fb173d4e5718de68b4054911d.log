2026-07-28T07:03:05.4977459Z > # CRAN guard
2026-07-28T07:03:05.4977785Z > #
2026-07-28T07:03:05.4978391Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:03:05.4979221Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:03:05.4980033Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:03:05.4980813Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:03:05.4981598Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:03:05.4982431Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:03:05.4983084Z > # so the guard is obvious and self-contained.
2026-07-28T07:03:05.4983699Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:03:05.4984174Z > 
2026-07-28T07:03:05.4984551Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:03:05.4984990Z +   run <- TRUE
2026-07-28T07:03:05.4985431Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:03:05.4986066Z +   run <- FALSE
2026-07-28T07:03:05.4986367Z + } else {
2026-07-28T07:03:05.4986866Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:03:05.4987485Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:03:05.4987868Z + }
2026-07-28T07:03:05.4988102Z > 
2026-07-28T07:03:05.4988364Z > if (run) {
2026-07-28T07:03:05.4988714Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:03:05.4989084Z + } else {
2026-07-28T07:03:05.4989346Z +   message(
2026-07-28T07:03:05.4989625Z +     "\n",
2026-07-28T07:03:05.4989919Z +     strrep("=", 78),
2026-07-28T07:03:05.4990223Z +     "\n",
2026-07-28T07:03:05.4990560Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:03:05.4990946Z +     "\n",
2026-07-28T07:03:05.4991507Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:03:05.4992326Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:03:05.4993109Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:03:05.4993943Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:03:05.4994521Z +     "manner.\n",
2026-07-28T07:03:05.4994810Z +     "\n",
2026-07-28T07:03:05.4995351Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:03:05.4996373Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:03:05.4996959Z +     "\n",
2026-07-28T07:03:05.4997525Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:03:05.4998324Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:03:05.4999054Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:03:05.4999702Z +     strrep("=", 78),
2026-07-28T07:03:05.5000014Z +     "\n"
2026-07-28T07:03:05.5000262Z +   )
2026-07-28T07:03:05.5000503Z + }
