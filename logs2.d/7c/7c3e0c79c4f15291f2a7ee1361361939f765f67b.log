2026-07-27T06:13:40.7508753Z > library(testthat)
2026-07-27T06:13:40.7509154Z > library(duckdb.dev)
2026-07-27T06:13:40.7509601Z Loading required package: DBI
2026-07-27T06:13:40.7509995Z > 
2026-07-27T06:13:40.7510323Z > # CRAN guard
2026-07-27T06:13:40.7510643Z > #
2026-07-27T06:13:40.7511627Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:13:40.7512686Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:13:40.7513720Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:13:40.7514721Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:13:40.7515885Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:13:40.7516938Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:13:40.7517921Z > # so the guard is obvious and self-contained.
2026-07-27T06:13:40.7518696Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:13:40.7519281Z > 
2026-07-27T06:13:40.7519734Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:13:40.7520248Z +   run <- TRUE
2026-07-27T06:13:40.7521172Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:13:40.7521774Z +   run <- FALSE
2026-07-27T06:13:40.7522136Z + } else {
2026-07-27T06:13:40.7522757Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:13:40.7523531Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:13:40.7524017Z + }
2026-07-27T06:13:40.7524312Z > 
2026-07-27T06:13:40.7524637Z > if (run) {
2026-07-27T06:13:40.7525065Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:13:40.7525520Z + } else {
2026-07-27T06:13:40.7525860Z +   message(
2026-07-27T06:13:40.7526193Z +     "\n",
2026-07-27T06:13:40.7526548Z +     strrep("=", 78),
2026-07-27T06:13:40.7526924Z +     "\n",
2026-07-27T06:13:40.7527360Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:13:40.7527836Z +     "\n",
2026-07-27T06:13:40.7528546Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:13:40.7529574Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:13:40.7530567Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:13:40.7531813Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:13:40.7532551Z +     "manner.\n",
2026-07-27T06:13:40.7532911Z +     "\n",
2026-07-27T06:13:40.7533611Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:13:40.7534841Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:13:40.7535566Z +     "\n",
2026-07-27T06:13:40.7536279Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:13:40.7537286Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:13:40.7538307Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:13:40.7538949Z +     strrep("=", 78),
2026-07-27T06:13:40.7539326Z +     "\n"
2026-07-27T06:13:40.7539621Z +   )
2026-07-27T06:13:40.7539916Z + }
