2026-07-27T06:15:30.1223459Z > # This file is part of the standard setup for testthat.
2026-07-27T06:15:30.1223943Z > # It is recommended that you do not modify it.
2026-07-27T06:15:30.1224220Z > #
2026-07-27T06:15:30.1224500Z > # Where should you do additional test configuration?
2026-07-27T06:15:30.1224892Z > # Learn more about the roles of various files in:
2026-07-27T06:15:30.1225358Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:15:30.1225911Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:15:30.1226235Z > 
2026-07-27T06:15:30.1226442Z > library(testthat)
2026-07-27T06:15:30.1226677Z > library(duckdb.dev)
2026-07-27T06:15:30.1226934Z Loading required package: DBI
2026-07-27T06:15:30.1227173Z > 
2026-07-27T06:15:30.1227376Z > # CRAN guard
2026-07-27T06:15:30.1227566Z > #
2026-07-27T06:15:30.1227967Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:15:30.1228581Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:15:30.1229171Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:15:30.1229747Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:15:30.1230328Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:15:30.1231150Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:15:30.1231632Z > # so the guard is obvious and self-contained.
2026-07-27T06:15:30.1232081Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:15:30.1232423Z > 
2026-07-27T06:15:30.1232684Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:15:30.1232997Z +   run <- TRUE
2026-07-27T06:15:30.1233303Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:15:30.1233631Z +   run <- FALSE
2026-07-27T06:15:30.1233832Z + } else {
2026-07-27T06:15:30.1234191Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:15:30.1234637Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:15:30.1234915Z + }
2026-07-27T06:15:30.1235087Z > 
2026-07-27T06:15:30.1235270Z > if (run) {
2026-07-27T06:15:30.1235513Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:15:30.1235779Z + } else {
2026-07-27T06:15:30.1235973Z +   message(
2026-07-27T06:15:30.1236167Z +     "\n",
2026-07-27T06:15:30.1236379Z +     strrep("=", 78),
2026-07-27T06:15:30.1236601Z +     "\n",
2026-07-27T06:15:30.1236842Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:15:30.1237119Z +     "\n",
2026-07-27T06:15:30.1237517Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:15:30.1238249Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:15:30.1238823Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:15:30.1239416Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:15:30.1239848Z +     "manner.\n",
2026-07-27T06:15:30.1240061Z +     "\n",
2026-07-27T06:15:30.1240456Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:15:30.1241327Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:15:30.1241756Z +     "\n",
2026-07-27T06:15:30.1242285Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:15:30.1242874Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:15:30.1243406Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:15:30.1243791Z +     strrep("=", 78),
2026-07-27T06:15:30.1244010Z +     "\n"
2026-07-27T06:15:30.1244196Z +   )
2026-07-27T06:15:30.1244370Z + }
