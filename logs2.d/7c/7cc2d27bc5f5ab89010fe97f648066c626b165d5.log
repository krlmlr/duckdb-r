2026-07-27T14:41:43.0806340Z +                   row.addEventListener("click", function () {
2026-07-27T14:41:43.0806927Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:41:43.0807035Z +                   });
2026-07-27T14:41:43.0807141Z +               }
2026-07-27T14:41:43.0807259Z +               return wrap;
2026-07-27T14:41:43.0807363Z +           }
2026-07-27T14:41:43.0807562Z +           panel.innerHTML = "";
