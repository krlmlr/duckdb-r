2026-07-27T14:41:43.0802220Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:41:43.0802441Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:41:43.0803071Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:41:43.0803469Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
