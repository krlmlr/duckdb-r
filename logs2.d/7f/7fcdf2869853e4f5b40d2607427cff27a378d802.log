2026-07-27T06:47:20.2874780Z > # This file is part of the standard setup for testthat.
2026-07-27T06:47:20.2875190Z > # It is recommended that you do not modify it.
2026-07-27T06:47:20.2875475Z > #
2026-07-27T06:47:20.2875775Z > # Where should you do additional test configuration?
2026-07-27T06:47:20.2876192Z > # Learn more about the roles of various files in:
2026-07-27T06:47:20.2876687Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:47:20.2877204Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:47:20.2877528Z > 
2026-07-27T06:47:20.2877734Z > library(testthat)
2026-07-27T06:47:20.2877972Z > library(duckdb.dev)
2026-07-27T06:47:20.2878231Z Loading required package: DBI
2026-07-27T06:47:20.2878460Z > 
2026-07-27T06:47:20.2878651Z > # CRAN guard
2026-07-27T06:47:20.2878830Z > #
2026-07-27T06:47:20.2879238Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:47:20.2880643Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:47:20.2881617Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:47:20.2882189Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:47:20.2882763Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:47:20.2883352Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:47:20.2883918Z > # so the guard is obvious and self-contained.
2026-07-27T06:47:20.2884377Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:47:20.2884713Z > 
2026-07-27T06:47:20.2884977Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:47:20.2885280Z +   run <- TRUE
2026-07-27T06:47:20.2885758Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:47:20.2886094Z +   run <- FALSE
2026-07-27T06:47:20.2886298Z + } else {
2026-07-27T06:47:20.2886658Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:47:20.2887103Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:47:20.2887378Z + }
2026-07-27T06:47:20.2887543Z > 
2026-07-27T06:47:20.2887730Z > if (run) {
2026-07-27T06:47:20.2887973Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:47:20.2888242Z + } else {
2026-07-27T06:47:20.2888437Z +   message(
2026-07-27T06:47:20.2888630Z +     "\n",
2026-07-27T06:47:20.2888841Z +     strrep("=", 78),
2026-07-27T06:47:20.2889059Z +     "\n",
2026-07-27T06:47:20.2889567Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:47:20.2889875Z +     "\n",
2026-07-27T06:47:20.2890304Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:47:20.2890903Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:47:20.2891577Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:47:20.2892184Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:47:20.2892601Z +     "manner.\n",
2026-07-27T06:47:20.2892807Z +     "\n",
2026-07-27T06:47:20.2893212Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:47:20.2893925Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:47:20.2894351Z +     "\n",
2026-07-27T06:47:20.2894759Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:47:20.2895341Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:47:20.2895870Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:47:20.2896251Z +     strrep("=", 78),
2026-07-27T06:47:20.2896467Z +     "\n"
2026-07-27T06:47:20.2896641Z +   )
2026-07-27T06:47:20.2896811Z + }
