2026-07-27T06:49:09.8437722Z > # This file is part of the standard setup for testthat.
2026-07-27T06:49:09.8438130Z > # It is recommended that you do not modify it.
2026-07-27T06:49:09.8438417Z > #
2026-07-27T06:49:09.8438704Z > # Where should you do additional test configuration?
2026-07-27T06:49:09.8439103Z > # Learn more about the roles of various files in:
2026-07-27T06:49:09.8439739Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:49:09.8440257Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:49:09.8440577Z > 
2026-07-27T06:49:09.8440786Z > library(testthat)
2026-07-27T06:49:09.8441019Z > library(duckdb.dev)
2026-07-27T06:49:09.8441287Z Loading required package: DBI
2026-07-27T06:49:09.8441518Z > 
2026-07-27T06:49:09.8441716Z > # CRAN guard
2026-07-27T06:49:09.8441899Z > #
2026-07-27T06:49:09.8442307Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:49:09.8442927Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:49:09.8443535Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:49:09.8444111Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:49:09.8444696Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:49:09.8445307Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:49:09.8445797Z > # so the guard is obvious and self-contained.
2026-07-27T06:49:09.8446255Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:49:09.8446607Z > 
2026-07-27T06:49:09.8446880Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:49:09.8447196Z +   run <- TRUE
2026-07-27T06:49:09.8447523Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:49:09.8447856Z +   run <- FALSE
2026-07-27T06:49:09.8448072Z + } else {
2026-07-27T06:49:09.8448441Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:49:09.8448908Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:49:09.8449192Z + }
2026-07-27T06:49:09.8449627Z > 
2026-07-27T06:49:09.8449842Z > if (run) {
2026-07-27T06:49:09.8450104Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:49:09.8450387Z + } else {
2026-07-27T06:49:09.8450585Z +   message(
2026-07-27T06:49:09.8450792Z +     "\n",
2026-07-27T06:49:09.8451005Z +     strrep("=", 78),
2026-07-27T06:49:09.8451223Z +     "\n",
2026-07-27T06:49:09.8451476Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:49:09.8451756Z +     "\n",
2026-07-27T06:49:09.8452307Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:49:09.8452924Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:49:09.8453500Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:49:09.8454109Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:49:09.8454611Z +     "manner.\n",
2026-07-27T06:49:09.8454826Z +     "\n",
2026-07-27T06:49:09.8455235Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:49:09.8455888Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:49:09.8456319Z +     "\n",
2026-07-27T06:49:09.8456729Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:49:09.8457313Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:49:09.8457919Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:49:09.8458302Z +     strrep("=", 78),
2026-07-27T06:49:09.8458523Z +     "\n"
2026-07-27T06:49:09.8458703Z +   )
2026-07-27T06:49:09.8458874Z + }
