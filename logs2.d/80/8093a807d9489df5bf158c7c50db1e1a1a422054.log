2026-09-12T14:56:26.9094056Z > # CRAN guard
2026-09-12T14:56:26.9094252Z > #
2026-09-12T14:56:26.9094667Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-12T14:56:26.9095282Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-12T14:56:26.9096024Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-12T14:56:26.9096626Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-12T14:56:26.9097209Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-12T14:56:26.9097824Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-12T14:56:26.9098310Z > # so the guard is obvious and self-contained.
2026-09-12T14:56:26.9098763Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-12T14:56:26.9099105Z > 
2026-09-12T14:56:26.9099386Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-12T14:56:26.9099695Z +   run <- TRUE
2026-09-12T14:56:26.9100015Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-12T14:56:26.9100346Z +   run <- FALSE
2026-09-12T14:56:26.9100555Z + } else {
2026-09-12T14:56:26.9100927Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-12T14:56:26.9101525Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-12T14:56:26.9101821Z + }
2026-09-12T14:56:26.9101991Z > 
2026-09-12T14:56:26.9102186Z > if (run) {
2026-09-12T14:56:26.9102438Z +   test_check(simulate_duckdb()$pkg)
2026-09-12T14:56:26.9103264Z + } else {
2026-09-12T14:56:26.9103668Z +   message(
2026-09-12T14:56:26.9104036Z +     "\n",
2026-09-12T14:56:26.9104404Z +     strrep("=", 78),
2026-09-12T14:56:26.9104777Z +     "\n",
2026-09-12T14:56:26.9105051Z +     "Skipping the duckdb test suite.\n",
2026-09-12T14:56:26.9105343Z +     "\n",
2026-09-12T14:56:26.9105763Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-12T14:56:26.9106379Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
