2026-08-16T08:21:57.2660935Z [36;1mncores="$(Rscript --vanilla -e 'n <- parallel::detectCores(); cat(if (is.na(n) || n < 1) 2L else as.integer(n))')"[0m
2026-08-16T08:21:57.2661474Z [36;1mecho "MAKEFLAGS = -j${ncores}" >> ~/.R/Makevars[0m
2026-08-16T08:21:57.2661790Z [36;1mecho "===== generated ~/.R/Makevars ====="[0m
2026-08-16T08:21:57.2662093Z [36;1mcat ~/.R/Makevars[0m
2026-08-16T08:21:57.2662312Z [36;1mecho "==================================="[0m
