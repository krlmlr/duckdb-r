2026-08-16T08:21:57.2650695Z [36;1m        echo "::warning::No usable $wrapper, compiling $var without ccache."[0m
2026-08-16T08:21:57.2651039Z [36;1m      fi[0m
2026-08-16T08:21:57.2651198Z [36;1m    fi[0m
2026-08-16T08:21:57.2651355Z [36;1m[0m
2026-08-16T08:21:57.2651544Z [36;1m    if [ -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-16T08:21:57.2652205Z [36;1m      echo "$var = $wrapper$flags" >> ~/.R/Makevars[0m
2026-08-16T08:21:57.2652482Z [36;1m    fi[0m
2026-08-16T08:21:57.2652638Z [36;1m  done[0m
2026-08-16T08:21:57.2652835Z [36;1m  rm -f "$empty_makevars"[0m
2026-08-16T08:21:57.2653047Z [36;1m[0m
2026-08-16T08:21:57.2653224Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-08-16T08:21:57.2653507Z [36;1m    echo "$wrapper_dir" >> "$GITHUB_PATH"[0m
2026-08-16T08:21:57.2653818Z [36;1m    echo "===== ccache wrappers in $wrapper_dir ====="[0m
