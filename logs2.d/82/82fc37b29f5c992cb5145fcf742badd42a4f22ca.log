2026-07-27T07:26:51.0355364Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T07:26:51.0356247Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T07:26:51.0356797Z > 
2026-07-27T07:26:51.0357159Z > library(testthat)
2026-07-27T07:26:51.0357566Z > library(duckdb.dev)
2026-07-27T07:26:51.0358169Z Loading required package: DBI
2026-07-27T07:26:51.0358580Z > 
2026-07-27T07:26:51.0358923Z > # CRAN guard
2026-07-27T07:26:51.0359253Z > #
2026-07-27T07:26:51.0360003Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T07:26:51.0361378Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T07:26:51.0362444Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T07:26:51.0363477Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T07:26:51.0364512Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T07:26:51.0365562Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T07:26:51.0366426Z > # so the guard is obvious and self-contained.
2026-07-27T07:26:51.0367251Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T07:26:51.0367934Z > 
2026-07-27T07:26:51.0368417Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T07:26:51.0368943Z +   run <- TRUE
2026-07-27T07:26:51.0369640Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T07:26:51.0370230Z +   run <- FALSE
2026-07-27T07:26:51.0370599Z + } else {
2026-07-27T07:26:51.0371270Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T07:26:51.0372058Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T07:26:51.0372585Z + }
2026-07-27T07:26:51.0372885Z > 
2026-07-27T07:26:51.0373202Z > if (run) {
2026-07-27T07:26:51.0373641Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T07:26:51.0374103Z + } else {
2026-07-27T07:26:51.0374441Z +   message(
2026-07-27T07:26:51.0374780Z +     "\n",
2026-07-27T07:26:51.0375146Z +     strrep("=", 78),
2026-07-27T07:26:51.0375545Z +     "\n",
2026-07-27T07:26:51.0375985Z +     "Skipping the duckdb test suite.\n",
2026-07-27T07:26:51.0376472Z +     "\n",
2026-07-27T07:26:51.0377223Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T07:26:51.0378478Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T07:26:51.0379502Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T07:26:51.0380578Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T07:26:51.0381310Z +     "manner.\n",
2026-07-27T07:26:51.0381670Z +     "\n",
2026-07-27T07:26:51.0382400Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T07:26:51.0383538Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T07:26:51.0384305Z +     "\n",
2026-07-27T07:26:51.0385052Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T07:26:51.0386087Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T07:26:51.0387021Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T07:26:51.0387671Z +     strrep("=", 78),
2026-07-27T07:26:51.0388278Z +     "\n"
2026-07-27T07:26:51.0388600Z +   )
2026-07-27T07:26:51.0388912Z + }
