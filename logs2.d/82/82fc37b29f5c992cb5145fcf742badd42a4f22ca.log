2026-07-27T07:28:44.9360568Z > # Where should you do additional test configuration?
2026-07-27T07:28:44.9360967Z > # Learn more about the roles of various files in:
2026-07-27T07:28:44.9361448Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T07:28:44.9361936Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T07:28:44.9362252Z > 
2026-07-27T07:28:44.9362458Z > library(testthat)
2026-07-27T07:28:44.9362703Z > library(duckdb.dev)
2026-07-27T07:28:44.9362966Z Loading required package: DBI
2026-07-27T07:28:44.9363200Z > 
2026-07-27T07:28:44.9363401Z > # CRAN guard
2026-07-27T07:28:44.9363592Z > #
2026-07-27T07:28:44.9363985Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T07:28:44.9364567Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T07:28:44.9365147Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T07:28:44.9365746Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T07:28:44.9366300Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T07:28:44.9366891Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T07:28:44.9367362Z > # so the guard is obvious and self-contained.
2026-07-27T07:28:44.9367987Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T07:28:44.9368365Z > 
2026-07-27T07:28:44.9368636Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T07:28:44.9368941Z +   run <- TRUE
2026-07-27T07:28:44.9369270Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T07:28:44.9369588Z +   run <- FALSE
2026-07-27T07:28:44.9369795Z + } else {
2026-07-27T07:28:44.9370146Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T07:28:44.9370669Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T07:28:44.9370944Z + }
2026-07-27T07:28:44.9371111Z > 
2026-07-27T07:28:44.9371304Z > if (run) {
2026-07-27T07:28:44.9371550Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T07:28:44.9371812Z + } else {
2026-07-27T07:28:44.9372007Z +   message(
2026-07-27T07:28:44.9372212Z +     "\n",
2026-07-27T07:28:44.9372425Z +     strrep("=", 78),
2026-07-27T07:28:44.9372650Z +     "\n",
2026-07-27T07:28:44.9372907Z +     "Skipping the duckdb test suite.\n",
2026-07-27T07:28:44.9373184Z +     "\n",
2026-07-27T07:28:44.9373586Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T07:28:44.9374163Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T07:28:44.9374720Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T07:28:44.9375289Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T07:28:44.9375708Z +     "manner.\n",
2026-07-27T07:28:44.9375931Z +     "\n",
2026-07-27T07:28:44.9376319Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T07:28:44.9376932Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T07:28:44.9377347Z +     "\n",
2026-07-27T07:28:44.9377906Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T07:28:44.9378476Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T07:28:44.9378998Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T07:28:44.9379363Z +     strrep("=", 78),
2026-07-27T07:28:44.9379587Z +     "\n"
2026-07-27T07:28:44.9379781Z +   )
2026-07-27T07:28:44.9379960Z + }
