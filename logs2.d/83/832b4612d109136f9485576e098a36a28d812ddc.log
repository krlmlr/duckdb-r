2026-07-28T07:03:22.5528483Z > library(testthat)
2026-07-28T07:03:22.5528785Z > library(duckdb.dev)
2026-07-28T07:03:22.5529123Z Loading required package: DBI
2026-07-28T07:03:22.5539553Z > 
2026-07-28T07:03:22.5539843Z > # CRAN guard
2026-07-28T07:03:22.5540066Z > #
2026-07-28T07:03:22.5540416Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:03:22.5540905Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:03:22.5541378Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:03:22.5541834Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:03:22.5542290Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:03:22.5542884Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:03:22.5543269Z > # so the guard is obvious and self-contained.
2026-07-28T07:03:22.5543640Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:03:22.5543925Z > 
2026-07-28T07:03:22.5544163Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:03:22.5544414Z +   run <- TRUE
2026-07-28T07:03:22.5544832Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:03:22.5545097Z +   run <- FALSE
2026-07-28T07:03:22.5545271Z + } else {
2026-07-28T07:03:22.5545563Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:03:22.5545921Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:03:22.5546147Z + }
2026-07-28T07:03:22.5546294Z > 
2026-07-28T07:03:22.5546455Z > if (run) {
2026-07-28T07:03:22.5546658Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:03:22.5546882Z + } else {
2026-07-28T07:03:22.5547169Z +   message(
2026-07-28T07:03:22.5547344Z +     "\n",
2026-07-28T07:03:22.5547523Z +     strrep("=", 78),
2026-07-28T07:03:22.5547708Z +     "\n",
2026-07-28T07:03:22.5547914Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:03:22.5548137Z +     "\n",
2026-07-28T07:03:22.5548459Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:03:22.5548913Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:03:22.5549347Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:03:22.5549802Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:03:22.5550122Z +     "manner.\n",
2026-07-28T07:03:22.5550296Z +     "\n",
2026-07-28T07:03:22.5550610Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:03:22.5551121Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:03:22.5551478Z +     "\n",
2026-07-28T07:03:22.5551874Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:03:22.5552328Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:03:22.5552749Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:03:22.5553052Z +     strrep("=", 78),
2026-07-28T07:03:22.5553234Z +     "\n"
2026-07-28T07:03:22.5553391Z +   )
2026-07-28T07:03:22.5553541Z + }
