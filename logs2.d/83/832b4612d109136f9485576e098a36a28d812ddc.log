2026-07-28T07:01:49.7464912Z > library(testthat)
2026-07-28T07:01:49.7465205Z > library(duckdb.dev)
2026-07-28T07:01:49.7465531Z Loading required package: DBI
2026-07-28T07:01:49.7465829Z > 
2026-07-28T07:01:49.7466080Z > # CRAN guard
2026-07-28T07:01:49.7466317Z > #
2026-07-28T07:01:49.7466823Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:01:49.7467662Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:01:49.7468392Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:01:49.7469102Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:01:49.7469806Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:01:49.7470549Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:01:49.7471269Z > # so the guard is obvious and self-contained.
2026-07-28T07:01:49.7471824Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:01:49.7472248Z > 
2026-07-28T07:01:49.7472587Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:01:49.7472969Z +   run <- TRUE
2026-07-28T07:01:49.7473360Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:01:49.7473784Z +   run <- FALSE
2026-07-28T07:01:49.7474039Z + } else {
2026-07-28T07:01:49.7474488Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:01:49.7475188Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:01:49.7475535Z + }
2026-07-28T07:01:49.7475751Z > 
2026-07-28T07:01:49.7475983Z > if (run) {
2026-07-28T07:01:49.7476294Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:01:49.7476633Z + } else {
2026-07-28T07:01:49.7476879Z +   message(
2026-07-28T07:01:49.7477121Z +     "\n",
2026-07-28T07:01:49.7477393Z +     strrep("=", 78),
2026-07-28T07:01:49.7477665Z +     "\n",
2026-07-28T07:01:49.7477986Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:01:49.7478334Z +     "\n",
2026-07-28T07:01:49.7478848Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:01:49.7479678Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:01:49.7480374Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:01:49.7481129Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:01:49.7481666Z +     "manner.\n",
2026-07-28T07:01:49.7481938Z +     "\n",
2026-07-28T07:01:49.7482459Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:01:49.7483256Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:01:49.7483768Z +     "\n",
2026-07-28T07:01:49.7484277Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:01:49.7485136Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:01:49.7485787Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:01:49.7486404Z +     strrep("=", 78),
2026-07-28T07:01:49.7486682Z +     "\n"
2026-07-28T07:01:49.7486913Z +   )
2026-07-28T07:01:49.7487137Z + }
