2026-07-27T05:45:10.7803280Z > # This file is part of the standard setup for testthat.
2026-07-27T05:45:10.7804246Z > # It is recommended that you do not modify it.
2026-07-27T05:45:10.7804762Z > #
2026-07-27T05:45:10.7805340Z > # Where should you do additional test configuration?
2026-07-27T05:45:10.7806061Z > # Learn more about the roles of various files in:
2026-07-27T05:45:10.7806932Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T05:45:10.7807848Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T05:45:10.7808432Z > 
2026-07-27T05:45:10.7808791Z > library(testthat)
2026-07-27T05:45:10.7809209Z > library(duckdb.dev)
2026-07-27T05:45:10.7809697Z Loading required package: DBI
2026-07-27T05:45:10.7810124Z > 
2026-07-27T05:45:10.7810471Z > # CRAN guard
2026-07-27T05:45:10.7810806Z > #
2026-07-27T05:45:10.7811538Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T05:45:10.7812683Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T05:45:10.7814003Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T05:45:10.7815025Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T05:45:10.7816219Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T05:45:10.7817283Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T05:45:10.7818142Z > # so the guard is obvious and self-contained.
2026-07-27T05:45:10.7818927Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T05:45:10.7819510Z > 
2026-07-27T05:45:10.7819983Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T05:45:10.7820527Z +   run <- TRUE
2026-07-27T05:45:10.7821069Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T05:45:10.7821858Z +   run <- FALSE
2026-07-27T05:45:10.7822235Z + } else {
2026-07-27T05:45:10.7822887Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T05:45:10.7823878Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T05:45:10.7824429Z + }
2026-07-27T05:45:10.7824762Z > 
2026-07-27T05:45:10.7825109Z > if (run) {
2026-07-27T05:45:10.7825550Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T05:45:10.7826012Z + } else {
2026-07-27T05:45:10.7826345Z +   message(
2026-07-27T05:45:10.7826685Z +     "\n",
2026-07-27T05:45:10.7827051Z +     strrep("=", 78),
2026-07-27T05:45:10.7827446Z +     "\n",
2026-07-27T05:45:10.7827884Z +     "Skipping the duckdb test suite.\n",
2026-07-27T05:45:10.7828364Z +     "\n",
2026-07-27T05:45:10.7829087Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T05:45:10.7830136Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T05:45:10.7831155Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T05:45:10.7832238Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T05:45:10.7832977Z +     "manner.\n",
2026-07-27T05:45:10.7833338Z +     "\n",
2026-07-27T05:45:10.7834262Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T05:45:10.7835427Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T05:45:10.7836191Z +     "\n",
2026-07-27T05:45:10.7836925Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T05:45:10.7837946Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T05:45:10.7838883Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T05:45:10.7839689Z +     strrep("=", 78),
2026-07-27T05:45:10.7840081Z +     "\n"
2026-07-27T05:45:10.7840378Z +   )
2026-07-27T05:45:10.7840684Z + }
