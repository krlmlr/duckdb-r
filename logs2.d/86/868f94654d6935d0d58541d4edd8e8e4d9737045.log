2026-07-27T05:47:05.3687769Z > # This file is part of the standard setup for testthat.
2026-07-27T05:47:05.3688182Z > # It is recommended that you do not modify it.
2026-07-27T05:47:05.3688470Z > #
2026-07-27T05:47:05.3688773Z > # Where should you do additional test configuration?
2026-07-27T05:47:05.3689180Z > # Learn more about the roles of various files in:
2026-07-27T05:47:05.3689679Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T05:47:05.3690211Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T05:47:05.3690634Z > 
2026-07-27T05:47:05.3690843Z > library(testthat)
2026-07-27T05:47:05.3691092Z > library(duckdb.dev)
2026-07-27T05:47:05.3691366Z Loading required package: DBI
2026-07-27T05:47:05.3691613Z > 
2026-07-27T05:47:05.3691811Z > # CRAN guard
2026-07-27T05:47:05.3692011Z > #
2026-07-27T05:47:05.3692422Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T05:47:05.3693042Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T05:47:05.3693972Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T05:47:05.3694621Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T05:47:05.3695215Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T05:47:05.3695830Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T05:47:05.3696324Z > # so the guard is obvious and self-contained.
2026-07-27T05:47:05.3696825Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T05:47:05.3697178Z > 
2026-07-27T05:47:05.3697457Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T05:47:05.3697767Z +   run <- TRUE
2026-07-27T05:47:05.3698095Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T05:47:05.3698433Z +   run <- FALSE
2026-07-27T05:47:05.3698648Z + } else {
2026-07-27T05:47:05.3699011Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T05:47:05.3699472Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T05:47:05.3699758Z + }
2026-07-27T05:47:05.3699931Z > 
2026-07-27T05:47:05.3700120Z > if (run) {
2026-07-27T05:47:05.3700378Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T05:47:05.3700650Z + } else {
2026-07-27T05:47:05.3700851Z +   message(
2026-07-27T05:47:05.3701059Z +     "\n",
2026-07-27T05:47:05.3701274Z +     strrep("=", 78),
2026-07-27T05:47:05.3701498Z +     "\n",
2026-07-27T05:47:05.3701757Z +     "Skipping the duckdb test suite.\n",
2026-07-27T05:47:05.3702052Z +     "\n",
2026-07-27T05:47:05.3702612Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T05:47:05.3703259Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T05:47:05.3704121Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T05:47:05.3704754Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T05:47:05.3705191Z +     "manner.\n",
2026-07-27T05:47:05.3705424Z +     "\n",
2026-07-27T05:47:05.3705842Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T05:47:05.3706498Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T05:47:05.3706936Z +     "\n",
2026-07-27T05:47:05.3707366Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T05:47:05.3707968Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T05:47:05.3708514Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T05:47:05.3708911Z +     strrep("=", 78),
2026-07-27T05:47:05.3709230Z +     "\n"
2026-07-27T05:47:05.3709417Z +   )
2026-07-27T05:47:05.3709606Z + }
