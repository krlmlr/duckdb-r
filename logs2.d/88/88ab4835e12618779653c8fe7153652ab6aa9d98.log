2026-07-27T14:32:09.8118525Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:32:09.8118655Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:32:09.8118938Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
