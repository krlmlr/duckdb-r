2026-07-27T15:10:43.0120853Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T15:10:43.0121108Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T15:10:43.0121214Z +           function val(k) { return map[k] || 0; }
2026-07-27T15:10:43.0121445Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T15:10:43.0121599Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T15:10:43.0121650Z +   
2026-07-27T15:10:43.0121872Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T15:10:43.0122196Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T15:10:43.0122374Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
