2026-07-27T15:10:43.0125795Z +                   wrap.appendChild(kids);
2026-07-27T15:10:43.0125889Z +                   var open = depth === 0;
2026-07-27T15:10:43.0126166Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T15:10:43.0126279Z +                   row.classList.add("clickable");
2026-07-27T15:10:43.0126418Z +                   row.addEventListener("click", function () {
2026-07-27T15:10:43.0126777Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T15:10:43.0126849Z +                   });
2026-07-27T15:10:43.0126923Z +               }
2026-07-27T15:10:43.0127005Z +               return wrap;
2026-07-27T15:10:43.0127078Z +           }
2026-07-27T15:10:43.0127178Z +           panel.innerHTML = "";
2026-07-27T15:10:43.0127355Z +           var head = document.createElement("div"); head.className = "tm-head";
