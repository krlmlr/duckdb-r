2026-07-27T15:10:43.0124501Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T15:10:43.0124849Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T15:10:43.0125043Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T15:10:43.0125140Z +               wrap.appendChild(row);
2026-07-27T15:10:43.0125230Z +               if (hasKids) {
