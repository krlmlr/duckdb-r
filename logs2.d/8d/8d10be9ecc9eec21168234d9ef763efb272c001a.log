2026-07-27T14:31:12.8499091Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:31:12.8499590Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:31:12.8499756Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:31:12.8500127Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
