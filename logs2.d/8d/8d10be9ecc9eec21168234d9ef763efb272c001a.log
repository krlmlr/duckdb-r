2026-07-27T14:31:12.8500429Z +   
2026-07-27T14:31:12.8500776Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:31:12.8501305Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:31:12.8501569Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:31:12.8502142Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
