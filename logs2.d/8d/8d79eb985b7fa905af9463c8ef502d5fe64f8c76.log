2026-07-27T13:58:51.7797976Z +           function renderTNode(node, depth) {
2026-07-27T13:58:51.7798112Z +               var wrap = document.createElement("div");
2026-07-27T13:58:51.7798424Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T13:58:51.7798585Z +               var hasKids = node.children && node.children.length;
2026-07-27T13:58:51.7799008Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T13:58:51.7799268Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T13:58:51.7799547Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T13:58:51.7799808Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T13:58:51.7799933Z +               wrap.appendChild(row);
2026-07-27T13:58:51.7800029Z +               if (hasKids) {
