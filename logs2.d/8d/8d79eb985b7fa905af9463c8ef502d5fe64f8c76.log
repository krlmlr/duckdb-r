2026-07-27T13:58:51.7800574Z +                   wrap.appendChild(kids);
2026-07-27T13:58:51.7800685Z +                   var open = depth === 0;
2026-07-27T13:58:51.7800979Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T13:58:51.7801121Z +                   row.classList.add("clickable");
2026-07-27T13:58:51.7801268Z +                   row.addEventListener("click", function () {
2026-07-27T13:58:51.7801645Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T13:58:51.7801724Z +                   });
2026-07-27T13:58:51.7801805Z +               }
2026-07-27T13:58:51.7801893Z +               return wrap;
2026-07-27T13:58:51.7801976Z +           }
2026-07-27T13:58:51.7802080Z +           panel.innerHTML = "";
2026-07-27T13:58:51.7802266Z +           var head = document.createElement("div"); head.className = "tm-head";
