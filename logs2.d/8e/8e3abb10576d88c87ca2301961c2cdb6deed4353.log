2026-07-28T07:03:41.5098846Z > library(testthat)
2026-07-28T07:03:41.5099047Z > library(duckdb.dev)
2026-07-28T07:03:41.5099276Z Loading required package: DBI
2026-07-28T07:03:41.5099615Z > 
2026-07-28T07:03:41.5099786Z > # CRAN guard
2026-07-28T07:03:41.5099951Z > #
2026-07-28T07:03:41.5100278Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:03:41.5100751Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:03:41.5101219Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:03:41.5101668Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:03:41.5102120Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:03:41.5102662Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:03:41.5103043Z > # so the guard is obvious and self-contained.
2026-07-28T07:03:41.5103409Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:03:41.5103689Z > 
2026-07-28T07:03:41.5103915Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:03:41.5104163Z +   run <- TRUE
2026-07-28T07:03:41.5104422Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:03:41.5104681Z +   run <- FALSE
2026-07-28T07:03:41.5104859Z + } else {
2026-07-28T07:03:41.5105158Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:03:41.5105519Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:03:41.5105744Z + }
2026-07-28T07:03:41.5105894Z > 
2026-07-28T07:03:41.5106056Z > if (run) {
2026-07-28T07:03:41.5106265Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:03:41.5106492Z + } else {
2026-07-28T07:03:41.5106760Z +   message(
2026-07-28T07:03:41.5106942Z +     "\n",
2026-07-28T07:03:41.5107126Z +     strrep("=", 78),
2026-07-28T07:03:41.5107312Z +     "\n",
2026-07-28T07:03:41.5107520Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:03:41.5107748Z +     "\n",
2026-07-28T07:03:41.5108076Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:03:41.5108534Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:03:41.5108987Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:03:41.5109609Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:03:41.5109947Z +     "manner.\n",
2026-07-28T07:03:41.5110127Z +     "\n",
2026-07-28T07:03:41.5110454Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:03:41.5110963Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:03:41.5111302Z +     "\n",
2026-07-28T07:03:41.5111625Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:03:41.5112193Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:03:41.5112616Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:03:41.5112922Z +     strrep("=", 78),
2026-07-28T07:03:41.5113118Z +     "\n"
2026-07-28T07:03:41.5113277Z +   )
2026-07-28T07:03:41.5113429Z + }
