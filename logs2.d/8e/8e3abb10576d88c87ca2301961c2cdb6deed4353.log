2026-07-28T07:02:07.9770440Z Loading required package: DBI
2026-07-28T07:02:07.9770634Z > 
2026-07-28T07:02:07.9770799Z > # CRAN guard
2026-07-28T07:02:07.9770961Z > #
2026-07-28T07:02:07.9771285Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:02:07.9771757Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:02:07.9772305Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:02:07.9772751Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:02:07.9773196Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:02:07.9773652Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:02:07.9774023Z > # so the guard is obvious and self-contained.
2026-07-28T07:02:07.9774379Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:02:07.9774653Z > 
2026-07-28T07:02:07.9774872Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:02:07.9775121Z +   run <- TRUE
2026-07-28T07:02:07.9775375Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:02:07.9775635Z +   run <- FALSE
2026-07-28T07:02:07.9775806Z + } else {
2026-07-28T07:02:07.9776106Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:02:07.9776452Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:02:07.9776675Z + }
2026-07-28T07:02:07.9776819Z > 
2026-07-28T07:02:07.9776976Z > if (run) {
2026-07-28T07:02:07.9777182Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:02:07.9777402Z + } else {
2026-07-28T07:02:07.9777562Z +   message(
2026-07-28T07:02:07.9777723Z +     "\n",
2026-07-28T07:02:07.9777898Z +     strrep("=", 78),
2026-07-28T07:02:07.9778075Z +     "\n",
2026-07-28T07:02:07.9778275Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:02:07.9778494Z +     "\n",
2026-07-28T07:02:07.9778815Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:02:07.9779489Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:02:07.9779933Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:02:07.9780397Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:02:07.9780726Z +     "manner.\n",
2026-07-28T07:02:07.9780902Z +     "\n",
2026-07-28T07:02:07.9781220Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:02:07.9781712Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:02:07.9782037Z +     "\n",
2026-07-28T07:02:07.9782353Z +     "To run the test suite locally, set the environment variable before checking:\n",
