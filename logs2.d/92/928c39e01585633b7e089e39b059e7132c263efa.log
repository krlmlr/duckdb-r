2026-07-27T15:04:34.7452435Z +           function renderTNode(node, depth) {
2026-07-27T15:04:34.7452631Z +               var wrap = document.createElement("div");
2026-07-27T15:04:34.7453114Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T15:04:34.7453336Z +               var hasKids = node.children && node.children.length;
2026-07-27T15:04:34.7453977Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T15:04:34.7454514Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T15:04:34.7454932Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T15:04:34.7455220Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T15:04:34.7455368Z +               wrap.appendChild(row);
2026-07-27T15:04:34.7455497Z +               if (hasKids) {
2026-07-27T15:04:34.7455791Z +                   var kids = document.createElement("div"); kids.className = "tm-kids";
2026-07-27T15:04:34.7456155Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T15:04:34.7456312Z +                   wrap.appendChild(kids);
2026-07-27T15:04:34.7456459Z +                   var open = depth === 0;
2026-07-27T15:04:34.7456888Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T15:04:34.7457063Z +                   row.classList.add("clickable");
2026-07-27T15:04:34.7457262Z +                   row.addEventListener("click", function () {
2026-07-27T15:04:34.7457942Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T15:04:34.7458066Z +                   });
2026-07-27T15:04:34.7458169Z +               }
2026-07-27T15:04:34.7458298Z +               return wrap;
2026-07-27T15:04:34.7458395Z +           }
2026-07-27T15:04:34.7458537Z +           panel.innerHTML = "";
2026-07-27T15:04:34.7458821Z +           var head = document.createElement("div"); head.className = "tm-head";
2026-07-27T15:04:34.7459294Z +           head.innerHTML = '<span class="t">Phase timings</span><span class="tm-close" id="tm-close">×</span>';
2026-07-27T15:04:34.7459442Z +           panel.appendChild(head);
