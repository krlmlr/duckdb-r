2026-07-27T15:04:34.7448099Z +           var map = {};
2026-07-27T15:04:34.7448338Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T15:04:34.7448671Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T15:04:34.7449080Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T15:04:34.7449327Z +           function val(k) { return map[k] || 0; }
2026-07-27T15:04:34.7449705Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T15:04:34.7449942Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T15:04:34.7450023Z +   
2026-07-27T15:04:34.7450382Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T15:04:34.7450916Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T15:04:34.7451178Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T15:04:34.7451764Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T15:04:34.7452085Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T15:04:34.7452188Z +           }) };
