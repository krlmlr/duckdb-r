2026-07-28T07:08:40.5510172Z > # CRAN guard
2026-07-28T07:08:40.5510454Z > #
2026-07-28T07:08:40.5511131Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:40.5512398Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:40.5513355Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:40.5514274Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:40.5515540Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:40.5516530Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:40.5517293Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:40.5518006Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:40.5518536Z > 
2026-07-28T07:08:40.5518949Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:40.5519433Z +   run <- TRUE
2026-07-28T07:08:40.5519923Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:40.5520431Z +   run <- FALSE
2026-07-28T07:08:40.5520749Z + } else {
2026-07-28T07:08:40.5521320Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:40.5522037Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:40.5522479Z + }
2026-07-28T07:08:40.5522731Z > 
2026-07-28T07:08:40.5523019Z > if (run) {
2026-07-28T07:08:40.5523412Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:40.5523835Z + } else {
2026-07-28T07:08:40.5524133Z +   message(
2026-07-28T07:08:40.5524432Z +     "\n",
2026-07-28T07:08:40.5524762Z +     strrep("=", 78),
2026-07-28T07:08:40.5525242Z +     "\n",
2026-07-28T07:08:40.5525637Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:40.5526065Z +     "\n",
2026-07-28T07:08:40.5526714Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:40.5527837Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:40.5528751Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:40.5529722Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:40.5530400Z +     "manner.\n",
2026-07-28T07:08:40.5530730Z +     "\n",
2026-07-28T07:08:40.5531376Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:40.5532405Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:40.5533070Z +     "\n",
2026-07-28T07:08:40.5533723Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:40.5534646Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:40.5535835Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:40.5536656Z +     strrep("=", 78),
2026-07-28T07:08:40.5536998Z +     "\n"
2026-07-28T07:08:40.5537263Z +   )
2026-07-28T07:08:40.5537525Z + }
