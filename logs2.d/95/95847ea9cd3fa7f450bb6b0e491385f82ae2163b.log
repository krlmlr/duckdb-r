2026-07-28T07:10:40.5975861Z Loading required package: DBI
2026-07-28T07:10:40.5976138Z > 
2026-07-28T07:10:40.5976356Z > # CRAN guard
2026-07-28T07:10:40.5976560Z > #
2026-07-28T07:10:40.5976986Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:10:40.5977598Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:10:40.5978201Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:10:40.5978783Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:10:40.5979372Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:10:40.5980138Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:10:40.5980622Z > # so the guard is obvious and self-contained.
2026-07-28T07:10:40.5981082Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:10:40.5981425Z > 
2026-07-28T07:10:40.5981708Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:10:40.5982011Z +   run <- TRUE
2026-07-28T07:10:40.5982332Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:10:40.5982658Z +   run <- FALSE
2026-07-28T07:10:40.5982871Z + } else {
2026-07-28T07:10:40.5983238Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:10:40.5983695Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:10:40.5983976Z + }
2026-07-28T07:10:40.5984156Z > 
2026-07-28T07:10:40.5984353Z > if (run) {
2026-07-28T07:10:40.5984613Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:10:40.5984889Z + } else {
2026-07-28T07:10:40.5985548Z +   message(
2026-07-28T07:10:40.5985777Z +     "\n",
2026-07-28T07:10:40.5986002Z +     strrep("=", 78),
2026-07-28T07:10:40.5986236Z +     "\n",
2026-07-28T07:10:40.5986498Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:10:40.5986778Z +     "\n",
2026-07-28T07:10:40.5987198Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:10:40.5987789Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:10:40.5988354Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:10:40.5988938Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:10:40.5989352Z +     "manner.\n",
2026-07-28T07:10:40.5989576Z +     "\n",
2026-07-28T07:10:40.5989980Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:10:40.5990610Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:10:40.5991047Z +     "\n",
2026-07-28T07:10:40.5991553Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:10:40.5992137Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:10:40.5992658Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:10:40.5993031Z +     strrep("=", 78),
2026-07-28T07:10:40.5993268Z +     "\n"
2026-07-28T07:10:40.5993461Z +   )
2026-07-28T07:10:40.5993645Z + }
