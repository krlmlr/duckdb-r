2026-09-28T02:11:03.8281008Z > # CRAN guard
2026-09-28T02:11:03.8296813Z > #
2026-09-28T02:11:03.8297350Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-28T02:11:03.8298021Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-28T02:11:03.8298638Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-28T02:11:03.8299230Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-28T02:11:03.8300038Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-28T02:11:03.8300656Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-28T02:11:03.8301149Z > # so the guard is obvious and self-contained.
2026-09-28T02:11:03.8301617Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-28T02:11:03.8301980Z > 
2026-09-28T02:11:03.8302273Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-28T02:11:03.8302615Z +   run <- TRUE
2026-09-28T02:11:03.8302968Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-28T02:11:03.8303395Z +   run <- FALSE
2026-09-28T02:11:03.8303630Z + } else {
2026-09-28T02:11:03.8304013Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-28T02:11:03.8304479Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-28T02:11:03.8304773Z + }
2026-09-28T02:11:03.8304962Z > 
2026-09-28T02:11:03.8305163Z > if (run) {
2026-09-28T02:11:03.8305432Z +   test_check(simulate_duckdb()$pkg)
2026-09-28T02:11:03.8305722Z + } else {
2026-09-28T02:11:03.8305927Z +   message(
2026-09-28T02:11:03.8306137Z +     "\n",
2026-09-28T02:11:03.8306600Z +     strrep("=", 78),
2026-09-28T02:11:03.8306848Z +     "\n",
2026-09-28T02:11:03.8307115Z +     "Skipping the duckdb test suite.\n",
2026-09-28T02:11:03.8307408Z +     "\n",
2026-09-28T02:11:03.8307842Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-28T02:11:03.8308444Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-28T02:11:03.8309031Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-28T02:11:03.8309642Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-28T02:11:03.8310168Z +     "manner.\n",
2026-09-28T02:11:03.8310403Z +     "\n",
2026-09-28T02:11:03.8310813Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-28T02:11:03.8311473Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-28T02:11:03.8311906Z +     "\n",
2026-09-28T02:11:03.8312340Z +     "To run the test suite locally, set the environment variable before checking:\n",
