2026-09-28T02:11:03.9030686Z > # CRAN guard
2026-09-28T02:11:03.9030771Z > #
2026-09-28T02:11:03.9031097Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-28T02:11:03.9031400Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-28T02:11:03.9031705Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-28T02:11:03.9032055Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-28T02:11:03.9032420Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-28T02:11:03.9032723Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-28T02:11:03.9032906Z > # so the guard is obvious and self-contained.
2026-09-28T02:11:03.9033164Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-28T02:11:03.9033253Z > 
2026-09-28T02:11:03.9033438Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-28T02:11:03.9033551Z +   run <- TRUE
2026-09-28T02:11:03.9033860Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-28T02:11:03.9034027Z +   run <- FALSE
2026-09-28T02:11:03.9034176Z + } else {
2026-09-28T02:11:03.9034580Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-28T02:11:03.9034881Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-28T02:11:03.9035005Z + }
2026-09-28T02:11:03.9035134Z > 
2026-09-28T02:11:03.9035288Z > if (run) {
2026-09-28T02:11:03.9035524Z +   test_check(simulate_duckdb()$pkg)
2026-09-28T02:11:03.9035676Z + } else {
2026-09-28T02:11:03.9035834Z +   message(
2026-09-28T02:11:03.9035996Z +     "\n",
2026-09-28T02:11:03.9036185Z +     strrep("=", 78),
2026-09-28T02:11:03.9036503Z +     "\n",
2026-09-28T02:11:03.9036758Z +     "Skipping the duckdb test suite.\n",
2026-09-28T02:11:03.9036918Z +     "\n",
2026-09-28T02:11:03.9037442Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-28T02:11:03.9037914Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-28T02:11:03.9038357Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-28T02:11:03.9038835Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-28T02:11:03.9038961Z +     "manner.\n",
2026-09-28T02:11:03.9039066Z +     "\n",
2026-09-28T02:11:03.9039377Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-28T02:11:03.9039724Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-28T02:11:03.9039825Z +     "\n",
2026-09-28T02:11:03.9040143Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-28T02:11:03.9040429Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-28T02:11:03.9040693Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-28T02:11:03.9040817Z +     strrep("=", 78),
2026-09-28T02:11:03.9040916Z +     "\n"
2026-09-28T02:11:03.9041006Z +   )
2026-09-28T02:11:03.9041095Z + }
