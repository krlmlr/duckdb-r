2026-08-14T02:12:38.6960723Z > # CRAN guard
2026-08-14T02:12:38.6960792Z > #
2026-08-14T02:12:38.6961084Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-14T02:12:38.6961355Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-14T02:12:38.6961637Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-14T02:12:38.6962027Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-14T02:12:38.6963220Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-14T02:12:38.6963537Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-14T02:12:38.6963700Z > # so the guard is obvious and self-contained.
2026-08-14T02:12:38.6963939Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-14T02:12:38.6964012Z > 
2026-08-14T02:12:38.6964174Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-14T02:12:38.6964264Z +   run <- TRUE
2026-08-14T02:12:38.6964457Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-14T02:12:38.6964552Z +   run <- FALSE
2026-08-14T02:12:38.6964635Z + } else {
2026-08-14T02:12:38.6964882Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-14T02:12:38.6965051Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-14T02:12:38.6965122Z + }
2026-08-14T02:12:38.6965194Z > 
2026-08-14T02:12:38.6965282Z > if (run) {
2026-08-14T02:12:38.6965412Z +   test_check(simulate_duckdb()$pkg)
2026-08-14T02:12:38.6965498Z + } else {
2026-08-14T02:12:38.6965588Z +   message(
2026-08-14T02:12:38.6965670Z +     "\n",
2026-08-14T02:12:38.6965773Z +     strrep("=", 78),
2026-08-14T02:12:38.6966060Z +     "\n",
2026-08-14T02:12:38.6966201Z +     "Skipping the duckdb test suite.\n",
2026-08-14T02:12:38.6966287Z +     "\n",
2026-08-14T02:12:38.6966586Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-14T02:12:38.6966851Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-14T02:12:38.6967123Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-14T02:12:38.6967422Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-14T02:12:38.6967516Z +     "manner.\n",
2026-08-14T02:12:38.6967608Z +     "\n",
2026-08-14T02:12:38.6967897Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-14T02:12:38.6968214Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-14T02:12:38.6968303Z +     "\n",
2026-08-14T02:12:38.6968602Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-14T02:12:38.6968855Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-14T02:12:38.6969098Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-14T02:12:38.6969202Z +     strrep("=", 78),
2026-08-14T02:12:38.6969283Z +     "\n"
2026-08-14T02:12:38.6969352Z +   )
2026-08-14T02:12:38.6969418Z + }
