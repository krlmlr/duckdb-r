2026-07-28T07:08:54.8559850Z > library(testthat)
2026-07-28T07:08:54.8560082Z > library(duckdb.dev)
2026-07-28T07:08:54.8560345Z Loading required package: DBI
2026-07-28T07:08:54.8560578Z > 
2026-07-28T07:08:54.8560775Z > # CRAN guard
2026-07-28T07:08:54.8560959Z > #
2026-07-28T07:08:54.8561364Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:54.8562230Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:54.8562829Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:54.8563404Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:54.8563995Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:54.8564681Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:54.8565161Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:54.8565609Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:54.8565948Z > 
2026-07-28T07:08:54.8566207Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:54.8566509Z +   run <- TRUE
2026-07-28T07:08:54.8566818Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:54.8567138Z +   run <- FALSE
2026-07-28T07:08:54.8567342Z + } else {
2026-07-28T07:08:54.8567699Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:54.8568148Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:54.8568424Z + }
2026-07-28T07:08:54.8568593Z > 
2026-07-28T07:08:54.8568775Z > if (run) {
2026-07-28T07:08:54.8569019Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:54.8569293Z + } else {
2026-07-28T07:08:54.8569598Z +   message(
2026-07-28T07:08:54.8569797Z +     "\n",
2026-07-28T07:08:54.8570004Z +     strrep("=", 78),
2026-07-28T07:08:54.8570229Z +     "\n",
2026-07-28T07:08:54.8570475Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:54.8570750Z +     "\n",
2026-07-28T07:08:54.8571159Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:54.8572024Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:54.8572613Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:54.8573222Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:54.8573641Z +     "manner.\n",
2026-07-28T07:08:54.8573854Z +     "\n",
2026-07-28T07:08:54.8574256Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:54.8574904Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:54.8575331Z +     "\n",
2026-07-28T07:08:54.8575754Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:54.8576427Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:54.8576955Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:54.8577334Z +     strrep("=", 78),
2026-07-28T07:08:54.8577551Z +     "\n"
2026-07-28T07:08:54.8577723Z +   )
2026-07-28T07:08:54.8577904Z + }
