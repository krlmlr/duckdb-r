2026-07-28T07:07:02.3573459Z > library(testthat)
2026-07-28T07:07:02.3573693Z > library(duckdb.dev)
2026-07-28T07:07:02.3573955Z Loading required package: DBI
2026-07-28T07:07:02.3574188Z > 
2026-07-28T07:07:02.3574380Z > # CRAN guard
2026-07-28T07:07:02.3574565Z > #
2026-07-28T07:07:02.3574961Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:02.3575688Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:02.3576286Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:02.3576860Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:02.3577441Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:02.3578041Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:02.3578519Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:02.3578964Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:02.3579300Z > 
2026-07-28T07:07:02.3579566Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:02.3579885Z +   run <- TRUE
2026-07-28T07:07:02.3580198Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:02.3580524Z +   run <- FALSE
2026-07-28T07:07:02.3580733Z + } else {
2026-07-28T07:07:02.3581096Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:02.3581787Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:02.3582119Z + }
2026-07-28T07:07:02.3582287Z > 
2026-07-28T07:07:02.3582466Z > if (run) {
2026-07-28T07:07:02.3582709Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:02.3582972Z + } else {
2026-07-28T07:07:02.3583157Z +   message(
2026-07-28T07:07:02.3583347Z +     "\n",
2026-07-28T07:07:02.3583552Z +     strrep("=", 78),
2026-07-28T07:07:02.3583766Z +     "\n",
2026-07-28T07:07:02.3584004Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:02.3584272Z +     "\n",
2026-07-28T07:07:02.3584675Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:02.3585388Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:02.3585955Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:02.3586554Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:02.3586975Z +     "manner.\n",
2026-07-28T07:07:02.3587178Z +     "\n",
2026-07-28T07:07:02.3587571Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:02.3588200Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:02.3588628Z +     "\n",
2026-07-28T07:07:02.3589030Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:02.3589610Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:02.3590134Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:02.3590635Z +     strrep("=", 78),
2026-07-28T07:07:02.3590858Z +     "\n"
2026-07-28T07:07:02.3591030Z +   )
2026-07-28T07:07:02.3591199Z + }
