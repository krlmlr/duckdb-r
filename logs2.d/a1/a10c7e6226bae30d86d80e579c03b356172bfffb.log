2026-07-28T07:05:56.3218174Z > # CRAN guard
2026-07-28T07:05:56.3218489Z > #
2026-07-28T07:05:56.3219198Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:05:56.3220277Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:05:56.3221831Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:05:56.3222862Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:05:56.3223886Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:05:56.3224981Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:05:56.3225845Z > # so the guard is obvious and self-contained.
2026-07-28T07:05:56.3226630Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:05:56.3227219Z > 
2026-07-28T07:05:56.3227681Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:05:56.3228213Z +   run <- TRUE
2026-07-28T07:05:56.3228762Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:05:56.3229328Z +   run <- FALSE
2026-07-28T07:05:56.3229684Z + } else {
2026-07-28T07:05:56.3230326Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:05:56.3231387Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:05:56.3231886Z + }
2026-07-28T07:05:56.3232166Z > 
2026-07-28T07:05:56.3232485Z > if (run) {
2026-07-28T07:05:56.3232920Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:05:56.3233379Z + } else {
2026-07-28T07:05:56.3233707Z +   message(
2026-07-28T07:05:56.3234041Z +     "\n",
2026-07-28T07:05:56.3234400Z +     strrep("=", 78),
2026-07-28T07:05:56.3234775Z +     "\n",
2026-07-28T07:05:56.3235209Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:05:56.3235689Z +     "\n",
2026-07-28T07:05:56.3236409Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:05:56.3237607Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:05:56.3238621Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
