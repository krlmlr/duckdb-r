2026-07-28T07:07:45.4761748Z > library(testthat)
2026-07-28T07:07:45.4761978Z > library(duckdb.dev)
2026-07-28T07:07:45.4762237Z Loading required package: DBI
2026-07-28T07:07:45.4762464Z > 
2026-07-28T07:07:45.4762659Z > # CRAN guard
2026-07-28T07:07:45.4762842Z > #
2026-07-28T07:07:45.4763242Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:45.4763852Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:45.4764444Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:45.4765013Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:45.4765587Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:45.4766289Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:45.4766768Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:45.4767221Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:45.4767569Z > 
2026-07-28T07:07:45.4767835Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:45.4768137Z +   run <- TRUE
2026-07-28T07:07:45.4768452Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:45.4768782Z +   run <- FALSE
2026-07-28T07:07:45.4768985Z + } else {
2026-07-28T07:07:45.4769343Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:45.4769794Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:45.4770073Z + }
2026-07-28T07:07:45.4770243Z > 
2026-07-28T07:07:45.4770427Z > if (run) {
2026-07-28T07:07:45.4770674Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:45.4770947Z + } else {
2026-07-28T07:07:45.4771513Z +   message(
2026-07-28T07:07:45.4771736Z +     "\n",
2026-07-28T07:07:45.4772069Z +     strrep("=", 78),
2026-07-28T07:07:45.4772299Z +     "\n",
2026-07-28T07:07:45.4772550Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:45.4772830Z +     "\n",
2026-07-28T07:07:45.4773233Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:45.4773823Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:45.4774392Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:45.4774995Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:45.4775419Z +     "manner.\n",
2026-07-28T07:07:45.4775623Z +     "\n",
2026-07-28T07:07:45.4776017Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:45.4776657Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:45.4777082Z +     "\n",
2026-07-28T07:07:45.4777494Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:45.4778210Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:45.4778736Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:45.4779108Z +     strrep("=", 78),
2026-07-28T07:07:45.4779326Z +     "\n"
2026-07-28T07:07:45.4779496Z +   )
2026-07-28T07:07:45.4779669Z + }
