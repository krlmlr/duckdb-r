2026-09-27T03:07:49.6258794Z > # CRAN guard
2026-09-27T03:07:49.6258873Z > #
2026-09-27T03:07:49.6259214Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-27T03:07:49.6259517Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-27T03:07:49.6259821Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-27T03:07:49.6260106Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-27T03:07:49.6260406Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-27T03:07:49.6260716Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-27T03:07:49.6260896Z > # so the guard is obvious and self-contained.
2026-09-27T03:07:49.6261152Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-27T03:07:49.6261227Z > 
2026-09-27T03:07:49.6261407Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-27T03:07:49.6261605Z +   run <- TRUE
2026-09-27T03:07:49.6261988Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-27T03:07:49.6262193Z +   run <- FALSE
2026-09-27T03:07:49.6262377Z + } else {
2026-09-27T03:07:49.6262872Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-27T03:07:49.6263195Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-27T03:07:49.6263332Z + }
2026-09-27T03:07:49.6263465Z > 
2026-09-27T03:07:49.6263649Z > if (run) {
2026-09-27T03:07:49.6263855Z +   test_check(simulate_duckdb()$pkg)
2026-09-27T03:07:49.6263956Z + } else {
2026-09-27T03:07:49.6264055Z +   message(
2026-09-27T03:07:49.6264262Z +     "\n",
2026-09-27T03:07:49.6264640Z +     strrep("=", 78),
2026-09-27T03:07:49.6264819Z +     "\n",
2026-09-27T03:07:49.6265112Z +     "Skipping the duckdb test suite.\n",
2026-09-27T03:07:49.6265270Z +     "\n",
2026-09-27T03:07:49.6265847Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-27T03:07:49.6266378Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-27T03:07:49.6266908Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-27T03:07:49.6267495Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-27T03:07:49.6267689Z +     "manner.\n",
2026-09-27T03:07:49.6267861Z +     "\n",
2026-09-27T03:07:49.6269159Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-27T03:07:49.6269526Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-27T03:07:49.6269630Z +     "\n",
2026-09-27T03:07:49.6269955Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-27T03:07:49.6270232Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-27T03:07:49.6270499Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-27T03:07:49.6270623Z +     strrep("=", 78),
2026-09-27T03:07:49.6270832Z +     "\n"
2026-09-27T03:07:49.6270923Z +   )
2026-09-27T03:07:49.6271005Z + }
