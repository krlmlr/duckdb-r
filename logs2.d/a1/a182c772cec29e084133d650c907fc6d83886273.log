2026-07-27T14:32:06.8428478Z +           function renderTNode(node, depth) {
2026-07-27T14:32:06.8428660Z +               var wrap = document.createElement("div");
2026-07-27T14:32:06.8429129Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:32:06.8429346Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:32:06.8429941Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:32:06.8430320Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:32:06.8430731Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:32:06.8431006Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:32:06.8431145Z +               wrap.appendChild(row);
2026-07-27T14:32:06.8431269Z +               if (hasKids) {
