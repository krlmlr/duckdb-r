2026-07-27T14:32:06.8431914Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T14:32:06.8432060Z +                   wrap.appendChild(kids);
2026-07-27T14:32:06.8432194Z +                   var open = depth === 0;
2026-07-27T14:32:06.8432609Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:32:06.8432766Z +                   row.classList.add("clickable");
2026-07-27T14:32:06.8433040Z +                   row.addEventListener("click", function () {
2026-07-27T14:32:06.8433605Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:32:06.8433711Z +                   });
2026-07-27T14:32:06.8433814Z +               }
2026-07-27T14:32:06.8433932Z +               return wrap;
2026-07-27T14:32:06.8434020Z +           }
2026-07-27T14:32:06.8434151Z +           panel.innerHTML = "";
2026-07-27T14:32:06.8434417Z +           var head = document.createElement("div"); head.className = "tm-head";
2026-07-27T14:32:06.8434891Z +           head.innerHTML = '<span class="t">Phase timings</span><span class="tm-close" id="tm-close">×</span>';
2026-07-27T14:32:06.8435030Z +           panel.appendChild(head);
2026-07-27T14:32:06.8435215Z +           panel.appendChild(renderTNode(planNode, 0));
