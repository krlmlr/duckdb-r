2026-07-28T07:09:25.3169832Z > library(testthat)
2026-07-28T07:09:25.3170077Z > library(duckdb.dev)
2026-07-28T07:09:25.3170352Z Loading required package: DBI
2026-07-28T07:09:25.3170595Z > 
2026-07-28T07:09:25.3170799Z > # CRAN guard
2026-07-28T07:09:25.3171001Z > #
2026-07-28T07:09:25.3171675Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:09:25.3172291Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:09:25.3172885Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:09:25.3173475Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:09:25.3174063Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:09:25.3174771Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:09:25.3175269Z > # so the guard is obvious and self-contained.
2026-07-28T07:09:25.3175723Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:09:25.3176068Z > 
2026-07-28T07:09:25.3176346Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:09:25.3176649Z +   run <- TRUE
2026-07-28T07:09:25.3176984Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:09:25.3177318Z +   run <- FALSE
2026-07-28T07:09:25.3177539Z + } else {
2026-07-28T07:09:25.3177911Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:09:25.3178362Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:09:25.3178657Z + }
2026-07-28T07:09:25.3178848Z > 
2026-07-28T07:09:25.3179056Z > if (run) {
2026-07-28T07:09:25.3179327Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:09:25.3179747Z + } else {
2026-07-28T07:09:25.3179964Z +   message(
2026-07-28T07:09:25.3180177Z +     "\n",
2026-07-28T07:09:25.3180407Z +     strrep("=", 78),
2026-07-28T07:09:25.3180639Z +     "\n",
2026-07-28T07:09:25.3180899Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:09:25.3181431Z +     "\n",
2026-07-28T07:09:25.3181857Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:09:25.3182453Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:09:25.3183016Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:09:25.3183619Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:09:25.3184047Z +     "manner.\n",
2026-07-28T07:09:25.3184269Z +     "\n",
2026-07-28T07:09:25.3184680Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:09:25.3185331Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:09:25.3185763Z +     "\n",
2026-07-28T07:09:25.3186191Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:09:25.3186883Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:09:25.3187416Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:09:25.3187802Z +     strrep("=", 78),
2026-07-28T07:09:25.3188042Z +     "\n"
2026-07-28T07:09:25.3188240Z +   )
2026-07-28T07:09:25.3188431Z + }
