2026-07-28T07:07:26.1791682Z > # CRAN guard
2026-07-28T07:07:26.1791962Z > #
2026-07-28T07:07:26.1792603Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:26.1793711Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:26.1794679Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:26.1795610Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:26.1796521Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:26.1797512Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:26.1798290Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:26.1799002Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:26.1799538Z > 
2026-07-28T07:07:26.1799956Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:26.1800446Z +   run <- TRUE
2026-07-28T07:07:26.1800935Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:26.1801773Z +   run <- FALSE
2026-07-28T07:07:26.1802092Z + } else {
2026-07-28T07:07:26.1802656Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:26.1803391Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:26.1803835Z + }
2026-07-28T07:07:26.1804086Z > 
2026-07-28T07:07:26.1804374Z > if (run) {
2026-07-28T07:07:26.1804764Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:26.1805178Z + } else {
2026-07-28T07:07:26.1805477Z +   message(
2026-07-28T07:07:26.1805772Z +     "\n",
2026-07-28T07:07:26.1806103Z +     strrep("=", 78),
2026-07-28T07:07:26.1806438Z +     "\n",
2026-07-28T07:07:26.1806828Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:26.1807256Z +     "\n",
2026-07-28T07:07:26.1807904Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:26.1808994Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:26.1809896Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:26.1810870Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:26.1811749Z +     "manner.\n",
2026-07-28T07:07:26.1812094Z +     "\n",
2026-07-28T07:07:26.1812765Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:26.1813796Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:26.1814466Z +     "\n",
2026-07-28T07:07:26.1815208Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:26.1816140Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:26.1816986Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:26.1817779Z +     strrep("=", 78),
2026-07-28T07:07:26.1818126Z +     "\n"
2026-07-28T07:07:26.1818400Z +   )
2026-07-28T07:07:26.1818674Z + }
