2026-07-27T07:19:13.6620484Z > # This file is part of the standard setup for testthat.
2026-07-27T07:19:13.6621026Z > # It is recommended that you do not modify it.
2026-07-27T07:19:13.6621428Z > #
2026-07-27T07:19:13.6621839Z > # Where should you do additional test configuration?
2026-07-27T07:19:13.6622403Z > # Learn more about the roles of various files in:
2026-07-27T07:19:13.6623205Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T07:19:13.6623933Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T07:19:13.6624396Z > 
2026-07-27T07:19:13.6624683Z > library(testthat)
2026-07-27T07:19:13.6625018Z > library(duckdb.dev)
2026-07-27T07:19:13.6625391Z Loading required package: DBI
2026-07-27T07:19:13.6625725Z > 
2026-07-27T07:19:13.6625997Z > # CRAN guard
2026-07-27T07:19:13.6626260Z > #
2026-07-27T07:19:13.6626836Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T07:19:13.6627712Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T07:19:13.6628531Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T07:19:13.6629340Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T07:19:13.6630142Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T07:19:13.6630987Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T07:19:13.6631819Z > # so the guard is obvious and self-contained.
2026-07-27T07:19:13.6632445Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T07:19:13.6632910Z > 
2026-07-27T07:19:13.6633542Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T07:19:13.6634042Z +   run <- TRUE
2026-07-27T07:19:13.6634582Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T07:19:13.6635058Z +   run <- FALSE
2026-07-27T07:19:13.6635352Z + } else {
2026-07-27T07:19:13.6635864Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T07:19:13.6636508Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T07:19:13.6636899Z + }
2026-07-27T07:19:13.6637139Z > 
2026-07-27T07:19:13.6637413Z > if (run) {
2026-07-27T07:19:13.6637768Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T07:19:13.6638153Z + } else {
2026-07-27T07:19:13.6638432Z +   message(
2026-07-27T07:19:13.6638715Z +     "\n",
2026-07-27T07:19:13.6639012Z +     strrep("=", 78),
2026-07-27T07:19:13.6639325Z +     "\n",
2026-07-27T07:19:13.6639676Z +     "Skipping the duckdb test suite.\n",
2026-07-27T07:19:13.6640075Z +     "\n",
2026-07-27T07:19:13.6640653Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T07:19:13.6641499Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T07:19:13.6642311Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T07:19:13.6643254Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T07:19:13.6643862Z +     "manner.\n",
2026-07-27T07:19:13.6644171Z +     "\n",
2026-07-27T07:19:13.6644735Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T07:19:13.6645639Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T07:19:13.6646239Z +     "\n",
2026-07-27T07:19:13.6646823Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T07:19:13.6647641Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T07:19:13.6648391Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T07:19:13.6648922Z +     strrep("=", 78),
2026-07-27T07:19:13.6649247Z +     "\n"
2026-07-27T07:19:13.6649499Z +   )
2026-07-27T07:19:13.6649747Z + }
