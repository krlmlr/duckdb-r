2026-07-27T07:21:04.0915025Z > # It is recommended that you do not modify it.
2026-07-27T07:21:04.0915316Z > #
2026-07-27T07:21:04.0915609Z > # Where should you do additional test configuration?
2026-07-27T07:21:04.0916001Z > # Learn more about the roles of various files in:
2026-07-27T07:21:04.0916473Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T07:21:04.0916955Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T07:21:04.0917272Z > 
2026-07-27T07:21:04.0917481Z > library(testthat)
2026-07-27T07:21:04.0917745Z > library(duckdb.dev)
2026-07-27T07:21:04.0918015Z Loading required package: DBI
2026-07-27T07:21:04.0918250Z > 
2026-07-27T07:21:04.0918457Z > # CRAN guard
2026-07-27T07:21:04.0918651Z > #
2026-07-27T07:21:04.0919036Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T07:21:04.0919597Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T07:21:04.0920156Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T07:21:04.0920693Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T07:21:04.0921242Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T07:21:04.0921801Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T07:21:04.0922258Z > # so the guard is obvious and self-contained.
2026-07-27T07:21:04.0922732Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T07:21:04.0923244Z > 
2026-07-27T07:21:04.0923527Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T07:21:04.0923833Z +   run <- TRUE
2026-07-27T07:21:04.0924159Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T07:21:04.0924488Z +   run <- FALSE
2026-07-27T07:21:04.0924709Z + } else {
2026-07-27T07:21:04.0925063Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T07:21:04.0925513Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T07:21:04.0925796Z + }
2026-07-27T07:21:04.0925972Z > 
2026-07-27T07:21:04.0926177Z > if (run) {
2026-07-27T07:21:04.0926473Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T07:21:04.0926743Z + } else {
2026-07-27T07:21:04.0926946Z +   message(
2026-07-27T07:21:04.0927159Z +     "\n",
2026-07-27T07:21:04.0927379Z +     strrep("=", 78),
2026-07-27T07:21:04.0927608Z +     "\n",
2026-07-27T07:21:04.0927873Z +     "Skipping the duckdb test suite.\n",
2026-07-27T07:21:04.0928155Z +     "\n",
2026-07-27T07:21:04.0928625Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T07:21:04.0929194Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T07:21:04.0929742Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T07:21:04.0930311Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T07:21:04.0930717Z +     "manner.\n",
2026-07-27T07:21:04.0930944Z +     "\n",
2026-07-27T07:21:04.0931374Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T07:21:04.0931993Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T07:21:04.0932404Z +     "\n",
2026-07-27T07:21:04.0932798Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T07:21:04.0933508Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T07:21:04.0934025Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T07:21:04.0934397Z +     strrep("=", 78),
2026-07-27T07:21:04.0934627Z +     "\n"
2026-07-27T07:21:04.0934815Z +   )
2026-07-27T07:21:04.0935007Z + }
