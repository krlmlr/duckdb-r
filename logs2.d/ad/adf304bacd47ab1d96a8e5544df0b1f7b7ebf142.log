2026-07-27T13:58:04.8711045Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T13:58:04.8711199Z +                   wrap.appendChild(kids);
2026-07-27T13:58:04.8711341Z +                   var open = depth === 0;
2026-07-27T13:58:04.8711782Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T13:58:04.8711959Z +                   row.classList.add("clickable");
2026-07-27T13:58:04.8712172Z +                   row.addEventListener("click", function () {
2026-07-27T13:58:04.8712766Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T13:58:04.8712887Z +                   });
2026-07-27T13:58:04.8712992Z +               }
2026-07-27T13:58:04.8713121Z +               return wrap;
2026-07-27T13:58:04.8713223Z +           }
2026-07-27T13:58:04.8713363Z +           panel.innerHTML = "";
2026-07-27T13:58:04.8713636Z +           var head = document.createElement("div"); head.className = "tm-head";
