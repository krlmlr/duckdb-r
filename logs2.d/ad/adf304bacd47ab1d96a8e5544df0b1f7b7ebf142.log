2026-07-27T13:58:04.8707448Z +           function renderTNode(node, depth) {
2026-07-27T13:58:04.8707642Z +               var wrap = document.createElement("div");
2026-07-27T13:58:04.8708116Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T13:58:04.8708340Z +               var hasKids = node.children && node.children.length;
2026-07-27T13:58:04.8708990Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T13:58:04.8709392Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T13:58:04.8709818Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T13:58:04.8710109Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T13:58:04.8710254Z +               wrap.appendChild(row);
2026-07-27T13:58:04.8710385Z +               if (hasKids) {
