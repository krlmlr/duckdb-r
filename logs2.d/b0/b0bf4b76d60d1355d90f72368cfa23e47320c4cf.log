2026-08-22T14:19:44.9859499Z [36;1m# Infer each compiler default for the active R version from R CMD config,[0m
2026-08-22T14:19:44.9859995Z [36;1m# then route it through ccache. Reading the resolved defaults preserves the[0m
2026-08-22T14:19:44.9860810Z [36;1m# standard flags R selects per version (e.g. -std=gnu2x for C, -std=gnu++17[0m
2026-08-22T14:19:44.9861674Z [36;1m# / -std=gnu++20 for C++); a plain "CC = ccache gcc" override would drop[0m
2026-08-22T14:19:44.9862133Z [36;1m# them and silently downgrade the standard across the version matrix.[0m
2026-08-22T14:19:44.9862812Z [36;1m# Inference uses an empty user Makevars so we always read the pristine[0m
2026-08-22T14:19:44.9863218Z [36;1m# Makeconf defaults, never a value we just wrote.[0m
2026-08-22T14:19:44.9863616Z [36;1m# Note: the versioned switches (CXX11..CXX23) intentionally come out as[0m
2026-08-22T14:19:44.9864067Z [36;1m# bare "g++" with no -std flag. R keeps the standard in a separate[0m
2026-08-22T14:19:44.9864509Z [36;1m# CXXnnSTD variable (CXX17STD = -std=gnu++17, ...) and applies it on top[0m
2026-08-22T14:19:44.9864969Z [36;1m# at compile time, so wrapping only CXXnn with ccache is correct and we[0m
2026-08-22T14:19:44.9865340Z [36;1m# must NOT pin -std here ourselves.[0m
2026-08-22T14:19:44.9865583Z [36;1m#[0m
2026-08-22T14:19:44.9865853Z [36;1m# On Unix, ccache is attached through a generated one-word wrapper[0m
2026-08-22T14:19:44.9866297Z [36;1m# command (ccache-gcc, ccache-g++, ...) rather than the more obvious[0m
2026-08-22T14:19:44.9866729Z [36;1m# "CC = ccache gcc" prefix. R-devel briefly could not cope with a[0m
2026-08-22T14:19:44.9867175Z [36;1m# compiler command of more than one word: tools:::ccE(), which backs the[0m
2026-08-22T14:19:44.9867632Z [36;1m# "checking use of non-API entry points" check and therefore runs for[0m
2026-08-22T14:19:44.9868094Z [36;1m# every package with compiled code, read R CMD config CC, kept only the[0m
2026-08-22T14:19:44.9868549Z [36;1m# first word, and ran that. With "CC = ccache gcc" that left a bare[0m
2026-08-22T14:19:44.9868981Z [36;1m# "ccache", and the check died with "ccache: invalid option -- 'E'".[0m
2026-08-22T14:19:44.9869485Z [36;1m# https://github.com/r-devel/r-svn/commit/ca19f35240517186ed447e773ee67b55e207cf27[0m
2026-08-22T14:19:44.9869948Z [36;1m# https://bugs.r-project.org/show_bug.cgi?id=19130[0m
2026-08-22T14:19:44.9870358Z [36;1m# Upstream has since dropped the truncation again, so the prefix works[0m
2026-08-22T14:19:44.9870819Z [36;1m# once more -- but it takes a while for that to reach the R-devel builds[0m
2026-08-22T14:19:44.9872499Z [36;1m# CI installs, so the wrapper is still doing real work here. It stays[0m
2026-08-22T14:19:44.9872937Z [36;1m# after that too: it costs nothing and is correct either way.[0m
2026-08-22T14:19:44.9873249Z [36;1m#[0m
2026-08-22T14:19:44.9873538Z [36;1m# Windows deliberately keeps the plain prefix, as a control group: it is[0m
2026-08-22T14:19:44.9874013Z [36;1m# where a repeat of that upstream change would show up, while the Unix[0m
2026-08-22T14:19:44.9874369Z [36;1m# jobs carry on regardless.[0m
2026-08-22T14:19:44.9874639Z [36;1mccache_bin="$(command -v ccache || true)"[0m
2026-08-22T14:19:44.9874918Z [36;1mif [ -z "$ccache_bin" ]; then[0m
2026-08-22T14:19:44.9875261Z [36;1m  echo "::warning::ccache is not on the PATH, compiling without it."[0m
2026-08-22T14:19:44.9875597Z [36;1melse[0m
2026-08-22T14:19:44.9875805Z [36;1m  wrapper_dir="$HOME/.R/ccache-wrappers"[0m
2026-08-22T14:19:44.9876096Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-08-22T14:19:44.9876370Z [36;1m    mkdir -p "$wrapper_dir"[0m
2026-08-22T14:19:44.9876599Z [36;1m  fi[0m
2026-08-22T14:19:44.9876764Z [36;1m[0m
2026-08-22T14:19:44.9876942Z [36;1m  empty_makevars="$(mktemp)"[0m
2026-08-22T14:19:44.9877229Z [36;1m  for var in CC CXX CXX11 CXX14 CXX17 CXX20 CXX23; do[0m
2026-08-22T14:19:44.9877664Z [36;1m    val="$(R_MAKEVARS_USER="$empty_makevars" R CMD config "$var" 2>/dev/null || true)"[0m
2026-08-22T14:19:44.9878059Z [36;1m    if [ -z "$val" ]; then[0m
2026-08-22T14:19:44.9878290Z [36;1m      continue[0m
2026-08-22T14:19:44.9878486Z [36;1m    fi[0m
2026-08-22T14:19:44.9878689Z [36;1m    if [ "$RUNNER_OS" = "Windows" ]; then[0m
2026-08-22T14:19:44.9879337Z [36;1m      echo "$var = ccache $val" >> ~/.R/Makevars[0m
2026-08-22T14:19:44.9879635Z [36;1m      continue[0m
2026-08-22T14:19:44.9879822Z [36;1m    fi[0m
2026-08-22T14:19:44.9879986Z [36;1m[0m
2026-08-22T14:19:44.9880249Z [36;1m    # Split "gcc -std=gnu2x" into the compiler and its flags: only the[0m
2026-08-22T14:19:44.9880821Z [36;1m    # compiler is wrapped, the flags are passed through unchanged.[0m
2026-08-22T14:19:44.9881575Z [36;1m    # ccache and the compiler are both found on the PATH at run time,[0m
2026-08-22T14:19:44.9881968Z [36;1m    # nothing is baked into the wrapper by path.[0m
2026-08-22T14:19:44.9882261Z [36;1m    prog="${val%%[[:space:]]*}"[0m
2026-08-22T14:19:44.9882506Z [36;1m    flags="${val#"$prog"}"[0m
2026-08-22T14:19:44.9882762Z [36;1m    wrapper="ccache-$(basename "$prog")"[0m
2026-08-22T14:19:44.9883015Z [36;1m[0m
2026-08-22T14:19:44.9883217Z [36;1m    if [ ! -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-22T14:19:44.9883610Z [36;1m      printf '#!/bin/sh\nexec ccache %s "$@"\n' "$prog" > "$wrapper_dir/$wrapper"[0m
2026-08-22T14:19:44.9883995Z [36;1m      chmod +x "$wrapper_dir/$wrapper"[0m
2026-08-22T14:19:44.9884329Z [36;1m      # Never hand R a wrapper that has not been shown to work.[0m
2026-08-22T14:19:44.9884723Z [36;1m      if ! "$wrapper_dir/$wrapper" --version > /dev/null; then[0m
2026-08-22T14:19:44.9885055Z [36;1m        rm -f "$wrapper_dir/$wrapper"[0m
2026-08-22T14:19:44.9885416Z [36;1m        echo "::warning::No usable $wrapper, compiling $var without ccache."[0m
2026-08-22T14:19:44.9885762Z [36;1m      fi[0m
2026-08-22T14:19:44.9885930Z [36;1m    fi[0m
2026-08-22T14:19:44.9886093Z [36;1m[0m
2026-08-22T14:19:44.9886287Z [36;1m    if [ -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-22T14:19:44.9886600Z [36;1m      echo "$var = $wrapper$flags" >> ~/.R/Makevars[0m
2026-08-22T14:19:44.9886871Z [36;1m    fi[0m
2026-08-22T14:19:44.9887037Z [36;1m  done[0m
2026-08-22T14:19:44.9887223Z [36;1m  rm -f "$empty_makevars"[0m
2026-08-22T14:19:44.9887440Z [36;1m[0m
2026-08-22T14:19:44.9887638Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-08-22T14:19:44.9887935Z [36;1m    echo "$wrapper_dir" >> "$GITHUB_PATH"[0m
2026-08-22T14:19:44.9888254Z [36;1m    echo "===== ccache wrappers in $wrapper_dir ====="[0m
2026-08-22T14:19:44.9888560Z [36;1m    ls -l "$wrapper_dir"[0m
