2026-08-10T02:10:57.9272211Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-10T02:10:57.9272666Z > # so the guard is obvious and self-contained.
2026-08-10T02:10:57.9273092Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-10T02:10:57.9273703Z > 
2026-08-10T02:10:57.9273963Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-10T02:10:57.9274255Z +   run <- TRUE
2026-08-10T02:10:57.9274787Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-10T02:10:57.9275106Z +   run <- FALSE
2026-08-10T02:10:57.9275298Z + } else {
2026-08-10T02:10:57.9275636Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-10T02:10:57.9276063Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-10T02:10:57.9276337Z + }
