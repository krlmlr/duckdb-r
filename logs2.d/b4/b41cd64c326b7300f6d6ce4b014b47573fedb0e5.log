2026-08-10T02:10:57.9921449Z > 
2026-08-10T02:10:57.9921549Z > library(testthat)
2026-08-10T02:10:57.9921646Z > library(duckdb)
2026-08-10T02:10:57.9921772Z Loading required package: DBI
2026-08-10T02:10:57.9921837Z > 
2026-08-10T02:10:57.9921931Z > # CRAN guard
2026-08-10T02:10:57.9921998Z > #
2026-08-10T02:10:57.9922289Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-10T02:10:57.9922568Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-10T02:10:57.9922851Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-10T02:10:57.9923531Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-10T02:10:57.9923894Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-10T02:10:57.9924198Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-10T02:10:57.9924363Z > # so the guard is obvious and self-contained.
2026-08-10T02:10:57.9924599Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-10T02:10:57.9924673Z > 
2026-08-10T02:10:57.9924838Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-10T02:10:57.9924930Z +   run <- TRUE
2026-08-10T02:10:57.9925123Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-10T02:10:57.9925219Z +   run <- FALSE
2026-08-10T02:10:57.9925302Z + } else {
2026-08-10T02:10:57.9925551Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-10T02:10:57.9925725Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-10T02:10:57.9925794Z + }
2026-08-10T02:10:57.9925862Z > 
2026-08-10T02:10:57.9925952Z > if (run) {
2026-08-10T02:10:57.9926084Z +   test_check(simulate_duckdb()$pkg)
2026-08-10T02:10:57.9926170Z + } else {
2026-08-10T02:10:57.9926261Z +   message(
2026-08-10T02:10:57.9926344Z +     "\n",
2026-08-10T02:10:57.9926453Z +     strrep("=", 78),
2026-08-10T02:10:57.9926539Z +     "\n",
2026-08-10T02:10:57.9926679Z +     "Skipping the duckdb test suite.\n",
2026-08-10T02:10:57.9926769Z +     "\n",
2026-08-10T02:10:57.9927067Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-10T02:10:57.9927332Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-10T02:10:57.9927608Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-10T02:10:57.9927910Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-10T02:10:57.9928013Z +     "manner.\n",
2026-08-10T02:10:57.9928105Z +     "\n",
2026-08-10T02:10:57.9928398Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-10T02:10:57.9928717Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-10T02:10:57.9928805Z +     "\n",
2026-08-10T02:10:57.9929286Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-10T02:10:57.9929543Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-10T02:10:57.9929789Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-10T02:10:57.9929894Z +     strrep("=", 78),
2026-08-10T02:10:57.9929976Z +     "\n"
2026-08-10T02:10:57.9930046Z +   )
2026-08-10T02:10:57.9930113Z + }
