2026-07-27T14:04:07.6572838Z +       function buildTimings() {
2026-07-27T14:04:07.6573039Z +           var btn = document.getElementById("timings-fab");
2026-07-27T14:04:07.6573378Z +           var panel = document.getElementById("timings-panel");
2026-07-27T14:04:07.6573958Z +           var timings = (PLAN.query && PLAN.query.timings) ? PLAN.query.timings : [];
2026-07-27T14:04:07.6574091Z +           var map = {};
2026-07-27T14:04:07.6574338Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:04:07.6574678Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:04:07.6575096Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:04:07.6575267Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:04:07.6575646Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:04:07.6575882Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:04:07.6575955Z +   
2026-07-27T14:04:07.6576303Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:04:07.6576846Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:04:07.6577196Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:04:07.6577774Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:04:07.6578090Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T14:04:07.6578188Z +           }) };
2026-07-27T14:04:07.6578264Z +   
2026-07-27T14:04:07.6578429Z +           function renderTNode(node, depth) {
2026-07-27T14:04:07.6578615Z +               var wrap = document.createElement("div");
2026-07-27T14:04:07.6579102Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:04:07.6579324Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:04:07.6579945Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:04:07.6580337Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:04:07.6580761Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:04:07.6581048Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:04:07.6581194Z +               wrap.appendChild(row);
2026-07-27T14:04:07.6581316Z +               if (hasKids) {
2026-07-27T14:04:07.6581614Z +                   var kids = document.createElement("div"); kids.className = "tm-kids";
2026-07-27T14:04:07.6581978Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T14:04:07.6582132Z +                   wrap.appendChild(kids);
2026-07-27T14:04:07.6582275Z +                   var open = depth === 0;
2026-07-27T14:04:07.6582701Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:04:07.6582869Z +                   row.classList.add("clickable");
2026-07-27T14:04:07.6583070Z +                   row.addEventListener("click", function () {
2026-07-27T14:04:07.6583915Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:04:07.6584040Z +                   });
2026-07-27T14:04:07.6584137Z +               }
2026-07-27T14:04:07.6584261Z +               return wrap;
2026-07-27T14:04:07.6584349Z +           }
2026-07-27T14:04:07.6584484Z +           panel.innerHTML = "";
2026-07-27T14:04:07.6584773Z +           var head = document.createElement("div"); head.className = "tm-head";
