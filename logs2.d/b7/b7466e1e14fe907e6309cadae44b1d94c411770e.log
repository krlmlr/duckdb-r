2026-07-27T14:54:34.7618184Z +                   wrap.appendChild(kids);
2026-07-27T14:54:34.7618320Z +                   var open = depth === 0;
2026-07-27T14:54:34.7618750Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T14:54:34.7618921Z +                   row.classList.add("clickable");
2026-07-27T14:54:34.7619118Z +                   row.addEventListener("click", function () {
2026-07-27T14:54:34.7619689Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:54:34.7619805Z +                   });
2026-07-27T14:54:34.7619912Z +               }
2026-07-27T14:54:34.7620040Z +               return wrap;
2026-07-27T14:54:34.7620135Z +           }
2026-07-27T14:54:34.7620273Z +           panel.innerHTML = "";
2026-07-27T14:54:34.7620550Z +           var head = document.createElement("div"); head.className = "tm-head";
