2026-07-27T14:54:34.7610116Z +           var map = {};
2026-07-27T14:54:34.7610356Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:54:34.7610679Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:54:34.7611082Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:54:34.7611253Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:54:34.7611624Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:54:34.7611851Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:54:34.7611932Z +   
2026-07-27T14:54:34.7612277Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:54:34.7612793Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:54:34.7613054Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:54:34.7613650Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:54:34.7613969Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T14:54:34.7614070Z +           }) };
2026-07-27T14:54:34.7614211Z +   
2026-07-27T14:54:34.7614375Z +           function renderTNode(node, depth) {
2026-07-27T14:54:34.7614565Z +               var wrap = document.createElement("div");
2026-07-27T14:54:34.7615041Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:54:34.7615263Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:54:34.7615879Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:54:34.7616248Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:54:34.7616660Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:54:34.7616939Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:54:34.7617084Z +               wrap.appendChild(row);
2026-07-27T14:54:34.7617211Z +               if (hasKids) {
