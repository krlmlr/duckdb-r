2026-07-29T11:15:47.7117948Z > # CRAN guard
2026-07-29T11:15:47.7118107Z > #
2026-07-29T11:15:47.7118431Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T11:15:47.7118925Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T11:15:47.7119416Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T11:15:47.7119885Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T11:15:47.7120640Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T11:15:47.7121135Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T11:15:47.7121534Z > # so the guard is obvious and self-contained.
2026-07-29T11:15:47.7121901Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T11:15:47.7122185Z > 
2026-07-29T11:15:47.7122411Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T11:15:47.7122667Z +   run <- TRUE
2026-07-29T11:15:47.7122942Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T11:15:47.7123212Z +   run <- FALSE
2026-07-29T11:15:47.7123389Z + } else {
2026-07-29T11:15:47.7123691Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T11:15:47.7124054Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T11:15:47.7124291Z + }
2026-07-29T11:15:47.7124452Z > 
2026-07-29T11:15:47.7124621Z > if (run) {
2026-07-29T11:15:47.7124990Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T11:15:47.7125225Z + } else {
2026-07-29T11:15:47.7125409Z +   message(
2026-07-29T11:15:47.7125638Z +     "\n",
2026-07-29T11:15:47.7125822Z +     strrep("=", 78),
2026-07-29T11:15:47.7126006Z +     "\n",
2026-07-29T11:15:47.7126225Z +     "Skipping the duckdb test suite.\n",
2026-07-29T11:15:47.7126458Z +     "\n",
2026-07-29T11:15:47.7126795Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T11:15:47.7127277Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T11:15:47.7127724Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T11:15:47.7128204Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T11:15:47.7128554Z +     "manner.\n",
2026-07-29T11:15:47.7128739Z +     "\n",
2026-07-29T11:15:47.7129074Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T11:15:47.7129626Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T11:15:47.7129998Z +     "\n",
2026-07-29T11:15:47.7130525Z +     "To run the test suite locally, set the environment variable before checking:\n",
