2026-08-06T16:13:17.1061991Z > # CRAN guard
2026-08-06T16:13:17.1062115Z > #
2026-08-06T16:13:17.1062670Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-06T16:13:17.1063188Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-06T16:13:17.1063714Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-06T16:13:17.1064186Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-06T16:13:17.1064716Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-06T16:13:17.1065269Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-06T16:13:17.1065791Z > # so the guard is obvious and self-contained.
2026-08-06T16:13:17.1066228Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-06T16:13:17.1066346Z > 
2026-08-06T16:13:17.1066647Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-06T16:13:17.1066818Z +   run <- TRUE
2026-08-06T16:13:17.1067159Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-06T16:13:17.1067334Z +   run <- FALSE
2026-08-06T16:13:17.1067489Z + } else {
2026-08-06T16:13:17.1067947Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-06T16:13:17.1068253Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-06T16:13:17.1068373Z + }
2026-08-06T16:13:17.1068496Z > 
2026-08-06T16:13:17.1068653Z > if (run) {
2026-08-06T16:13:17.1069063Z +   test_check(simulate_duckdb()$pkg)
2026-08-06T16:13:17.1069231Z + } else {
2026-08-06T16:13:17.1069384Z +   message(
2026-08-06T16:13:17.1069542Z +     "\n",
2026-08-06T16:13:17.1069726Z +     strrep("=", 78),
2026-08-06T16:13:17.1069882Z +     "\n",
2026-08-06T16:13:17.1070148Z +     "Skipping the duckdb test suite.\n",
2026-08-06T16:13:17.1070299Z +     "\n",
2026-08-06T16:13:17.1070851Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-06T16:13:17.1071338Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
