2026-08-23T02:08:34.2483220Z > # CRAN guard
2026-08-23T02:08:34.2483480Z > #
2026-08-23T02:08:34.2484010Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-23T02:08:34.2485150Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-23T02:08:34.2485740Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-23T02:08:34.2486500Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-23T02:08:34.2487150Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-23T02:08:34.2487840Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-23T02:08:34.2488340Z > # so the guard is obvious and self-contained.
2026-08-23T02:08:34.2488990Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-23T02:08:34.2489330Z > 
2026-08-23T02:08:34.2489640Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-23T02:08:34.2490030Z +   run <- TRUE
2026-08-23T02:08:34.2490450Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-23T02:08:34.2490960Z +   run <- FALSE
2026-08-23T02:08:34.2491300Z + } else {
2026-08-23T02:08:34.2491790Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-23T02:08:34.2492330Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-23T02:08:34.2492620Z + }
2026-08-23T02:08:34.2492880Z > 
2026-08-23T02:08:34.2493150Z > if (run) {
2026-08-23T02:08:34.2493430Z +   test_check(simulate_duckdb()$pkg)
2026-08-23T02:08:34.2493790Z + } else {
2026-08-23T02:08:34.2494040Z +   message(
2026-08-23T02:08:34.2494260Z +     "\n",
2026-08-23T02:08:34.2494650Z +     strrep("=", 78),
2026-08-23T02:08:34.2495340Z +     "\n",
2026-08-23T02:08:34.2495630Z +     "Skipping the duckdb test suite.\n",
2026-08-23T02:08:34.2496000Z +     "\n",
2026-08-23T02:08:34.2496530Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-23T02:08:34.2497130Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-23T02:08:34.2497690Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-23T02:08:34.2498440Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-23T02:08:34.2498950Z +     "manner.\n",
2026-08-23T02:08:34.2499190Z +     "\n",
2026-08-23T02:08:34.2499690Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-23T02:08:34.2500420Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-23T02:08:34.2500880Z +     "\n",
2026-08-23T02:08:34.2501380Z +     "To run the test suite locally, set the environment variable before checking:\n",
