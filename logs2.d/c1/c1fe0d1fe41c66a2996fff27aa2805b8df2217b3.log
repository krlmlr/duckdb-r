2026-08-23T02:08:34.3739960Z > # CRAN guard
2026-08-23T02:08:34.3740030Z > #
2026-08-23T02:08:34.3740330Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-23T02:08:34.3740590Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-23T02:08:34.3740870Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-23T02:08:34.3741120Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-23T02:08:34.3741410Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-23T02:08:34.3741690Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-23T02:08:34.3741850Z > # so the guard is obvious and self-contained.
2026-08-23T02:08:34.3742080Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-23T02:08:34.3742130Z > 
2026-08-23T02:08:34.3742290Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-23T02:08:34.3742360Z +   run <- TRUE
2026-08-23T02:08:34.3742740Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-23T02:08:34.3742820Z +   run <- FALSE
2026-08-23T02:08:34.3742890Z + } else {
2026-08-23T02:08:34.3743130Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-23T02:08:34.3743300Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-23T02:08:34.3743350Z + }
2026-08-23T02:08:34.3743400Z > 
2026-08-23T02:08:34.3743620Z > if (run) {
2026-08-23T02:08:34.3743740Z +   test_check(simulate_duckdb()$pkg)
2026-08-23T02:08:34.3743810Z + } else {
2026-08-23T02:08:34.3743880Z +   message(
2026-08-23T02:08:34.3743950Z +     "\n",
2026-08-23T02:08:34.3744050Z +     strrep("=", 78),
2026-08-23T02:08:34.3744120Z +     "\n",
2026-08-23T02:08:34.3744260Z +     "Skipping the duckdb test suite.\n",
2026-08-23T02:08:34.3744330Z +     "\n",
2026-08-23T02:08:34.3744630Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-23T02:08:34.3744900Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-23T02:08:34.3745170Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-23T02:08:34.3745530Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-23T02:08:34.3745640Z +     "manner.\n",
2026-08-23T02:08:34.3745720Z +     "\n",
2026-08-23T02:08:34.3746060Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-23T02:08:34.3746450Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-23T02:08:34.3746520Z +     "\n",
2026-08-23T02:08:34.3746810Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-23T02:08:34.3747060Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-23T02:08:34.3747330Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-23T02:08:34.3747440Z +     strrep("=", 78),
2026-08-23T02:08:34.3747560Z +     "\n"
2026-08-23T02:08:34.3747620Z +   )
2026-08-23T02:08:34.3747670Z + }
