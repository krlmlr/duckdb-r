2026-07-28T07:07:19.5421831Z > # CRAN guard
2026-07-28T07:07:19.5422003Z > #
2026-07-28T07:07:19.5422388Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:19.5423084Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:19.5423751Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:19.5424312Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:19.5424873Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:19.5425454Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:19.5425915Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:19.5426350Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:19.5426680Z > 
2026-07-28T07:07:19.5426933Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:19.5427227Z +   run <- TRUE
2026-07-28T07:07:19.5427525Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:19.5427833Z +   run <- FALSE
2026-07-28T07:07:19.5428027Z + } else {
2026-07-28T07:07:19.5428719Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:19.5429171Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:19.5429448Z + }
2026-07-28T07:07:19.5429613Z > 
2026-07-28T07:07:19.5429792Z > if (run) {
2026-07-28T07:07:19.5430036Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:19.5430293Z + } else {
2026-07-28T07:07:19.5430476Z +   message(
2026-07-28T07:07:19.5430657Z +     "\n",
2026-07-28T07:07:19.5430855Z +     strrep("=", 78),
2026-07-28T07:07:19.5431063Z +     "\n",
2026-07-28T07:07:19.5431294Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:19.5431555Z +     "\n",
2026-07-28T07:07:19.5431954Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:19.5432644Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:19.5433200Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:19.5433777Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:19.5434184Z +     "manner.\n",
2026-07-28T07:07:19.5434384Z +     "\n",
2026-07-28T07:07:19.5434765Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:19.5435389Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:19.5435803Z +     "\n",
2026-07-28T07:07:19.5436194Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:19.5436761Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:19.5437274Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:19.5437759Z +     strrep("=", 78),
