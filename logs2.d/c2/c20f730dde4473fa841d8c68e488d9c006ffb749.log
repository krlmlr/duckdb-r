2026-07-28T07:09:11.3522554Z > library(testthat)
2026-07-28T07:09:11.3522790Z > library(duckdb.dev)
2026-07-28T07:09:11.3523052Z Loading required package: DBI
2026-07-28T07:09:11.3523286Z > 
2026-07-28T07:09:11.3523473Z > # CRAN guard
2026-07-28T07:09:11.3523655Z > #
2026-07-28T07:09:11.3524063Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:09:11.3524684Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:09:11.3525289Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:09:11.3525875Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:09:11.3526471Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:09:11.3527175Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:09:11.3527666Z > # so the guard is obvious and self-contained.
2026-07-28T07:09:11.3528386Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:09:11.3528759Z > 
2026-07-28T07:09:11.3529035Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:09:11.3529361Z +   run <- TRUE
2026-07-28T07:09:11.3529700Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:09:11.3530036Z +   run <- FALSE
2026-07-28T07:09:11.3530246Z + } else {
2026-07-28T07:09:11.3530611Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:09:11.3531078Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:09:11.3531369Z + }
2026-07-28T07:09:11.3531542Z > 
2026-07-28T07:09:11.3531739Z > if (run) {
2026-07-28T07:09:11.3531988Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:09:11.3532271Z + } else {
2026-07-28T07:09:11.3532600Z +   message(
2026-07-28T07:09:11.3532803Z +     "\n",
2026-07-28T07:09:11.3533013Z +     strrep("=", 78),
2026-07-28T07:09:11.3533232Z +     "\n",
2026-07-28T07:09:11.3533486Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:09:11.3533767Z +     "\n",
2026-07-28T07:09:11.3534180Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:09:11.3534791Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:09:11.3535379Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:09:11.3535990Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:09:11.3536425Z +     "manner.\n",
2026-07-28T07:09:11.3536636Z +     "\n",
2026-07-28T07:09:11.3537043Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:09:11.3537705Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:09:11.3538422Z +     "\n",
2026-07-28T07:09:11.3538972Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:09:11.3539622Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:09:11.3540273Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:09:11.3540686Z +     strrep("=", 78),
2026-07-28T07:09:11.3540915Z +     "\n"
2026-07-28T07:09:11.3541091Z +   )
2026-07-28T07:09:11.3541260Z + }
