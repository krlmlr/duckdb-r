2026-07-28T07:06:37.8870310Z > # CRAN guard
2026-07-28T07:06:37.8870489Z > #
2026-07-28T07:06:37.8870878Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:06:37.8871633Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:06:37.8872228Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:06:37.8872804Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:06:37.8873378Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:06:37.8873974Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:06:37.8874446Z > # so the guard is obvious and self-contained.
2026-07-28T07:06:37.8874892Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:06:37.8875232Z > 
2026-07-28T07:06:37.8875497Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:06:37.8875799Z +   run <- TRUE
2026-07-28T07:06:37.8876106Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:06:37.8876430Z +   run <- FALSE
2026-07-28T07:06:37.8876933Z + } else {
2026-07-28T07:06:37.8877299Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:06:37.8877739Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:06:37.8878010Z + }
2026-07-28T07:06:37.8878171Z > 
2026-07-28T07:06:37.8878346Z > if (run) {
2026-07-28T07:06:37.8878589Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:06:37.8878848Z + } else {
2026-07-28T07:06:37.8879031Z +   message(
2026-07-28T07:06:37.8879218Z +     "\n",
2026-07-28T07:06:37.8879422Z +     strrep("=", 78),
2026-07-28T07:06:37.8879632Z +     "\n",
2026-07-28T07:06:37.8879868Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:06:37.8880136Z +     "\n",
2026-07-28T07:06:37.8880533Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:06:37.8881237Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:06:37.8881800Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:06:37.8882396Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:06:37.8882808Z +     "manner.\n",
2026-07-28T07:06:37.8883009Z +     "\n",
2026-07-28T07:06:37.8883398Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:06:37.8884025Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:06:37.8884447Z +     "\n",
2026-07-28T07:06:37.8884843Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:06:37.8885433Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:06:37.8885988Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:06:37.8886683Z +     strrep("=", 78),
2026-07-28T07:06:37.8886939Z +     "\n"
2026-07-28T07:06:37.8887117Z +   )
2026-07-28T07:06:37.8887285Z + }
