2026-07-28T07:08:28.7453168Z > 
2026-07-28T07:08:28.7453498Z > library(testthat)
2026-07-28T07:08:28.7453884Z > library(duckdb.dev)
2026-07-28T07:08:28.7454321Z Loading required package: DBI
2026-07-28T07:08:28.7454710Z > 
2026-07-28T07:08:28.7455020Z > # CRAN guard
2026-07-28T07:08:28.7455321Z > #
2026-07-28T07:08:28.7456016Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:28.7457244Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:28.7458302Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:28.7459328Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:28.7459943Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:28.7461347Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:28.7462202Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:28.7462985Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:28.7463578Z > 
2026-07-28T07:08:28.7464024Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:28.7464549Z +   run <- TRUE
2026-07-28T07:08:28.7465075Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:28.7465635Z +   run <- FALSE
2026-07-28T07:08:28.7465970Z + } else {
2026-07-28T07:08:28.7466783Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:28.7467576Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:28.7468057Z + }
2026-07-28T07:08:28.7468325Z > 
2026-07-28T07:08:28.7468633Z > if (run) {
2026-07-28T07:08:28.7469051Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:28.7469511Z + } else {
2026-07-28T07:08:28.7470010Z +   message(
2026-07-28T07:08:28.7470346Z +     "\n",
2026-07-28T07:08:28.7470692Z +     strrep("=", 78),
2026-07-28T07:08:28.7471061Z +     "\n",
2026-07-28T07:08:28.7471472Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:28.7471940Z +     "\n",
2026-07-28T07:08:28.7472649Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:28.7473704Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:28.7474707Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:28.7475792Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:28.7476258Z +     "manner.\n",
2026-07-28T07:08:28.7476856Z +     "\n",
2026-07-28T07:08:28.7477605Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:28.7478766Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:28.7479521Z +     "\n",
2026-07-28T07:08:28.7480282Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:28.7481433Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:28.7482366Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:28.7483015Z +     strrep("=", 78),
2026-07-28T07:08:28.7483387Z +     "\n"
2026-07-28T07:08:28.7483668Z +   )
2026-07-28T07:08:28.7483943Z + }
