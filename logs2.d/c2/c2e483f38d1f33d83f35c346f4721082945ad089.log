2026-07-27T16:14:04.8626318Z +           var map = {};
2026-07-27T16:14:04.8626679Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T16:14:04.8627011Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T16:14:04.8627434Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T16:14:04.8627614Z +           function val(k) { return map[k] || 0; }
2026-07-27T16:14:04.8627987Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T16:14:04.8628228Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T16:14:04.8628313Z +   
2026-07-27T16:14:04.8628659Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T16:14:04.8629189Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T16:14:04.8629452Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T16:14:04.8630094Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T16:14:04.8630463Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
2026-07-27T16:14:04.8630571Z +           }) };
2026-07-27T16:14:04.8630663Z +   
2026-07-27T16:14:04.8630828Z +           function renderTNode(node, depth) {
2026-07-27T16:14:04.8631023Z +               var wrap = document.createElement("div");
2026-07-27T16:14:04.8631504Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T16:14:04.8631740Z +               var hasKids = node.children && node.children.length;
2026-07-27T16:14:04.8632396Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T16:14:04.8632785Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T16:14:04.8633206Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T16:14:04.8633499Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T16:14:04.8633715Z +               wrap.appendChild(row);
2026-07-27T16:14:04.8633851Z +               if (hasKids) {
2026-07-27T16:14:04.8634148Z +                   var kids = document.createElement("div"); kids.className = "tm-kids";
2026-07-27T16:14:04.8634510Z +                   node.children.forEach(function (c) { kids.appendChild(renderTNode(c, depth + 1)); });
2026-07-27T16:14:04.8634664Z +                   wrap.appendChild(kids);
2026-07-27T16:14:04.8634822Z +                   var open = depth === 0;
2026-07-27T16:14:04.8635260Z +                   kids.style.display = open ? "block" : "none"; caret.textContent = open ? "▾" : "▸";
2026-07-27T16:14:04.8635438Z +                   row.classList.add("clickable");
2026-07-27T16:14:04.8635642Z +                   row.addEventListener("click", function () {
2026-07-27T16:14:04.8636230Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T16:14:04.8636478Z +                   });
2026-07-27T16:14:04.8636579Z +               }
2026-07-27T16:14:04.8636708Z +               return wrap;
2026-07-27T16:14:04.8636806Z +           }
2026-07-27T16:14:04.8636952Z +           panel.innerHTML = "";
2026-07-27T16:14:04.8637235Z +           var head = document.createElement("div"); head.className = "tm-head";
2026-07-27T16:14:04.8637716Z +           head.innerHTML = '<span class="t">Phase timings</span><span class="tm-close" id="tm-close">×</span>';
2026-07-27T16:14:04.8637864Z +           panel.appendChild(head);
2026-07-27T16:14:04.8638055Z +           panel.appendChild(renderTNode(planNode, 0));
