2026-07-27T16:14:04.8617638Z +           allNodes.forEach(function (r) { r.node.classList.toggle("open-details", open); });
2026-07-27T16:14:04.8617766Z +           scheduleEdges();
2026-07-27T16:14:04.8617865Z +       }
