2026-07-27T16:14:04.8625476Z +       function buildTimings() {
2026-07-27T16:14:04.8625677Z +           var btn = document.getElementById("timings-fab");
2026-07-27T16:14:04.8625898Z +           var panel = document.getElementById("timings-panel");
