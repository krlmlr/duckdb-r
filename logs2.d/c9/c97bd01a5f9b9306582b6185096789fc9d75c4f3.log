2026-07-28T07:09:21.8131679Z > library(testthat)
2026-07-28T07:09:21.8131917Z > library(duckdb.dev)
2026-07-28T07:09:21.8132180Z Loading required package: DBI
2026-07-28T07:09:21.8132413Z > 
2026-07-28T07:09:21.8132603Z > # CRAN guard
2026-07-28T07:09:21.8132788Z > #
2026-07-28T07:09:21.8133186Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:09:21.8133790Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:09:21.8134378Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:09:21.8134951Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:09:21.8135528Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:09:21.8136234Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:09:21.8136846Z > # so the guard is obvious and self-contained.
2026-07-28T07:09:21.8137299Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:09:21.8137640Z > 
2026-07-28T07:09:21.8137909Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:09:21.8138215Z +   run <- TRUE
2026-07-28T07:09:21.8138522Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:09:21.8138849Z +   run <- FALSE
2026-07-28T07:09:21.8139056Z + } else {
2026-07-28T07:09:21.8139414Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:09:21.8139864Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:09:21.8140143Z + }
2026-07-28T07:09:21.8140309Z > 
2026-07-28T07:09:21.8140494Z > if (run) {
2026-07-28T07:09:21.8140743Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:09:21.8141010Z + } else {
2026-07-28T07:09:21.8141319Z +   message(
2026-07-28T07:09:21.8141522Z +     "\n",
2026-07-28T07:09:21.8141733Z +     strrep("=", 78),
2026-07-28T07:09:21.8141953Z +     "\n",
2026-07-28T07:09:21.8142197Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:09:21.8142472Z +     "\n",
2026-07-28T07:09:21.8142875Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:09:21.8143466Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:09:21.8144048Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:09:21.8144648Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:09:21.8145072Z +     "manner.\n",
2026-07-28T07:09:21.8145285Z +     "\n",
2026-07-28T07:09:21.8145684Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:09:21.8146336Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:09:21.8147068Z +     "\n",
2026-07-28T07:09:21.8147490Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:09:21.8148170Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:09:21.8148699Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:09:21.8149077Z +     strrep("=", 78),
2026-07-28T07:09:21.8149296Z +     "\n"
2026-07-28T07:09:21.8149475Z +   )
2026-07-28T07:09:21.8149649Z + }
