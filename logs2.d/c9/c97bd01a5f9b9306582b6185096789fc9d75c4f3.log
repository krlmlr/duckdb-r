2026-07-28T07:07:30.1752999Z > library(testthat)
2026-07-28T07:07:30.1753396Z > library(duckdb.dev)
2026-07-28T07:07:30.1753842Z Loading required package: DBI
2026-07-28T07:07:30.1754244Z > 
2026-07-28T07:07:30.1754584Z > # CRAN guard
2026-07-28T07:07:30.1754893Z > #
2026-07-28T07:07:30.1755602Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:30.1757283Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:30.1758368Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:30.1759391Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:30.1760426Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:30.1761510Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:30.1762365Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:30.1763161Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:30.1763749Z > 
2026-07-28T07:07:30.1764207Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:30.1764750Z +   run <- TRUE
2026-07-28T07:07:30.1765297Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:30.1765858Z +   run <- FALSE
2026-07-28T07:07:30.1766213Z + } else {
2026-07-28T07:07:30.1767059Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:30.1767868Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:30.1768359Z + }
2026-07-28T07:07:30.1768639Z > 
2026-07-28T07:07:30.1768961Z > if (run) {
2026-07-28T07:07:30.1769389Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:30.1769852Z + } else {
2026-07-28T07:07:30.1770186Z +   message(
2026-07-28T07:07:30.1770520Z +     "\n",
2026-07-28T07:07:30.1770879Z +     strrep("=", 78),
2026-07-28T07:07:30.1771257Z +     "\n",
2026-07-28T07:07:30.1771686Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:30.1772169Z +     "\n",
2026-07-28T07:07:30.1772891Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:30.1774116Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:30.1775126Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:30.1776223Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:30.1777156Z +     "manner.\n",
2026-07-28T07:07:30.1777517Z +     "\n",
2026-07-28T07:07:30.1778231Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:30.1779382Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:30.1780129Z +     "\n",
2026-07-28T07:07:30.1780862Z +     "To run the test suite locally, set the environment variable before checking:\n",
