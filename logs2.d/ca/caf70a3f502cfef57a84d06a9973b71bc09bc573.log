2026-09-04T14:42:04.1012000Z > library(testthat)
2026-09-04T14:42:04.1012340Z > library(duckdb)
2026-09-04T14:42:04.1012620Z Loading required package: DBI
2026-09-04T14:42:04.1013000Z > 
2026-09-04T14:42:04.1013290Z > # CRAN guard
2026-09-04T14:42:04.1013580Z > #
2026-09-04T14:42:04.1014090Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-04T14:42:04.1014830Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-04T14:42:04.1015440Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-04T14:42:04.1016260Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-04T14:42:04.1017050Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-04T14:42:04.1018000Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-04T14:42:04.1018530Z > # so the guard is obvious and self-contained.
2026-09-04T14:42:04.1019080Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-04T14:42:04.1019510Z > 
2026-09-04T14:42:04.1019790Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-04T14:42:04.1020150Z +   run <- TRUE
2026-09-04T14:42:04.1020530Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-04T14:42:04.1020840Z +   run <- FALSE
2026-09-04T14:42:04.1021120Z + } else {
2026-09-04T14:42:04.1021490Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-04T14:42:04.1022020Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-04T14:42:04.1022290Z + }
2026-09-04T14:42:04.1022580Z > 
2026-09-04T14:42:04.1022860Z > if (run) {
2026-09-04T14:42:04.1023180Z +   test_check(simulate_duckdb()$pkg)
2026-09-04T14:42:04.1023450Z + } else {
2026-09-04T14:42:04.1040820Z +   message(
2026-09-04T14:42:04.1041120Z +     "\n",
2026-09-04T14:42:04.1041490Z +     strrep("=", 78),
2026-09-04T14:42:04.1041740Z +     "\n",
2026-09-04T14:42:04.1042650Z +     "Skipping the duckdb test suite.\n",
2026-09-04T14:42:04.1043000Z +     "\n",
2026-09-04T14:42:04.1043600Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-04T14:42:04.1044320Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-04T14:42:04.1045010Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-04T14:42:04.1045780Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-04T14:42:04.1046260Z +     "manner.\n",
2026-09-04T14:42:04.1046630Z +     "\n",
2026-09-04T14:42:04.1047140Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-04T14:42:04.1047960Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-04T14:42:04.1048420Z +     "\n",
2026-09-04T14:42:04.1049040Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-04T14:42:04.1049740Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-04T14:42:04.1050460Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-04T14:42:04.1051020Z +     strrep("=", 78),
2026-09-04T14:42:04.1051290Z +     "\n"
2026-09-04T14:42:04.1051550Z +   )
2026-09-04T14:42:04.1051750Z + }
