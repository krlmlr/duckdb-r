2026-09-04T14:42:04.2467270Z > # CRAN guard
2026-09-04T14:42:04.2467450Z > #
2026-09-04T14:42:04.2467930Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-04T14:42:04.2468260Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-04T14:42:04.2468600Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-04T14:42:04.2469030Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-04T14:42:04.2469360Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-04T14:42:04.2469660Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-04T14:42:04.2469830Z > # so the guard is obvious and self-contained.
2026-09-04T14:42:04.2470120Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-04T14:42:04.2470290Z > 
2026-09-04T14:42:04.2479620Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-04T14:42:04.2479770Z +   run <- TRUE
2026-09-04T14:42:04.2480230Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-04T14:42:04.2480320Z +   run <- FALSE
2026-09-04T14:42:04.2480390Z + } else {
2026-09-04T14:42:04.2480630Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-04T14:42:04.2480790Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-04T14:42:04.2480840Z + }
2026-09-04T14:42:04.2480890Z > 
2026-09-04T14:42:04.2480960Z > if (run) {
2026-09-04T14:42:04.2481090Z +   test_check(simulate_duckdb()$pkg)
2026-09-04T14:42:04.2481150Z + } else {
2026-09-04T14:42:04.2481220Z +   message(
2026-09-04T14:42:04.2481290Z +     "\n",
2026-09-04T14:42:04.2481380Z +     strrep("=", 78),
2026-09-04T14:42:04.2481450Z +     "\n",
2026-09-04T14:42:04.2481590Z +     "Skipping the duckdb test suite.\n",
2026-09-04T14:42:04.2481660Z +     "\n",
2026-09-04T14:42:04.2481950Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-04T14:42:04.2482210Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-04T14:42:04.2482630Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-04T14:42:04.2482970Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-04T14:42:04.2483070Z +     "manner.\n",
2026-09-04T14:42:04.2483160Z +     "\n",
2026-09-04T14:42:04.2483450Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-04T14:42:04.2483850Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-04T14:42:04.2483960Z +     "\n",
2026-09-04T14:42:04.2484260Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-04T14:42:04.2484740Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-04T14:42:04.2485010Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-04T14:42:04.2485120Z +     strrep("=", 78),
2026-09-04T14:42:04.2485200Z +     "\n"
2026-09-04T14:42:04.2485270Z +   )
2026-09-04T14:42:04.2485330Z + }
