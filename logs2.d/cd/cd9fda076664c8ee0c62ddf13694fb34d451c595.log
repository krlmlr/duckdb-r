2026-07-27T15:27:29.7629636Z [36;1m# Infer each compiler default for the active R version from R CMD config,[0m
2026-07-27T15:27:29.7630409Z [36;1m# then prepend ccache. Reading the resolved defaults preserves the[0m
2026-07-27T15:27:29.7630954Z [36;1m# standard flags R selects per version (e.g. -std=gnu2x for C, -std=gnu++17[0m
2026-07-27T15:27:29.7631490Z [36;1m# / -std=gnu++20 for C++); a plain "CC = ccache gcc" override would drop[0m
2026-07-27T15:27:29.7631987Z [36;1m# them and silently downgrade the standard across the version matrix.[0m
2026-07-27T15:27:29.7632496Z [36;1m# Inference uses an empty user Makevars so we always read the pristine[0m
2026-07-27T15:27:29.7632939Z [36;1m# Makeconf defaults, never a value we just wrote.[0m
2026-07-27T15:27:29.7633939Z [36;1m# Note: the versioned switches (CXX11..CXX23) intentionally come out as[0m
2026-07-27T15:27:29.7634608Z [36;1m# bare "g++" with no -std flag. R keeps the standard in a separate[0m
2026-07-27T15:27:29.7635094Z [36;1m# CXXnnSTD variable (CXX17STD = -std=gnu++17, ...) and applies it on top[0m
2026-07-27T15:27:29.7635610Z [36;1m# at compile time, so wrapping only CXXnn with ccache is correct and we[0m
2026-07-27T15:27:29.7636029Z [36;1m# must NOT pin -std here ourselves.[0m
2026-07-27T15:27:29.7636337Z [36;1mempty_makevars="$(mktemp)"[0m
2026-07-27T15:27:29.7636669Z [36;1mfor var in CC CXX CXX11 CXX14 CXX17 CXX20 CXX23; do[0m
2026-07-27T15:27:29.7637159Z [36;1m  val="$(R_MAKEVARS_USER="$empty_makevars" R CMD config "$var" 2>/dev/null || true)"[0m
2026-07-27T15:27:29.7637595Z [36;1m  if [ -n "$val" ]; then[0m
2026-07-27T15:27:29.7637902Z [36;1m    echo "$var = ccache $val" >> ~/.R/Makevars[0m
2026-07-27T15:27:29.7638215Z [36;1m  fi[0m
2026-07-27T15:27:29.7638427Z [36;1mdone[0m
2026-07-27T15:27:29.7638651Z [36;1mrm -f "$empty_makevars"[0m
