2026-08-06T02:23:33.8766814Z Loading required package: DBI
2026-08-06T02:23:33.8766939Z > 
2026-08-06T02:23:33.8767070Z > # CRAN guard
2026-08-06T02:23:33.8767146Z > #
2026-08-06T02:23:33.8767443Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-06T02:23:33.8767708Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-06T02:23:33.8768223Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-06T02:23:33.8768670Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-06T02:23:33.8769140Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-06T02:23:33.8769588Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-06T02:23:33.8769755Z > # so the guard is obvious and self-contained.
2026-08-06T02:23:33.8769984Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-06T02:23:33.8770053Z > 
2026-08-06T02:23:33.8770544Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-06T02:23:33.8770672Z +   run <- TRUE
2026-08-06T02:23:33.8770866Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-06T02:23:33.8770956Z +   run <- FALSE
2026-08-06T02:23:33.8771032Z + } else {
2026-08-06T02:23:33.8771278Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-06T02:23:33.8771437Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-06T02:23:33.8771499Z + }
2026-08-06T02:23:33.8771564Z > 
2026-08-06T02:23:33.8771651Z > if (run) {
2026-08-06T02:23:33.8771777Z +   test_check(simulate_duckdb()$pkg)
2026-08-06T02:23:33.8771862Z + } else {
2026-08-06T02:23:33.8771944Z +   message(
2026-08-06T02:23:33.8772018Z +     "\n",
2026-08-06T02:23:33.8772118Z +     strrep("=", 78),
2026-08-06T02:23:33.8772293Z +     "\n",
2026-08-06T02:23:33.8772475Z +     "Skipping the duckdb test suite.\n",
2026-08-06T02:23:33.8773519Z +     "\n",
2026-08-06T02:23:33.8774386Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-06T02:23:33.8774862Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-06T02:23:33.8775339Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-06T02:23:33.8776257Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-06T02:23:33.8776456Z +     "manner.\n",
2026-08-06T02:23:33.8776595Z +     "\n",
2026-08-06T02:23:33.8777131Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-06T02:23:33.8777590Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-06T02:23:33.8777680Z +     "\n",
2026-08-06T02:23:33.8777985Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-06T02:23:33.8778358Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-06T02:23:33.8778939Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-06T02:23:33.8779805Z +     strrep("=", 78),
2026-08-06T02:23:33.8779980Z +     "\n"
2026-08-06T02:23:33.8780097Z +   )
2026-08-06T02:23:33.8780204Z + }
