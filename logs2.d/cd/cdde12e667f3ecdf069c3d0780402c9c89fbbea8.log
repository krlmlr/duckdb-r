2026-08-06T02:23:33.6575310Z > # Learn more about the roles of various files in:
2026-08-06T02:23:33.6575834Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-08-06T02:23:33.6576387Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-08-06T02:23:33.6576844Z > 
2026-08-06T02:23:33.6577099Z > library(testthat)
2026-08-06T02:23:33.6577377Z > library(duckdb)
2026-08-06T02:23:33.6577678Z Loading required package: DBI
2026-08-06T02:23:33.6577992Z > 
2026-08-06T02:23:33.6578249Z > # CRAN guard
2026-08-06T02:23:33.6578488Z > #
2026-08-06T02:23:33.6578965Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-06T02:23:33.6597334Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-06T02:23:33.6598464Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-06T02:23:33.6599383Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-06T02:23:33.6600227Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-06T02:23:33.6601126Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-06T02:23:33.6601799Z > # so the guard is obvious and self-contained.
2026-08-06T02:23:33.6603542Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-06T02:23:33.6603958Z > 
2026-08-06T02:23:33.6604241Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-06T02:23:33.6604938Z +   run <- TRUE
2026-08-06T02:23:33.6605493Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-06T02:23:33.6606064Z +   run <- FALSE
2026-08-06T02:23:33.6606589Z + } else {
2026-08-06T02:23:33.6607442Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-06T02:23:33.6608173Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-06T02:23:33.6608547Z + }
2026-08-06T02:23:33.6608767Z > 
2026-08-06T02:23:33.6609039Z > if (run) {
2026-08-06T02:23:33.6609337Z +   test_check(simulate_duckdb()$pkg)
2026-08-06T02:23:33.6609700Z + } else {
2026-08-06T02:23:33.6609939Z +   message(
2026-08-06T02:23:33.6610613Z +     "\n",
2026-08-06T02:23:33.6610929Z +     strrep("=", 78),
2026-08-06T02:23:33.6611581Z +     "\n",
2026-08-06T02:23:33.6612719Z +     "Skipping the duckdb test suite.\n",
2026-08-06T02:23:33.6613291Z +     "\n",
2026-08-06T02:23:33.6613967Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-06T02:23:33.6615109Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-06T02:23:33.6616274Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-06T02:23:33.6617703Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-06T02:23:33.6619674Z +     "manner.\n",
2026-08-06T02:23:33.6620372Z +     "\n",
2026-08-06T02:23:33.6621196Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-06T02:23:33.6622125Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-06T02:23:33.6622906Z +     "\n",
2026-08-06T02:23:33.6623841Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-06T02:23:33.6626286Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-06T02:23:33.6627723Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-06T02:23:33.6629357Z +     strrep("=", 78),
2026-08-06T02:23:33.6629860Z +     "\n"
2026-08-06T02:23:33.6630272Z +   )
2026-08-06T02:23:33.6631087Z + }
