2026-08-09T08:47:01.4802399Z ##[start-action display=Use ccache for compiling R code, and parallelize;id=__self_2.__run_11]
2026-08-09T08:47:01.4941987Z ##[group]Run mkdir -p ~/.R
2026-08-09T08:47:01.4942606Z [36;1mmkdir -p ~/.R[0m
2026-08-09T08:47:01.4942970Z [36;1m# Infer each compiler default for the active R version from R CMD config,[0m
2026-08-09T08:47:01.4943487Z [36;1m# then route it through ccache. Reading the resolved defaults preserves the[0m
2026-08-09T08:47:01.4944002Z [36;1m# standard flags R selects per version (e.g. -std=gnu2x for C, -std=gnu++17[0m
2026-08-09T08:47:01.4944511Z [36;1m# / -std=gnu++20 for C++); a plain "CC = ccache gcc" override would drop[0m
2026-08-09T08:47:01.4944991Z [36;1m# them and silently downgrade the standard across the version matrix.[0m
2026-08-09T08:47:01.4945483Z [36;1m# Inference uses an empty user Makevars so we always read the pristine[0m
2026-08-09T08:47:01.4945899Z [36;1m# Makeconf defaults, never a value we just wrote.[0m
2026-08-09T08:47:01.4946312Z [36;1m# Note: the versioned switches (CXX11..CXX23) intentionally come out as[0m
2026-08-09T08:47:01.4946782Z [36;1m# bare "g++" with no -std flag. R keeps the standard in a separate[0m
2026-08-09T08:47:01.4947262Z [36;1m# CXXnnSTD variable (CXX17STD = -std=gnu++17, ...) and applies it on top[0m
2026-08-09T08:47:01.4947929Z [36;1m# at compile time, so wrapping only CXXnn with ccache is correct and we[0m
2026-08-09T08:47:01.4948319Z [36;1m# must NOT pin -std here ourselves.[0m
2026-08-09T08:47:01.4948569Z [36;1m#[0m
2026-08-09T08:47:01.4948840Z [36;1m# On Unix, ccache is attached through a generated one-word wrapper[0m
2026-08-09T08:47:01.4949306Z [36;1m# command (ccache-gcc, ccache-g++, ...) rather than the more obvious[0m
2026-08-09T08:47:01.4949751Z [36;1m# "CC = ccache gcc" prefix. R-devel briefly could not cope with a[0m
2026-08-09T08:47:01.4950212Z [36;1m# compiler command of more than one word: tools:::ccE(), which backs the[0m
2026-08-09T08:47:01.4950688Z [36;1m# "checking use of non-API entry points" check and therefore runs for[0m
2026-08-09T08:47:01.4951165Z [36;1m# every package with compiled code, read R CMD config CC, kept only the[0m
2026-08-09T08:47:01.4951630Z [36;1m# first word, and ran that. With "CC = ccache gcc" that left a bare[0m
2026-08-09T08:47:01.4952077Z [36;1m# "ccache", and the check died with "ccache: invalid option -- 'E'".[0m
2026-08-09T08:47:01.4953019Z [36;1m# https://github.com/r-devel/r-svn/commit/ca19f35240517186ed447e773ee67b55e207cf27[0m
2026-08-09T08:47:01.4953526Z [36;1m# https://bugs.r-project.org/show_bug.cgi?id=19130[0m
2026-08-09T08:47:01.4953955Z [36;1m# Upstream has since dropped the truncation again, so the prefix works[0m
2026-08-09T08:47:01.4954437Z [36;1m# once more -- but it takes a while for that to reach the R-devel builds[0m
2026-08-09T08:47:01.4954908Z [36;1m# CI installs, so the wrapper is still doing real work here. It stays[0m
2026-08-09T08:47:01.4955343Z [36;1m# after that too: it costs nothing and is correct either way.[0m
2026-08-09T08:47:01.4955658Z [36;1m#[0m
2026-08-09T08:47:01.4955952Z [36;1m# Windows deliberately keeps the plain prefix, as a control group: it is[0m
2026-08-09T08:47:01.4956459Z [36;1m# where a repeat of that upstream change would show up, while the Unix[0m
2026-08-09T08:47:01.4956829Z [36;1m# jobs carry on regardless.[0m
2026-08-09T08:47:01.4957099Z [36;1mccache_bin="$(command -v ccache || true)"[0m
2026-08-09T08:47:01.4957376Z [36;1mif [ -z "$ccache_bin" ]; then[0m
2026-08-09T08:47:01.4957715Z [36;1m  echo "::warning::ccache is not on the PATH, compiling without it."[0m
2026-08-09T08:47:01.4958054Z [36;1melse[0m
2026-08-09T08:47:01.4958258Z [36;1m  wrapper_dir="$HOME/.R/ccache-wrappers"[0m
2026-08-09T08:47:01.4958549Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-08-09T08:47:01.4958967Z [36;1m    mkdir -p "$wrapper_dir"[0m
2026-08-09T08:47:01.4959199Z [36;1m  fi[0m
2026-08-09T08:47:01.4959353Z [36;1m[0m
2026-08-09T08:47:01.4959521Z [36;1m  empty_makevars="$(mktemp)"[0m
2026-08-09T08:47:01.4959811Z [36;1m  for var in CC CXX CXX11 CXX14 CXX17 CXX20 CXX23; do[0m
2026-08-09T08:47:01.4960254Z [36;1m    val="$(R_MAKEVARS_USER="$empty_makevars" R CMD config "$var" 2>/dev/null || true)"[0m
2026-08-09T08:47:01.4960668Z [36;1m    if [ -z "$val" ]; then[0m
2026-08-09T08:47:01.4960891Z [36;1m      continue[0m
2026-08-09T08:47:01.4961073Z [36;1m    fi[0m
2026-08-09T08:47:01.4961267Z [36;1m    if [ "$RUNNER_OS" = "Windows" ]; then[0m
2026-08-09T08:47:01.4961565Z [36;1m      echo "$var = ccache $val" >> ~/.R/Makevars[0m
2026-08-09T08:47:01.4961834Z [36;1m      continue[0m
2026-08-09T08:47:01.4962015Z [36;1m    fi[0m
2026-08-09T08:47:01.4962171Z [36;1m[0m
2026-08-09T08:47:01.4962434Z [36;1m    # Split "gcc -std=gnu2x" into the compiler and its flags: only the[0m
2026-08-09T08:47:01.4962891Z [36;1m    # compiler is wrapped, the flags are passed through unchanged.[0m
2026-08-09T08:47:01.4963346Z [36;1m    # ccache and the compiler are both found on the PATH at run time,[0m
2026-08-09T08:47:01.4963744Z [36;1m    # nothing is baked into the wrapper by path.[0m
2026-08-09T08:47:01.4964044Z [36;1m    prog="${val%%[[:space:]]*}"[0m
2026-08-09T08:47:01.4964381Z [36;1m    flags="${val#"$prog"}"[0m
2026-08-09T08:47:01.4964645Z [36;1m    wrapper="ccache-$(basename "$prog")"[0m
2026-08-09T08:47:01.4964898Z [36;1m[0m
2026-08-09T08:47:01.4965101Z [36;1m    if [ ! -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-09T08:47:01.4965510Z [36;1m      printf '#!/bin/sh\nexec ccache %s "$@"\n' "$prog" > "$wrapper_dir/$wrapper"[0m
2026-08-09T08:47:01.4965910Z [36;1m      chmod +x "$wrapper_dir/$wrapper"[0m
2026-08-09T08:47:01.4966250Z [36;1m      # Never hand R a wrapper that has not been shown to work.[0m
2026-08-09T08:47:01.4966655Z [36;1m      if ! "$wrapper_dir/$wrapper" --version > /dev/null; then[0m
2026-08-09T08:47:01.4967000Z [36;1m        rm -f "$wrapper_dir/$wrapper"[0m
2026-08-09T08:47:01.4967374Z [36;1m        echo "::warning::No usable $wrapper, compiling $var without ccache."[0m
2026-08-09T08:47:01.4967727Z [36;1m      fi[0m
2026-08-09T08:47:01.4967891Z [36;1m    fi[0m
2026-08-09T08:47:01.4968049Z [36;1m[0m
2026-08-09T08:47:01.4968244Z [36;1m    if [ -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-09T08:47:01.4968556Z [36;1m      echo "$var = $wrapper$flags" >> ~/.R/Makevars[0m
2026-08-09T08:47:01.4968827Z [36;1m    fi[0m
