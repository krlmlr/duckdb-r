2026-07-28T04:40:50.5141605Z > # CRAN guard
2026-07-28T04:40:50.5141900Z > #
2026-07-28T04:40:50.5142546Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T04:40:50.5143473Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T04:40:50.5144630Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T04:40:50.5145661Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T04:40:50.5146555Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T04:40:50.5147691Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T04:40:50.5148434Z > # so the guard is obvious and self-contained.
2026-07-28T04:40:50.5149135Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T04:40:50.5149654Z > 
2026-07-28T04:40:50.5150077Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T04:40:50.5150537Z +   run <- TRUE
2026-07-28T04:40:50.5151018Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T04:40:50.5151528Z +   run <- FALSE
2026-07-28T04:40:50.5151850Z + } else {
2026-07-28T04:40:50.5152412Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T04:40:50.5153151Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T04:40:50.5153572Z + }
2026-07-28T04:40:50.5153834Z > 
2026-07-28T04:40:50.5154127Z > if (run) {
2026-07-28T04:40:50.5154526Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T04:40:50.5154935Z + } else {
2026-07-28T04:40:50.5155230Z +   message(
