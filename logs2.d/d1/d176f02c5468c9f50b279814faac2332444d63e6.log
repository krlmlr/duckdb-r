2026-07-26T10:22:29.3497484Z > # It is recommended that you do not modify it.
2026-07-26T10:22:29.3498115Z > #
2026-07-26T10:22:29.3498644Z > # Where should you do additional test configuration?
2026-07-26T10:22:29.3499320Z > # Learn more about the roles of various files in:
2026-07-26T10:22:29.3500320Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-26T10:22:29.3501019Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-26T10:22:29.3501472Z > 
2026-07-26T10:22:29.3501750Z > library(testthat)
2026-07-26T10:22:29.3502064Z > library(duckdb)
2026-07-26T10:22:29.3502442Z Loading required package: DBI
2026-07-26T10:22:29.3502765Z > 
2026-07-26T10:22:29.3503043Z > # CRAN guard
2026-07-26T10:22:29.3503325Z > #
2026-07-26T10:22:29.3503908Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-26T10:22:29.3504756Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-26T10:22:29.3505607Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-26T10:22:29.3506446Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-26T10:22:29.3507297Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-26T10:22:29.3508172Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-26T10:22:29.3508916Z > # so the guard is obvious and self-contained.
2026-07-26T10:22:29.3510425Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-26T10:22:29.3510958Z > 
2026-07-26T10:22:29.3511371Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-26T10:22:29.3511851Z +   run <- TRUE
2026-07-26T10:22:29.3512325Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-26T10:22:29.3512812Z +   run <- FALSE
2026-07-26T10:22:29.3513148Z + } else {
2026-07-26T10:22:29.3513691Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-26T10:22:29.3515205Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-26T10:22:29.3515651Z + }
2026-07-26T10:22:29.3515925Z > 
2026-07-26T10:22:29.3516224Z > if (run) {
2026-07-26T10:22:29.3516605Z +   test_check(simulate_duckdb()$pkg)
2026-07-26T10:22:29.3517018Z + } else {
2026-07-26T10:22:29.3517294Z +   message(
2026-07-26T10:22:29.3517578Z +     "\n",
2026-07-26T10:22:29.3517887Z +     strrep("=", 78),
2026-07-26T10:22:29.3518191Z +     "\n",
2026-07-26T10:22:29.3518530Z +     "Skipping the duckdb test suite.\n",
2026-07-26T10:22:29.3518917Z +     "\n",
2026-07-26T10:22:29.3519482Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-26T10:22:29.3520678Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-26T10:22:29.3521450Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-26T10:22:29.3522618Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-26T10:22:29.3523265Z +     "manner.\n",
2026-07-26T10:22:29.3523590Z +     "\n",
2026-07-26T10:22:29.3524146Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-26T10:22:29.3525017Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-26T10:22:29.3525616Z +     "\n",
2026-07-26T10:22:29.3526180Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-26T10:22:29.3527047Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-26T10:22:29.3527823Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-26T10:22:29.3528464Z +     strrep("=", 78),
2026-07-26T10:22:29.3528786Z +     "\n"
2026-07-26T10:22:29.3529125Z +   )
2026-07-26T10:22:29.3529325Z + }
