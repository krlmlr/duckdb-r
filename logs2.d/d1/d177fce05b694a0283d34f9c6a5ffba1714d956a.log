2026-07-27T07:19:36.8275215Z > library(testthat)
2026-07-27T07:19:36.8275457Z > library(duckdb.dev)
2026-07-27T07:19:36.8276118Z Loading required package: DBI
2026-07-27T07:19:36.8276389Z > 
2026-07-27T07:19:36.8276587Z > # CRAN guard
2026-07-27T07:19:36.8276776Z > #
2026-07-27T07:19:36.8277185Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T07:19:36.8277793Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T07:19:36.8278392Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T07:19:36.8278958Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T07:19:36.8279527Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T07:19:36.8280126Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T07:19:36.8280602Z > # so the guard is obvious and self-contained.
2026-07-27T07:19:36.8281051Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T07:19:36.8281395Z > 
2026-07-27T07:19:36.8281660Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T07:19:36.8281964Z +   run <- TRUE
2026-07-27T07:19:36.8282430Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T07:19:36.8282770Z +   run <- FALSE
2026-07-27T07:19:36.8282983Z + } else {
2026-07-27T07:19:36.8283347Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T07:19:36.8298432Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T07:19:36.8298791Z + }
2026-07-27T07:19:36.8298973Z > 
2026-07-27T07:19:36.8299176Z > if (run) {
2026-07-27T07:19:36.8299448Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T07:19:36.8299746Z + } else {
2026-07-27T07:19:36.8299953Z +   message(
2026-07-27T07:19:36.8300151Z +     "\n",
2026-07-27T07:19:36.8300377Z +     strrep("=", 78),
2026-07-27T07:19:36.8300621Z +     "\n",
2026-07-27T07:19:36.8300880Z +     "Skipping the duckdb test suite.\n",
2026-07-27T07:19:36.8301170Z +     "\n",
2026-07-27T07:19:36.8301627Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T07:19:36.8302269Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T07:19:36.8302859Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T07:19:36.8303491Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T07:19:36.8303922Z +     "manner.\n",
2026-07-27T07:19:36.8304141Z +     "\n",
2026-07-27T07:19:36.8304549Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T07:19:36.8305201Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T07:19:36.8305934Z +     "\n",
2026-07-27T07:19:36.8306514Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T07:19:36.8307108Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T07:19:36.8307649Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T07:19:36.8308109Z +     strrep("=", 78),
2026-07-27T07:19:36.8308331Z +     "\n"
2026-07-27T07:19:36.8308513Z +   )
2026-07-27T07:19:36.8308691Z + }
