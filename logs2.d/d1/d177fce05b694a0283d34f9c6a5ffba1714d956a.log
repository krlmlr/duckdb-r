2026-07-27T07:21:27.9172447Z > # This file is part of the standard setup for testthat.
2026-07-27T07:21:27.9172850Z > # It is recommended that you do not modify it.
2026-07-27T07:21:27.9173141Z > #
2026-07-27T07:21:27.9173437Z > # Where should you do additional test configuration?
2026-07-27T07:21:27.9173919Z > # Learn more about the roles of various files in:
2026-07-27T07:21:27.9174417Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T07:21:27.9174937Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T07:21:27.9175269Z > 
2026-07-27T07:21:27.9175480Z > library(testthat)
2026-07-27T07:21:27.9176044Z > library(duckdb.dev)
2026-07-27T07:21:27.9176332Z Loading required package: DBI
2026-07-27T07:21:27.9176571Z > 
2026-07-27T07:21:27.9176775Z > # CRAN guard
2026-07-27T07:21:27.9176968Z > #
2026-07-27T07:21:27.9177384Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T07:21:27.9178015Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T07:21:27.9178618Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T07:21:27.9179201Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T07:21:27.9179793Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T07:21:27.9180403Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T07:21:27.9180887Z > # so the guard is obvious and self-contained.
2026-07-27T07:21:27.9181356Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T07:21:27.9181716Z > 
2026-07-27T07:21:27.9181996Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T07:21:27.9182308Z +   run <- TRUE
2026-07-27T07:21:27.9182641Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T07:21:27.9182978Z +   run <- FALSE
2026-07-27T07:21:27.9183196Z + } else {
2026-07-27T07:21:27.9183567Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T07:21:27.9184037Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T07:21:27.9184327Z + }
2026-07-27T07:21:27.9184502Z > 
2026-07-27T07:21:27.9184702Z > if (run) {
2026-07-27T07:21:27.9184962Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T07:21:27.9185242Z + } else {
2026-07-27T07:21:27.9185439Z +   message(
2026-07-27T07:21:27.9185914Z +     "\n",
2026-07-27T07:21:27.9186142Z +     strrep("=", 78),
2026-07-27T07:21:27.9186374Z +     "\n",
2026-07-27T07:21:27.9186639Z +     "Skipping the duckdb test suite.\n",
2026-07-27T07:21:27.9186940Z +     "\n",
2026-07-27T07:21:27.9187554Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T07:21:27.9188177Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T07:21:27.9188755Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T07:21:27.9189371Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T07:21:27.9189799Z +     "manner.\n",
2026-07-27T07:21:27.9190027Z +     "\n",
2026-07-27T07:21:27.9190433Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T07:21:27.9191087Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T07:21:27.9191533Z +     "\n",
2026-07-27T07:21:27.9191953Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T07:21:27.9192609Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T07:21:27.9193154Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T07:21:27.9193540Z +     strrep("=", 78),
2026-07-27T07:21:27.9193770Z +     "\n"
2026-07-27T07:21:27.9193966Z +   )
2026-07-27T07:21:27.9194145Z + }
