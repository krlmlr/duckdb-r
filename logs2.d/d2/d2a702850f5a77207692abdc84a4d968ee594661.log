2026-09-13T02:46:50.3357726Z [36;1m      if ! "$wrapper_dir/$wrapper" --version > /dev/null; then[0m
2026-09-13T02:46:50.3358104Z [36;1m        rm -f "$wrapper_dir/$wrapper"[0m
2026-09-13T02:46:50.3358482Z [36;1m        echo "::warning::No usable $wrapper, compiling $var without ccache."[0m
2026-09-13T02:46:50.3358844Z [36;1m      fi[0m
2026-09-13T02:46:50.3359009Z [36;1m    fi[0m
2026-09-13T02:46:50.3359170Z [36;1m[0m
2026-09-13T02:46:50.3359365Z [36;1m    if [ -f "$wrapper_dir/$wrapper" ]; then[0m
2026-09-13T02:46:50.3359688Z [36;1m      echo "$var = $wrapper$flags" >> ~/.R/Makevars[0m
2026-09-13T02:46:50.3360040Z [36;1m    fi[0m
2026-09-13T02:46:50.3360211Z [36;1m  done[0m
2026-09-13T02:46:50.3360387Z [36;1m  rm -f "$empty_makevars"[0m
2026-09-13T02:46:50.3360613Z [36;1m[0m
2026-09-13T02:46:50.3360798Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-09-13T02:46:50.3361087Z [36;1m    echo "$wrapper_dir" >> "$GITHUB_PATH"[0m
2026-09-13T02:46:50.3361403Z [36;1m    echo "===== ccache wrappers in $wrapper_dir ====="[0m
