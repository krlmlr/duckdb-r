2026-09-13T02:46:50.3368594Z [36;1mncores="$(Rscript --vanilla -e 'n <- parallel::detectCores(); cat(if (is.na(n) || n < 1) 2L else as.integer(n))')"[0m
2026-09-13T02:46:50.3369144Z [36;1mecho "MAKEFLAGS = -j${ncores}" >> ~/.R/Makevars[0m
2026-09-13T02:46:50.3369461Z [36;1mecho "===== generated ~/.R/Makevars ====="[0m
2026-09-13T02:46:50.3369728Z [36;1mcat ~/.R/Makevars[0m
2026-09-13T02:46:50.3369963Z [36;1mecho "==================================="[0m
