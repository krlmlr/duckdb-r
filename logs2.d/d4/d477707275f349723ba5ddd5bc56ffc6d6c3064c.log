2026-07-27T05:41:20.0080627Z > # CRAN guard
2026-07-27T05:41:20.0080835Z > #
2026-07-27T05:41:20.0081331Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T05:41:20.0082057Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T05:41:20.0082762Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T05:41:20.0083368Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T05:41:20.0084164Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T05:41:20.0085184Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T05:41:20.0085715Z > # so the guard is obvious and self-contained.
2026-07-27T05:41:20.0086347Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T05:41:20.0087035Z > 
2026-07-27T05:41:20.0087456Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T05:41:20.0087760Z +   run <- TRUE
2026-07-27T05:41:20.0088221Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T05:41:20.0088562Z +   run <- FALSE
2026-07-27T05:41:20.0088781Z + } else {
2026-07-27T05:41:20.0089137Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T05:41:20.0089585Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T05:41:20.0089869Z + }
2026-07-27T05:41:20.0090035Z > 
2026-07-27T05:41:20.0090585Z > if (run) {
2026-07-27T05:41:20.0090860Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T05:41:20.0091128Z + } else {
2026-07-27T05:41:20.0091319Z +   message(
2026-07-27T05:41:20.0091507Z +     "\n",
2026-07-27T05:41:20.0091718Z +     strrep("=", 78),
2026-07-27T05:41:20.0091933Z +     "\n",
2026-07-27T05:41:20.0092172Z +     "Skipping the duckdb test suite.\n",
2026-07-27T05:41:20.0092454Z +     "\n",
2026-07-27T05:41:20.0092857Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T05:41:20.0093460Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T05:41:20.0094029Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T05:41:20.0094626Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T05:41:20.0095045Z +     "manner.\n",
2026-07-27T05:41:20.0095249Z +     "\n",
2026-07-27T05:41:20.0095642Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T05:41:20.0096276Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T05:41:20.0096706Z +     "\n",
2026-07-27T05:41:20.0097107Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T05:41:20.0097683Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T05:41:20.0098228Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T05:41:20.0098709Z +     strrep("=", 78),
