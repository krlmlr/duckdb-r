2026-07-27T05:43:12.7643811Z > # This file is part of the standard setup for testthat.
2026-07-27T05:43:12.7644226Z > # It is recommended that you do not modify it.
2026-07-27T05:43:12.7644515Z > #
2026-07-27T05:43:12.7644805Z > # Where should you do additional test configuration?
2026-07-27T05:43:12.7645214Z > # Learn more about the roles of various files in:
2026-07-27T05:43:12.7645704Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T05:43:12.7646212Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T05:43:12.7646629Z > 
2026-07-27T05:43:12.7646834Z > library(testthat)
2026-07-27T05:43:12.7647068Z > library(duckdb.dev)
2026-07-27T05:43:12.7647333Z Loading required package: DBI
2026-07-27T05:43:12.7647577Z > 
2026-07-27T05:43:12.7647769Z > # CRAN guard
2026-07-27T05:43:12.7647953Z > #
2026-07-27T05:43:12.7648358Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T05:43:12.7648979Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T05:43:12.7649578Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T05:43:12.7650158Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T05:43:12.7651115Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T05:43:12.7651732Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T05:43:12.7652220Z > # so the guard is obvious and self-contained.
2026-07-27T05:43:12.7652691Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T05:43:12.7653037Z > 
2026-07-27T05:43:12.7653310Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T05:43:12.7653626Z +   run <- TRUE
2026-07-27T05:43:12.7653947Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T05:43:12.7654278Z +   run <- FALSE
2026-07-27T05:43:12.7654493Z + } else {
2026-07-27T05:43:12.7654853Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T05:43:12.7655319Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T05:43:12.7655604Z + }
2026-07-27T05:43:12.7655776Z > 
2026-07-27T05:43:12.7655967Z > if (run) {
2026-07-27T05:43:12.7656218Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T05:43:12.7656496Z + } else {
2026-07-27T05:43:12.7656690Z +   message(
2026-07-27T05:43:12.7656888Z +     "\n",
2026-07-27T05:43:12.7657103Z +     strrep("=", 78),
2026-07-27T05:43:12.7657332Z +     "\n",
2026-07-27T05:43:12.7657585Z +     "Skipping the duckdb test suite.\n",
2026-07-27T05:43:12.7657868Z +     "\n",
2026-07-27T05:43:12.7658424Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T05:43:12.7659056Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T05:43:12.7659636Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T05:43:12.7660540Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T05:43:12.7660995Z +     "manner.\n",
2026-07-27T05:43:12.7661214Z +     "\n",
2026-07-27T05:43:12.7661622Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T05:43:12.7662280Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T05:43:12.7662715Z +     "\n",
2026-07-27T05:43:12.7663126Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T05:43:12.7663736Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T05:43:12.7664274Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T05:43:12.7664751Z +     strrep("=", 78),
2026-07-27T05:43:12.7664976Z +     "\n"
2026-07-27T05:43:12.7665149Z +   )
2026-07-27T05:43:12.7665318Z + }
