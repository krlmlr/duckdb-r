2026-07-27T06:46:07.6904443Z > # This file is part of the standard setup for testthat.
2026-07-27T06:46:07.6904850Z > # It is recommended that you do not modify it.
2026-07-27T06:46:07.6905144Z > #
2026-07-27T06:46:07.6905447Z > # Where should you do additional test configuration?
2026-07-27T06:46:07.6905850Z > # Learn more about the roles of various files in:
2026-07-27T06:46:07.6906343Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:46:07.6906859Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:46:07.6907197Z > 
2026-07-27T06:46:07.6907420Z > library(testthat)
2026-07-27T06:46:07.6907665Z > library(duckdb.dev)
2026-07-27T06:46:07.6907955Z Loading required package: DBI
2026-07-27T06:46:07.6908198Z > 
2026-07-27T06:46:07.6908402Z > # CRAN guard
2026-07-27T06:46:07.6908602Z > #
2026-07-27T06:46:07.6909019Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:46:07.6909643Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:46:07.6910246Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:46:07.6910836Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:46:07.6911668Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:46:07.6912284Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:46:07.6912775Z > # so the guard is obvious and self-contained.
2026-07-27T06:46:07.6913234Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:46:07.6913592Z > 
2026-07-27T06:46:07.6913892Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:46:07.6914215Z +   run <- TRUE
2026-07-27T06:46:07.6914543Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:46:07.6914885Z +   run <- FALSE
2026-07-27T06:46:07.6915116Z + } else {
2026-07-27T06:46:07.6915485Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:46:07.6915950Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:46:07.6916243Z + }
2026-07-27T06:46:07.6916423Z > 
2026-07-27T06:46:07.6916622Z > if (run) {
2026-07-27T06:46:07.6916882Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:46:07.6917167Z + } else {
2026-07-27T06:46:07.6917369Z +   message(
2026-07-27T06:46:07.6917578Z +     "\n",
2026-07-27T06:46:07.6917811Z +     strrep("=", 78),
2026-07-27T06:46:07.6918043Z +     "\n",
2026-07-27T06:46:07.6918302Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:46:07.6918588Z +     "\n",
2026-07-27T06:46:07.6919186Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:46:07.6919798Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:46:07.6920430Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:46:07.6921040Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:46:07.6921689Z +     "manner.\n",
2026-07-27T06:46:07.6921918Z +     "\n",
2026-07-27T06:46:07.6922339Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:46:07.6922987Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:46:07.6923429Z +     "\n",
2026-07-27T06:46:07.6923857Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:46:07.6924451Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:46:07.6925074Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:46:07.6925469Z +     strrep("=", 78),
2026-07-27T06:46:07.6925702Z +     "\n"
2026-07-27T06:46:07.6925893Z +   )
2026-07-27T06:46:07.6926077Z + }
