2026-07-27T06:44:16.0152697Z > library(testthat)
2026-07-27T06:44:16.0152972Z > library(duckdb.dev)
2026-07-27T06:44:16.0153359Z Loading required package: DBI
2026-07-27T06:44:16.0153613Z > 
2026-07-27T06:44:16.0153823Z > # CRAN guard
2026-07-27T06:44:16.0154026Z > #
2026-07-27T06:44:16.0154474Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:44:16.0155131Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:44:16.0155812Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:44:16.0156428Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:44:16.0157053Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:44:16.0157714Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:44:16.0158242Z > # so the guard is obvious and self-contained.
2026-07-27T06:44:16.0158716Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:44:16.0159075Z > 
2026-07-27T06:44:16.0159356Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:44:16.0159668Z +   run <- TRUE
2026-07-27T06:44:16.0159994Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:44:16.0160523Z +   run <- FALSE
2026-07-27T06:44:16.0160752Z + } else {
2026-07-27T06:44:16.0161121Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:44:16.0161859Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:44:16.0162146Z + }
2026-07-27T06:44:16.0162320Z > 
2026-07-27T06:44:16.0162514Z > if (run) {
2026-07-27T06:44:16.0162777Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:44:16.0163053Z + } else {
2026-07-27T06:44:16.0163253Z +   message(
2026-07-27T06:44:16.0163454Z +     "\n",
2026-07-27T06:44:16.0163672Z +     strrep("=", 78),
2026-07-27T06:44:16.0163900Z +     "\n",
2026-07-27T06:44:16.0164154Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:44:16.0164442Z +     "\n",
2026-07-27T06:44:16.0164855Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:44:16.0165454Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:44:16.0166131Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:44:16.0166738Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:44:16.0167232Z +     "manner.\n",
2026-07-27T06:44:16.0167449Z +     "\n",
2026-07-27T06:44:16.0167862Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:44:16.0168511Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:44:16.0168948Z +     "\n",
2026-07-27T06:44:16.0169372Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:44:16.0169982Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:44:16.0170523Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:44:16.0170911Z +     strrep("=", 78),
2026-07-27T06:44:16.0171149Z +     "\n"
2026-07-27T06:44:16.0171585Z +   )
2026-07-27T06:44:16.0171776Z + }
