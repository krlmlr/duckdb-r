2026-08-15T03:01:24.0591072Z > # This file is part of the standard setup for testthat.
2026-08-15T03:01:24.0591763Z > # It is recommended that you do not modify it.
2026-08-15T03:01:24.0592128Z > #
2026-08-15T03:01:24.0592434Z > # Where should you do additional test configuration?
2026-08-15T03:01:24.0592834Z > # Learn more about the roles of various files in:
2026-08-15T03:01:24.0594462Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-08-15T03:01:24.0595024Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-08-15T03:01:24.0597873Z > 
2026-08-15T03:01:24.0598136Z > library(testthat)
2026-08-15T03:01:24.0598376Z > library(duckdb)
2026-08-15T03:01:24.0599066Z Loading required package: DBI
2026-08-15T03:01:24.0599313Z > 
2026-08-15T03:01:24.0599890Z > # CRAN guard
2026-08-15T03:01:24.0600168Z > #
2026-08-15T03:01:24.0600568Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-15T03:01:24.0601628Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-15T03:01:24.0602275Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-15T03:01:24.0602862Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-15T03:01:24.0603641Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-15T03:01:24.0604280Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-15T03:01:24.0605271Z > # so the guard is obvious and self-contained.
2026-08-15T03:01:24.0605787Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-15T03:01:24.0606130Z > 
2026-08-15T03:01:24.0606697Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-15T03:01:24.0607080Z +   run <- TRUE
2026-08-15T03:01:24.0607398Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-15T03:01:24.0608414Z +   run <- FALSE
2026-08-15T03:01:24.0608648Z + } else {
2026-08-15T03:01:24.0609287Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-15T03:01:24.0611301Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-15T03:01:24.0611716Z + }
2026-08-15T03:01:24.0612359Z > 
2026-08-15T03:01:24.0612590Z > if (run) {
2026-08-15T03:01:24.0612972Z +   test_check(simulate_duckdb()$pkg)
2026-08-15T03:01:24.0613286Z + } else {
2026-08-15T03:01:24.0613532Z +   message(
2026-08-15T03:01:24.0613721Z +     "\n",
2026-08-15T03:01:24.0613952Z +     strrep("=", 78),
2026-08-15T03:01:24.0614220Z +     "\n",
2026-08-15T03:01:24.0614478Z +     "Skipping the duckdb test suite.\n",
2026-08-15T03:01:24.0614773Z +     "\n",
2026-08-15T03:01:24.0616205Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-15T03:01:24.0617088Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-15T03:01:24.0617670Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-15T03:01:24.0618602Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-15T03:01:24.0619056Z +     "manner.\n",
2026-08-15T03:01:24.0619285Z +     "\n",
2026-08-15T03:01:24.0620664Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-15T03:01:24.0621326Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-15T03:01:24.0622133Z +     "\n",
2026-08-15T03:01:24.0622580Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-15T03:01:24.0623170Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-15T03:01:24.0623765Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-15T03:01:24.0624154Z +     strrep("=", 78),
2026-08-15T03:01:24.0624389Z +     "\n"
2026-08-15T03:01:24.0624596Z +   )
2026-08-15T03:01:24.0624761Z + }
