2026-08-15T03:01:23.6191859Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-15T03:01:23.6192984Z > 
2026-08-15T03:01:23.6193922Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-15T03:01:23.6196720Z +   run <- TRUE
2026-08-15T03:01:23.6198235Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-15T03:01:23.6199292Z +   run <- FALSE
2026-08-15T03:01:23.6199531Z + } else {
2026-08-15T03:01:23.6201755Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-15T03:01:23.6202398Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-15T03:01:23.6203038Z + }
2026-08-15T03:01:23.6203562Z > 
2026-08-15T03:01:23.6203806Z > if (run) {
2026-08-15T03:01:23.6204440Z +   test_check(simulate_duckdb()$pkg)
2026-08-15T03:01:23.6205051Z + } else {
2026-08-15T03:01:23.6208609Z +   message(
2026-08-15T03:01:23.6209049Z +     "\n",
2026-08-15T03:01:23.6209786Z +     strrep("=", 78),
2026-08-15T03:01:23.6210040Z +     "\n",
2026-08-15T03:01:23.6210639Z +     "Skipping the duckdb test suite.\n",
2026-08-15T03:01:23.6210992Z +     "\n",
2026-08-15T03:01:23.6211398Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-15T03:01:23.6212454Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-15T03:01:23.6213060Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-15T03:01:23.6213956Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-15T03:01:23.6214414Z +     "manner.\n",
2026-08-15T03:01:23.6214639Z +     "\n",
2026-08-15T03:01:23.6216395Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-15T03:01:23.6217063Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-15T03:01:23.6217502Z +     "\n",
2026-08-15T03:01:23.6218318Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-15T03:01:23.6218893Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-15T03:01:23.6219869Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-15T03:01:23.6220343Z +     strrep("=", 78),
2026-08-15T03:01:23.6220582Z +     "\n"
2026-08-15T03:01:23.6221131Z +   )
2026-08-15T03:01:23.6221352Z + }
