2026-07-28T07:07:34.9381536Z > # CRAN guard
2026-07-28T07:07:34.9381711Z > #
2026-07-28T07:07:34.9382405Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:07:34.9383040Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:07:34.9383735Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:07:34.9384310Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:07:34.9384879Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:07:34.9385474Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:07:34.9385941Z > # so the guard is obvious and self-contained.
2026-07-28T07:07:34.9386390Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:07:34.9386727Z > 
2026-07-28T07:07:34.9386986Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:07:34.9387288Z +   run <- TRUE
2026-07-28T07:07:34.9387591Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:07:34.9387917Z +   run <- FALSE
2026-07-28T07:07:34.9388121Z + } else {
2026-07-28T07:07:34.9388478Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:07:34.9388915Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:07:34.9389182Z + }
2026-07-28T07:07:34.9389338Z > 
2026-07-28T07:07:34.9389517Z > if (run) {
2026-07-28T07:07:34.9389760Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:07:34.9390017Z + } else {
2026-07-28T07:07:34.9390202Z +   message(
2026-07-28T07:07:34.9390392Z +     "\n",
2026-07-28T07:07:34.9390596Z +     strrep("=", 78),
2026-07-28T07:07:34.9390808Z +     "\n",
2026-07-28T07:07:34.9391046Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:07:34.9391317Z +     "\n",
2026-07-28T07:07:34.9391717Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:07:34.9392692Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:07:34.9393373Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:07:34.9394049Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:07:34.9394480Z +     "manner.\n",
2026-07-28T07:07:34.9394695Z +     "\n",
2026-07-28T07:07:34.9395102Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:07:34.9395741Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:07:34.9396166Z +     "\n",
2026-07-28T07:07:34.9396570Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:07:34.9397149Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:07:34.9397675Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:07:34.9398185Z +     strrep("=", 78),
2026-07-28T07:07:34.9398414Z +     "\n"
2026-07-28T07:07:34.9398597Z +   )
2026-07-28T07:07:34.9398762Z + }
