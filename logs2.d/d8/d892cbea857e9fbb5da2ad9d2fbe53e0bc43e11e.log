2026-07-28T07:09:26.2909393Z > library(testthat)
2026-07-28T07:09:26.2909636Z > library(duckdb.dev)
2026-07-28T07:09:26.2909897Z Loading required package: DBI
2026-07-28T07:09:26.2910126Z > 
2026-07-28T07:09:26.2910320Z > # CRAN guard
2026-07-28T07:09:26.2910503Z > #
2026-07-28T07:09:26.2910908Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:09:26.2911523Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:09:26.2912389Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:09:26.2912985Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:09:26.2913579Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:09:26.2914286Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:09:26.2914768Z > # so the guard is obvious and self-contained.
2026-07-28T07:09:26.2915235Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:09:26.2915584Z > 
2026-07-28T07:09:26.2915855Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:09:26.2916165Z +   run <- TRUE
2026-07-28T07:09:26.2916482Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:09:26.2916816Z +   run <- FALSE
2026-07-28T07:09:26.2917026Z + } else {
2026-07-28T07:09:26.2917394Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:09:26.2917853Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:09:26.2918140Z + }
2026-07-28T07:09:26.2918311Z > 
2026-07-28T07:09:26.2918501Z > if (run) {
2026-07-28T07:09:26.2918760Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:09:26.2919035Z + } else {
2026-07-28T07:09:26.2919360Z +   message(
2026-07-28T07:09:26.2919566Z +     "\n",
2026-07-28T07:09:26.2919781Z +     strrep("=", 78),
2026-07-28T07:09:26.2920007Z +     "\n",
2026-07-28T07:09:26.2920258Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:09:26.2920545Z +     "\n",
2026-07-28T07:09:26.2920959Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:09:26.2921569Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:09:26.2922453Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:09:26.2923082Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:09:26.2923516Z +     "manner.\n",
2026-07-28T07:09:26.2923729Z +     "\n",
2026-07-28T07:09:26.2924140Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:09:26.2924798Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:09:26.2925236Z +     "\n",
2026-07-28T07:09:26.2925643Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:09:26.2926320Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:09:26.2926853Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:09:26.2927239Z +     strrep("=", 78),
2026-07-28T07:09:26.2927460Z +     "\n"
2026-07-28T07:09:26.2927637Z +   )
2026-07-28T07:09:26.2927817Z + }
