+                   sub += r.size;
+                   rec.childHeads.push(r.head);
+               });
+               li.appendChild(ul);
+               rec.size += sub;
+   
+               var handle = document.createElement("div");
+               handle.className = "collapse-handle";
+               handle.textContent = "−";
