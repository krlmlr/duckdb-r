2026-08-15T08:35:53.7701840Z Loading required package: DBI
2026-08-15T08:35:53.7701890Z > 
2026-08-15T08:35:53.7701970Z > # CRAN guard
2026-08-15T08:35:53.7702020Z > #
2026-08-15T08:35:53.7702320Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-15T08:35:53.7702610Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-15T08:35:53.7702900Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-15T08:35:53.7703160Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-15T08:35:53.7703440Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-15T08:35:53.7703840Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-15T08:35:53.7704000Z > # so the guard is obvious and self-contained.
2026-08-15T08:35:53.7704240Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-15T08:35:53.7704290Z > 
2026-08-15T08:35:53.7704460Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-15T08:35:53.7704540Z +   run <- TRUE
2026-08-15T08:35:53.7704730Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-15T08:35:53.7704820Z +   run <- FALSE
2026-08-15T08:35:53.7704890Z + } else {
2026-08-15T08:35:53.7705140Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-15T08:35:53.7705440Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-15T08:35:53.7705500Z + }
2026-08-15T08:35:53.7705550Z > 
2026-08-15T08:35:53.7705620Z > if (run) {
2026-08-15T08:35:53.7705750Z +   test_check(simulate_duckdb()$pkg)
2026-08-15T08:35:53.7705830Z + } else {
2026-08-15T08:35:53.7705910Z +   message(
2026-08-15T08:35:53.7705980Z +     "\n",
2026-08-15T08:35:53.7706080Z +     strrep("=", 78),
2026-08-15T08:35:53.7706160Z +     "\n",
2026-08-15T08:35:53.7706300Z +     "Skipping the duckdb test suite.\n",
2026-08-15T08:35:53.7706370Z +     "\n",
2026-08-15T08:35:53.7706670Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-15T08:35:53.7706960Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-15T08:35:53.7707250Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-15T08:35:53.7707550Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-15T08:35:53.7707640Z +     "manner.\n",
2026-08-15T08:35:53.7707720Z +     "\n",
2026-08-15T08:35:53.7708030Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-15T08:35:53.7708360Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-15T08:35:53.7708440Z +     "\n",
2026-08-15T08:35:53.7708740Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-15T08:35:53.7709010Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-15T08:35:53.7709260Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-15T08:35:53.7709350Z +     strrep("=", 78),
2026-08-15T08:35:53.7709430Z +     "\n"
2026-08-15T08:35:53.7709490Z +   )
2026-08-15T08:35:53.7709540Z + }
