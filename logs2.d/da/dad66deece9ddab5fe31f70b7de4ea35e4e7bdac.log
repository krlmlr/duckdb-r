2026-08-15T08:35:53.6523670Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-15T08:35:53.6524570Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-15T08:35:53.6525250Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-15T08:35:53.6525820Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-15T08:35:53.6526470Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-15T08:35:53.6526990Z > # so the guard is obvious and self-contained.
2026-08-15T08:35:53.6527540Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-15T08:35:53.6527860Z > 
2026-08-15T08:35:53.6528110Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-15T08:35:53.6528400Z +   run <- TRUE
2026-08-15T08:35:53.6528730Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-15T08:35:53.6529020Z +   run <- FALSE
2026-08-15T08:35:53.6529320Z + } else {
2026-08-15T08:35:53.6529790Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-15T08:35:53.6530300Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-15T08:35:53.6530620Z + }
2026-08-15T08:35:53.6530840Z > 
2026-08-15T08:35:53.6531080Z > if (run) {
2026-08-15T08:35:53.6531360Z +   test_check(simulate_duckdb()$pkg)
2026-08-15T08:35:53.6531740Z + } else {
2026-08-15T08:35:53.6531990Z +   message(
2026-08-15T08:35:53.6532260Z +     "\n",
2026-08-15T08:35:53.6532500Z +     strrep("=", 78),
2026-08-15T08:35:53.6532810Z +     "\n",
2026-08-15T08:35:53.6533180Z +     "Skipping the duckdb test suite.\n",
2026-08-15T08:35:53.6533610Z +     "\n",
2026-08-15T08:35:53.6534130Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-15T08:35:53.6535060Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-15T08:35:53.6535650Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-15T08:35:53.6536240Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-15T08:35:53.6536630Z +     "manner.\n",
2026-08-15T08:35:53.6536910Z +     "\n",
2026-08-15T08:35:53.6537320Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-15T08:35:53.6538030Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-15T08:35:53.6538540Z +     "\n",
2026-08-15T08:35:53.6539060Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-15T08:35:53.6539680Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-15T08:35:53.6540270Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-15T08:35:53.6540630Z +     strrep("=", 78),
2026-08-15T08:35:53.6540900Z +     "\n"
2026-08-15T08:35:53.6541090Z +   )
2026-08-15T08:35:53.6541310Z + }
