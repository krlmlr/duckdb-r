2026-09-12T09:05:10.0096526Z > # CRAN guard
2026-09-12T09:05:10.0096712Z > #
2026-09-12T09:05:10.0097128Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-12T09:05:10.0097739Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-12T09:05:10.0098340Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-12T09:05:10.0098903Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-12T09:05:10.0099474Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-12T09:05:10.0100058Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-12T09:05:10.0100522Z > # so the guard is obvious and self-contained.
2026-09-12T09:05:10.0100962Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-12T09:05:10.0101305Z > 
2026-09-12T09:05:10.0101569Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-12T09:05:10.0101864Z +   run <- TRUE
2026-09-12T09:05:10.0102168Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-12T09:05:10.0102487Z +   run <- FALSE
2026-09-12T09:05:10.0102684Z + } else {
2026-09-12T09:05:10.0103032Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-12T09:05:10.0103472Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-12T09:05:10.0103747Z + }
2026-09-12T09:05:10.0104176Z > 
2026-09-12T09:05:10.0104415Z > if (run) {
2026-09-12T09:05:10.0104832Z +   test_check(simulate_duckdb()$pkg)
2026-09-12T09:05:10.0105121Z + } else {
2026-09-12T09:05:10.0105316Z +   message(
