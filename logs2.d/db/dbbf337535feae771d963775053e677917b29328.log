2026-09-12T08:43:10.3857645Z [36;1m# Infer each compiler default for the active R version from R CMD config,[0m
2026-09-12T08:43:10.3858578Z [36;1m# then route it through ccache. Reading the resolved defaults preserves the[0m
2026-09-12T08:43:10.3859533Z [36;1m# standard flags R selects per version (e.g. -std=gnu2x for C, -std=gnu++17[0m
2026-09-12T08:43:10.3860418Z [36;1m# / -std=gnu++20 for C++); a plain "CC = ccache gcc" override would drop[0m
2026-09-12T08:43:10.3861258Z [36;1m# them and silently downgrade the standard across the version matrix.[0m
2026-09-12T08:43:10.3862128Z [36;1m# Inference uses an empty user Makevars so we always read the pristine[0m
2026-09-12T08:43:10.3862907Z [36;1m# Makeconf defaults, never a value we just wrote.[0m
2026-09-12T08:43:10.3863674Z [36;1m# Note: the versioned switches (CXX11..CXX23) intentionally come out as[0m
2026-09-12T08:43:10.3864736Z [36;1m# bare "g++" with no -std flag. R keeps the standard in a separate[0m
2026-09-12T08:43:10.3865567Z [36;1m# CXXnnSTD variable (CXX17STD = -std=gnu++17, ...) and applies it on top[0m
2026-09-12T08:43:10.3866436Z [36;1m# at compile time, so wrapping only CXXnn with ccache is correct and we[0m
2026-09-12T08:43:10.3867134Z [36;1m# must NOT pin -std here ourselves.[0m
2026-09-12T08:43:10.3867593Z [36;1m#[0m
2026-09-12T08:43:10.3868078Z [36;1m# On Unix, ccache is attached through a generated one-word wrapper[0m
2026-09-12T08:43:10.3868880Z [36;1m# command (ccache-gcc, ccache-g++, ...) rather than the more obvious[0m
2026-09-12T08:43:10.3869728Z [36;1m# "CC = ccache gcc" prefix. R-devel briefly could not cope with a[0m
2026-09-12T08:43:10.3870318Z [36;1m# compiler command of more than one word: tools:::ccE(), which backs the[0m
2026-09-12T08:43:10.3870846Z [36;1m# "checking use of non-API entry points" check and therefore runs for[0m
2026-09-12T08:43:10.3871366Z [36;1m# every package with compiled code, read R CMD config CC, kept only the[0m
2026-09-12T08:43:10.3871853Z [36;1m# first word, and ran that. With "CC = ccache gcc" that left a bare[0m
2026-09-12T08:43:10.3872338Z [36;1m# "ccache", and the check died with "ccache: invalid option -- 'E'".[0m
2026-09-12T08:43:10.3872912Z [36;1m# https://github.com/r-devel/r-svn/commit/ca19f35240517186ed447e773ee67b55e207cf27[0m
2026-09-12T08:43:10.3873430Z [36;1m# https://bugs.r-project.org/show_bug.cgi?id=19130[0m
2026-09-12T08:43:10.3874114Z [36;1m# Upstream has since dropped the truncation again, so the prefix works[0m
2026-09-12T08:43:10.3874684Z [36;1m# once more -- but it takes a while for that to reach the R-devel builds[0m
2026-09-12T08:43:10.3875171Z [36;1m# CI installs, so the wrapper is still doing real work here. It stays[0m
2026-09-12T08:43:10.3875841Z [36;1m# after that too: it costs nothing and is correct either way.[0m
2026-09-12T08:43:10.3876189Z [36;1m#[0m
2026-09-12T08:43:10.3876509Z [36;1m# Windows deliberately keeps the plain prefix, as a control group: it is[0m
2026-09-12T08:43:10.3877015Z [36;1m# where a repeat of that upstream change would show up, while the Unix[0m
2026-09-12T08:43:10.3877400Z [36;1m# jobs carry on regardless.[0m
2026-09-12T08:43:10.3877699Z [36;1mccache_bin="$(command -v ccache || true)"[0m
2026-09-12T08:43:10.3878001Z [36;1mif [ -z "$ccache_bin" ]; then[0m
2026-09-12T08:43:10.3878363Z [36;1m  echo "::warning::ccache is not on the PATH, compiling without it."[0m
2026-09-12T08:43:10.3878719Z [36;1melse[0m
2026-09-12T08:43:10.3878948Z [36;1m  wrapper_dir="$HOME/.R/ccache-wrappers"[0m
2026-09-12T08:43:10.3879259Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-09-12T08:43:10.3879540Z [36;1m    mkdir -p "$wrapper_dir"[0m
2026-09-12T08:43:10.3879795Z [36;1m  fi[0m
2026-09-12T08:43:10.3880074Z [36;1m[0m
2026-09-12T08:43:10.3880277Z [36;1m  empty_makevars="$(mktemp)"[0m
2026-09-12T08:43:10.3880718Z [36;1m  for var in CC CXX CXX11 CXX14 CXX17 CXX20 CXX23; do[0m
2026-09-12T08:43:10.3881186Z [36;1m    val="$(R_MAKEVARS_USER="$empty_makevars" R CMD config "$var" 2>/dev/null || true)"[0m
2026-09-12T08:43:10.3881605Z [36;1m    if [ -z "$val" ]; then[0m
2026-09-12T08:43:10.3881851Z [36;1m      continue[0m
2026-09-12T08:43:10.3882059Z [36;1m    fi[0m
2026-09-12T08:43:10.3882280Z [36;1m    if [ "$RUNNER_OS" = "Windows" ]; then[0m
2026-09-12T08:43:10.3882612Z [36;1m      echo "$var = ccache $val" >> ~/.R/Makevars[0m
2026-09-12T08:43:10.3882907Z [36;1m      continue[0m
2026-09-12T08:43:10.3883109Z [36;1m    fi[0m
2026-09-12T08:43:10.3883299Z [36;1m[0m
2026-09-12T08:43:10.3883588Z [36;1m    # Split "gcc -std=gnu2x" into the compiler and its flags: only the[0m
2026-09-12T08:43:10.3884360Z [36;1m    # compiler is wrapped, the flags are passed through unchanged.[0m
2026-09-12T08:43:10.3884836Z [36;1m    # ccache and the compiler are both found on the PATH at run time,[0m
2026-09-12T08:43:10.3885253Z [36;1m    # nothing is baked into the wrapper by path.[0m
2026-09-12T08:43:10.3885579Z [36;1m    prog="${val%%[[:space:]]*}"[0m
2026-09-12T08:43:10.3885849Z [36;1m    flags="${val#"$prog"}"[0m
2026-09-12T08:43:10.3886131Z [36;1m    wrapper="ccache-$(basename "$prog")"[0m
2026-09-12T08:43:10.3886407Z [36;1m[0m
2026-09-12T08:43:10.3886630Z [36;1m    if [ ! -f "$wrapper_dir/$wrapper" ]; then[0m
