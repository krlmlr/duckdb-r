2026-09-12T09:05:09.9413763Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-12T09:05:09.9414682Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-12T09:05:09.9415185Z > # so the guard is obvious and self-contained.
2026-09-12T09:05:09.9415634Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-12T09:05:09.9415984Z > 
2026-09-12T09:05:09.9416257Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-12T09:05:09.9416565Z +   run <- TRUE
2026-09-12T09:05:09.9417077Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
