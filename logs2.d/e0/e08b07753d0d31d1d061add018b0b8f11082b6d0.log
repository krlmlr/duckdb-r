2026-07-27T14:39:58.0795163Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:39:58.0795705Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
