2026-09-05T01:48:41.8129356Z > library(testthat)
2026-09-05T01:48:41.8129520Z > library(duckdb)
2026-09-05T01:48:41.8129731Z Loading required package: DBI
2026-09-05T01:48:41.8129850Z > 
2026-09-05T01:48:41.8130006Z > # CRAN guard
2026-09-05T01:48:41.8130127Z > #
2026-09-05T01:48:41.8131010Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-05T01:48:41.8131510Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-05T01:48:41.8132026Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-05T01:48:41.8132488Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-05T01:48:41.8132939Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-05T01:48:41.8133235Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-05T01:48:41.8133596Z > # so the guard is obvious and self-contained.
2026-09-05T01:48:41.8133978Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-05T01:48:41.8134064Z > 
2026-09-05T01:48:41.8134244Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-05T01:48:41.8134358Z +   run <- TRUE
2026-09-05T01:48:41.8134572Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-05T01:48:41.8134682Z +   run <- FALSE
2026-09-05T01:48:41.8134779Z + } else {
2026-09-05T01:48:41.8135045Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-05T01:48:41.8135224Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-05T01:48:41.8135307Z + }
2026-09-05T01:48:41.8135426Z > 
2026-09-05T01:48:41.8135600Z > if (run) {
2026-09-05T01:48:41.8136003Z +   test_check(simulate_duckdb()$pkg)
2026-09-05T01:48:41.8136155Z + } else {
2026-09-05T01:48:41.8136307Z +   message(
2026-09-05T01:48:41.8136447Z +     "\n",
2026-09-05T01:48:41.8136635Z +     strrep("=", 78),
2026-09-05T01:48:41.8136783Z +     "\n",
2026-09-05T01:48:41.8137023Z +     "Skipping the duckdb test suite.\n",
2026-09-05T01:48:41.8137171Z +     "\n",
2026-09-05T01:48:41.8137570Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-05T01:48:41.8137864Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-05T01:48:41.8138140Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-05T01:48:41.8138452Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-05T01:48:41.8138565Z +     "manner.\n",
2026-09-05T01:48:41.8138665Z +     "\n",
2026-09-05T01:48:41.8139084Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-05T01:48:41.8139425Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-05T01:48:41.8139524Z +     "\n",
2026-09-05T01:48:41.8139839Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-05T01:48:41.8140120Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-05T01:48:41.8140377Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-05T01:48:41.8140496Z +     strrep("=", 78),
2026-09-05T01:48:41.8140838Z +     "\n"
2026-09-05T01:48:41.8140972Z +   )
2026-09-05T01:48:41.8141062Z + }
