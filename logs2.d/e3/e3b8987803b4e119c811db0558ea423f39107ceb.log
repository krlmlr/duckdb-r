2026-08-07T19:04:26.5142814Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-07T19:04:26.5143314Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-07T19:04:26.5143608Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-07T19:04:26.5143914Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-07T19:04:26.5144089Z > # so the guard is obvious and self-contained.
2026-08-07T19:04:26.5144332Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-07T19:04:26.5144414Z > 
2026-08-07T19:04:26.5144596Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-07T19:04:26.5144696Z +   run <- TRUE
2026-08-07T19:04:26.5144898Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-07T19:04:26.5145006Z +   run <- FALSE
2026-08-07T19:04:26.5145098Z + } else {
2026-08-07T19:04:26.5145360Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-07T19:04:26.5145544Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-07T19:04:26.5145618Z + }
2026-08-07T19:04:26.5145698Z > 
2026-08-07T19:04:26.5145802Z > if (run) {
2026-08-07T19:04:26.5145943Z +   test_check(simulate_duckdb()$pkg)
2026-08-07T19:04:26.5146043Z + } else {
2026-08-07T19:04:26.5146141Z +   message(
2026-08-07T19:04:26.5146231Z +     "\n",
2026-08-07T19:04:26.5146350Z +     strrep("=", 78),
2026-08-07T19:04:26.5146447Z +     "\n",
2026-08-07T19:04:26.5146594Z +     "Skipping the duckdb test suite.\n",
2026-08-07T19:04:26.5146692Z +     "\n",
2026-08-07T19:04:26.5147007Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-07T19:04:26.5147283Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-07T19:04:26.5147567Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-07T19:04:26.5148019Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-07T19:04:26.5148127Z +     "manner.\n",
2026-08-07T19:04:26.5148225Z +     "\n",
2026-08-07T19:04:26.5148531Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-07T19:04:26.5148862Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-07T19:04:26.5148962Z +     "\n",
2026-08-07T19:04:26.5149270Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-07T19:04:26.5149540Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-07T19:04:26.5149802Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-07T19:04:26.5149923Z +     strrep("=", 78),
2026-08-07T19:04:26.5150015Z +     "\n"
2026-08-07T19:04:26.5150168Z +   )
2026-08-07T19:04:26.5150252Z + }
