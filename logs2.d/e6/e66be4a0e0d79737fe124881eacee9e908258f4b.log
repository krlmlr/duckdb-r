2026-07-26T07:21:32.7995935Z > # CRAN guard
2026-07-26T07:21:32.7996056Z > #
2026-07-26T07:21:32.7996560Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-26T07:21:32.7997084Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-26T07:21:32.7997601Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-26T07:21:32.7999121Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-26T07:21:32.8000395Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-26T07:21:32.8001519Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-26T07:21:32.8001817Z > # so the guard is obvious and self-contained.
2026-07-26T07:21:32.8002951Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-26T07:21:32.8003294Z > 
2026-07-26T07:21:32.8004182Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-26T07:21:32.8004390Z +   run <- TRUE
2026-07-26T07:21:32.8004692Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-26T07:21:32.8005169Z +   run <- FALSE
2026-07-26T07:21:32.8005321Z + } else {
2026-07-26T07:21:32.8007059Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-26T07:21:32.8007725Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-26T07:21:32.8007848Z + }
2026-07-26T07:21:32.8007970Z > 
2026-07-26T07:21:32.8008127Z > if (run) {
2026-07-26T07:21:32.8008370Z +   test_check(simulate_duckdb()$pkg)
2026-07-26T07:21:32.8008521Z + } else {
2026-07-26T07:21:32.8008670Z +   message(
2026-07-26T07:21:32.8008818Z +     "\n",
2026-07-26T07:21:32.8008991Z +     strrep("=", 78),
2026-07-26T07:21:32.8009142Z +     "\n",
2026-07-26T07:21:32.8009395Z +     "Skipping the duckdb test suite.\n",
2026-07-26T07:21:32.8009537Z +     "\n",
2026-07-26T07:21:32.8010079Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-26T07:21:32.8011522Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-26T07:21:32.8012497Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-26T07:21:32.8013622Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-26T07:21:32.8013841Z +     "manner.\n",
2026-07-26T07:21:32.8014004Z +     "\n",
2026-07-26T07:21:32.8014533Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-26T07:21:32.8015112Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-26T07:21:32.8015287Z +     "\n",
2026-07-26T07:21:32.8015807Z +     "To run the test suite locally, set the environment variable before checking:\n",
