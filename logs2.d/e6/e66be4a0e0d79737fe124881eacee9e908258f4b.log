2026-07-27T18:21:59.3789213Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T18:21:59.3789970Z > # so the guard is obvious and self-contained.
2026-07-27T18:21:59.3790695Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T18:21:59.3791228Z > 
2026-07-27T18:21:59.3792023Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T18:21:59.3792497Z +   run <- TRUE
2026-07-27T18:21:59.3793286Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
