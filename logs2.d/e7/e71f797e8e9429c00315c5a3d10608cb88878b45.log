2026-07-29T08:41:04.7478079Z > # CRAN guard
2026-07-29T08:41:04.7478279Z > #
2026-07-29T08:41:04.7478717Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T08:41:04.7479395Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T08:41:04.7480054Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T08:41:04.7480688Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T08:41:04.7481306Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T08:41:04.7481928Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T08:41:04.7482420Z > # so the guard is obvious and self-contained.
2026-07-29T08:41:04.7482894Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T08:41:04.7483249Z > 
2026-07-29T08:41:04.7483526Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T08:41:04.7483834Z +   run <- TRUE
2026-07-29T08:41:04.7484158Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T08:41:04.7484491Z +   run <- FALSE
2026-07-29T08:41:04.7485099Z + } else {
2026-07-29T08:41:04.7485568Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T08:41:04.7486055Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T08:41:04.7486358Z + }
2026-07-29T08:41:04.7486531Z > 
2026-07-29T08:41:04.7486735Z > if (run) {
2026-07-29T08:41:04.7486997Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T08:41:04.7487276Z + } else {
2026-07-29T08:41:04.7487477Z +   message(
2026-07-29T08:41:04.7487678Z +     "\n",
2026-07-29T08:41:04.7487895Z +     strrep("=", 78),
2026-07-29T08:41:04.7488125Z +     "\n",
2026-07-29T08:41:04.7488385Z +     "Skipping the duckdb test suite.\n",
2026-07-29T08:41:04.7488669Z +     "\n",
2026-07-29T08:41:04.7489085Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T08:41:04.7489702Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T08:41:04.7490278Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T08:41:04.7490900Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T08:41:04.7491463Z +     "manner.\n",
2026-07-29T08:41:04.7491686Z +     "\n",
2026-07-29T08:41:04.7492103Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T08:41:04.7492779Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T08:41:04.7493222Z +     "\n",
2026-07-29T08:41:04.7493644Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-29T08:41:04.7494824Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-29T08:41:04.7495863Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-29T08:41:04.7496569Z +     strrep("=", 78),
2026-07-29T08:41:04.7496973Z +     "\n"
2026-07-29T08:41:04.7497299Z +   )
2026-07-29T08:41:04.7497604Z + }
