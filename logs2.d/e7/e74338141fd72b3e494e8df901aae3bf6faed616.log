2026-09-13T09:04:54.7686018Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-13T09:04:54.7687034Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-13T09:04:54.7688093Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-13T09:04:54.7688978Z > # so the guard is obvious and self-contained.
2026-09-13T09:04:54.7689794Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-13T09:04:54.7690602Z > 
2026-09-13T09:04:54.7691086Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-13T09:04:54.7691612Z +   run <- TRUE
2026-09-13T09:04:54.7692175Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-13T09:04:54.7692727Z +   run <- FALSE
2026-09-13T09:04:54.7693198Z + } else {
2026-09-13T09:04:54.7693936Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-13T09:04:54.7694581Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-13T09:04:54.7694950Z + }
2026-09-13T09:04:54.7695182Z > 
2026-09-13T09:04:54.7695428Z > if (run) {
2026-09-13T09:04:54.7695733Z +   test_check(simulate_duckdb()$pkg)
2026-09-13T09:04:54.7695992Z + } else {
2026-09-13T09:04:54.7696173Z +   message(
2026-09-13T09:04:54.7696363Z +     "\n",
2026-09-13T09:04:54.7696725Z +     strrep("=", 78),
2026-09-13T09:04:54.7697141Z +     "\n",
2026-09-13T09:04:54.7697388Z +     "Skipping the duckdb test suite.\n",
2026-09-13T09:04:54.7697656Z +     "\n",
2026-09-13T09:04:54.7698032Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-13T09:04:54.7698604Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-13T09:04:54.7699131Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-13T09:04:54.7699690Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-13T09:04:54.7700089Z +     "manner.\n",
2026-09-13T09:04:54.7700273Z +     "\n",
2026-09-13T09:04:54.7700636Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-13T09:04:54.7701236Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-13T09:04:54.7701800Z +     "\n",
2026-09-13T09:04:54.7702177Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-13T09:04:54.7702724Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-13T09:04:54.7703215Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-13T09:04:54.7703570Z +     strrep("=", 78),
2026-09-13T09:04:54.7703764Z +     "\n"
2026-09-13T09:04:54.7703920Z +   )
2026-09-13T09:04:54.7704069Z + }
