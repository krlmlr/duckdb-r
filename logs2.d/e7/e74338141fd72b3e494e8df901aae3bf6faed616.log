2026-09-13T09:04:54.9598014Z > # CRAN guard
2026-09-13T09:04:54.9598079Z > #
2026-09-13T09:04:54.9598486Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-13T09:04:54.9598987Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-13T09:04:54.9599596Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-13T09:04:54.9600262Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-13T09:04:54.9600572Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-13T09:04:54.9600873Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-13T09:04:54.9601038Z > # so the guard is obvious and self-contained.
2026-09-13T09:04:54.9601263Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-13T09:04:54.9601326Z > 
2026-09-13T09:04:54.9601481Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-13T09:04:54.9601565Z +   run <- TRUE
2026-09-13T09:04:54.9601743Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-13T09:04:54.9601826Z +   run <- FALSE
2026-09-13T09:04:54.9601989Z + } else {
2026-09-13T09:04:54.9602453Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-13T09:04:54.9602619Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-13T09:04:54.9602705Z + }
2026-09-13T09:04:54.9602774Z > 
2026-09-13T09:04:54.9602859Z > if (run) {
2026-09-13T09:04:54.9602981Z +   test_check(simulate_duckdb()$pkg)
2026-09-13T09:04:54.9603065Z + } else {
2026-09-13T09:04:54.9603149Z +   message(
2026-09-13T09:04:54.9603224Z +     "\n",
2026-09-13T09:04:54.9603321Z +     strrep("=", 78),
2026-09-13T09:04:54.9603440Z +     "\n",
2026-09-13T09:04:54.9603872Z +     "Skipping the duckdb test suite.\n",
2026-09-13T09:04:54.9604027Z +     "\n",
2026-09-13T09:04:54.9604883Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-13T09:04:54.9605400Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-13T09:04:54.9605867Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-13T09:04:54.9606391Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-13T09:04:54.9606553Z +     "manner.\n",
2026-09-13T09:04:54.9606692Z +     "\n",
2026-09-13T09:04:54.9607197Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-13T09:04:54.9607754Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-13T09:04:54.9608077Z +     "\n",
2026-09-13T09:04:54.9608390Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-13T09:04:54.9608765Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-13T09:04:54.9609158Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-13T09:04:54.9609273Z +     strrep("=", 78),
2026-09-13T09:04:54.9623672Z +     "\n"
2026-09-13T09:04:54.9623842Z +   )
2026-09-13T09:04:54.9623974Z + }
