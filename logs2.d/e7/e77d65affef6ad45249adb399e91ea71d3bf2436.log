2026-07-27T06:45:20.4302192Z > # This file is part of the standard setup for testthat.
2026-07-27T06:45:20.4302824Z > # It is recommended that you do not modify it.
2026-07-27T06:45:20.4303271Z > #
2026-07-27T06:45:20.4303730Z > # Where should you do additional test configuration?
2026-07-27T06:45:20.4304347Z > # Learn more about the roles of various files in:
2026-07-27T06:45:20.4305097Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:45:20.4305891Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:45:20.4306397Z > 
2026-07-27T06:45:20.4306726Z > library(testthat)
2026-07-27T06:45:20.4307090Z > library(duckdb.dev)
2026-07-27T06:45:20.4307499Z Loading required package: DBI
2026-07-27T06:45:20.4307864Z > 
2026-07-27T06:45:20.4308169Z > # CRAN guard
2026-07-27T06:45:20.4308456Z > #
2026-07-27T06:45:20.4309121Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:45:20.4310235Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:45:20.4311170Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:45:20.4312082Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:45:20.4312996Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:45:20.4313932Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:45:20.4314700Z > # so the guard is obvious and self-contained.
2026-07-27T06:45:20.4315432Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:45:20.4315985Z > 
2026-07-27T06:45:20.4316402Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:45:20.4316873Z +   run <- TRUE
2026-07-27T06:45:20.4317584Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:45:20.4318277Z +   run <- FALSE
2026-07-27T06:45:20.4318613Z + } else {
2026-07-27T06:45:20.4319191Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:45:20.4319892Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:45:20.4320636Z + }
2026-07-27T06:45:20.4320904Z > 
2026-07-27T06:45:20.4321191Z > if (run) {
2026-07-27T06:45:20.4321579Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:45:20.4322004Z + } else {
2026-07-27T06:45:20.4322303Z +   message(
2026-07-27T06:45:20.4322607Z +     "\n",
2026-07-27T06:45:20.4322942Z +     strrep("=", 78),
2026-07-27T06:45:20.4323284Z +     "\n",
2026-07-27T06:45:20.4323674Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:45:20.4324105Z +     "\n",
2026-07-27T06:45:20.4324763Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:45:20.4325723Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:45:20.4326634Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:45:20.4327727Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:45:20.4328424Z +     "manner.\n",
2026-07-27T06:45:20.4328752Z +     "\n",
2026-07-27T06:45:20.4329526Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:45:20.4330693Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:45:20.4331368Z +     "\n",
2026-07-27T06:45:20.4332091Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:45:20.4333015Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:45:20.4333891Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:45:20.4334498Z +     strrep("=", 78),
2026-07-27T06:45:20.4334841Z +     "\n"
2026-07-27T06:45:20.4335116Z +   )
2026-07-27T06:45:20.4335389Z + }
