2026-07-27T06:47:19.7034942Z > # It is recommended that you do not modify it.
2026-07-27T06:47:19.7035252Z > #
2026-07-27T06:47:19.7035584Z > # Where should you do additional test configuration?
2026-07-27T06:47:19.7036061Z > # Learn more about the roles of various files in:
2026-07-27T06:47:19.7036804Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:47:19.7037580Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:47:19.7038110Z > 
2026-07-27T06:47:19.7038423Z > library(testthat)
2026-07-27T06:47:19.7038797Z > library(duckdb.dev)
2026-07-27T06:47:19.7039259Z Loading required package: DBI
2026-07-27T06:47:19.7039641Z > 
2026-07-27T06:47:19.7039925Z > # CRAN guard
2026-07-27T06:47:19.7040382Z > #
2026-07-27T06:47:19.7041039Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:47:19.7042270Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:47:19.7042929Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:47:19.7043559Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:47:19.7044186Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:47:19.7044822Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:47:19.7045342Z > # so the guard is obvious and self-contained.
2026-07-27T06:47:19.7045841Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:47:19.7046226Z > 
2026-07-27T06:47:19.7046545Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:47:19.7046896Z +   run <- TRUE
2026-07-27T06:47:19.7047247Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:47:19.7047604Z +   run <- FALSE
2026-07-27T06:47:19.7047846Z + } else {
2026-07-27T06:47:19.7048237Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:47:19.7048735Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:47:19.7049054Z + }
2026-07-27T06:47:19.7049241Z > 
2026-07-27T06:47:19.7049442Z > if (run) {
2026-07-27T06:47:19.7049721Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:47:19.7050044Z + } else {
2026-07-27T06:47:19.7050466Z +   message(
2026-07-27T06:47:19.7050684Z +     "\n",
2026-07-27T06:47:19.7050925Z +     strrep("=", 78),
2026-07-27T06:47:19.7051172Z +     "\n",
2026-07-27T06:47:19.7051433Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:47:19.7051740Z +     "\n",
2026-07-27T06:47:19.7052385Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:47:19.7053063Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:47:19.7053684Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:47:19.7054343Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:47:19.7054932Z +     "manner.\n",
2026-07-27T06:47:19.7055164Z +     "\n",
2026-07-27T06:47:19.7055605Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:47:19.7056293Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:47:19.7056772Z +     "\n",
2026-07-27T06:47:19.7057215Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:47:19.7057847Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:47:19.7058426Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:47:19.7058916Z +     strrep("=", 78),
2026-07-27T06:47:19.7059162Z +     "\n"
2026-07-27T06:47:19.7059357Z +   )
2026-07-27T06:47:19.7059544Z + }
