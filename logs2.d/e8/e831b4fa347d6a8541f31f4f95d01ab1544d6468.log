2026-08-15T14:34:59.2524105Z [36;1m    # nothing is baked into the wrapper by path.[0m
2026-08-15T14:34:59.2524306Z [36;1m    prog="${val%%[[:space:]]*}"[0m
2026-08-15T14:34:59.2524470Z [36;1m    flags="${val#"$prog"}"[0m
2026-08-15T14:34:59.2524649Z [36;1m    wrapper="ccache-$(basename "$prog")"[0m
2026-08-15T14:34:59.2524834Z [36;1m[0m
2026-08-15T14:34:59.2524976Z [36;1m    if [ ! -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-15T14:34:59.2525244Z [36;1m      printf '#!/bin/sh\nexec ccache %s "$@"\n' "$prog" > "$wrapper_dir/$wrapper"[0m
2026-08-15T14:34:59.2525504Z [36;1m      chmod +x "$wrapper_dir/$wrapper"[0m
2026-08-15T14:34:59.2525737Z [36;1m      # Never hand R a wrapper that has not been shown to work.[0m
2026-08-15T14:34:59.2526082Z [36;1m      if ! "$wrapper_dir/$wrapper" --version > /dev/null; then[0m
2026-08-15T14:34:59.2526309Z [36;1m        rm -f "$wrapper_dir/$wrapper"[0m
2026-08-15T14:34:59.2526553Z [36;1m        echo "::warning::No usable $wrapper, compiling $var without ccache."[0m
2026-08-15T14:34:59.2527244Z [36;1m      fi[0m
2026-08-15T14:34:59.2527394Z [36;1m    fi[0m
2026-08-15T14:34:59.2527508Z [36;1m[0m
2026-08-15T14:34:59.2527651Z [36;1m    if [ -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-15T14:34:59.2527870Z [36;1m      echo "$var = $wrapper$flags" >> ~/.R/Makevars[0m
2026-08-15T14:34:59.2528057Z [36;1m    fi[0m
2026-08-15T14:34:59.2528170Z [36;1m  done[0m
2026-08-15T14:34:59.2528293Z [36;1m  rm -f "$empty_makevars"[0m
2026-08-15T14:34:59.2528443Z [36;1m[0m
2026-08-15T14:34:59.2528582Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-08-15T14:34:59.2528780Z [36;1m    echo "$wrapper_dir" >> "$GITHUB_PATH"[0m
2026-08-15T14:34:59.2528993Z [36;1m    echo "===== ccache wrappers in $wrapper_dir ====="[0m
