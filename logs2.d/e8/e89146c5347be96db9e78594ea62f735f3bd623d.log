2026-07-27T14:34:40.7966129Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:34:40.7966603Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:34:40.7966943Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:34:40.7967459Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:34:40.7967813Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:34:40.7967896Z +   
2026-07-27T14:34:40.7968252Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:34:40.7968786Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:34:40.7969060Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:34:40.7969669Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
2026-07-27T14:34:40.7969987Z +               return { label: p.label, secs: val(p.key + ".total_time"), children: subs };
