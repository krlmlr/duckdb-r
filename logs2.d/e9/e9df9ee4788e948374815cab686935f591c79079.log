2026-07-27T05:39:30.7651640Z > # This file is part of the standard setup for testthat.
2026-07-27T05:39:30.7652011Z > # It is recommended that you do not modify it.
2026-07-27T05:39:30.7652277Z > #
2026-07-27T05:39:30.7652555Z > # Where should you do additional test configuration?
2026-07-27T05:39:30.7652925Z > # Learn more about the roles of various files in:
2026-07-27T05:39:30.7653361Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T05:39:30.7653806Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T05:39:30.7654144Z > 
2026-07-27T05:39:30.7654353Z > library(testthat)
2026-07-27T05:39:30.7654591Z > library(duckdb.dev)
2026-07-27T05:39:30.7654853Z Loading required package: DBI
2026-07-27T05:39:30.7655084Z > 
2026-07-27T05:39:30.7655291Z > # CRAN guard
2026-07-27T05:39:30.7655483Z > #
2026-07-27T05:39:30.7655866Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T05:39:30.7656408Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T05:39:30.7657172Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T05:39:30.7657692Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T05:39:30.7658216Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T05:39:30.7658741Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T05:39:30.7659177Z > # so the guard is obvious and self-contained.
2026-07-27T05:39:30.7659587Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T05:39:30.7659905Z > 
2026-07-27T05:39:30.7660173Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T05:39:30.7660485Z +   run <- TRUE
2026-07-27T05:39:30.7660788Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T05:39:30.7661093Z +   run <- FALSE
2026-07-27T05:39:30.7661316Z + } else {
2026-07-27T05:39:30.7661652Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T05:39:30.7662063Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T05:39:30.7662337Z + }
2026-07-27T05:39:30.7662516Z > 
2026-07-27T05:39:30.7662716Z > if (run) {
2026-07-27T05:39:30.7662965Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T05:39:30.7663234Z + } else {
2026-07-27T05:39:30.7663468Z +   message(
2026-07-27T05:39:30.7663688Z +     "\n",
2026-07-27T05:39:30.7663908Z +     strrep("=", 78),
2026-07-27T05:39:30.7664144Z +     "\n",
2026-07-27T05:39:30.7664397Z +     "Skipping the duckdb test suite.\n",
2026-07-27T05:39:30.7664663Z +     "\n",
2026-07-27T05:39:30.7665128Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T05:39:30.7665665Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T05:39:30.7666173Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T05:39:30.7666949Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T05:39:30.7667354Z +     "manner.\n",
2026-07-27T05:39:30.7667569Z +     "\n",
2026-07-27T05:39:30.7667949Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T05:39:30.7668513Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T05:39:30.7668898Z +     "\n",
2026-07-27T05:39:30.7669275Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T05:39:30.7669801Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T05:39:30.7670278Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T05:39:30.7670666Z +     strrep("=", 78),
2026-07-27T05:39:30.7670897Z +     "\n"
2026-07-27T05:39:30.7671085Z +   )
2026-07-27T05:39:30.7671270Z + }
