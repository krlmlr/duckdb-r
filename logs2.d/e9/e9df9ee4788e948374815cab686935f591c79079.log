2026-07-27T05:37:47.9939564Z Loading required package: DBI
2026-07-27T05:37:47.9939778Z > 
2026-07-27T05:37:47.9939962Z > # CRAN guard
2026-07-27T05:37:47.9940133Z > #
2026-07-27T05:37:47.9940474Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T05:37:47.9940961Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T05:37:47.9941438Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T05:37:47.9941893Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T05:37:47.9942354Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T05:37:47.9942831Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T05:37:47.9943216Z > # so the guard is obvious and self-contained.
2026-07-27T05:37:47.9943601Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T05:37:47.9943885Z > 
2026-07-27T05:37:47.9944126Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T05:37:47.9944390Z +   run <- TRUE
2026-07-27T05:37:47.9944801Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T05:37:47.9945083Z +   run <- FALSE
2026-07-27T05:37:47.9945285Z + } else {
2026-07-27T05:37:47.9945608Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T05:37:47.9945983Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T05:37:47.9946227Z + }
2026-07-27T05:37:47.9946401Z > 
2026-07-27T05:37:47.9946740Z > if (run) {
2026-07-27T05:37:47.9947001Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T05:37:47.9947254Z + } else {
2026-07-27T05:37:47.9947594Z +   message(
2026-07-27T05:37:47.9947782Z +     "\n",
2026-07-27T05:37:47.9947981Z +     strrep("=", 78),
2026-07-27T05:37:47.9948181Z +     "\n",
2026-07-27T05:37:47.9948403Z +     "Skipping the duckdb test suite.\n",
2026-07-27T05:37:47.9948644Z +     "\n",
2026-07-27T05:37:47.9948997Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T05:37:47.9949481Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T05:37:47.9949942Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T05:37:47.9950422Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T05:37:47.9950767Z +     "manner.\n",
2026-07-27T05:37:47.9950962Z +     "\n",
2026-07-27T05:37:47.9951301Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T05:37:47.9951808Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T05:37:47.9952154Z +     "\n",
2026-07-27T05:37:47.9952493Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T05:37:47.9952953Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T05:37:47.9953381Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T05:37:47.9953754Z +     strrep("=", 78),
2026-07-27T05:37:47.9953957Z +     "\n"
2026-07-27T05:37:47.9954123Z +   )
2026-07-27T05:37:47.9954295Z + }
