2026-07-29T15:33:17.3093259Z > # CRAN guard
2026-07-29T15:33:17.3093371Z > #
2026-07-29T15:33:17.3093837Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T15:33:17.3094310Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T15:33:17.3094783Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T15:33:17.3095184Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T15:33:17.3096617Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T15:33:17.3097516Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T15:33:17.3097785Z > # so the guard is obvious and self-contained.
2026-07-29T15:33:17.3098174Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T15:33:17.3098299Z > 
2026-07-29T15:33:17.3098549Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T15:33:17.3098698Z +   run <- TRUE
2026-07-29T15:33:17.3098999Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T15:33:17.3099133Z +   run <- FALSE
2026-07-29T15:33:17.3099262Z + } else {
2026-07-29T15:33:17.3099656Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T15:33:17.3099898Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T15:33:17.3100010Z + }
2026-07-29T15:33:17.3100119Z > 
