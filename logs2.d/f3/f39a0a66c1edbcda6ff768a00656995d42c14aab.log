2026-07-28T17:00:29.2221498Z > # It is recommended that you do not modify it.
2026-07-28T17:00:29.2221772Z > #
2026-07-28T17:00:29.2222058Z > # Where should you do additional test configuration?
2026-07-28T17:00:29.2222446Z > # Learn more about the roles of various files in:
2026-07-28T17:00:29.2222956Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T17:00:29.2223431Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T17:00:29.2223947Z > 
2026-07-28T17:00:29.2224165Z > library(testthat)
2026-07-28T17:00:29.2224391Z > library(duckdb)
2026-07-28T17:00:29.2224642Z Loading required package: DBI
2026-07-28T17:00:29.2224872Z > 
2026-07-28T17:00:29.2225081Z > # CRAN guard
2026-07-28T17:00:29.2225271Z > #
2026-07-28T17:00:29.2225655Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T17:00:29.2226236Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T17:00:29.2226788Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T17:00:29.2227319Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T17:00:29.2227868Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T17:00:29.2228581Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T17:00:29.2229032Z > # so the guard is obvious and self-contained.
2026-07-28T17:00:29.2229466Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T17:00:29.2229786Z > 
2026-07-28T17:00:29.2230055Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T17:00:29.2230345Z +   run <- TRUE
2026-07-28T17:00:29.2230661Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T17:00:29.2230973Z +   run <- FALSE
2026-07-28T17:00:29.2231252Z + } else {
2026-07-28T17:00:29.2231623Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T17:00:29.2232065Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T17:00:29.2232345Z + }
2026-07-28T17:00:29.2232536Z > 
2026-07-28T17:00:29.2232735Z > if (run) {
2026-07-28T17:00:29.2232987Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T17:00:29.2233249Z + } else {
2026-07-28T17:00:29.2233452Z +   message(
2026-07-28T17:00:29.2233979Z +     "\n",
2026-07-28T17:00:29.2234194Z +     strrep("=", 78),
2026-07-28T17:00:29.2234417Z +     "\n",
2026-07-28T17:00:29.2234673Z +     "Skipping the duckdb test suite.\n",
2026-07-28T17:00:29.2234944Z +     "\n",
2026-07-28T17:00:29.2235344Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T17:00:29.2235916Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T17:00:29.2236448Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T17:00:29.2237330Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T17:00:29.2238020Z +     "manner.\n",
2026-07-28T17:00:29.2238358Z +     "\n",
2026-07-28T17:00:29.2238812Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T17:00:29.2239427Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T17:00:29.2240095Z +     "\n",
2026-07-28T17:00:29.2240830Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T17:00:29.2241889Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T17:00:29.2242854Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T17:00:29.2243646Z +     strrep("=", 78),
2026-07-28T17:00:29.2244060Z +     "\n"
2026-07-28T17:00:29.2244384Z +   )
2026-07-28T17:00:29.2244706Z + }
