2026-07-28T17:14:22.4369971Z > # This file is part of the standard setup for testthat.
2026-07-28T17:14:22.4370641Z > # It is recommended that you do not modify it.
2026-07-28T17:14:22.4371186Z > #
2026-07-28T17:14:22.4371722Z > # Where should you do additional test configuration?
2026-07-28T17:14:22.4372934Z > # Learn more about the roles of various files in:
2026-07-28T17:14:22.4373809Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T17:14:22.4375363Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T17:14:22.4377437Z > 
2026-07-28T17:14:22.4378821Z > library(testthat)
2026-07-28T17:14:22.4379260Z > library(duckdb)
2026-07-28T17:14:22.4379820Z Loading required package: DBI
2026-07-28T17:14:22.4380249Z > 
2026-07-28T17:14:22.4380609Z > # CRAN guard
2026-07-28T17:14:22.4380952Z > #
2026-07-28T17:14:22.4381642Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T17:14:22.4383066Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T17:14:22.4385194Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T17:14:22.4386204Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T17:14:22.4387212Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T17:14:22.4389727Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T17:14:22.4390596Z > # so the guard is obvious and self-contained.
2026-07-28T17:14:22.4391361Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T17:14:22.4392325Z > 
2026-07-28T17:14:22.4392722Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T17:14:22.4393334Z +   run <- TRUE
2026-07-28T17:14:22.4393794Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T17:14:22.4394268Z +   run <- FALSE
2026-07-28T17:14:22.4394574Z + } else {
2026-07-28T17:14:22.4395123Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T17:14:22.4395827Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T17:14:22.4396236Z + }
2026-07-28T17:14:22.4396484Z > 
2026-07-28T17:14:22.4396749Z > if (run) {
2026-07-28T17:14:22.4397120Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T17:14:22.4397513Z + } else {
2026-07-28T17:14:22.4397777Z +   message(
2026-07-28T17:14:22.4398276Z +     "\n",
2026-07-28T17:14:22.4398569Z +     strrep("=", 78),
2026-07-28T17:14:22.4398895Z +     "\n",
2026-07-28T17:14:22.4399238Z +     "Skipping the duckdb test suite.\n",
2026-07-28T17:14:22.4399652Z +     "\n",
2026-07-28T17:14:22.4400278Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T17:14:22.4401137Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T17:14:22.4401980Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T17:14:22.4402917Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T17:14:22.4403546Z +     "manner.\n",
2026-07-28T17:14:22.4403840Z +     "\n",
2026-07-28T17:14:22.4404686Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T17:14:22.4405703Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T17:14:22.4406398Z +     "\n",
2026-07-28T17:14:22.4407020Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T17:14:22.4407877Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T17:14:22.4408455Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T17:14:22.4408817Z +     strrep("=", 78),
2026-07-28T17:14:22.4409042Z +     "\n"
2026-07-28T17:14:22.4409214Z +   )
2026-07-28T17:14:22.4409384Z + }
