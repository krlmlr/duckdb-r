2026-07-28T17:14:22.7067306Z > # This file is part of the standard setup for testthat.
2026-07-28T17:14:22.7067939Z > # It is recommended that you do not modify it.
2026-07-28T17:14:22.7068274Z > #
2026-07-28T17:14:22.7068544Z > # Where should you do additional test configuration?
2026-07-28T17:14:22.7068928Z > # Learn more about the roles of various files in:
2026-07-28T17:14:22.7069396Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T17:14:22.7069870Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T17:14:22.7070165Z > 
2026-07-28T17:14:22.7070360Z > library(testthat)
2026-07-28T17:14:22.7070687Z > library(duckdb)
2026-07-28T17:14:22.7071401Z Loading required package: DBI
2026-07-28T17:14:22.7072307Z > 
2026-07-28T17:14:22.7072578Z > # CRAN guard
2026-07-28T17:14:22.7072851Z > #
2026-07-28T17:14:22.7073430Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T17:14:22.7074374Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T17:14:22.7075225Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T17:14:22.7075830Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T17:14:22.7077141Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T17:14:22.7078144Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T17:14:22.7078894Z > # so the guard is obvious and self-contained.
2026-07-28T17:14:22.7079589Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T17:14:22.7079918Z > 
2026-07-28T17:14:22.7080171Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T17:14:22.7080583Z +   run <- TRUE
2026-07-28T17:14:22.7081059Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T17:14:22.7081713Z +   run <- FALSE
2026-07-28T17:14:22.7082210Z + } else {
2026-07-28T17:14:22.7083970Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T17:14:22.7084904Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T17:14:22.7085411Z + }
2026-07-28T17:14:22.7085677Z > 
2026-07-28T17:14:22.7085957Z > if (run) {
2026-07-28T17:14:22.7086334Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T17:14:22.7086745Z + } else {
2026-07-28T17:14:22.7087027Z +   message(
2026-07-28T17:14:22.7087316Z +     "\n",
2026-07-28T17:14:22.7087609Z +     strrep("=", 78),
2026-07-28T17:14:22.7087921Z +     "\n",
2026-07-28T17:14:22.7088296Z +     "Skipping the duckdb test suite.\n",
2026-07-28T17:14:22.7088729Z +     "\n",
2026-07-28T17:14:22.7089336Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T17:14:22.7090298Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T17:14:22.7091178Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T17:14:22.7092865Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T17:14:22.7093582Z +     "manner.\n",
2026-07-28T17:14:22.7093908Z +     "\n",
2026-07-28T17:14:22.7094315Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T17:14:22.7094945Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T17:14:22.7095541Z +     "\n",
2026-07-28T17:14:22.7095923Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T17:14:22.7096477Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T17:14:22.7096976Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T17:14:22.7097324Z +     strrep("=", 78),
2026-07-28T17:14:22.7097525Z +     "\n"
2026-07-28T17:14:22.7097689Z +   )
2026-07-28T17:14:22.7097848Z + }
