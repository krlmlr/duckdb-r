2026-07-28T07:08:48.9073809Z > # CRAN guard
2026-07-28T07:08:48.9073995Z > #
2026-07-28T07:08:48.9074404Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:08:48.9075020Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:08:48.9075620Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:08:48.9076196Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:08:48.9076783Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:08:48.9077614Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:08:48.9078104Z > # so the guard is obvious and self-contained.
2026-07-28T07:08:48.9078557Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:08:48.9078895Z > 
2026-07-28T07:08:48.9079168Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:08:48.9079473Z +   run <- TRUE
2026-07-28T07:08:48.9079792Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:08:48.9080118Z +   run <- FALSE
2026-07-28T07:08:48.9080602Z + } else {
2026-07-28T07:08:48.9080995Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:08:48.9081483Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:08:48.9081770Z + }
2026-07-28T07:08:48.9081941Z > 
2026-07-28T07:08:48.9082132Z > if (run) {
2026-07-28T07:08:48.9082389Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:08:48.9082666Z + } else {
2026-07-28T07:08:48.9083002Z +   message(
2026-07-28T07:08:48.9083213Z +     "\n",
2026-07-28T07:08:48.9083440Z +     strrep("=", 78),
2026-07-28T07:08:48.9083666Z +     "\n",
2026-07-28T07:08:48.9083921Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:08:48.9084207Z +     "\n",
2026-07-28T07:08:48.9084617Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:08:48.9085215Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:08:48.9085790Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:08:48.9086395Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:08:48.9086814Z +     "manner.\n",
2026-07-28T07:08:48.9087024Z +     "\n",
2026-07-28T07:08:48.9087429Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:08:48.9088076Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:08:48.9088511Z +     "\n",
2026-07-28T07:08:48.9088921Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:08:48.9089569Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:08:48.9090103Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:08:48.9090704Z +     strrep("=", 78),
2026-07-28T07:08:48.9090929Z +     "\n"
2026-07-28T07:08:48.9091111Z +   )
2026-07-28T07:08:48.9091285Z + }
