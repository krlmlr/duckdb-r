2026-07-28T07:06:58.4875139Z > # This file is part of the standard setup for testthat.
2026-07-28T07:06:58.4875525Z > # It is recommended that you do not modify it.
2026-07-28T07:06:58.4875793Z > #
2026-07-28T07:06:58.4876070Z > # Where should you do additional test configuration?
2026-07-28T07:06:58.4876456Z > # Learn more about the roles of various files in:
2026-07-28T07:06:58.4876932Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-28T07:06:58.4877534Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-28T07:06:58.4877851Z > 
2026-07-28T07:06:58.4878048Z > library(testthat)
2026-07-28T07:06:58.4878274Z > library(duckdb.dev)
2026-07-28T07:06:58.4878524Z Loading required package: DBI
2026-07-28T07:06:58.4878760Z > 
2026-07-28T07:06:58.4878946Z > # CRAN guard
2026-07-28T07:06:58.4879125Z > #
2026-07-28T07:06:58.4879519Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-28T07:06:58.4880193Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-28T07:06:58.4881188Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-28T07:06:58.4881765Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-28T07:06:58.4882339Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-28T07:06:58.4882941Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-28T07:06:58.4883417Z > # so the guard is obvious and self-contained.
2026-07-28T07:06:58.4883859Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-28T07:06:58.4884189Z > 
2026-07-28T07:06:58.4884450Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-28T07:06:58.4884754Z +   run <- TRUE
2026-07-28T07:06:58.4885062Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-28T07:06:58.4885383Z +   run <- FALSE
2026-07-28T07:06:58.4885584Z + } else {
2026-07-28T07:06:58.4885935Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-28T07:06:58.4886373Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-28T07:06:58.4886647Z + }
2026-07-28T07:06:58.4886807Z > 
2026-07-28T07:06:58.4886983Z > if (run) {
2026-07-28T07:06:58.4887224Z +   test_check(simulate_duckdb()$pkg)
2026-07-28T07:06:58.4887486Z + } else {
2026-07-28T07:06:58.4887670Z +   message(
2026-07-28T07:06:58.4887857Z +     "\n",
2026-07-28T07:06:58.4888060Z +     strrep("=", 78),
2026-07-28T07:06:58.4888267Z +     "\n",
2026-07-28T07:06:58.4888510Z +     "Skipping the duckdb test suite.\n",
2026-07-28T07:06:58.4888774Z +     "\n",
2026-07-28T07:06:58.4889173Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-28T07:06:58.4889871Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-28T07:06:58.4890666Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-28T07:06:58.4891287Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-28T07:06:58.4891777Z +     "manner.\n",
2026-07-28T07:06:58.4891976Z +     "\n",
2026-07-28T07:06:58.4892377Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-28T07:06:58.4893002Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-28T07:06:58.4893424Z +     "\n",
2026-07-28T07:06:58.4893819Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-28T07:06:58.4894391Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-28T07:06:58.4894912Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-28T07:06:58.4895414Z +     strrep("=", 78),
2026-07-28T07:06:58.4895632Z +     "\n"
2026-07-28T07:06:58.4895798Z +   )
2026-07-28T07:06:58.4895960Z + }
