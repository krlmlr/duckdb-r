2026-08-16T02:29:12.3666367Z [36;1mncores="$(Rscript --vanilla -e 'n <- parallel::detectCores(); cat(if (is.na(n) || n < 1) 2L else as.integer(n))')"[0m
2026-08-16T02:29:12.3666919Z [36;1mecho "MAKEFLAGS = -j${ncores}" >> ~/.R/Makevars[0m
2026-08-16T02:29:12.3667243Z [36;1mecho "===== generated ~/.R/Makevars ====="[0m
2026-08-16T02:29:12.3667520Z [36;1mcat ~/.R/Makevars[0m
2026-08-16T02:29:12.3667747Z [36;1mecho "==================================="[0m
2026-08-16T02:29:12.3668002Z [36;1m[0m
2026-08-16T02:29:12.3668271Z [36;1mecho 'CCACHE_SLOPPINESS=locale,time_macros' | tee -a $GITHUB_ENV[0m
2026-08-16T02:29:12.3668618Z [36;1m[0m
2026-08-16T02:29:12.3668896Z [36;1m# Do NOT export UserNM here, however tempting the `UserNM=true` trick[0m
2026-08-16T02:29:12.3669369Z [36;1m# from AGENTS.md looks. It is a development shortcut, not a CI setting.[0m
