2026-08-16T02:29:12.3652424Z [36;1m    prog="${val%%[[:space:]]*}"[0m
2026-08-16T02:29:12.3652670Z [36;1m    flags="${val#"$prog"}"[0m
2026-08-16T02:29:12.3652932Z [36;1m    wrapper="ccache-$(basename "$prog")"[0m
2026-08-16T02:29:12.3653188Z [36;1m[0m
2026-08-16T02:29:12.3653388Z [36;1m    if [ ! -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-16T02:29:12.3653793Z [36;1m      printf '#!/bin/sh\nexec ccache %s "$@"\n' "$prog" > "$wrapper_dir/$wrapper"[0m
