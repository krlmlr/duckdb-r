2026-08-16T02:29:12.3654543Z [36;1m      # Never hand R a wrapper that has not been shown to work.[0m
2026-08-16T02:29:12.3655077Z [36;1m      if ! "$wrapper_dir/$wrapper" --version > /dev/null; then[0m
2026-08-16T02:29:12.3655425Z [36;1m        rm -f "$wrapper_dir/$wrapper"[0m
2026-08-16T02:29:12.3655815Z [36;1m        echo "::warning::No usable $wrapper, compiling $var without ccache."[0m
2026-08-16T02:29:12.3656175Z [36;1m      fi[0m
2026-08-16T02:29:12.3656345Z [36;1m    fi[0m
2026-08-16T02:29:12.3656512Z [36;1m[0m
2026-08-16T02:29:12.3656713Z [36;1m    if [ -f "$wrapper_dir/$wrapper" ]; then[0m
2026-08-16T02:29:12.3657032Z [36;1m      echo "$var = $wrapper$flags" >> ~/.R/Makevars[0m
2026-08-16T02:29:12.3657309Z [36;1m    fi[0m
2026-08-16T02:29:12.3657471Z [36;1m  done[0m
2026-08-16T02:29:12.3657651Z [36;1m  rm -f "$empty_makevars"[0m
2026-08-16T02:29:12.3657872Z [36;1m[0m
2026-08-16T02:29:12.3658056Z [36;1m  if [ "$RUNNER_OS" != "Windows" ]; then[0m
2026-08-16T02:29:12.3658349Z [36;1m    echo "$wrapper_dir" >> "$GITHUB_PATH"[0m
2026-08-16T02:29:12.3658672Z [36;1m    echo "===== ccache wrappers in $wrapper_dir ====="[0m
