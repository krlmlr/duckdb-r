2026-08-16T02:29:12.3647817Z [36;1m  empty_makevars="$(mktemp)"[0m
2026-08-16T02:29:12.3648117Z [36;1m  for var in CC CXX CXX11 CXX14 CXX17 CXX20 CXX23; do[0m
2026-08-16T02:29:12.3648575Z [36;1m    val="$(R_MAKEVARS_USER="$empty_makevars" R CMD config "$var" 2>/dev/null || true)"[0m
2026-08-16T02:29:12.3648984Z [36;1m    if [ -z "$val" ]; then[0m
2026-08-16T02:29:12.3649216Z [36;1m      continue[0m
2026-08-16T02:29:12.3649411Z [36;1m    fi[0m
2026-08-16T02:29:12.3649617Z [36;1m    if [ "$RUNNER_OS" = "Windows" ]; then[0m
