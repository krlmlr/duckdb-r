2026-08-07T03:00:49.2972828Z > # Learn more about the roles of various files in:
2026-08-07T03:00:49.2973533Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-08-07T03:00:49.2974068Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-08-07T03:00:49.2974339Z > 
2026-08-07T03:00:49.2974508Z > library(testthat)
2026-08-07T03:00:49.2974692Z > library(duckdb)
2026-08-07T03:00:49.2974896Z Loading required package: DBI
2026-08-07T03:00:49.2975090Z > 
2026-08-07T03:00:49.2975246Z > # CRAN guard
2026-08-07T03:00:49.2975411Z > #
2026-08-07T03:00:49.2975740Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-08-07T03:00:49.2976353Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-08-07T03:00:49.2976816Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-08-07T03:00:49.2977260Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-08-07T03:00:49.2977722Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-08-07T03:00:49.2978216Z > # This check is intentionally inlined here (rather than calling into the package)
2026-08-07T03:00:49.2978603Z > # so the guard is obvious and self-contained.
2026-08-07T03:00:49.2978966Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-08-07T03:00:49.2979248Z > 
2026-08-07T03:00:49.2979473Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-08-07T03:00:49.2979719Z +   run <- TRUE
2026-08-07T03:00:49.2980308Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-08-07T03:00:49.2980608Z +   run <- FALSE
2026-08-07T03:00:49.2980799Z + } else {
2026-08-07T03:00:49.2981087Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-08-07T03:00:49.2981442Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-08-07T03:00:49.2981675Z + }
2026-08-07T03:00:49.2981877Z > 
2026-08-07T03:00:49.2982034Z > if (run) {
2026-08-07T03:00:49.2982239Z +   test_check(simulate_duckdb()$pkg)
2026-08-07T03:00:49.2982458Z + } else {
2026-08-07T03:00:49.2982617Z +   message(
2026-08-07T03:00:49.2982780Z +     "\n",
2026-08-07T03:00:49.2982959Z +     strrep("=", 78),
2026-08-07T03:00:49.2983142Z +     "\n",
2026-08-07T03:00:49.2983340Z +     "Skipping the duckdb test suite.\n",
2026-08-07T03:00:49.2983563Z +     "\n",
2026-08-07T03:00:49.2983899Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-08-07T03:00:49.2984374Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-08-07T03:00:49.2984818Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-08-07T03:00:49.2985288Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-08-07T03:00:49.2985615Z +     "manner.\n",
2026-08-07T03:00:49.2985782Z +     "\n",
2026-08-07T03:00:49.2986107Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-08-07T03:00:49.2986598Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-08-07T03:00:49.2986922Z +     "\n",
2026-08-07T03:00:49.2987255Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-08-07T03:00:49.2987717Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-08-07T03:00:49.2988123Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-08-07T03:00:49.2988425Z +     strrep("=", 78),
2026-08-07T03:00:49.2988616Z +     "\n"
2026-08-07T03:00:49.2988764Z +   )
2026-08-07T03:00:49.2988909Z + }
