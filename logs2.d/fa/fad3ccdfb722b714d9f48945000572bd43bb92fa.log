2026-07-27T06:47:29.0135757Z > # It is recommended that you do not modify it.
2026-07-27T06:47:29.0136049Z > #
2026-07-27T06:47:29.0136360Z > # Where should you do additional test configuration?
2026-07-27T06:47:29.0136769Z > # Learn more about the roles of various files in:
2026-07-27T06:47:29.0137456Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:47:29.0137966Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:47:29.0138290Z > 
2026-07-27T06:47:29.0138506Z > library(testthat)
2026-07-27T06:47:29.0138757Z > library(duckdb.dev)
2026-07-27T06:47:29.0139041Z Loading required package: DBI
2026-07-27T06:47:29.0139286Z > 
2026-07-27T06:47:29.0139490Z > # CRAN guard
2026-07-27T06:47:29.0139700Z > #
2026-07-27T06:47:29.0140108Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:47:29.0140725Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:47:29.0141349Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:47:29.0141919Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:47:29.0142495Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:47:29.0143096Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:47:29.0143585Z > # so the guard is obvious and self-contained.
2026-07-27T06:47:29.0144041Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:47:29.0144398Z > 
2026-07-27T06:47:29.0144680Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:47:29.0145018Z +   run <- TRUE
2026-07-27T06:47:29.0145351Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:47:29.0145699Z +   run <- FALSE
2026-07-27T06:47:29.0145929Z + } else {
2026-07-27T06:47:29.0146313Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:47:29.0146777Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:47:29.0147378Z + }
2026-07-27T06:47:29.0147564Z > 
2026-07-27T06:47:29.0147774Z > if (run) {
2026-07-27T06:47:29.0148059Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:47:29.0148350Z + } else {
2026-07-27T06:47:29.0148561Z +   message(
2026-07-27T06:47:29.0148781Z +     "\n",
2026-07-27T06:47:29.0149011Z +     strrep("=", 78),
2026-07-27T06:47:29.0149253Z +     "\n",
2026-07-27T06:47:29.0149516Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:47:29.0149824Z +     "\n",
2026-07-27T06:47:29.0150444Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:47:29.0151085Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:47:29.0151672Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:47:29.0152381Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:47:29.0152807Z +     "manner.\n",
2026-07-27T06:47:29.0153047Z +     "\n",
2026-07-27T06:47:29.0153463Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:47:29.0154119Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:47:29.0154574Z +     "\n",
2026-07-27T06:47:29.0155010Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:47:29.0155605Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:47:29.0156248Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:47:29.0156651Z +     strrep("=", 78),
2026-07-27T06:47:29.0157066Z +     "\n"
2026-07-27T06:47:29.0157361Z +   )
2026-07-27T06:47:29.0157557Z + }
