2026-07-27T06:45:29.5094127Z > #
2026-07-27T06:45:29.5094585Z > # Where should you do additional test configuration?
2026-07-27T06:45:29.5095229Z > # Learn more about the roles of various files in:
2026-07-27T06:45:29.5096032Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:45:29.5097013Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:45:29.5097529Z > 
2026-07-27T06:45:29.5097858Z > library(testthat)
2026-07-27T06:45:29.5098242Z > library(duckdb.dev)
2026-07-27T06:45:29.5098643Z Loading required package: DBI
2026-07-27T06:45:29.5099020Z > 
2026-07-27T06:45:29.5099317Z > # CRAN guard
2026-07-27T06:45:29.5099609Z > #
2026-07-27T06:45:29.5100273Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:45:29.5101227Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:45:29.5102162Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:45:29.5103073Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:45:29.5104048Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:45:29.5104994Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:45:29.5105755Z > # so the guard is obvious and self-contained.
2026-07-27T06:45:29.5106466Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:45:29.5107296Z > 
2026-07-27T06:45:29.5107727Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:45:29.5108210Z +   run <- TRUE
2026-07-27T06:45:29.5108974Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:45:29.5109507Z +   run <- FALSE
2026-07-27T06:45:29.5110019Z + } else {
2026-07-27T06:45:29.5110597Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:45:29.5111314Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:45:29.5111796Z + }
2026-07-27T06:45:29.5112056Z > 
2026-07-27T06:45:29.5112350Z > if (run) {
2026-07-27T06:45:29.5112739Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:45:29.5113153Z + } else {
2026-07-27T06:45:29.5113458Z +   message(
2026-07-27T06:45:29.5113767Z +     "\n",
2026-07-27T06:45:29.5114112Z +     strrep("=", 78),
2026-07-27T06:45:29.5114448Z +     "\n",
2026-07-27T06:45:29.5114846Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:45:29.5115284Z +     "\n",
2026-07-27T06:45:29.5115931Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:45:29.5117073Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:45:29.5118148Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:45:29.5119096Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:45:29.5119772Z +     "manner.\n",
2026-07-27T06:45:29.5120218Z +     "\n",
2026-07-27T06:45:29.5120875Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:45:29.5121915Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:45:29.5122578Z +     "\n",
2026-07-27T06:45:29.5123225Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:45:29.5124140Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:45:29.5124977Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:45:29.5125561Z +     strrep("=", 78),
2026-07-27T06:45:29.5125916Z +     "\n"
2026-07-27T06:45:29.5126221Z +   )
2026-07-27T06:45:29.5126505Z + }
