2026-07-27T14:44:04.6521103Z +                   row.addEventListener("click", function () {
2026-07-27T14:44:04.6521687Z +                       var o = kids.style.display === "none"; kids.style.display = o ? "block" : "none"; caret.textContent = o ? "▾" : "▸";
2026-07-27T14:44:04.6521802Z +                   });
2026-07-27T14:44:04.6521896Z +               }
2026-07-27T14:44:04.6522016Z +               return wrap;
2026-07-27T14:44:04.6522113Z +           }
2026-07-27T14:44:04.6522242Z +           panel.innerHTML = "";
