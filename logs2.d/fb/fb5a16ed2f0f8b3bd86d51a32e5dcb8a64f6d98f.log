2026-07-27T14:44:04.6512318Z +           timings.forEach(function (t) { map[t.key] = t.seconds; });
2026-07-27T14:44:04.6512651Z +           var phases = [{ key: "parser", label: "Parser" }, { key: "planner", label: "Planner" },
2026-07-27T14:44:04.6513065Z +                         { key: "optimizer", label: "Optimizer" }, { key: "physical_planner", label: "Physical Planner" }];
2026-07-27T14:44:04.6513231Z +           function val(k) { return map[k] || 0; }
2026-07-27T14:44:04.6513606Z +           var planTotal = phases.reduce(function (a, p) { return a + val(p.key + ".total_time"); }, 0);
2026-07-27T14:44:04.6513841Z +           if (planTotal <= 0) { btn.style.display = "none"; return; }
2026-07-27T14:44:04.6513918Z +   
2026-07-27T14:44:04.6514261Z +           var planNode = { label: "Plan Time", secs: planTotal, children: phases.map(function (p) {
2026-07-27T14:44:04.6514797Z +               var subs = timings.filter(function (t) { return t.key.indexOf(p.key + ".") === 0 && t.key !== p.key + ".total_time" && t.seconds > 0; })
2026-07-27T14:44:04.6515065Z +                                 .sort(function (a, b) { return b.seconds - a.seconds; })
2026-07-27T14:44:04.6515637Z +                                 .map(function (t) { return { label: t.key.split(".").slice(1).join("."), secs: t.seconds, children: [] }; });
