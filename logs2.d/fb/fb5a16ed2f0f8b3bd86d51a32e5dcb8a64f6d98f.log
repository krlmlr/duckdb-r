2026-07-27T14:44:04.6516951Z +               var row = document.createElement("div"); row.className = "tm-row"; row.style.paddingLeft = (10 + depth * 15) + "px";
2026-07-27T14:44:04.6517175Z +               var hasKids = node.children && node.children.length;
2026-07-27T14:44:04.6517896Z +               var caret = document.createElement("span"); caret.className = "tm-caret"; caret.textContent = hasKids ? "▸" : "";
2026-07-27T14:44:04.6518290Z +               var nm = document.createElement("span"); nm.className = "tm-nm"; nm.textContent = node.label;
2026-07-27T14:44:04.6518713Z +               var pc = document.createElement("span"); pc.className = "tm-pc"; pc.textContent = fmtTime(node.secs);
2026-07-27T14:44:04.6518997Z +               row.appendChild(caret); row.appendChild(nm); row.appendChild(pc);
2026-07-27T14:44:04.6519217Z +               wrap.appendChild(row);
