2026-07-27T06:27:18.3282811Z > # This file is part of the standard setup for testthat.
2026-07-27T06:27:18.3283366Z > # It is recommended that you do not modify it.
2026-07-27T06:27:18.3283648Z > #
2026-07-27T06:27:18.3283940Z > # Where should you do additional test configuration?
2026-07-27T06:27:18.3284342Z > # Learn more about the roles of various files in:
2026-07-27T06:27:18.3284833Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-27T06:27:18.3285361Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-27T06:27:18.3285685Z > 
2026-07-27T06:27:18.3285902Z > library(testthat)
2026-07-27T06:27:18.3286143Z > library(duckdb.dev)
2026-07-27T06:27:18.3286412Z Loading required package: DBI
2026-07-27T06:27:18.3286652Z > 
2026-07-27T06:27:18.3286852Z > # CRAN guard
2026-07-27T06:27:18.3287040Z > #
2026-07-27T06:27:18.3287770Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:27:18.3288403Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:27:18.3288996Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:27:18.3289574Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:27:18.3290162Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:27:18.3290770Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:27:18.3291259Z > # so the guard is obvious and self-contained.
2026-07-27T06:27:18.3291730Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:27:18.3292075Z > 
2026-07-27T06:27:18.3292347Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:27:18.3292665Z +   run <- TRUE
2026-07-27T06:27:18.3292985Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:27:18.3293321Z +   run <- FALSE
2026-07-27T06:27:18.3293534Z + } else {
2026-07-27T06:27:18.3293917Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:27:18.3294371Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:27:18.3294657Z + }
2026-07-27T06:27:18.3294838Z > 
2026-07-27T06:27:18.3295033Z > if (run) {
2026-07-27T06:27:18.3295290Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:27:18.3295565Z + } else {
2026-07-27T06:27:18.3295771Z +   message(
2026-07-27T06:27:18.3295970Z +     "\n",
2026-07-27T06:27:18.3296187Z +     strrep("=", 78),
2026-07-27T06:27:18.3296418Z +     "\n",
2026-07-27T06:27:18.3296668Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:27:18.3296949Z +     "\n",
2026-07-27T06:27:18.3297615Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:27:18.3298438Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:27:18.3299025Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:27:18.3299627Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:27:18.3300059Z +     "manner.\n",
2026-07-27T06:27:18.3300273Z +     "\n",
2026-07-27T06:27:18.3300676Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:27:18.3301325Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:27:18.3301827Z +     "\n",
2026-07-27T06:27:18.3302240Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:27:18.3302832Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:27:18.3303361Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:27:18.3303744Z +     strrep("=", 78),
2026-07-27T06:27:18.3303966Z +     "\n"
2026-07-27T06:27:18.3304153Z +   )
2026-07-27T06:27:18.3304330Z + }
