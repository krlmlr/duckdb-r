2026-07-27T06:25:24.0962525Z > library(testthat)
2026-07-27T06:25:24.0962945Z > library(duckdb.dev)
2026-07-27T06:25:24.0963419Z Loading required package: DBI
2026-07-27T06:25:24.0963835Z > 
2026-07-27T06:25:24.0964181Z > # CRAN guard
2026-07-27T06:25:24.0964508Z > #
2026-07-27T06:25:24.0965256Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-27T06:25:24.0966361Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-27T06:25:24.0967688Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-27T06:25:24.0968752Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-27T06:25:24.0969818Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-27T06:25:24.0970925Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-27T06:25:24.0971964Z > # so the guard is obvious and self-contained.
2026-07-27T06:25:24.0972776Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-27T06:25:24.0973373Z > 
2026-07-27T06:25:24.0973867Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-27T06:25:24.0974413Z +   run <- TRUE
2026-07-27T06:25:24.0975280Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-27T06:25:24.0975899Z +   run <- FALSE
2026-07-27T06:25:24.0976267Z + } else {
2026-07-27T06:25:24.0976920Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-27T06:25:24.0978021Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-27T06:25:24.0978574Z + }
2026-07-27T06:25:24.0978872Z > 
2026-07-27T06:25:24.0979213Z > if (run) {
2026-07-27T06:25:24.0979658Z +   test_check(simulate_duckdb()$pkg)
2026-07-27T06:25:24.0980139Z + } else {
2026-07-27T06:25:24.0980473Z +   message(
2026-07-27T06:25:24.0980813Z +     "\n",
2026-07-27T06:25:24.0981195Z +     strrep("=", 78),
2026-07-27T06:25:24.0981583Z +     "\n",
2026-07-27T06:25:24.0982028Z +     "Skipping the duckdb test suite.\n",
2026-07-27T06:25:24.0982527Z +     "\n",
2026-07-27T06:25:24.0983267Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-27T06:25:24.0984345Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-27T06:25:24.0985387Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-27T06:25:24.0986482Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-27T06:25:24.0987247Z +     "manner.\n",
2026-07-27T06:25:24.0987838Z +     "\n",
2026-07-27T06:25:24.0988593Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-27T06:25:24.0989904Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-27T06:25:24.0990683Z +     "\n",
2026-07-27T06:25:24.0991555Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-27T06:25:24.0992615Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-27T06:25:24.0993577Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-27T06:25:24.0994254Z +     strrep("=", 78),
2026-07-27T06:25:24.0994645Z +     "\n"
2026-07-27T06:25:24.0994951Z +   )
2026-07-27T06:25:24.0995254Z + }
