2026-09-12T02:00:52.6726470Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-12T02:00:52.6727040Z > # so the guard is obvious and self-contained.
2026-09-12T02:00:52.6727480Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-12T02:00:52.6727910Z > 
2026-09-12T02:00:52.6728230Z > if (run_tests %in% c("true", "1", "yes", "on")) {
