2026-09-12T02:00:52.8873190Z > library(testthat)
2026-09-12T02:00:52.8873270Z > library(duckdb)
2026-09-12T02:00:52.8873390Z Loading required package: DBI
2026-09-12T02:00:52.8873430Z > 
2026-09-12T02:00:52.8873510Z > # CRAN guard
2026-09-12T02:00:52.8873550Z > #
2026-09-12T02:00:52.8873850Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-09-12T02:00:52.8874120Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-09-12T02:00:52.8874390Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-09-12T02:00:52.8874640Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-09-12T02:00:52.8874910Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-09-12T02:00:52.8875180Z > # This check is intentionally inlined here (rather than calling into the package)
2026-09-12T02:00:52.8875380Z > # so the guard is obvious and self-contained.
2026-09-12T02:00:52.8875600Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-09-12T02:00:52.8875650Z > 
2026-09-12T02:00:52.8875800Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-09-12T02:00:52.8875880Z +   run <- TRUE
2026-09-12T02:00:52.8876060Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-09-12T02:00:52.8876130Z +   run <- FALSE
2026-09-12T02:00:52.8876190Z + } else {
2026-09-12T02:00:52.8876430Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-09-12T02:00:52.8876640Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-09-12T02:00:52.8876680Z + }
2026-09-12T02:00:52.8876730Z > 
2026-09-12T02:00:52.8876800Z > if (run) {
2026-09-12T02:00:52.8876930Z +   test_check(simulate_duckdb()$pkg)
2026-09-12T02:00:52.8877020Z + } else {
2026-09-12T02:00:52.8877090Z +   message(
2026-09-12T02:00:52.8877160Z +     "\n",
2026-09-12T02:00:52.8877250Z +     strrep("=", 78),
2026-09-12T02:00:52.8877320Z +     "\n",
2026-09-12T02:00:52.8877450Z +     "Skipping the duckdb test suite.\n",
2026-09-12T02:00:52.8877510Z +     "\n",
2026-09-12T02:00:52.8877790Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-09-12T02:00:52.8878060Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-09-12T02:00:52.8878320Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-09-12T02:00:52.8878640Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-09-12T02:00:52.8878750Z +     "manner.\n",
2026-09-12T02:00:52.8878830Z +     "\n",
2026-09-12T02:00:52.8879180Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-09-12T02:00:52.8879550Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-09-12T02:00:52.8879650Z +     "\n",
2026-09-12T02:00:52.8880010Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-09-12T02:00:52.8880300Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-09-12T02:00:52.8880620Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-09-12T02:00:52.8880710Z +     strrep("=", 78),
2026-09-12T02:00:52.8880800Z +     "\n"
2026-09-12T02:00:52.8880860Z +   )
2026-09-12T02:00:52.8880910Z + }
