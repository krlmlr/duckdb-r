2026-07-29T06:46:47.1705732Z > # This file is part of the standard setup for testthat.
2026-07-29T06:46:47.1706442Z > # It is recommended that you do not modify it.
2026-07-29T06:46:47.1706917Z > #
2026-07-29T06:46:47.1707402Z > # Where should you do additional test configuration?
2026-07-29T06:46:47.1708128Z > # Learn more about the roles of various files in:
2026-07-29T06:46:47.1708821Z > # * https://r-pkgs.org/testing-design.html#sec-tests-files-overview
2026-07-29T06:46:47.1709321Z > # * https://testthat.r-lib.org/articles/special-files.html
2026-07-29T06:46:47.1709638Z > 
2026-07-29T06:46:47.1709836Z > library(testthat)
2026-07-29T06:46:47.1710055Z > library(duckdb)
2026-07-29T06:46:47.1710299Z Loading required package: DBI
2026-07-29T06:46:47.1710543Z > 
2026-07-29T06:46:47.1710733Z > # CRAN guard
2026-07-29T06:46:47.1710917Z > #
2026-07-29T06:46:47.1711419Z > # The duckdb test suite exercises DuckDB's bundled C++ engine, which is too heavy
2026-07-29T06:46:47.1712307Z > # for CRAN's check farm, and checks were very fragile in the past. We therefore
2026-07-29T06:46:47.1713277Z > # keep it off on CRAN but run it automatically on GitHub Actions (GITHUB_ACTIONS)
2026-07-29T06:46:47.1713879Z > # and on r-universe (MY_UNIVERSE). An explicit DUCKDB_R_RUN_TESTS opts in
2026-07-29T06:46:47.1714770Z > # (true-ish) or out (false-ish) and always wins; otherwise we fall back to those.
2026-07-29T06:46:47.1715379Z > # This check is intentionally inlined here (rather than calling into the package)
2026-07-29T06:46:47.1715859Z > # so the guard is obvious and self-contained.
2026-07-29T06:46:47.1716304Z > run_tests <- tolower(trimws(Sys.getenv("DUCKDB_R_RUN_TESTS", "")))
2026-07-29T06:46:47.1716645Z > 
2026-07-29T06:46:47.1716910Z > if (run_tests %in% c("true", "1", "yes", "on")) {
2026-07-29T06:46:47.1717209Z +   run <- TRUE
2026-07-29T06:46:47.1717521Z + } else if (run_tests %in% c("false", "0", "no", "off")) {
2026-07-29T06:46:47.1717852Z +   run <- FALSE
2026-07-29T06:46:47.1718061Z + } else {
2026-07-29T06:46:47.1718432Z +   run <- tolower(trimws(Sys.getenv("GITHUB_ACTIONS", ""))) == "true" ||
2026-07-29T06:46:47.1718997Z +     nzchar(trimws(Sys.getenv("MY_UNIVERSE", "")))
2026-07-29T06:46:47.1719272Z + }
2026-07-29T06:46:47.1719437Z > 
2026-07-29T06:46:47.1719623Z > if (run) {
2026-07-29T06:46:47.1719867Z +   test_check(simulate_duckdb()$pkg)
2026-07-29T06:46:47.1720133Z + } else {
2026-07-29T06:46:47.1720330Z +   message(
2026-07-29T06:46:47.1720521Z +     "\n",
2026-07-29T06:46:47.1720734Z +     strrep("=", 78),
2026-07-29T06:46:47.1720951Z +     "\n",
2026-07-29T06:46:47.1721195Z +     "Skipping the duckdb test suite.\n",
2026-07-29T06:46:47.1721472Z +     "\n",
2026-07-29T06:46:47.1721872Z +     "The duckdb tests exercise DuckDB's bundled C++ engine and are deliberately\n",
2026-07-29T06:46:47.1722473Z +     "NOT run on CRAN. They run automatically on GitHub Actions (including\n",
2026-07-29T06:46:47.1723030Z +     "r-universe). This keeps check time and resource usage on CRAN within\n",
2026-07-29T06:46:47.1723623Z +     "acceptable limits and helps release duckdb in a predictable and controlled\n",
2026-07-29T06:46:47.1724045Z +     "manner.\n",
2026-07-29T06:46:47.1724617Z +     "\n",
2026-07-29T06:46:47.1725310Z +     "This is intentional, not an oversight. duckdb has an extensive test suite\n",
2026-07-29T06:46:47.1726366Z +     "that runs continuously in our own CI; see <https://github.com/duckdb/duckdb-r>.\n",
2026-07-29T06:46:47.1726796Z +     "\n",
2026-07-29T06:46:47.1727315Z +     "To run the test suite locally, set the environment variable before checking:\n",
2026-07-29T06:46:47.1727883Z +     "  Sys.setenv(DUCKDB_R_RUN_TESTS = \"true\")    # from within R, or\n",
2026-07-29T06:46:47.1728403Z +     "  DUCKDB_R_RUN_TESTS=true R CMD check ...      # from the shell\n",
2026-07-29T06:46:47.1728781Z +     strrep("=", 78),
2026-07-29T06:46:47.1728998Z +     "\n"
2026-07-29T06:46:47.1729290Z +   )
2026-07-29T06:46:47.1729469Z + }
